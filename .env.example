# Every VITE_* value is compiled into the public JavaScript bundle, so none of
# them may be a secret. Local development: copy to `.env.local`. GitHub Pages:
# set the same names as repository Actions variables.

# Public Spotify application identifier. Safe to expose in a browser SPA.
# Never add a Spotify client secret to Vite/GitHub Pages.
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
# Must exactly match a redirect URI registered in the Spotify developer dashboard.
# When empty, the app uses the address it is served from (origin + base path).
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/

# Lyrics: lrclib (public LRCLIB API, no key) | mock (test lines) | none
VITE_LYRICS_PROVIDER=lrclib

# Translation: browser (on-device Translator API in recent Chrome) | http | mock | none
VITE_TRANSLATION_PROVIDER=browser
# Public URL of your own translation function (only for `http`). Not a secret.
VITE_TRANSLATION_ENDPOINT=
# BCP 47 target language for lyric translation.
VITE_TRANSLATION_TARGET=ko

# Offer "Preview without Spotify" (sample archive, simulated clock, no audio).
VITE_ENABLE_PREVIEW=true
