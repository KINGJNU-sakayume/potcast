  "segments": [
    {
      "startMs": 220,
      "endMs": 2580,
      "translation": "밤이면 사람들이 수군대는 소리가 들려"
    },
    {
      "startMs": 2580,
      "endMs": 5630,
      "translation": "세상에서 가장 차가운 이야기"
    },
    {
      "startMs": 5630,
      "endMs": 8080,
      "translation": "이 길 어딘가 저 멀리서"
    },
    {
      "startMs": 8080,
      "endMs": 15350,
      "translation": "그는 영혼을 잃었지, 그토록 매정한 여자에게"
    },
    {
      "startMs": 15350,
      "endMs": 19630,
      "translation": "어떻게 그렇게 매정할 수 있어?"
    },
    {
      "startMs": 19630,
      "endMs": 23570,
      "translation": "오, 어떻게 그렇게 매정할 수 있어?"
    },
    {
      "startMs": 23570,
      "endMs": 27870,
      "translation": "어떻게 그렇게, 불어오는 겨울바람처럼 차가울 수 있어"
    },
    {
      "startMs": 27870,
      "endMs": 30450,
      "translation": "그래도 지금 누구랑 얘기하는지는 기억해"
    },
    {
      "startMs": 30450,
      "endMs": 33060,
      "translation": "나한테 하는 말투 좀 조심하라고"
    },
    {
      "startMs": 33060,
      "endMs": 35870,
      "translation": "우리가 함께 겪은 그 모든 일이 있었는데"
    },
    {
      "startMs": 35870,
      "endMs": 38550,
      "translation": "우리가 같이 휘말린 그 모든 일이 있었는데"
    },
    {
      "startMs": 38550,
      "endMs": 41160,
      "translation": "야, 네가 나한테 말 안 한 것들도 알고 있어"
    },
    {
      "startMs": 41160,
      "endMs": 43920,
      "translation": "야, 나도 잘못한 게 있지만 그건 옛날의 나야"
    },
    {
      "startMs": 43920,
      "endMs": 46890,
      "translation": "그런데 이제 넌 날 되찾아서 본때를 보여 주겠다고"
    },
    {
      "startMs": 46890,
      "endMs": 49330,
      "translation": "날 모르는 사람처럼 지나가"
    },
    {
      "startMs": 49330,
      "endMs": 52150,
      "translation": "넌 새 친구가 생겼고, 나야 내 친구들이 있지"
    },
    {
      "startMs": 52150,
      "endMs": 54640,
      "translation": "그래도 결국엔 여전히 너무 외로워"
    },
    {
      "startMs": 54640,
      "endMs": 57180,
      "translation": "밤이면 사람들이 수군대는 소리가 들려"
    },
    {
      "startMs": 57180,
      "endMs": 60130,
      "translation": "세상에서 가장 차가운 이야기"
    },
    {
      "startMs": 60130,
      "endMs": 62620,
      "translation": "이 길 어딘가 저 멀리서"
    },
    {
      "startMs": 62620,
      "endMs": 69940,
      "translation": "그는 영혼을 잃었지, 그토록 매정한 여자에게"
    },
    {
      "startMs": 69940,
      "endMs": 74010,
      "translation": "어떻게 그렇게 매정할 수 있어?"
    },
    {
      "startMs": 74010,
      "endMs": 77380,
      "translation": "오, 어떻게 그렇게 매정할 수 있어?"
    },
    {
      "startMs": 77380,
      "endMs": 79770,
      "translation": "어떻게 그렇게 닥터 이블처럼 굴 수 있어?"
    },
    {
      "startMs": 79770,
      "endMs": 82720,
      "translation": "너는 나도 몰랐던 내 모습을 끌어내"
    },
    {
      "startMs": 82720,
      "endMs": 85430,
      "translation": "우린 서로 말도 안 하기로 했잖아, 그런데"
    },
    {
      "startMs": 85430,
      "endMs": 88420,
      "translation": "왜 새벽 3시에 통화하고 있는 거야?"
    },
    {
      "startMs": 88420,
      "endMs": 90810,
      "translation": "그녀는 왜 그렇게 나한테 화가 나 있는 걸까?"
    },
    {
      "startMs": 90810,
      "endMs": 93790,
      "translation": "친구, 나도 몰라, 뜨거웠다 차가웠다 해"
    },
    {
      "startMs": 93790,
      "endMs": 96010,
      "translation": "난 멈추지 않아, 내 흐름을 망치지 않아"
    },
    {
      "startMs": 96010,
      "endMs": 98930,
      "translation": "이게 어떻게 흘러갈지 이미 아니까"
    },
    {
      "startMs": 98930,
      "endMs": 101770,
      "translation": "넌 친구들한테 달려가 날 떠난다고 말하겠지 (헤이)"
    },
    {
      "startMs": 101770,
      "endMs": 104350,
      "translation": "걔들은 네가 나한테서 뭘 보는지 모르겠다고 하겠지 (헤이)"
    },
    {
      "startMs": 104350,
      "endMs": 107120,
      "translation": "두어 달만 기다려 봐, 그럼 알게 될 거야 (헤이)"
    },
    {
      "startMs": 107120,
      "endMs": 109320,
      "translation": "나보다 나은 사람은 절대 못 찾는다는 걸"
    },
    {
      "startMs": 109320,
      "endMs": 111680,
      "translation": "밤이면 사람들이 수군대는 소리가 들려"
    },
    {
      "startMs": 111680,
      "endMs": 114690,
      "translation": "세상에서 가장 차가운 이야기"
    },
    {
      "startMs": 114690,
      "endMs": 117000,
      "translation": "이 길 어딘가 저 멀리서"
    },
    {
      "startMs": 117000,
      "endMs": 124330,
      "translation": "그는 영혼을 잃었지, 그토록 매정한 여자에게"
    },
    {
      "startMs": 124330,
      "endMs": 128660,
      "translation": "어떻게 그렇게 매정할 수 있어?"
    },
    {
      "startMs": 128660,
      "endMs": 133260,
      "translation": "오, 어떻게 그렇게 매정할 수 있어?"
    },
    {
      "startMs": 133260,
      "endMs": 135790,
      "translation": "말하고 말하고 또 말하고"
    },
    {
      "startMs": 135790,
      "endMs": 138520,
      "translation": "자기야, 우리 이제 그만하자"
    },
    {
      "startMs": 138520,
      "endMs": 141280,
      "translation": "사람들은 우리가 뭘 겪었는지 몰라"
    },
    {
      "startMs": 141280,
      "endMs": 143880,
      "translation": "너와 나에 대해 아무것도 몰라"
    },
    {
      "startMs": 143880,
      "endMs": 146670,
      "translation": "그래서 난 새로운 걸 보러 갈 거야"
    },
    {
      "startMs": 146670,
      "endMs": 149340,
      "translation": "넌 계속 날 미워하겠지"
    },
    {
      "startMs": 149340,
      "endMs": 152340,
      "translation": "우린 그냥 원수가 되겠지"
    },
    {
      "startMs": 152340,
      "endMs": 155140,
      "translation": "넌 믿기지 않겠지"
    },
    {
      "startMs": 155140,
      "endMs": 157770,
      "translation": "내가 이걸 틀어진 채로 그냥 둘 수 있다는 게"
    },
    {
      "startMs": 157770,
      "endMs": 160550,
      "translation": "그리고 넌 그걸 바로잡을 수 없다는 게"
    },
    {
      "startMs": 160550,
      "endMs": 163390,
      "translation": "난 오늘 밤 떠날 거야"
    },
    {
      "startMs": 163390,
      "endMs": 164280,
      "translation": "밤 속으로"
    },
    {
