  "segments": [
    {
      "startMs": 2310,
      "endMs": 4980,
      "translation": "다들 이걸 기다렸잖아, 안 그래?"
    },
    {
      "startMs": 4980,
      "endMs": 7910,
      "translation": "사람들이 돈 내고 사는 그거, 젠장, 다들 못 참지"
    },
    {
      "startMs": 7910,
      "endMs": 10760,
      "translation": "새로운 걸 원하니까, 다시 인사나 하자"
    },
    {
      "startMs": 10760,
      "endMs": 11950,
      "translation": "동네가 제일 좋아하는 녀석이 됐어"
    },
    {
      "startMs": 11950,
      "endMs": 15090,
      "translation": "나도 설명을 못 하겠어, 나도 놀라"
    },
    {
      "startMs": 15090,
      "endMs": 18150,
      "translation": "돈의 삶, 조명은 계속 빛나고"
    },
    {
      "startMs": 18150,
      "endMs": 20330,
      "translation": "신상을 걸치고 클럽에 들어서"
    },
    {
      "startMs": 20330,
      "endMs": 23840,
      "translation": "팔엔 뭔가 끝내주는 걸 두르고, 어어어"
    },
    {
      "startMs": 23840,
      "endMs": 28010,
      "translation": "그리고 여기 또 한 방, 배리 본즈"
    },
    {
      "startMs": 28010,
      "endMs": 31050,
      "translation": "넘어갔어, 자기"
    },
    {
      "startMs": 31050,
      "endMs": 33910,
      "translation": "넘어갔어, 자기"
    },
    {
      "startMs": 33910,
      "endMs": 36960,
      "translation": "넘어갔어, 자기"
    },
    {
      "startMs": 36960,
      "endMs": 40810,
      "translation": "\"이봐\", 막 비행기에서 내려서 \"곤니치와, 얘들아\""
    },
    {
      "startMs": 40810,
      "endMs": 43990,
      "translation": "다른 비행기로 갈아타, 여권은 늘 대기 중"
    },
    {
      "startMs": 43990,
      "endMs": 46770,
      "translation": "해 달라면 했지, 그 재수 없는 놈이 해냈어"
    },
    {
      "startMs": 46770,
      "endMs": 49420,
      "translation": "말하고 나서 살아 냈고, 뱉고 나서 해치웠지"
    },
    {
      "startMs": 49420,
      "endMs": 52550,
      "translation": "대필 작가는 필요 없어, 아이디어를 주고받을 순 있어도"
    },
    {
      "startMs": 52550,
      "endMs": 55430,
      "translation": "이런 건 나만 생각해 낼 수 있거든"
    },
    {
      "startMs": 55430,
      "endMs": 58090,
      "translation": "난 평생 약자 역할을 했어"
    },
    {
      "startMs": 58090,
      "endMs": 60850,
      "translation": "올해 꽤 신사적이었지, 안 그래?"
    },
    {
      "startMs": 60850,
      "endMs": 63930,
      "translation": "다들 그래, \"저 녀석 미쳐 가고 있어, 전에도 봤잖아\""
    },
    {
      "startMs": 63930,
      "endMs": 66960,
      "translation": "그래도 천재치고는 꽤 잘하고 있잖아"
    },
    {
      "startMs": 66960,
      "endMs": 69820,
      "translation": "분홍색 폴로를 입고도 꽤 동네 사람답지"
    },
    {
      "startMs": 69820,
      "endMs": 73110,
      "translation": "이봐, 내가 폴로 마니아가 아니라니 무슨 소리야"
    },
    {
      "startMs": 73110,
      "endMs": 75960,
      "translation": "내 디오르 때문에 모델들한테 인기가 더 많은데?"
    },
    {
      "startMs": 75960,
      "endMs": 78670,
      "translation": "모욕적이네, 어서"
    },
    {
      "startMs": 78670,
      "endMs": 82630,
      "translation": "무릎이 이마에 닿을 때까지 고개를 숙여"
    },
    {
      "startMs": 82630,
      "endMs": 84580,
      "translation": "그리고 이 흐름은 이제 비상사태야"
    },
    {
      "startMs": 84580,
      "endMs": 87550,
      "translation": "랩 상위 다섯 명, 굳이 말 안 해 줘도 돼"
    },
    {
      "startMs": 87550,
      "endMs": 90290,
      "translation": "랩 상위 다섯 명, 날 다시 돌려 들어야 할걸"
    },
    {
      "startMs": 90290,
      "endMs": 92890,
      "translation": "난 높은 데 있어, 내 뒤에 줄 서도 돼"
    },
    {
      "startMs": 92890,
      "endMs": 96230,
      "translation": "그런데 내 머리가 너무 커서 뒤에 앉을 순 없을 거야 (뒤에 앉을 순)"
    },
    {
      "startMs": 96230,
      "endMs": 99100,
      "translation": "돈의 삶, 조명은 계속 빛나고"
    },
    {
      "startMs": 99100,
      "endMs": 101440,
      "translation": "신상을 걸치고 클럽에 들어서"
    },
    {
      "startMs": 101440,
      "endMs": 104820,
      "translation": "팔엔 뭔가 끝내주는 걸 두르고, 어어어"
    },
    {
      "startMs": 104820,
      "endMs": 108300,
      "translation": "그리고 여기 또 한 방, 배리 본즈"
    },
    {
      "startMs": 108300,
      "endMs": 110770,
      "translation": "그래, 그래, 넘어갔어, 자기"
    },
    {
      "startMs": 110770,
      "endMs": 113610,
      "translation": "뭐? 뭐? 넘어갔어, 자기"
    },
    {
      "startMs": 113610,
      "endMs": 116740,
      "translation": "헤이, 웨스트 씨, 우리 완전히 넘어갔어, 자기"
    },
    {
      "startMs": 116740,
      "endMs": 119770,
      "translation": "그리고 나, 난 미스터 위지 베이비"
    },
    {
      "startMs": 119770,
      "endMs": 122090,
      "translation": "그래, 난 환하지, 수상하지 않아"
    },
    {
      "startMs": 122090,
      "endMs": 125200,
      "translation": "내 이빨과 보석은 셰이디처럼 하얘"
    },
    {
      "startMs": 125200,
      "endMs": 127810,
      "translation": "이빨의 보석이 냉장고처럼 차가워"
    },
    {
      "startMs": 127810,
      "endMs": 130720,
      "translation": "메건이랑 자는 것처럼 끝내주게 잘나가 (하)"
    },
    {
      "startMs": 130720,
      "endMs": 133660,
      "translation": "난 프랭클린, 링컨, 레이건 지폐만 생각해"
    },
    {
      "startMs": 133660,
      "endMs": 136350,
      "translation": "저들이 찍어 낼 때마다 난 그걸 '헤이브'할 거야"
    },
    {
      "startMs": 136350,
      "endMs": 139410,
      "translation": "아차, '해브'라고 하려던 거야, 나 참 미쳤지"
    },
    {
      "startMs": 139410,
      "endMs": 142430,
      "translation": "하지만 미친 척하면 데이지 밑에서 잠들게 될걸"
    },
    {
      "startMs": 142430,
      "endMs": 145080,
      "translation": "난 정말 '헤이빅'이야, 아차, '해벅'이라고"
    },
    {
      "startMs": 145080,
      "endMs": 148090,
      "translation": "내 술은 아직도 부활절 토끼보다 분홍색이야"
    },
    {
      "startMs": 148090,
      "endMs": 151250,
      "translation": "그리고 난 여전히 키샤네 가족처럼 차가워"
    },
    {
      "startMs": 151250,
      "endMs": 154350,
      "translation": "허리엔 총, 싸움은 다져서 패티로 만들어 (빵)"
    },
    {
      "startMs": 154350,
      "endMs": 156950,
      "translation": "그리고 먹어 치웠지, 난 열성적이니까"
    },
    {
      "startMs": 156950,
      "endMs": 159740,
      "translation": "난 허세도 안 부리고 뒷걸음질도 안 쳐"
    },
    {
      "startMs": 159740,
      "endMs": 162530,
      "translation": "연습도 안 하고 부족한 것도 없어"
    },
    {
      "startMs": 162530,
      "endMs": 166810,
      "translation": "그리고 넌 묻힐 수 있어, 내 배트나 맛봐 (하)"
    },
    {
      "startMs": 166810,
      "endMs": 169840,
      "translation": "넘어갔어, 자기"
    },
    {
      "startMs": 169840,
      "endMs": 172550,
      "translation": "넘어갔어, 자기"
    },
    {
      "startMs": 172550,
      "endMs": 174510,
      "translation": "넘어갔어, 자기"
    },
    {
      "startMs": 174510,
      "endMs": 177130,
      "translation": "스웩은 100에서 계속 올라가, 자기, 그래"
    },
    {
      "startMs": 177130,
      "endMs": 180110,
      "translation": "돈의 삶, 조명은 계속 빛나고"
    },
    {
      "startMs": 180110,
      "endMs": 182360,
      "translation": "신상을 걸치고 클럽에 들어서"
    },
    {
      "startMs": 182360,
      "endMs": 185680,
      "translation": "팔엔 뭔가 끝내주는 걸 두르고, 어어어"
    },
    {
      "startMs": 185680,
      "endMs": 204000,
      "translation": "그리고 여기 또 한 방, 배리 본즈"
    }
  ]
}
