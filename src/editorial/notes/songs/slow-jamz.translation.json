  "segments": [
    {
      "startMs": 21530,
      "endMs": 26810,
      "translation": "그럴 거야? 그럴 거라고 말해 줘"
    },
    {
      "startMs": 26810,
      "endMs": 27840,
      "translation": "우, 우, 우, 우, 우"
    },
    {
      "startMs": 27840,
      "endMs": 30980,
      "translation": "그녀는 마빈 게이를, 루서 밴드로스를 원한대"
    },
    {
      "startMs": 30980,
      "endMs": 34700,
      "translation": "애니타 베이커 조금이면 이 파티가 확실히 제대로 시작될 거야"
    },
    {
      "startMs": 34700,
      "endMs": 39190,
      "translation": "(그럴 거야, 그럴 거야, 그럴 거야"
    },
    {
      "startMs": 39190,
      "endMs": 41080,
      "translation": "그럴 거야, 그럴 거야, 자, 자, 자, 자)"
    },
    {
      "startMs": 41080,
      "endMs": 44650,
      "translation": "그녀는 레디 포 더 월드를, 뉴 에디션을 원한대"
    },
    {
      "startMs": 44650,
      "endMs": 47940,
      "translation": "미니 리퍼튼 조금이면 이 파티가 확실히 제대로 시작될 거야"
    },
    {
      "startMs": 47940,
      "endMs": 50090,
      "translation": "(그럴 거야, 그럴 거야, 그럴 거야"
    },
    {
      "startMs": 50090,
      "endMs": 52140,
      "translation": "그럴 거야, 그럴 거야, 자, 자, 자, 자)"
    },
    {
      "startMs": 52140,
      "endMs": 52910,
      "translation": "확실히 그럴 거야"
    },
    {
      "startMs": 52910,
      "endMs": 53790,
      "translation": "내가 뭐라고 했는지 알아?"
    },
    {
      "startMs": 53790,
      "endMs": 56350,
      "translation": "네 새 차를 몰고 오라고 했어"
    },
    {
      "startMs": 56350,
      "endMs": 57920,
      "translation": "편한 친구들도 데려오고"
    },
    {
      "startMs": 57920,
      "endMs": 61220,
      "translation": "난 휘핑크림을 가져갈 테니 넌 옷을 벗어"
    },
    {
      "startMs": 61220,
      "endMs": 64340,
      "translation": "넌 내 새 여자니까 우리 몸을 맞대고 흔들자"
    },
    {
      "startMs": 64340,
      "endMs": 67980,
      "translation": "그녀는 날 붙잡고 날 비기라고 불러, 샤인이 집에 있을 때처럼"
    },
    {
      "startMs": 67980,
      "endMs": 70940,
      "translation": "진짜 끝내주게 예쁜데 왜 맨날 거짓말이야?"
    },
    {
      "startMs": 70940,
      "endMs": 74180,
      "translation": "라인스톤인 걸 알면서 다이아몬드라고 하잖아"
    },
    {
      "startMs": 74180,
      "endMs": 77340,
      "translation": "피부 밝은 친구는 마이클 잭슨을 닮았고"
    },
    {
      "startMs": 77340,
      "endMs": 80540,
      "translation": "피부 어두운 친구도 마이클 잭슨을 닮았어"
    },
    {
      "startMs": 80540,
      "endMs": 83990,
      "translation": "레디 포 더 월드를 틀었더니 그녀는 바로 준비가 됐어"
    },
    {
      "startMs": 83990,
      "endMs": 87290,
      "translation": "내 친구가 넌 화끈하지 않다던데, 그 말이 틀렸다는 걸 증명해 봐"
    },
    {
      "startMs": 87290,
      "endMs": 90350,
      "translation": "이 밴드로스를 틀면 넌 바지를 벗을 거야"
    },
    {
      "startMs": 90350,
      "endMs": 93840,
      "translation": "이 글래디스 나이트를 틀면 우린 제대로 즐길 거야"
    },
    {
      "startMs": 93840,
