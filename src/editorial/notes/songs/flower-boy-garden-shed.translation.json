    },
    {
      "startMs": 165280,
      "endMs": 167110,
      "translation": "정원 창고, 정원 창고, 정원 창고, 정원 창고"
    },
    {
      "startMs": 167110,
      "endMs": 169250,
      "translation": "정원을 위한 곳, 내가 숨어 있던 곳이 거기야"
    },
    {
      "startMs": 169250,
      "endMs": 170660,
      "translation": "내가 빠져 있던 사랑이 바로 그거였어"
    },
    {
      "startMs": 170660,
      "endMs": 172020,
      "translation": "이제 아닌 척할 이유도 없어"
    },
    {
