  "segments": [
    {
      "startMs": 2350,
      "endMs": 14330,
      "translation": "버드 라이트 한 캔 마시고 좀 쉴게, 아, 아"
    },
    {
      "startMs": 14330,
      "endMs": 17670,
      "translation": "인생 최고의 황홀에서 이제 막 내려왔어"
    },
    {
      "startMs": 17670,
      "endMs": 21370,
      "translation": "방금, 방금 인생 최고의 황홀에서 내려왔어"
    },
    {
      "startMs": 21370,
      "endMs": 25150,
      "translation": "우리가 샴페인 터뜨리는 거 봐, 밤새도록 할 수 있어"
    },
    {
      "startMs": 25150,
      "endMs": 29460,
      "translation": "다 잘못된다 해도 우린 괜찮게 만들 거야"
    },
    {
      "startMs": 29460,
      "endMs": 33470,
      "translation": "일도 안 해 놓고 상을 바라면 어떡해?"
    },
    {
      "startMs": 33470,
      "endMs": 37350,
      "translation": "방금 부동산 중개인이랑 통화를 끝냈어"
    },
    {
      "startMs": 37350,
      "endMs": 41260,
      "translation": "하도 잘 먹어서 배가 터질 지경이야"
    },
    {
      "startMs": 41260,
      "endMs": 45120,
      "translation": "뮬산을 뽑을지도 몰라, 벤틀리가 날 부르거든"
    },
    {
      "startMs": 45120,
      "endMs": 48790,
      "translation": "그 여자한테 금방 멋을 입혀 주고"
    },
    {
      "startMs": 48790,
      "endMs": 52630,
      "translation": "손목엔 매끈하게 다이아를 채워"
    },
    {
      "startMs": 52630,
      "endMs": 56450,
      "translation": "내 지갑이 얼마나 두툼한지 너도 알잖아"
    },
    {
      "startMs": 56450,
      "endMs": 60040,
      "translation": "그리고 궁금해, 너 뭘 마시고 있는지"
    },
    {
      "startMs": 60040,
      "endMs": 63380,
      "translation": "인생 최고의 황홀에서 이제 막 내려왔어"
    },
    {
      "startMs": 63380,
      "endMs": 67230,
      "translation": "방금, 방금 인생 최고의 황홀에서 내려왔어"
    },
    {
      "startMs": 67230,
      "endMs": 70920,
      "translation": "우리가 샴페인 터뜨리는 거 봐, 밤새도록 할 수 있어"
    },
    {
      "startMs": 70920,
      "endMs": 75040,
      "translation": "다 잘못된다 해도 우린 괜찮게 만들 거야"
    },
    {
      "startMs": 75040,
      "endMs": 78600,
      "translation": "우린 너희랑 진짜 안 엮여, 그렇지?"
    },
    {
      "startMs": 78600,
      "endMs": 82380,
      "translation": "너희 앞에서 굳이 자랑할 필요도 없잖아, 그렇지?"
    },
    {
      "startMs": 82380,
      "endMs": 86270,
      "translation": "그 돈은 다시 이 몸에게 가져와"
    },
    {
      "startMs": 86270,
      "endMs": 90620,
      "translation": "내가 보석을 잔뜩 두르고 있을 때, 그래"
    },
    {
      "startMs": 90620,
      "endMs": 94430,
      "translation": "헤이, 외제차에서 막 내렸어, 멋져 보이지, 그래"
    },
    {
      "startMs": 94430,
      "endMs": 98220,
      "translation": "그래, 내 팔의 시계는 1조쯤 돼 보여"
    },
    {
      "startMs": 98220,
      "endMs": 102210,
      "translation": "화이트 아이버슨 알지, 아니, 보석은 감춰 둬"
    },
    {
      "startMs": 102210,
      "endMs": 105890,
      "translation": "머리가 텅 빌 만큼 다 써 버렸어, 버바 척이 된 기분이야"
    },
    {
      "startMs": 105890,
      "endMs": 108310,
      "translation": "자기야, 난 멍해, 약 기운이 돌아"
    },
    {
      "startMs": 108310,
      "endMs": 110130,
      "translation": "아무도 몰라"
    },
    {
      "startMs": 110130,
      "endMs": 112270,
      "translation": "너랑 나뿐이야, 가서 친구들 불러"
    },
    {
      "startMs": 112270,
      "endMs": 114050,
      "translation": "등유를 잔뜩 구해 오자"
    },
    {
      "startMs": 114050,
      "endMs": 116020,
      "translation": "넌 몸을 붙이고 흔들 거야"
    },
    {
      "startMs": 116020,
      "endMs": 117820,
      "translation": "그래, 두 배로 빠르게 움직이는 거 보여 줘"
    },
    {
      "startMs": 117820,
      "endMs": 120980,
      "translation": "그 여자들한텐 말 안 해도 돼, 다 아니까, 그래"
    },
