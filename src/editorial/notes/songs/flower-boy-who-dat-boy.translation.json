    {
      "startMs": 146180,
      "endMs": 148070,
      "translation": "너희는 왜 그렇게 느끼는 거야?"
    },
    {
      "startMs": 148070,
      "endMs": 150120,
      "translation": "내 목에 얼음이 이렇게 차가워서 화났어?"
    },
    {
      "startMs": 150120,
      "endMs": 152030,
      "translation": "내가 이렇게 큰 물량을 굴려서 화났어?"
    },
    {
      "startMs": 152030,
      "endMs": 154020,
      "translation": "왜 공기 중에 나쁜 기운을-?"
    },
    {
      "startMs": 154020,
      "endMs": 156410,
      "translation": "랩은 집어치워, 난 행성 하나를 사려는 중이야,"
    },
    {
      "startMs": 156410,
      "endMs": 158490,
      "translation": "내 다른 빌어먹을 사업들로."
    },
    {
      "startMs": 158490,
      "endMs": 160220,
      "translation": "요즘 이 놈들은"
    },
    {
      "startMs": 160220,
      "endMs": 162640,
      "translation": "너랑 어울리는 척하면서 계집애처럼 굴어 (그래)."
    },
    {
      "startMs": 162640,
      "endMs": 164470,
      "translation": "이빨이 반짝여, 세상에, 크리스마스네."
    },
    {
      "startMs": 164470,
      "endMs": 167450,
      "translation": "그는 막 쏟아내고, 그녀는 근사하고, 여자들은 비싸 (오, 안 돼, 야)."
    },
    {
      "startMs": 167450,
