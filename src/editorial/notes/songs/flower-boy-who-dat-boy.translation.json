  "segments": [
    {
      "startMs": 53590,
      "endMs": 56180,
      "translation": "야, 저 녀석 누구야? 대체 누구냐고?"
    },
    {
      "startMs": 56180,
      "endMs": 58220,
      "translation": "맹세컨대 그놈이 바로 그놈이야."
    },
    {
      "startMs": 58220,
      "endMs": 60120,
      "translation": "한눈에 튀는 놈이라 의자도 필요 없지."
    },
    {
      "startMs": 60120,
      "endMs": 61380,
      "translation": "근데 그놈 대체 어디 있는데?"
    },
    {
      "startMs": 61380,
      "endMs": 62480,
      "translation": "야, 난 바로 여기 있는데."
    },
    {
      "startMs": 62480,
      "endMs": 64410,
      "translation": "나는 쇼핑몰에서 쇼핑 안 해, 너희 전부 그냥"
    },
    {
      "startMs": 64410,
      "endMs": 65400,
      "translation": "멍청한 새끼들이야."
    },
    {
      "startMs": 65400,
      "endMs": 66660,
      "translation": "나는 빌어먹을 아티스트라고."
    },
    {
      "startMs": 66660,
      "endMs": 68740,
      "translation": "마커 몇 개만 주면 네 옷장을 그려 줄 수 있어."
    },
    {
      "startMs": 68740,
      "endMs": 69660,
      "translation": "그리고 알다시피 이건 GOLF야."
    },
    {
      "startMs": 69660,
      "endMs": 70920,
      "translation": "그러니 얼른 가서 입금이나 해."
    },
    {
      "startMs": 70920,
      "endMs": 72950,
      "translation": "관 속에서 옷을 입고 나온 것처럼 죽도록 멋진 놈이지."
    },
    {
      "startMs": 72950,
      "endMs": 74750,
      "translation": "컨버스에 멜빵바지, 줄무늬 셔츠."
    },
    {
      "startMs": 74750,
      "endMs": 76880,
      "translation": "이 녀석은 고장 난 수도꼭지처럼 스웩이 뚝뚝 떨어져."
    },
    {
      "startMs": 76880,
      "endMs": 78870,
      "translation": "줄줄 흘러, 야, 내가 이 판을 굴리고 있어."
    },
    {
      "startMs": 78870,
      "endMs": 81060,
      "translation": "그 체리는 폭탄이야, 보스턴을 뛴 놈처럼."
    },
    {
      "startMs": 81060,
      "endMs": 82970,
      "translation": "경찰이 에워쌀 때까지 멈추지 않아."
    },
    {
      "startMs": 82970,
      "endMs": 84860,
      "translation": "한 놈은 신나게 놀고 한 놈은 끝내줘."
    },
    {
      "startMs": 84860,
      "endMs": 86920,
      "translation": "빌어먹을 얼굴이 날아간 채로 발견됐지, 사람들이 그렇게 찾아냈어."
    },
    {
      "startMs": 86920,
      "endMs": 87710,
      "translation": "영 T야."
    },
    {
      "startMs": 87710,
      "endMs": 89350,
      "translation": "저 녀석 누구야? 누구냐고?"
    },
    {
      "startMs": 89350,
      "endMs": 91540,
      "translation": "저 녀석 누구야? 누구냐고?"
    },
    {
      "startMs": 91540,
      "endMs": 93680,
      "translation": "야, 저 녀석 누구야? 누구냐고?"
    },
    {
      "startMs": 93680,
      "endMs": 95950,
      "translation": "저놈들 누구야? 야, 누구냐고, 야?"
    },
    {
      "startMs": 95950,
      "endMs": 98090,
      "translation": "너희는 왜 그렇게 느끼는 거야?"
    },
    {
      "startMs": 98090,
      "endMs": 100020,
      "translation": "내 목에 얼음이 이렇게 차가워서 화났어?"
    },
    {
      "startMs": 100020,
      "endMs": 101980,
      "translation": "내가 차를 이렇게 몰아서 화났어?"
    },
    {
      "startMs": 101980,
      "endMs": 103930,
      "translation": "왜 공기 중에 그렇게 나쁜 기운을 풀어놓는 거야?"
    },
    {
      "startMs": 103930,
      "endMs": 105180,
      "translation": "야, 저놈들 누구야?"
    },
    {
      "startMs": 105180,
      "endMs": 106350,
      "translation": "누구냐고? 야, 누구냐고?"
    },
    {
      "startMs": 106350,
      "endMs": 108330,
      "translation": "이 판에 이만큼 신나게 들어선 놈이 또 누구야?"
    },
    {
      "startMs": 108330,
      "endMs": 110370,
      "translation": "네 여자가 내 물건(bick)이 이만큼 크다고 말한 놈이 또 누구야?"
    },
    {
      "startMs": 110370,
      "endMs": 112470,
      "translation": "손목을 이만큼 휙 돌리는 놈이 또 누구야?"
    },
    {
      "startMs": 112470,
      "endMs": 114650,
      "translation": "야, 내 바지 사이즈를 맞혀 봐, 내 춤을 춰 봐."
    },
    {
      "startMs": 114650,
      "endMs": 116660,
      "translation": "한 바퀴 돌아 봐, 내 엉덩이에 입 맞춰도 좋아."
    },
    {
      "startMs": 116660,
      "endMs": 118860,
      "translation": "라프를 이만큼 걸친 놈은 본 적이 없지."
    },
    {
      "startMs": 118860,
      "endMs": 120950,
      "translation": "수업을 빼먹을 때도 여전히 계산 중이야."
    },
    {
      "startMs": 120950,
      "endMs": 123060,
      "translation": "2006년 여름이었나, 넘버(N)인(일본 패션 브랜드)을 입었을 때."
    },
    {
      "startMs": 123060,
      "endMs": 125120,
      "translation": "야, 아니, 빈스 이전의 다른 시절이었지."
    },
    {
      "startMs": 125120,
      "endMs": 126990,
      "translation": "레터맨 재킷에 구찌 금장 팁도 있었고."
    },
    {
      "startMs": 126990,
      "endMs": 129330,
      "translation": "야, 그때 내가 제일 좋아한 숫자는 달러 기호였어."
    },
    {
      "startMs": 129330,
      "endMs": 131250,
      "translation": "내가 땡땡이치기 전까지는 싱싱한 신입생이었고,"
    },
    {
      "startMs": 131250,
      "endMs": 133350,
      "translation": "지금은 어르신이니까 내 통행증 잊지 마."
    },
    {
      "startMs": 133350,
      "endMs": 135380,
      "translation": "그놈이었어, 너도 거기서 알았잖아."
    },
    {
      "startMs": 135380,
      "endMs": 137530,
      "translation": "그걸 사라지게 만들어, 걔는 저걸 어떻게 하는 거지?"
    },
    {
      "startMs": 137530,
      "endMs": 139620,
      "translation": "저 녀석 누구야? 누구냐고?"
    },
    {
      "startMs": 139620,
