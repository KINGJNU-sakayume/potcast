{
  "schemaVersion": 2,
  "timing": {
    "lrclibId": 136611,
    "durationMs": 96000
  },
  "segments": [
    {
      "startMs": 13620,
      "endMs": 17460,
      "translation": "지금 돌아보면, 그게 어떤 거여야 하는지 몰랐어"
    },
    {
      "startMs": 17460,
      "endMs": 19510,
      "translation": "그리고, 그건 애들 키우는 거랑 같아, 이 사람아"
    },
    {
      "startMs": 19510,
      "endMs": 22430,
      "translation": "자기가 길러진 적이 없으면 기르는 법을 모르는 거야, 알잖아?"
    },
    {
      "startMs": 22430,
      "endMs": 24500,
      "translation": "난 그저 애들한테 할 수 있는 최선을 다했어, 왜냐면"
    },
    {
      "startMs": 24500,
      "endMs": 28180,
      "translation": "내가 그 애들을 사랑한다는 건 걔들도 지독하게 잘 알거든"
    },
    {
      "startMs": 28180,
      "endMs": 30490,
      "translation": "하지만 난 할 수 있는 최선을 다하지 않았어"
    },
    {
      "startMs": 30490,
      "endMs": 33590,
      "translation": "내가 대체 뭘 하는지도 몰랐어"
    },
    {
      "startMs": 33590,
      "endMs": 37230,
      "translation": "몰랐어"
    },
    {
      "startMs": 37230,
      "endMs": 42190,
      "translation": "어머니가 구속복에 묶이는 걸 지켜본 건 절대 잊지 못할 거야"
    },
    {
      "startMs": 42190,
      "endMs": 46190,
      "translation": "그리고 고작 일곱 살 때 집에서 끌려 나가는 걸"
    },
    {
      "startMs": 46190,
      "endMs": 50360,
      "translation": "어머니는 조발성 치매 진단을 받고 정신병원에 들어갔어"
    },
    {
      "startMs": 50360,
      "endMs": 55330,
      "translation": "아버지 혼자 나랑 동생 로이드를 맡게 됐지"
    },
    {
      "startMs": 55330,
      "endMs": 61900,
      "translation": "나중엔 못된 계모가 생겼는데, 그 덕에 내겐 어머니가 필요 없다는 생각이 더 굳어졌어"
    },
    {
      "startMs": 61900,
      "endMs": 65030,
      "translation": "어머니 없이 자란 건 오래도록 흔적을 남겼어"
    },
    {
      "startMs": 65030,
      "endMs": 69680,
      "translation": "인생 훨씬 뒤에야 온전히 이해하게 됐지"
    },
    {
      "startMs": 69680,
      "endMs": 72510,
      "translation": "그게 가족과의 관계로 번졌고"
    },
    {
      "startMs": 72510,
      "endMs": 76680,
      "translation": "연인으로 엮였던 사람들과의 관계로도 번졌어"
    },
    {
      "startMs": 76680,
      "endMs": 80050,
      "translation": "여자와 너무 가까워질 때마다 난 그 사람을 끊어 냈어"
    },
    {
      "startMs": 80050,
      "endMs": 84730,
      "translation": "그중 일부는 앙갚음이었고, 일부는 두려움 때문이었지"
    },
    {
      "startMs": 84730,
      "endMs": 89420,
      "translation": "하지만 완전히 무의식적인 것이기도 했어"
    },
    {
      "startMs": 89420,
      "endMs": 96000,
      "translation": "돌아보는 건 지독한 일이야, 안 그래?"
    }
  ]
}
