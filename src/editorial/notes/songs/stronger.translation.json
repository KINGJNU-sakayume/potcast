  "segments": [
    {
      "startMs": 60,
      "endMs": 2220,
      "translation": "일해, 만들어, 해내, 그게 우릴"
    },
    {
      "startMs": 2220,
      "endMs": 4920,
      "translation": "더 세게, 더 좋게, 더 빠르게, 더 강하게"
    },
    {
      "startMs": 4920,
      "endMs": 7330,
      "translation": "이, 이제, 날 죽이지 못하는 건"
    },
    {
      "startMs": 7330,
      "endMs": 9820,
      "translation": "날 더 강하게 만들 뿐이야"
    },
    {
      "startMs": 9820,
      "endMs": 11970,
      "translation": "서둘러 줘"
    },
    {
      "startMs": 11970,
      "endMs": 14120,
      "translation": "더는 못 기다리겠으니까"
    },
    {
      "startMs": 14120,
      "endMs": 16530,
      "translation": "이번엔 제대로 해야 한다는 거 알아"
    },
    {
      "startMs": 16530,
      "endMs": 19040,
      "translation": "더 틀릴 수도 없을 만큼 틀렸으니까"
    },
    {
      "startMs": 19040,
      "endMs": 21180,
      "translation": "밤새 기다렸어"
    },
    {
      "startMs": 21180,
      "endMs": 23150,
      "translation": "그만큼 오래 너한테 빠져 있었지"
    },
    {
      "startMs": 23150,
      "endMs": 25390,
      "translation": "더 세게 일하고, 더 좋게 만들어"
    },
    {
      "startMs": 25390,
      "endMs": 26240,
      "translation": "더 빠르게 해내면 우린 더 강해져"
    },
    {
      "startMs": 26240,
      "endMs": 27890,
      "translation": "(지금 당장 네가 필요해!)"
    },
    {
      "startMs": 27890,
      "endMs": 28670,
      "translation": "그 어느 때보다"
    },
    {
      "startMs": 28670,
      "endMs": 30880,
      "translation": "한 시간 또 한 시간 일해"
    },
    {
      "startMs": 30880,
      "endMs": 31980,
      "translation": "(지금 당장 네가 필요해!)"
    },
    {
      "startMs": 31980,
      "endMs": 33310,
      "translation": "오늘 밤 같이 사라지자"
    },
    {
      "startMs": 33310,
      "endMs": 35730,
      "translation": "오늘 밤 넌 내 흑인 케이트 모스가 될 수 있어"
    },
    {
      "startMs": 35730,
      "endMs": 37770,
      "translation": "넌 비서 놀이를 해, 오늘 밤 사장은 나야"
    },
    {
      "startMs": 37770,
      "endMs": 40360,
      "translation": "그리고 남들이 뭐라든 상관 안 하지, 그렇지?"
    },
    {
      "startMs": 40360,
      "endMs": 42860,
      "translation": "끝내줘, 크리스티앙 디오르의 크리스티앙처럼"
    },
    {
      "startMs": 42860,
      "endMs": 45210,
      "translation": "이런, 이런 건 더 이상 안 만들어"
    },
    {
      "startMs": 45210,
      "endMs": 47140,
      "translation": "잘 모르겠으니까 물어볼게"
    },
    {
      "startMs": 47140,
      "endMs": 49720,
      "translation": "요즘 누가 진짜를 만들긴 해?"
    },
    {
      "startMs": 49720,
      "endMs": 51970,
      "translation": "위대함 앞에 고개를 숙여"
    },
    {
      "startMs": 51970,
      "endMs": 54210,
      "translation": "지금 너희가 우릴 버렸으니까"
    },
    {
      "startMs": 54210,
      "endMs": 56250,
      "translation": "내가 늦게 와 준 것도 영광으로 알아"
    },
    {
      "startMs": 56250,
      "endMs": 58480,
      "translation": "이런 가짜 판에 나타나 주기라도 한 걸"
    },
    {
      "startMs": 58480,
      "endMs": 60830,
      "translation": "그러니 마음껏 미쳐, 날뛰어 봐"
    },
    {
      "startMs": 60830,
      "endMs": 63190,
      "translation": "특히 내 파스텔 옷, 내 베이프 차림에"
    },
    {
      "startMs": 63190,
      "endMs": 65150,
      "translation": "누가 이걸 만들었는지 모르는 척해 봐"
    },
    {
      "startMs": 65150,
      "endMs": 67360,
