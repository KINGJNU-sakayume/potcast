  "schemaVersion": 2,
  "timing": { "lrclibId": 11732112, "durationMs": 275000 },
  "segments": [
    { "startMs": 16220, "endMs": 31720, "translation": "내가 태어난 날의 하늘은 높고 멀리, 맑게 개어 있었다." },
    { "startMs": 31720, "endMs": 45300, "translation": "\"다녀오렴\" 하며 등을 쓸어 주는 목소리를 들었다, 그날." },
    { "startMs": 45300, "endMs": 77450, "translation": "계절 속에서 스치며 때로는 사람을 아프게 하면서, 빛에 닿아 그림자를 늘이고, 하늘은 더욱 멀다." },
    { "startMs": 77450, "endMs": 83510, "translation": "바람을 맞으며 달려 나가 잔해를 넘어간다." },
    { "startMs": 83510, "endMs": 89650, "translation": "이 길의 끝에서 누군가가 기다리고 있다." },
    { "startMs": 89650, "endMs": 98890, "translation": "빛이 비치는 꿈을 꾼다, 어느 날에도." },
    { "startMs": 98890, "endMs": 105010, "translation": "문을 지금 활짝 연다, 비밀을 밝혀내듯이." },
    { "startMs": 105010, "endMs": 108090, "translation": "성에 차지 않아 먼 곳에 마음을 달린다." },
    { "startMs": 108090, "endMs": 123800, "translation": "지구본을 돌리듯이." },
    { "startMs": 123800, "endMs": 139310, "translation": "내가 사랑한 그 사람은 아무도 모르는 곳으로 갔다." },
    { "startMs": 139310, "endMs": 155850, "translation": "그날 그대로의 다정한 얼굴로, 지금도 어딘가 멀리." },
    { "startMs": 155850, "endMs": 161960, "translation": "비를 맞으며 노래하기 시작한다, 남의 눈도 아랑곳하지 않고." },
    { "startMs": 161960, "endMs": 168090, "translation": "이 길이 이어지는 것은 이어지라고 바랐기 때문이다." },
    { "startMs": 168090, "endMs": 177170, "translation": "다시 만날 꿈을 꾼다, 언제까지나." },
    { "startMs": 177170, "endMs": 186630, "translation": "한 조각 움켜쥔 비밀을 잊지 않도록, 끝까지 마음을 달린다." },
    { "startMs": 186630, "endMs": 196170, "translation": "지구본을 돌리듯이." },
    { "startMs": 196170, "endMs": 203820, "translation": "작은 자신의 올바른 소원에서 시작되는 것." },
    { "startMs": 203820, "endMs": 215120, "translation": "하나의 쓸쓸함을 안고, 나는 길을 꺾어 든다." },
    { "startMs": 215120, "endMs": 221190, "translation": "바람을 맞으며 달려 나가 잔해를 넘어간다." },
    { "startMs": 221190, "endMs": 227370, "translation": "이 길의 끝에서 누군가가 기다리고 있다." },
    { "startMs": 227370, "endMs": 236480, "translation": "빛이 비치는 꿈을 꾼다, 어느 날에도." },
    { "startMs": 236480, "endMs": 242750, "translation": "문을 지금 활짝 연다, 비밀을 밝혀내듯이." },
    { "startMs": 242750, "endMs": 251980, "translation": "손이 맞닿는 기쁨도, 손을 놓은 슬픔도, 성에 차지 않아 그려 나간다." },
    { "startMs": 251980, "endMs": 275000, "translation": "지구본을 돌리듯이." }
  ]
}
