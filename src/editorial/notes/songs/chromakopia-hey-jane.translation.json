{
  "schemaVersion": 2,
  "timing": {
    "lrclibId": 13876392,
    "durationMs": 241000
  },
  "segments": [
    {
      "startMs": 170,
      "endMs": 3990,
      "translation": "언제나, 언제나, 언제나 콘돔을 써."
    },
    {
      "startMs": 3990,
      "endMs": 4930,
      "translation": "믿지 마-"
    },
    {
      "startMs": 4930,
      "endMs": 6840,
      "translation": "제인, 소식을 들었는데 난 어떻게 해야 할지 몰랐어."
    },
    {
      "startMs": 6840,
      "endMs": 9080,
      "translation": "당황하진 않았어, 오히려 널 달래고 있었지."
    },
    {
      "startMs": 9080,
      "endMs": 12270,
      "translation": "아직 충격이긴 한데, 와, 반응이 늦었네, 이게 정말이야?"
    },
    {
      "startMs": 12270,
      "endMs": 14820,
      "translation": "어차피 나한테 벌어질 일이었다면, 너라서 다행이야."
    },
    {
      "startMs": 14820,
      "endMs": 16980,
      "translation": "제인, 넌 머리가 길고 다리도 길어."
    },
    {
      "startMs": 16980,
      "endMs": 19620,
      "translation": "그리고 우리 둘 다 아빠가 떠났다는 걸 아니까 서로 이해할 수 있지."
    },
    {
      "startMs": 19620,
      "endMs": 22170,
      "translation": "너한테는 좋은 점이 몇 가지 있고, 그건 물려줄 만해."
    },
    {
      "startMs": 22170,
      "endMs": 24910,
      "translation": "넌 멍청하지 않고, 얼굴도 괜찮고, 의지가 강해, 봐."
    },
    {
      "startMs": 24910,
      "endMs": 27480,
      "translation": "제인, 우리 엄마가 엄청 기뻐할 거란 건 알아."
    },
    {
      "startMs": 27480,
      "endMs": 29540,
      "translation": "너희 엄마도 마찬가지로 기뻐할 거고."
    },
    {
      "startMs": 29540,
      "endMs": 31970,
      "translation": "근데 사람들은 떠들어 대니까, 말할 사람이 아무도 없는 척하자."
    },
    {
      "startMs": 31970,
      "endMs": 35170,
      "translation": "우리 전 애인들이 우리가 지옥에 가길 바란다는 것도 알아, 근데 이건 걔네랑 상관없어, 아니."
    },
    {
      "startMs": 35170,
      "endMs": 38110,
      "translation": "이건 친척들 일도 아니야, 시간이 빠듯한 우리 둘의 결정이야."
    },
    {
      "startMs": 38110,
      "endMs": 41790,
      "translation": "뛰쳐나가고 싶지만, 네가 이 방에 남고 싶다면 난 도망치지 않을 거야."
    },
    {
      "startMs": 41790,
      "endMs": 45440,
      "translation": "시간이 진입로를 막고 있어서 차를 못 빼, 아니, 안 뺐다고."
    },
    {
      "startMs": 45440,
      "endMs": 48030,
      "translation": "와, 내 자신에게 실망했어, 이건 나답지 않아."
    },
    {
      "startMs": 48030,
      "endMs": 50880,
      "translation": "내가 어떻게 이렇게 무모할 수 있지? 이건 내 생활 방식이 아닌데."
    },
    {
      "startMs": 50880,
      "endMs": 53430,
      "translation": "지금까지 살면서 이런 겁을 먹어 본 적이 없어."
    },
    {
      "startMs": 53430,
      "endMs": 55330,
      "translation": "빌어먹을 애를 키울 상태가 아니야."
    },
    {
      "startMs": 55330,
      "endMs": 57650,
      "translation": "제인, 난 겁나, 얼어붙을 만큼 겁나."
    },
    {
      "startMs": 57650,
      "endMs": 60230,
      "translation": "내 자유를 내주기도, 그걸 얌전하게 길들이기도 싫어."
    },
    {
      "startMs": 60230,
      "endMs": 62990,
      "translation": "이건 내 잘못이고, 이 결과는 당연한 거야."
    },
    {
      "startMs": 62990,
      "endMs": 65400,
      "translation": "내가 좆같이 망쳤고, 스트레스로 터질 것 같고, 속은 죽어 있어."
    },
    {
      "startMs": 65400,
      "endMs": 67990,
      "translation": "그래도 제인, 내가 뭔데 와서 징징대고 불평해?"
    },
    {
      "startMs": 67990,
      "endMs": 70660,
      "translation": "몸과 마음의 변화는 전부 네가 감당해야 하는데."
    },
    {
      "startMs": 70660,
      "endMs": 73070,
      "translation": "가장 무거운 감정들도, 몸의 고통도."
    },
    {
      "startMs": 73070,
      "endMs": 76730,
      "translation": "겨우 애한테 남자의 성을 붙여 주려고? 좆까."
    },
    {
      "startMs": 76730,
      "endMs": 79140,
      "translation": "우린 서로의 이력도 아직 모르고, 버스는 그 신호등에서 멈췄어."
    },
    {
      "startMs": 79140,
      "endMs": 80850,
      "translation": "우린 아직 사랑까지는 못 갔어."
    },
    {
      "startMs": 80850,
      "endMs": 82920,
      "translation": "영원으로 가는 지름길을 탔어, 속상해 (씨발)."
    },
    {
      "startMs": 82920,
      "endMs": 85580,
      "translation": "왜냐면 우린 뒤쪽에 있었고, 얽매인 건 없었는데 혀는 젖어 있었으니까."
    },
    {
      "startMs": 85580,
      "endMs": 88080,
      "translation": "보트 여행도 안 가 봤고, 싸워 본 적도 없어."
    },
    {
      "startMs": 88080,
      "endMs": 90510,
      "translation": "우린 아직 서로를 알아 가는 중이라 난 널 다 모르고,"
    },
    {
      "startMs": 90510,
      "endMs": 93050,
      "translation": "너도 날 다 모르는데, 내가 그걸 안고 어떻게 살아."
    },
    {
      "startMs": 93050,
      "endMs": 95800,
      "translation": "그건 같이 애를 가질 좋은 토대가 아니야."
    },
    {
      "startMs": 95800,
      "endMs": 98580,
      "translation": "아니면 그게 토대일 수도 있고, 아닐 수도 있지, 아직은 아닐 뿐."
    },
    {
      "startMs": 98580,
      "endMs": 101060,
      "translation": "어쩌면 이게 위장된 축복이지 후회는 아닐 거야."
    },
    {
      "startMs": 101060,
      "endMs": 103470,
      "translation": "있잖아 제인, 결국 네 선택이야."
    },
    {
      "startMs": 103470,
      "endMs": 116180,
      "translation": "어느 쪽이든 내가 지지한다는 것만 알아 둬, 부담 주는 거 아니야."
    },
    {
      "startMs": 116180,
      "endMs": 118640,
      "translation": "T, 소식을 듣고 나는 숨 쉬는 법을 잊어버렸어."
    },
    {
      "startMs": 118640,
      "endMs": 120600,
      "translation": "패닉이었는데, 네가 날 달래 줬지."
    },
    {
      "startMs": 120600,
      "endMs": 123930,
      "translation": "젠장, 우린 어떡해? 확률이 얼마나 된다고? 이거 진짜야?"
    },
    {
      "startMs": 123930,
      "endMs": 126500,
      "translation": "어차피 나한테 벌어질 일이었다면, 너라서 다행이야."
    },
    {
      "startMs": 126500,
      "endMs": 128630,
      "translation": "T, 너 다리 길고 허리도 가늘어."
    },
    {
      "startMs": 128630,
      "endMs": 131130,
      "translation": "그리고 우리 둘 다 피부가 끝내주게 좋다는 점은 서로 통하지."
    },
    {
      "startMs": 131130,
      "endMs": 133650,
      "translation": "넌 멍청하지 않고, 네 기운은 기분이 좋아지는 쪽이야."
    },
    {
      "startMs": 133650,
      "endMs": 136750,
      "translation": "좀 이상하긴 해도 전반적으로 괜찮은 녀석이야, 그치?"
    },
    {
      "startMs": 136750,
      "endMs": 139120,
      "translation": "T, 우리가 이걸 비밀로 하면 어떨 것 같아?"
    },
    {
      "startMs": 139120,
      "endMs": 141960,
      "translation": "내 안에서 그렇게 해 달라고 빌듯이 말하는 목소리가 있어."
    },
    {
      "startMs": 141960,
      "endMs": 144380,
      "translation": "나는 서른다섯이고 내 난소는 다시 초기화가 안 될 수도 있어."
    },
    {
      "startMs": 144380,
      "endMs": 146970,
      "translation": "평생 후회하며 살고 싶지 않아."
    },
    {
      "startMs": 146970,
      "endMs": 149500,
      "translation": "젠장, 넌 절대 이해 못 할 감정이야 (못 해)."
    },
    {
      "startMs": 149500,
      "endMs": 152080,
      "translation": "넌 내가 다시 생리하게 해 달라고 신께 빌기만 하겠지."
    },
    {
      "startMs": 152080,
      "endMs": 154450,
      "translation": "나 스물네 살 때-"
    },
    {
      "startMs": 154450,
      "endMs": 156790,
      "translation": "봐, 그 경험을 다시 겪고 싶진 않아."
    },
    {
      "startMs": 156790,
      "endMs": 159650,
      "translation": "T, 일은 일어나는 거고 잘못한 사람은 없어 (사고였어)."
    },
    {
      "startMs": 159650,
      "endMs": 161930,
      "translation": "근데 난 스트레스 받을 필요 없어, 혼자서도 할 수 있어."
    },
    {
      "startMs": 161930,
      "endMs": 164420,
      "translation": "우리 엄마도 했고 너희 엄마도 했어, 자존심 때문이 아니야."
    },
    {
      "startMs": 164420,
      "endMs": 167290,
      "translation": "이건 '난 마음의 평화를 택하겠어' 쪽이야."
    },
    {
      "startMs": 167290,
      "endMs": 169570,
      "translation": "내 밥벌이는 내가 하니까 네가 뭘 사 줄 필요는 없어."
    },
    {
      "startMs": 169570,
      "endMs": 172050,
      "translation": "내 필요에는 네 돈도 지위도 들어 있지 않거든."
    },
    {
      "startMs": 172050,
      "endMs": 174460,
      "translation": "런던으로 돌아가면 잡음도 피할 수 있어."
    },
    {
      "startMs": 174460,
      "endMs": 177060,
      "translation": "우리 사이를 굳은살처럼 딱딱하게 만들 필요는 없잖아."
    },
    {
      "startMs": 177060,
      "endMs": 179950,
      "translation": "네 접시에 너무 많은 게 올려져 있어, 나한텐 이게 정말 충격이 커."
    },
    {
      "startMs": 179950,
      "endMs": 182500,
      "translation": "난 혼자서도 키울 수 있어, 난 극적이거든, 보다시피."
    },
    {
      "startMs": 182500,
      "endMs": 185070,
      "translation": "사람들을 내 삶에서 밀어내는 건 버릇이야, 알지."
    },
    {
      "startMs": 185070,
      "endMs": 187310,
      "translation": "창문 좀 열어 줄래? 숨 좀 쉬게."
    },
    {
      "startMs": 187310,
      "endMs": 190270,
      "translation": "T, 나도 무서워 (나도 그래)."
    },
    {
      "startMs": 190270,
      "endMs": 193340,
      "translation": "너한테 말하기가 정말 힘들었어, 사실대로 말하기가."
    },
    {
      "startMs": 193340,
      "endMs": 197480,
      "translation": "나 자신한테도 말하기 싫었어, 거울을 보면 '젠장, 내가 날 망쳤네' 싶어."
    },
    {
      "startMs": 197480,
      "endMs": 200210,
      "translation": "엄마한테 말하기도 무섭고, 내 친구 년들한테 말하기도 무서워."
    },
    {
      "startMs": 200210,
      "endMs": 202750,
      "translation": "우리 사정을 전혀 모르는 사람들이 전부 무서워."
    },
    {
      "startMs": 202750,
      "endMs": 205230,
      "translation": "사람들의 조언도, 내 직감도 무서워."
    },
    {
      "startMs": 205230,
      "endMs": 207820,
      "translation": "모르는 게 무서운데, 결정하는 건 더 무서워."
    },
    {
      "startMs": 207820,
      "endMs": 210070,
      "translation": "다시는 이러지 않겠다고 말했는데."
    },
    {
      "startMs": 210070,
      "endMs": 212570,
      "translation": "결국 꼬맹이를 잃으면 지는 거야."
    },
    {
      "startMs": 212570,
      "endMs": 215050,
      "translation": "그리고 네가 친구로서 사라져도 둘 다 지는 판이야."
    },
    {
      "startMs": 215050,
      "endMs": 217720,
      "translation": "난 계속 나를 잃어 가고 있고, 날 변호해 줄 사람도 없어."
    },
    {
      "startMs": 217720,
      "endMs": 220380,
      "translation": "내 안에 내 축소판이 살고 있어."
    },
    {
      "startMs": 220380,
      "endMs": 222720,
      "translation": "넌 머리를 쥐어뜯고, 난 허둥지둥 돌아다녀."
    },
    {
      "startMs": 222720,
      "endMs": 225190,
      "translation": "네가 가까이 올 때마다 원망이 느껴져."
    },
    {
      "startMs": 225190,
      "endMs": 227830,
      "translation": "내 몸엔 시계가 있는데 끝이 어딘지 모르겠어."
    },
    {
      "startMs": 227830,
      "endMs": 230320,
      "translation": "감정이 프리스비처럼 날아다녀."
    },
    {
      "startMs": 230320,
      "endMs": 232980,
      "translation": "내 젖가슴은 커지는데 난 치킨 열 조각 세트가 당겨."
    },
    {
      "startMs": 232980,
      "endMs": 237900,
      "translation": "T, 오늘 어떤 결정을 하든, 어느 쪽이든 우리 괜찮았으면 좋겠어."
    },
    {
      "startMs": 237900,
      "endMs": 241000,
      "translation": "부담은 없어."
    }
  ]
}
