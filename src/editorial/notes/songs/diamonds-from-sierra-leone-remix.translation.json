    {
      "startMs": 204480,
      "endMs": 207020,
      "translation": "이제 루이 비통 돈의 타이밍은 더할 나위 없지"
    },
    {
      "startMs": 207020,
      "endMs": 209520,
      "translation": "사람들은 타이타닉이 가라앉는 걸 보려고 줄을 섰지"
