  "segments": [
    {
      "startMs": 230,
      "endMs": 2950,
      "translation": "라, 라, 라라 (그래)"
    },
    {
      "startMs": 2950,
      "endMs": 7020,
      "translation": "돈 좀 제대로 벌 때까지 기다려 (오, 오, 오, 오, 오)"
    },
    {
      "startMs": 7020,
      "endMs": 9460,
      "translation": "돈으로 천국에 갈 수 있는 꿈을 꿨어"
    },
    {
      "startMs": 9460,
      "endMs": 12900,
      "translation": "깨어나서는 그 돈을 목걸이에 써 버렸지 (오, 오, 오, 오, 오)"
    },
    {
      "startMs": 12900,
      "endMs": 15990,
      "translation": "하나님께 금방 돌아오겠다고 했어"
    },
    {
      "startMs": 15990,
      "endMs": 19150,
      "translation": "이런, 무모하게 굴지 않기가 너무 힘들어"
    },
    {
      "startMs": 19150,
      "endMs": 21580,
      "translation": "많이 받은 자는 많이 시험받는 법"
    },
    {
      "startMs": 21580,
      "endMs": 24790,
      "translation": "체포되고, 그가 깨달을 때까지 계속 그러겠지 (오, 오, 오, 오, 오)"
    },
    {
      "startMs": 24790,
      "endMs": 27250,
      "translation": "압박이 느껴져, 감시는 더 심해지고"
    },
    {
      "startMs": 27250,
      "endMs": 31640,
      "translation": "그래서 내가 뭘 하냐고? 더 멍청하게 굴지 (오, 오, 오, 오, 오)"
    },
    {
      "startMs": 31640,
      "endMs": 33950,
      "translation": "보석을 더 사고, 루이 비통을 더 사고"
    },
    {
      "startMs": 33950,
      "endMs": 37040,
      "translation": "엄마 말도 나한테 닿지 않았어 (오, 오, 오, 오, 오)"
    },
    {
      "startMs": 37040,
      "endMs": 39440,
      "translation": "난리법석, 사람들이 날 고소하고"
    },
    {
      "startMs": 39440,
      "endMs": 42780,
      "translation": "난 TV에서 너랑 나 둘만 있는 것처럼 떠들어"
    },
    {
      "startMs": 42780,
      "endMs": 45340,
      "translation": "그냥 내 느낌을 말하는 것뿐이야"
    },
    {
      "startMs": 45340,
      "endMs": 49110,
      "translation": "난 코스비 가족도 아니고, 지옥에 간 것도 아니야 (오, 오, 오, 오, 오)"
    },
    {
      "startMs": 49110,
      "endMs": 51470,
      "translation": "돈이 날 바꿨어야 했나 봐"
    },
    {
      "startMs": 51470,
      "endMs": 54120,
      "translation": "내가 어디서 왔는지 잊었어야 했나 봐"
    },
    {
      "startMs": 54120,
      "endMs": 57020,
      "translation": "라, 라, 라라 (에이)"
    },
    {
      "startMs": 57020,
      "endMs": 59940,
      "translation": "돈 좀 제대로 벌 때까지 기다려"
    },
    {
      "startMs": 59940,
      "endMs": 62960,
      "translation": "라, 라, 라라 (그래)"
    },
    {
      "startMs": 62960,
      "endMs": 66470,
      "translation": "그럼 아무도 내게 뭐라 못 해, 그렇지?"
    },
    {
      "startMs": 66470,
      "endMs": 69400,
      "translation": "뭐라고? 방금 뭐라고 했어?"
    },
    {
      "startMs": 69400,
      "endMs": 72380,
      "translation": "어어, 아무도 내게 뭐라 못 해 (그래)"
    },
    {
      "startMs": 72380,
      "endMs": 75220,
      "translation": "(하하) 아무도 내게 뭐라 못 해 (그래, 그래, 그래)"
    },
    {
      "startMs": 75220,
      "endMs": 78920,
      "translation": "어어, 아무도 내게 뭐라 못 해 (오, 오, 오, 오, 오)"
    },
    {
      "startMs": 78920,
      "endMs": 81080,
      "translation": "날개처럼 열리는 문을 올려"
    },
    {
      "startMs": 81080,
      "endMs": 85080,
      "translation": "이건 내 인생이야, 친구, 네 인생은 네가 정해 (오, 오, 오, 오, 오)"
    },
    {
      "startMs": 85080,
      "endMs": 87600,
      "translation": "예수님이 우릴 위해 죽으셨다는 건 알아"
    },
    {
      "startMs": 87600,
      "endMs": 89500,
      "translation": "하지만 누가 전쟁을 정하는지는 모르겠어"
    },
    {
      "startMs": 89500,
      "endMs": 93160,
      "translation": "그래서 그 차를 옆으로 이중 주차해 버려"
    },
    {
      "startMs": 93160,
      "endMs": 97330,
      "translation": "노인들은 \"우리 때는\" 하고 말하지 (오, 오, 오, 오, 오)"
    },
    {
      "startMs": 97330,
      "endMs": 101060,
      "translation": "하지만 친구, 지금은 내 시대야, 수업은 두 시간 전에 시작했어"
    },
    {
      "startMs": 101060,
      "endMs": 102420,
      "translation": "아, 내가 늦었나? (오, 오, 오, 오, 오)"
    },
    {
      "startMs": 102420,
      "endMs": 104750,
      "translation": "아니, 난 이미 졸업했어"
    },
    {
      "startMs": 104750,
      "endMs": 108850,
      "translation": "매직 존슨도 버텼다면 넌 뭐든 견딜 수 있어 (오, 오, 오, 오, 오)"
    },
    {
      "startMs": 108850,
      "endMs": 112580,
      "translation": "다들 내가 너무 힘줘서 말한대"
    },
    {
      "startMs": 112580,
      "endMs": 114770,
      "translation": "우, 다들 너무 예민해"
    },
    {
      "startMs": 114770,
      "endMs": 117060,
      "translation": "콜라겐 넣듯 입술을 고쳐 놓고"
    },
    {
      "startMs": 117060,
      "endMs": 121470,
      "translation": "결국 사과할 말은 하지도 마 (오, 오, 오, 오, 오)"
    },
    {
      "startMs": 121470,
      "endMs": 124460,
      "translation": "문제가 있으면 말해, 친구"
    },
    {
      "startMs": 124460,
      "endMs": 126120,
      "translation": "좋아, 친구, 그럼 연락해"
    },
    {
      "startMs": 126120,
      "endMs": 128910,
      "translation": "라, 라, 라라 (에이)"
    },
    {
      "startMs": 128910,
      "endMs": 132050,
      "translation": "돈 좀 제대로 벌 때까지 기다려"
    },
    {
      "startMs": 132050,
      "endMs": 135040,
      "translation": "라, 라, 라라 (그래)"
    },
    {
      "startMs": 135040,
