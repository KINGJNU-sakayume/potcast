    },
    {
      "startMs": 151180,
      "endMs": 152730,
      "translation": "샴페인을 터뜨려"
    },
    {
      "startMs": 152730,
      "endMs": 154180,
      "translation": "저 남자가 돈을 벌게 둬"
    },
    {
      "startMs": 154180,
      "endMs": 157050,
      "translation": "저 남자가 지나가게 둬"
    },
    {
      "startMs": 157050,
      "endMs": 158640,
      "translation": "기름 넣으려고 멈추지도 않아"
    },
    {
      "startMs": 158640,
      "endMs": 160270,
      "translation": "소문을 뚫고 갈 수 있다면"
    },
    {
      "startMs": 160270,
      "endMs": 162370,
      "translation": "연기만으로도 달릴 수 있을 테니까"
    },
    {
      "startMs": 162370,
      "endMs": 165250,
      "translation": "'안 돼'로 가득한 방에서 그는 어떻게 움직일까?"
    },
    {
      "startMs": 165250,
      "endMs": 168460,
      "translation": "여자들로 가득한 방에서 그는 어떻게 한눈을 안 팔까?"
    },
    {
      "startMs": 168460,
      "endMs": 171460,
      "translation": "파라오들처럼 자기 영혼과 통하나 봐"
    },
    {
      "startMs": 171460,
      "endMs": 175050,
      "translation": "그래서 금으로 가득한 무덤에 묻힐 때"
    },
    {
      "startMs": 175050,
      "endMs": 177060,
      "translation": "보물, 네 즐거움은 뭐야?"
    },
    {
      "startMs": 177060,
      "endMs": 180420,
      "translation": "인생은, 어, 어떻게 입히느냐에 달렸지"
    },
    {
      "startMs": 180420,
      "endMs": 183490,
      "translation": "악마가 프라다를 입는다면 아담과 이브는 아무것도 안 입지"
    },
    {
      "startMs": 183490,
      "endMs": 187130,
      "translation": "난 그 중간인데 훨씬 더 멋져"
    },
    {
      "startMs": 187130,
      "endMs": 189250,
      "translation": "힘은 훨씬 덜 들이고"
    },
    {
      "startMs": 189250,
      "endMs": 193140,
      "translation": "애쓸 때가 바로 죽도록 애쓰다 죽을 때니까"
    },
    {
      "startMs": 193140,
      "endMs": 195180,
      "translation": "너희 친구들은 \"왜요, 하나님?\" 하는 표정이지"
    },
    {
      "startMs": 195180,
      "endMs": 198030,
      "translation": "그들이 너를 그리워할 때, 맙소사"
    },
    {
      "startMs": 198030,
      "endMs": 201020,
      "translation": "라, 라, 라라 (에이)"
    },
    {
      "startMs": 201020,
