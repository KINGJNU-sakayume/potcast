{
  "schemaVersion": 2,
  "timing": {
    "lrclibId": 583630,
    "durationMs": 221000
  },
  "segments": [
    {
      "startMs": 430,
      "endMs": 3720,
      "translation": "야, 지, 저들이 내 랩을 막을 순 없겠지?"
    },
    {
      "startMs": 3720,
      "endMs": 7470,
      "translation": "그렇지, 합?"
    },
    {
      "startMs": 7470,
      "endMs": 12420,
      "translation": "난 철사 사이로 랩을 뱉어"
    },
    {
      "startMs": 12420,
      "endMs": 15530,
      "translation": "지금 마음에 담긴 게 너무 많아"
    },
    {
      "startMs": 15530,
      "endMs": 20740,
      "translation": "지금이라면 기꺼이 모든 걸 걸 거야"
    },
    {
      "startMs": 20740,
      "endMs": 22530,
      "translation": "이건 삶과 죽음의 문제야"
    },
    {
      "startMs": 22530,
      "endMs": 26190,
      "translation": "너흰 내가 지금 어떤 기분인지 잘 모를 거야"
    },
    {
      "startMs": 26190,
      "endMs": 27890,
      "translation": "너희의 카녜가"
    },
    {
      "startMs": 27890,
      "endMs": 32190,
      "translation": "시카고에 인사해, 다들 잘 지내?"
    },
    {
      "startMs": 32190,
      "endMs": 34270,
      "translation": "어, 그래, 그래"
    },
    {
      "startMs": 34270,
      "endMs": 37460,
      "translation": "아침엔 부스트를, 디저트로는 인슈어를 마셔"
    },
    {
      "startMs": 37460,
      "endMs": 40430,
      "translation": "누가 팬케이크를 시키면 난 시럽만 홀짝여"
    },
    {
      "startMs": 40430,
      "endMs": 43340,
      "translation": "그 정도면 멀쩡한 사람도 미쳐 버릴걸"
    },
    {
      "startMs": 43340,
      "endMs": 46040,
      "translation": "걱정 마, 'Izzo'를 만든 이 몸이 다시 일하러 돌아왔으니까"
    },
    {
      "startMs": 46040,
      "endMs": 48920,
      "translation": "우리 엄마를 어떻게 위로하고 기운을 북돋아 줄 수 있겠어"
    },
    {
      "startMs": 48920,
      "endMs": 51670,
      "translation": "아들이 생명 유지 장치에 의지하고 있다고 말하면서"
    },
    {
      "startMs": 51670,
      "endMs": 53780,
      "translation": "그리고 내 여자 기분이 어땠을지 상상해 봐"
    },
    {
      "startMs": 53780,
      "endMs": 57300,
      "translation": "비행기 안에서 자기 남자가 에밋 틸처럼 보일까 봐 겁에 질렸을 거야"
    },
    {
      "startMs": 57300,
      "endMs": 60240,
      "translation": "계약하기 전부터 내 곁에 있었고 내 사람이 되려고 했지"
    },
    {
      "startMs": 60240,
      "endMs": 63100,
      "translation": "델타 소속이라 늘 그 손 모양을 해 보였어"
    },
    {
      "startMs": 63100,
      "endMs": 64870,
      "translation": "거짓말해 봤자 소용없지"
    },
    {
      "startMs": 64870,
      "endMs": 66260,
      "translation": "난 계약을 따내려고 애썼어"
    },
    {
      "startMs": 66260,
      "endMs": 67570,
      "translation": "백만장자가 되려고 애썼어"
    },
    {
      "startMs": 67570,
      "endMs": 69270,
      "translation": "그런데 어떻게 목숨을 두 번이나 썼냐고?"
    },
    {
      "startMs": 69270,
      "endMs": 71930,
      "translation": "비기 스몰스가 죽은 바로 그 병원에서"
    },
    {
      "startMs": 71930,
      "endMs": 74000,
      "translation": "의사가 혈전이 생겼다더라"
    },
    {
      "startMs": 74000,
      "endMs": 75230,
      "translation": "난 자메이카 사람도 아닌데 말이야"
    },
    {
      "startMs": 75230,
      "endMs": 77900,
      "translation": "MTV에 내 얘기가 나왔지만 '메이킹 더 밴드'를 찍으려는 건 아니야"
    },
    {
      "startMs": 77900,
      "endMs": 81320,
      "translation": "맹세컨대, 지금 이건 역사가 만들어지는 순간이야"
    },
    {
      "startMs": 81320,
      "endMs": 84030,
      "translation": "지금 모든 게 정말 미안해"
    },
    {
      "startMs": 84030,
      "endMs": 85640,
      "translation": "혹시 잘 안 들린다면 말이야"
    },
    {
      "startMs": 85640,
      "endMs": 90140,
      "translation": "입을 철사로 묶어 놨거든, 의사 말로는, 글쎄, 한 6주쯤"
    },
    {
      "startMs": 90140,
      "endMs": 91310,
      "translation": "그러니까 우리가 재건"
    },
    {
      "startMs": 91310,
      "endMs": 95260,
      "translation": "턱 재건 수술을 받았어"
    },
    {
      "startMs": 95260,
      "endMs": 98580,
      "translation": "거울을 봤더니 턱 반쪽이 입 안쪽으로 들어가 있더라"
    },
    {
      "startMs": 98580,
      "endMs": 101160,
      "translation": "믿을 수가 없었어"
    },
    {
      "startMs": 101160,
      "endMs": 103690,
      "translation": "그래도 난 지금 너희를 위해 여기 있어"
    },
    {
      "startMs": 103690,
      "endMs": 105970,
      "translation": "이게 지금 내가 하고 싶은 말이야"
    },
    {
      "startMs": 105970,
      "endMs": 108550,
      "translation": "그래, 소리 좀 키워 줘, 그래"
    },
    {
      "startMs": 108550,
      "endMs": 109580,
      "translation": "어"
    },
    {
      "startMs": 109580,
      "endMs": 111440,
      "translation": "시카고 출신의 실력 좋은 누군가가"
    },
    {
      "startMs": 111440,
      "endMs": 114920,
      "translation": "가장 잘나가는 랩 레이블과 계약했다면 어떨까?"
    },
    {
      "startMs": 114920,
      "endMs": 118520,
      "translation": "그런데 그는 마약 얘기 대신 스포큰 워드 같은 얘길 했다면"
    },
    {
      "startMs": 118520,
      "endMs": 120980,
      "translation": "그것도 진짜 제대로 해냈다면"
    },
    {
      "startMs": 120980,
      "endMs": 124270,
      "translation": "그리고 흑인이 어떤 영광에서 왔는지 이야기했다면"
    },
    {
      "startMs": 124270,
      "endMs": 126340,
      "translation": "이 바닥에서 우리가 뭘 해야 하는지도"
    },
    {
      "startMs": 126340,
      "endMs": 129460,
      "translation": "좋은 놈, 나쁜 밤, 맞는 장소, 틀린 시간"
    },
    {
      "startMs": 129460,
      "endMs": 132160,
      "translation": "눈 깜짝할 새에 그의 삶 전체가 바뀌었어"
    },
    {
      "startMs": 132160,
      "endMs": 135940,
      "translation": "내 얼굴이 어땠는지 느낄 수 있다면 메이스가 어떤 기분이었는지 알 거야"
    },
    {
      "startMs": 135940,
      "endMs": 138800,
      "translation": "안전벨트를 무시할 만큼 쿨하지 않아서 다행이야"
    },
    {
      "startMs": 138800,
      "endMs": 141460,
      "translation": "맹세컨대, 상대 운전자가 소송을 걸고 싶어 해"
    },
    {
      "startMs": 141460,
      "endMs": 144710,
      "translation": "금고 속 돈을 지키려고 이 사건에 변호사를 붙였어"
    },
    {
      "startMs": 144710,
      "endMs": 146770,
      "translation": "내 친구들은 내가"
    },
    {
      "startMs": 146770,
      "endMs": 149330,
      "translation": "「바닐라 스카이」의 톰 크루즈처럼 보이는지 알아보지도 못했어"
    },
    {
      "startMs": 149330,
      "endMs": 150480,
      "translation": "TV에도 나왔지"
    },
    {
      "startMs": 150480,
      "endMs": 152510,
      "translation": "가이코 광고처럼 '사고가 났습니다'"
    },
    {
      "startMs": 152510,
      "endMs": 155340,
      "translation": "펩시가 마이클한테 그랬던 것처럼 다들 내가 다 탄 줄 알았대"
    },
    {
      "startMs": 155340,
      "endMs": 156820,
      "translation": "나한텐 분명 천사가 있어"
    },
    {
      "startMs": 156820,
      "endMs": 158610,
      "translation": "봐, 죽음이 날 아슬아슬하게 비껴갔잖아"
    },
    {
      "startMs": 158610,
      "endMs": 161660,
      "translation": "언브레이커블, 날 미스터 글래스라고 부를 줄 알았어?"
    },
    {
      "startMs": 161660,
      "endMs": 164560,
      "translation": "과거의 크리스마스 유령처럼 내 삶을 돌아봐"
    },
    {
      "startMs": 164560,
      "endMs": 167450,
      "translation": "크리스마스 용돈을 쓰러 가던 토이저러스"
    },
    {
      "startMs": 167450,
      "endMs": 170410,
      "translation": "난 아직도 철이 안 들었어, 다 큰 어린애야"
    },
    {
      "startMs": 170410,
      "endMs": 173270,
      "translation": "맹세컨대 내가 한 멍청한 짓들로 감옥에 갔어야 했어"
    },
    {
      "startMs": 173270,
      "endMs": 176220,
      "translation": "하지만 난 챔피언이니까 비극을 승리로 바꿨지"
    },
    {
      "startMs": 176220,
      "endMs": 180890,
      "translation": "불같은 음악을 만들고, 철사 사이로 내 영혼을 뱉어"
    },
    {
      "startMs": 180890,
      "endMs": 181930,
      "translation": "무슨 말인지 알지?"
    },
    {
      "startMs": 181930,
      "endMs": 184120,
      "translation": "의사가 나한테, 음"
    },
    {
      "startMs": 184120,
      "endMs": 186270,
      "translation": "턱에 금속판을 넣을 거라고 했을 때"
    },
    {
      "startMs": 186270,
      "endMs": 189890,
      "translation": "내가 그랬지, \"이봐요, 그럼 이제 비행기는 절대 못 탄다는 거 몰라요?"
    },
    {
      "startMs": 189890,
      "endMs": 194600,
      "translation": "안 그래도 이 보석들 때문에 골치 아픈데\""
    },
    {
      "startMs": 194600,
      "endMs": 221000,
      "translation": "말도 안 되잖아"
    }
  ]
}
