  "segments": [
    {
      "startMs": 18760,
      "endMs": 23460,
      "translation": "잠도 못 자고 기다렸어, 파도가 밀려와서 날 데려가기를"
    },
    {
      "startMs": 23460,
      "endMs": 27650,
      "translation": "너에게 곧장 데려가기를"
    },
    {
      "startMs": 27650,
      "endMs": 32510,
      "translation": "좋은 술 백 병으로도 널 돌아오게 할 수 없었어"
    },
    {
      "startMs": 32510,
      "endMs": 36870,
      "translation": "난 어떡해야 해?"
    },
    {
      "startMs": 36870,
      "endMs": 39230,
      "translation": "배수구 주위를 맴도는 것 같아"
    },
    {
      "startMs": 39230,
      "endMs": 45790,
      "translation": "보이는 건 추한 진실의 잔해뿐"
    },
    {
      "startMs": 45790,
      "endMs": 50530,
      "translation": "지옥까지 따라갔다 돌아올 수 있는 모델이 백 명이나 있어도"
    },
    {
      "startMs": 50530,
      "endMs": 55020,
      "translation": "그들은 널 대신할 수 없어"
    },
    {
      "startMs": 55020,
      "endMs": 57670,
      "translation": "오, 오, 오, 오"
    },
    {
      "startMs": 57670,
      "endMs": 59890,
      "translation": "오, 오, 오, 오"
    },
    {
      "startMs": 59890,
