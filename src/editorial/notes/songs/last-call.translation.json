      "startMs": 308110,
      "endMs": 312010,
      "translation": "제이가 하는 컴필레이션 앨범 『The Dynasty』에 쓰고 싶어 할지도 몰라\" 하더라"
    },
    {
      "startMs": 312010,
      "endMs": 314800,
      "translation": "그런데 그때 드럼이 영 마음에 안 들었어"
    },
    {
      "startMs": 314800,
      "endMs": 319380,
      "translation": "그래서, 음, 그때 드레의 『2001』을 듣고 있었거든"
    },
    {
      "startMs": 319380,
      "endMs": 322430,
      "translation": "솔직히 'Xxplosive'의 드럼을 그대로 따다가"
    },
    {
      "startMs": 322430,
      "endMs": 325200,
      "translation": "빠르게 돌린 샘플에 붙였어"
    },
    {
      "startMs": 325200,
      "endMs": 327710,
      "translation": "그게 지금 내 스타일 전체가 시작된 지점이야"
    },
    {
      "startMs": 327710,
      "endMs": 329290,
      "translation": "그가 'This Can't Be Life'에 랩을 했을 때"
    },
    {
      "startMs": 329290,
      "endMs": 333220,
      "translation": "그게 『The Dynasty』에 실린 그런 종류의 첫 비트였어"
    },
    {
      "startMs": 333220,
      "endMs": 337310,
      "translation": "소울 사운드가 되살아난 시작이라고 해도 될 거야"
    },
    {
      "startMs": 337310,
      "endMs": 339110,
      "translation": "난 그 비트를 녹음하러 가게 됐고"
    },
    {
      "startMs": 339110,
      "endMs": 340730,
      "translation": "그때 난 아직 다른 매니지먼트에 있었어"
    },
    {
      "startMs": 340730,
      "endMs": 342390,
      "translation": "정말 힙합이랑 같이 가고 싶었지"
    },
    {
      "startMs": 342390,
      "endMs": 344860,
      "translation": "그냥 좀 새로운 공기가 필요했어, 무슨 말인지 알지?"
    },
    {
      "startMs": 344860,
      "endMs": 346560,
      "translation": "거기 꽤 오래 있었거든"
    },
    {
      "startMs": 346560,
      "endMs": 348980,
      "translation": "그 사람들이 해 준 건 고맙지만"
    },
    {
      "startMs": 348980,
      "endMs": 352210,
      "translation": "사람한텐 누구나 변화를 줘야 할 때가 있잖아"
    },
    {
      "startMs": 352210,
      "endMs": 354400,
      "translation": "다음 단계로 올라가려면"
    },
    {
      "startMs": 354400,
      "endMs": 357570,
      "translation": "그날 가서 비트를 녹음하고 제이 지를 만났는데 그가 그러더라"
    },
    {
      "startMs": 357570,
      "endMs": 359020,
      "translation": "\"오, 넌 진짜 소울풀한 친구구나\""
    },
    {
      "startMs": 359020,
      "endMs": 363310,
      "translation": "그리고 그는, 어, 그 노래를 틀었어, 내가 도착했을 땐 벌써 벌스를 다 뱉어 놨거든"
    },
    {
      "startMs": 363310,
      "endMs": 364340,
      "translation": "알잖아, 한 번에 끝내는 거"
    },
    {
      "startMs": 364340,
      "endMs": 366520,
      "translation": "그가 이거 어떤지 말해 보라고 했어"
    },
    {
      "startMs": 366520,
      "endMs": 369550,
      "translation": "들어 보니까 이런 생각이 들었지"
    },
    {
      "startMs": 369550,
      "endMs": 371850,
      "translation": "난 좀 더 단순한 스타일의 제이 지를 원했거든"
    },
    {
      "startMs": 371850,
      "endMs": 376570,
      "translation": "더 내면적이고 복잡한 그런 랩 말고, 어디까지나 내 개인적인 생각이지만"
    },
    {
      "startMs": 376570,
      "endMs": 378480,
      "translation": "그래서 그가 \"어때?\" 하고 묻길래"
    },
    {
      "startMs": 378480,
      "endMs": 380920,
      "translation": "난 \"와, 끝내주네요\" 했지, 무슨 말인지 알지? 내가 뭐라고 하겠어?"
    },
    {
      "startMs": 380920,
      "endMs": 382950,
      "translation": "난 아직 기차 타고 다니던 처지였어, 알잖아"
    },
    {
      "startMs": 382950,
      "endMs": 385380,
      "translation": "그 뒤에 난 집으로 돌아갔어"
    },
    {
      "startMs": 385380,
      "endMs": 387820,
      "translation": "그리고, 난 그냥 시카고에서 내 일을 하려고 했지"
    },
    {
      "startMs": 387820,
      "endMs": 390510,
      "translation": "있잖아, 띄워 보려는 그룹이랑 가수들도 있었고"
    },
    {
      "startMs": 390510,
      "endMs": 395840,
      "translation": "그런데 일이 생각만큼 잘 안 풀렸어"
    },
    {
      "startMs": 395840,
      "endMs": 399960,
      "translation": "내 가수였던 친구 하나가 계약을 했는데"
    },
    {
      "startMs": 399960,
      "endMs": 402170,
      "translation": "원래는 내 프로덕션 회사를 통해서 해야 했거든"
    },
    {
      "startMs": 402170,
      "endMs": 404660,
      "translation": "그런데 결국 그 회사랑 직접 계약해 버렸어"
    },
    {
      "startMs": 404660,
      "endMs": 406410,
      "translation": "그래서 난 그냥 전화기만 붙들고"
    },
    {
      "startMs": 406410,
      "endMs": 409620,
      "translation": "그 녀석이 내 회사를 나가려 한다는 나쁜 소식을 듣고 있었지"
    },
    {
      "startMs": 409620,
      "endMs": 412320,
      "translation": "그리고 바로 그때 집에서 쫓겨났어"
    },
    {
      "startMs": 412320,
      "endMs": 415220,
      "translation": "그래서 가서 그 녀석한테 줄 비트를 녹음해 주고"
    },
    {
      "startMs": 415220,
      "endMs": 419460,
      "translation": "그 돈을 받아서 돌아와 짐을 전부 이삿짐 트럭에 실었어"
    },
    {
      "startMs": 419460,
      "endMs": 422460,
      "translation": "실제로 나가야 하기 열흘쯤 전에"
    },
    {
      "startMs": 422460,
      "endMs": 425440,
      "translation": "집주인을 상대하지 않으려고, 그 사람 진짜 재수 없었거든"
    },
    {
      "startMs": 425440,
      "endMs": 427640,
      "translation": "엄마랑 같이 차를 몰고"
    },
    {
      "startMs": 427640,
      "endMs": 430250,
      "translation": "뉴저지 뉴어크로 갔어, 아파트는 보지도 못한 채로"
    },
    {
      "startMs": 430250,
      "endMs": 433100,
      "translation": "도착해서 짐을 다 풀었던 게 기억나"
    },
    {
      "startMs": 433100,
      "endMs": 436270,
      "translation": "이케아에 가서 침대를 사고 혼자 조립했어"
    },
    {
      "startMs": 436270,
      "endMs": 442080,
      "translation": "장비를 다 설치하고 처음 만든 비트가, 어, 'Heart of the City'였어"
    },
    {
      "startMs": 442080,
      "endMs": 444560,
      "translation": "그때 비니는 아직 자기 앨범 작업 중이었고"
    },
    {
      "startMs": 444560,
      "endMs": 447570,
      "translation": "그래서 베이스라인 스튜디오에 갔는데 마침 비니 생일이었어"
    },
    {
      "startMs": 447570,
      "endMs": 449210,
      "translation": "비트를 한 일곱 개쯤 틀었는데"
    },
    {
      "startMs": 449210,
      "endMs": 453180,
      "translation": "아마 그는 자기 흐름에 빠져 있어서 원하는 비트를 이미 다 갖고 있었던 것 같아"
    },
    {
      "startMs": 453180,
      "endMs": 456300,
      "translation": "그때 'Nothing Like It'은 이미 해 놓은 상태였고"
    },
    {
      "startMs": 456300,
      "endMs": 457970,
      "translation": "그런데 제이가 들어왔어"
    },
    {
      "startMs": 457970,
      "endMs": 459680,
      "translation": "구찌 버킷햇을 쓰고 있었던 게 기억나"
    },
    {
      "startMs": 459680,
      "endMs": 462030,
      "translation": "어제 일처럼 기억나"
    },
    {
      "startMs": 462030,
      "endMs": 464290,
      "translation": "힙합이 \"야, 그 비트 하나 들려줘 봐\" 했지"
    },
    {
      "startMs": 464290,
      "endMs": 465870,
      "translation": "그래서 'Heart of the City'를 틀었어"
    },
    {
      "startMs": 465870,
      "endMs": 468950,
      "translation": "사실 'Heart of the City'는 DMX한테 주려고 만든 비트였거든"
    },
    {
      "startMs": 468950,
      "endMs": 471210,
      "translation": "그다음 비트를 틀고, 또 다음 비트를 틀었는데"
    },
    {
      "startMs": 471210,
      "endMs": 474150,
      "translation": "그가 그 구찌 버킷햇을 벗어서 얼굴을 덮더니"
    },
    {
      "startMs": 474150,
      "endMs": 477700,
      "translation": "이런 표정을 지었어, 우"
    },
    {
      "startMs": 477700,
      "endMs": 480070,
      "translation": "이틀 뒤 베이스라인에서 데임을 만났어"
    },
    {
      "startMs": 480070,
      "endMs": 483170,
      "translation": "데임은 내가 누군지 몰라서 \"안녕하세요, 카녜예요\" 했지"
    },
    {
      "startMs": 483170,
      "endMs": 487880,
      "translation": "\"네가 제이한테 그 비트들 다 준 녀석이야? 야, 이 녀석이 네 비트로 클래식을 만들었어\""
    },
    {
      "startMs": 487880,
      "endMs": 489530,
      "translation": "그 사람 말하는 방식 알잖아"
    },
    {
      "startMs": 489530,
      "endMs": 490860,
      "translation": "난 \"와, 세상에\" 했지"
    },
    {
      "startMs": 490860,
      "endMs": 492420,
      "translation": "그동안 내내 난 스타를 만난 기분이었어"
    },
    {
      "startMs": 492420,
      "endMs": 495160,
      "translation": "그 사람들이 나오던 프로그램을 떠올리고 있었거든"
    },
    {
      "startMs": 495160,
      "endMs": 496870,
      "translation": "『The Streets Is Watching』인가 뭔가"
    },
    {
      "startMs": 496870,
      "endMs": 499130,
      "translation": "내 눈엔 다 슈퍼스타였어"
    },
    {
      "startMs": 499130,
      "endMs": 500510,
      "translation": "지금도 그렇고, 알잖아"
    },
    {
      "startMs": 500510,
      "endMs": 507310,
      "translation": "아무튼, 제이가 와서 그 노래들을 하루 만에, 이틀 만에 다 뱉었어"
    },
    {
      "startMs": 507310,
      "endMs": 509900,
      "translation": "하나 짚고 넘어가야겠어, 얘기를 좀 되돌려서"
    },
    {
      "startMs": 509900,
      "endMs": 512290,
      "translation": "'This Can't Be Life' 비트를 녹음하던 날"
    },
    {
      "startMs": 512290,
      "endMs": 516310,
      "translation": "레니 S가 루이 비통 스니커즈를 신고 잘난 척하던 게 기억나"
    },
    {
      "startMs": 516310,
      "endMs": 520180,
      "translation": "힙합도 있었고, 타이타이랑 존 메닐리랑 여러 사람이 있었던 것 같아"
    },
    {
      "startMs": 520180,
      "endMs": 523720,
      "translation": "그땐 다 모르는 사람들이었는데, 방에 다 있었지, 그래서 내가 그랬어, \"제이, 저 랩도 해요\""
    },
    {
      "startMs": 523720,
      "endMs": 527660,
      "translation": "그러고는 이 랩을 뱉었어, 어, \"가사로 너희를 다 죽여 놓고 있었지"
    },
    {
      "startMs": 527660,
      "endMs": 530110,
      "translation": "마요네즈 색 벤츠, 난 미러클 휩을 몰아\""
    },
    {
      "startMs": 530110,
      "endMs": 532270,
      "translation": "그 줄을 말했을 때 그의 눈이 반짝이는 걸 봤어"
    },
    {
      "startMs": 532270,
      "endMs": 536550,
      "translation": "그런데 알다시피 나머지 랩은 진짜 별로였으니까 반응은 그게 다였어"
    },
    {
      "startMs": 536550,
      "endMs": 537840,
      "translation": "그가 \"와, 괜찮네\" 했지"
    },
    {
      "startMs": 537840,
      "endMs": 541180,
      "translation": "그게 끝이었어, 계약 같은 건 없었지"
    },
    {
      "startMs": 541180,
      "endMs": 542750,
      "translation": "좋아, 빨리 감기"
    },
    {
      "startMs": 542750,
      "endMs": 547700,
      "translation": "그래서 『The Blueprint』, 'Izzo', 내 첫 히트 싱글"
    },
    {
      "startMs": 547700,
      "endMs": 551180,
      "translation": "난 그걸 자랑스럽게 받아들이고 사람들과 관계를 쌓았어"
    },
    {
      "startMs": 551180,
      "endMs": 556460,
      "translation": "콸리와의 관계는 래퍼로서 내 경력에 생긴 최고의 일 중 하나였던 것 같아"
    },
    {
      "startMs": 556460,
      "endMs": 559980,
      "translation": "왜냐면, 알다시피, 나중에 그가 날 투어에 데려가 줬거든"
    },
    {
      "startMs": 559980,
      "endMs": 565400,
      "translation": "정말 고마워, 그 친구를 사랑해"
    },
    {
      "startMs": 565400,
      "endMs": 567390,
      "translation": "그리고 그땐, 알다시피 난 계약이 없었어"
    },
    {
      "startMs": 567390,
      "endMs": 570290,
      "translation": "노래도 있었고 A&R들이랑 다 알고 지냈지"
    },
    {
      "startMs": 570290,
      "endMs": 573460,
      "translation": "그 사람들이 내 비트를 원했으니까, 전화가 오면 비트를 들려줬어"
    },
    {
      "startMs": 573460,
      "endMs": 574630,
      "translation": "\"제이 지 같은 비트 하나 줘\""
    },
    {
      "startMs": 574630,
      "endMs": 576230,
      "translation": "알잖아, 남의 성공에 빌붙는 사람들, 뭐 그렇지"
    },
    {
      "startMs": 576230,
      "endMs": 580560,
      "translation": "그래서 『블루프린트』 이후 스타일 비트를 들려주고 그다음에 내 노래를 틀었어"
    },
    {
      "startMs": 580560,
      "endMs": 581870,
      "translation": "그러고는 \"참, 저 랩도 해요\" 하는 거지"
    },
    {
      "startMs": 581870,
      "endMs": 584440,
      "translation": "아마 날 이상하게 쳐다봤을 거야, 왜냐면"
    },
    {
      "startMs": 584440,
      "endMs": 586960,
      "translation": "난 저지를 입고 있지도 않았으니까"
    },
    {
      "startMs": 586960,
      "endMs": 588470,
      "translation": "다들 잘 들어"
    },
    {
      "startMs": 588470,
      "endMs": 591210,
      "translation": "난 그 사람들한테 'Jesus Walks'를 들려줬는데 계약을 안 해 주더라"
    },
    {
      "startMs": 591210,
      "endMs": 593930,
      "translation": "무슨 일이 있었냐면, 날 좋아해 준 A&R들도 있었어"
    },
    {
      "startMs": 593930,
      "endMs": 597110,
      "translation": "그런데 위에서, 회사의 누군가가 \"안 돼\" 하는 거야"
    },
    {
      "startMs": 597110,
      "endMs": 601760,
      "translation": "데이브 라이티는 날 좋아했고, 내 친구 멜은 날 여러 레이블에 데려가 줬어"
    },
    {
      "startMs": 601760,
      "endMs": 607300,
      "translation": "제시카 리베라, 정말"
    },
    {
      "startMs": 607300,
      "endMs": 611120,
      "translation": "내 홍보를 망칠 말은 안 할게"
    },
    {
      "startMs": 611120,
      "endMs": 612910,
      "translation": "그냥 계약을 못 따냈다고만 해 두자"
    },
    {
      "startMs": 612910,
      "endMs": 616020,
      "translation": "날 밀어 준 사람은, 아니, 그런 식으로 부를 사람이 아니고"
    },
    {
      "startMs": 616020,
      "endMs": 620580,
      "translation": "실제로 모든 걸 시작하게 해 준 사람은 캐피톨 레코드의 조 3H였어"
    },
    {
      "startMs": 620580,
      "endMs": 622280,
      "translation": "그는 정말 날 계약하고 싶어 했어"
    },
    {
      "startMs": 622280,
      "endMs": 627370,
      "translation": "데임은 \"야, 캐피톨이랑 계약한다고? 그래, 그럼 별로인 앨범만 아니게 해\" 했지"
    },
    {
      "startMs": 627370,
      "endMs": 629000,
      "translation": "그러던 어느 날 그냥 틀어 버렸어"
    },
    {
      "startMs": 629000,
      "endMs": 634280,
      "translation": "노래 몇 개를 들려주고 싶었거든, 캠이랑 영 구루, 데임이 방에 있었으니까"
    },
    {
      "startMs": 634280,
      "endMs": 638260,
      "translation": "그래서 틀었어, 사실 너희가 영영 못 들을 노래야"
    },
    {
      "startMs": 638260,
      "endMs": 640630,
      "translation": "글쎄, 내가 쓸지도 모르지만, 제목이 'Wow'야"
    },
    {
      "startMs": 640630,
      "endMs": 644890,
      "translation": "\"난 2만 5천 달러 들고 제이콥에 가, 넌 2천 5백 달러 들고 가지, 와"
    },
    {
      "startMs": 644890,
      "endMs": 647490,
      "translation": "지금 내 벽엔 상패가 열한 개 걸려 있어"
    },
    {
      "startMs": 647490,
      "endMs": 650430,
      "translation": "넌 첫 골드 싱글을 땄구나, 이야, 와\""
    },
    {
      "startMs": 650430,
      "endMs": 651420,
      "translation": "후렴이 이런 식이었어"
    },
    {
      "startMs": 651420,
      "endMs": 653220,
      "translation": "그 후렴 베끼지 마, 아직 쓸지도 모르니까"
    },
    {
      "startMs": 653220,
      "endMs": 657980,
      "translation": "그래서 그 노래를 들려줬더니 그가 \"와, 세상에\" 하더라"
    },
    {
      "startMs": 657980,
      "endMs": 661310,
      "translation": "\"솔직히 말해서, 꽤 괜찮네\""
    },
    {
      "startMs": 661310,
      "endMs": 662980,
      "translation": "그래도 다들 여전히 날 래퍼로 보진 않았어"
    },
    {
      "startMs": 662980,
      "endMs": 664140,
      "translation": "아마 데임은 이렇게 생각했을 거야"
    },
    {
      "startMs": 664140,
      "endMs": 666870,
      "translation": "이 녀석이 앨범 한 장을 다 냈는데 랩이 별로면"
    },
    {
      "startMs": 666870,
      "endMs": 671610,
      "translation": "적어도 곡마다 캠을 넣어서 앨범을 살릴 수 있겠다고, 알잖아"
    },
    {
      "startMs": 671610,
      "endMs": 673100,
      "translation": "그래서, 어, 데임이 날 복도로 데려가더니"
    },
    {
      "startMs": 673100,
      "endMs": 676740,
      "translation": "\"야, 이봐, 넌 망하고 싶지 않잖아, 망하고 싶지 않잖아\" 하더라"
    },
    {
      "startMs": 676740,
      "endMs": 679680,
      "translation": "\"우산 밑에 있어야 해, 안 그러면 비를 맞을 거야\""
    },
    {
      "startMs": 679680,
      "endMs": 682190,
      "translation": "힙합한테 말했더니 그가 \"오, 진짜?\" 하더라"
    },
    {
      "startMs": 682190,
      "endMs": 688060,
      "translation": "사실 그 말을 듣고도 난 여전히 캐피톨과 계약하려고 했어"
    },
    {
      "startMs": 688060,
      "endMs": 691160,
      "translation": "이미 테이블 위에 올라와 있었고 3H와의 관계도 있었으니까"
    },
    {
      "startMs": 691160,
      "endMs": 693990,
      "translation": "그한테 그러겠다고 말했거든, 난 약속을 지키는 사람이야"
    },
    {
      "startMs": 693990,
      "endMs": 696410,
      "translation": "하겠다고 한 대로 갈 생각이었지"
    },
    {
      "startMs": 696410,
      "endMs": 700730,
      "translation": "그런데, 알다시피, 이름은 안 밝힐게"
    },
    {
      "startMs": 700730,
      "endMs": 703080,
      "translation": "사람들이 \"아, 그 녀석은 그냥 랩하는 프로듀서야\" 하고"
    },
    {
      "startMs": 703080,
      "endMs": 705330,
      "translation": "3H한테 말했고, 그게 캐피톨 윗선까지 올라갔어"
    },
    {
      "startMs": 705330,
      "endMs": 709530,
      "translation": "그리고 바로 그날, 난 할 일을 전부 계획해 놨었어"
    },
    {
      "startMs": 709530,
      "endMs": 713650,
      "translation": "입을 옷도 골라 놨고, 스튜디오 세션도 잡기 시작했고"
    },
    {
      "startMs": 713650,
      "endMs": 717710,
      "translation": "앨범 구성도 짜고, 마케팅 계획도 생각하고, 난 갈 준비가 다 돼 있었어"
    },
    {
      "startMs": 717710,
      "endMs": 724400,
      "translation": "그런데 멜이 전화를 했어, \"야, 캐피톨이 계약을 철회했대\""
    },
    {
      "startMs": 724400,
      "endMs": 727550,
      "translation": "그래서 로커펠라가 관심 있다고 말했는데"
    },
    {
      "startMs": 727550,
      "endMs": 730470,
      "translation": "그 사람들은 내가 몸값을 올리려고"
    },
    {
      "startMs": 730470,
      "endMs": 732210,
      "translation": "괜히 하는 소리라고 생각했는지도 몰라"
    },
    {
      "startMs": 732210,
      "endMs": 738630,
      "translation": "그래서 지한테 전화해서 말했지, \"야, 우리 아직 로커펠라랑 계약할 수 있을 것 같아?\""
    },
    {
      "startMs": 738630,
      "endMs": 743910,
      "translation": "그러니 잔을 들어 주지 않을래?"
    },
    {
      "startMs": 743910,
      "endMs": 749440,
      "translation": "그러니 잔을 들어 주지 않을래?"
    },
    {
      "startMs": 749440,
      "endMs": 754750,
      "translation": "그러니 잔을 들어 주지 않을래?"
    },
    {
      "startMs": 754750,
      "endMs": 761000,
      "translation": "그러니 잔을 들어 주지 않을래?"
    }
  ]
