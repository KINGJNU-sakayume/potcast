    },
    {
      "startMs": 91150,
      "endMs": 115870,
      "translation": "지금 네가 이걸 싫어하는 거 알아"
    },
    {
      "startMs": 115870,
      "endMs": 120420,
      "translation": "애정이 흘러넘쳐"
