{
  "schemaVersion": 2,
  "timing": {
    "lrclibId": 3616023,
    "durationMs": 333000
  },
  "segments": [
    {
      "startMs": 440,
      "endMs": 6210,
      "translation": "네가 유일한 사람이라고 말했어야 했는데 (어 오!)"
    },
    {
      "startMs": 6210,
      "endMs": 11670,
      "translation": "하지만 너무 늦었어, 너무 늦었어, 떠나 버렸어"
    },
    {
      "startMs": 11670,
      "endMs": 13610,
      "translation": "넌 그녀에게 빠졌지, 쿠지 스웨터 얘기가 아니야"
    },
    {
      "startMs": 13610,
      "endMs": 16020,
      "translation": "넌 빅 엘이지, 쿨 제이 얘기가 아니야"
    },
    {
      "startMs": 16020,
      "endMs": 18850,
      "translation": "공항에서 날 보면 루이 비통 가방이 적어도 스무 개"
    },
    {
      "startMs": 18850,
      "endMs": 21440,
      "translation": "날 왕자처럼 모셔, 이쪽은 내 사랑스러운 형제 넘프세이"
    },
    {
      "startMs": 21440,
      "endMs": 23810,
      "translation": "(넘프세이 형제!) 그루피들은 내가 너무 까다롭대"
    },
    {
      "startMs": 23810,
      "endMs": 26550,
      "translation": "쇼에 데려가 놓고 영화 내내 떠들지"
    },
    {
      "startMs": 26550,
      "endMs": 29180,
      "translation": "다이아몬드를 원한다길래 루비 튜즈데이에 데려갔어"
    },
    {
      "startMs": 29180,
      "endMs": 31530,
      "translation": "프라이데이스에 가도 난 내 마음대로 해"
    },
    {
      "startMs": 31530,
      "endMs": 34360,
      "translation": "떠나, 우린 집으로 달려가"
    },
    {
      "startMs": 34360,
      "endMs": 37450,
      "translation": "떠나, 난 크롬 휠을 굴려, 너무 늦었어"
    },
    {
      "startMs": 37450,
      "endMs": 39390,
      "translation": "너희는 나랑 문제 일으키고 싶지 않을걸"
    },
    {
      "startMs": 39390,
      "endMs": 41720,
      "translation": "너희 래퍼들이 나한테서 얻을 수 있는 건 일자리뿐이야"
    },
    {
      "startMs": 41720,
      "endMs": 44460,
      "translation": "내 인턴이라도 하면 그 대가로"
    },
    {
      "startMs": 44460,
      "endMs": 46870,
      "translation": "겨울에 여름을 요리해 내는 법을 보여 줄게"
    },
    {
      "startMs": 46870,
      "endMs": 49750,
      "translation": "에런은 맨몸을 좋아해, 언제 정신 차릴래"
    },
    {
      "startMs": 49750,
      "endMs": 52360,
      "translation": "어셔 투어에서 뭘 옮아서 꾹 참고 견뎌야 했지"
    },
    {
      "startMs": 52360,
      "endMs": 54300,
      "translation": "게다가 이미 애가 셋이야"
    },
    {
      "startMs": 54300,
      "endMs": 57170,
      "translation": "베이비시터 문제로 다투지, 이번엔 네 차례라고"
    },
    {
      "startMs": 57170,
      "endMs": 59930,
      "translation": "\"이런, 예, 너를 디스하는 건 멍청한 짓이야"
    },
    {
      "startMs": 59930,
      "endMs": 61700,
      "translation": "네 피상적인 랩조차 완전 공식적이거든\""
    },
    {
      "startMs": 61700,
      "endMs": 65670,
      "translation": "로, 로, 로, 로커펠라 파스텔에 구찌를 걸치고"
    },
    {
      "startMs": 65670,
      "endMs": 68150,
      "translation": "차에는 TV, 영화나 한 편 틀어"
    },
    {
      "startMs": 68150,
      "endMs": 70620,
      "translation": "랩 못 한다던 놈이 이제 두비 롱이랑 정상에 있지"
    },
    {
      "startMs": 70620,
      "endMs": 73100,
      "translation": "날 올려 준 노래마다 내가 다 박살 냈으니까, 떠나"
    },
    {
      "startMs": 73100,
      "endMs": 75650,
      "translation": "우린 집으로 달려가, 떠나"
    },
    {
      "startMs": 75650,
      "endMs": 78020,
      "translation": "난 크롬 휠을 굴려"
    },
    {
      "startMs": 78020,
      "endMs": 80770,
      "translation": "우린 집으로 달려가"
    },
    {
      "startMs": 80770,
      "endMs": 86610,
      "translation": "우린 집으로 달려가, 떠나 (킬라)"
    },
    {
      "startMs": 86610,
      "endMs": 88660,
      "translation": "난 크롬 휠을 굴려"
    },
    {
      "startMs": 88660,
      "endMs": 91180,
      "translation": "똑똑, 누구세요? 킬라 캠, 킬라 누구?"
    },
    {
      "startMs": 91180,
      "endMs": 93790,
      "translation": "킬라 캠, 허슬러, 일벌레, 진짜 게릴라"
    },
    {
      "startMs": 93790,
      "endMs": 96970,
      "translation": "오, 내 친칠라는 파래, 파래, 딜러를 상대해 본 적 있어?"
    },
    {
      "startMs": 96970,
      "endMs": 99200,
      "translation": "좋아, 이렇게 하자, 자기, 우린 대리점에 갈 거야, 우"
    },
    {
      "startMs": 99200,
      "endMs": 101630,
      "translation": "숨길 것도 없고, 천장도 없어, 지붕은 필요 없지"
    },
    {
      "startMs": 101630,
      "endMs": 104010,
      "translation": "까불면 나가, 넌 필요 없어, 펑"
    },
    {
      "startMs": 104010,
      "endMs": 106310,
      "translation": "펑 사라져, 이런, 운이 없네"
    },
    {
      "startMs": 106310,
      "endMs": 109080,
      "translation": "이런, 다들 아직도 두 모금 빨고 넘기고 있네"
    },
    {
      "startMs": 109080,
      "endMs": 111700,
      "translation": "트럭을 빨리 대고 말하지"
    },
    {
      "startMs": 111700,
      "endMs": 114550,
      "translation": "헤이, 손본 재규어로 돌아왔어"
    },
    {
      "startMs": 114550,
      "endMs": 117050,
      "translation": "너희 모두 캠의 머릿속에 들어오고 싶어 하지"
    },
    {
      "startMs": 117050,
      "endMs": 119450,
      "translation": "늙은이 하나가 말해 주겠지, 너무 늦었다고"
    },
    {
      "startMs": 119450,
      "endMs": 122550,
      "translation": "내가 떠나면 너희가 어떻게 반응하는지 볼게"
    },
    {
      "startMs": 122550,
      "endMs": 125180,
      "translation": "전 여자는 날 다시 원해, 그때 난 잘나가고 있었지"
    },
    {
      "startMs": 125180,
      "endMs": 127420,
      "translation": "좋아, 있어, 넌 일할 줄은 아니까, 헤이"
    },
    {
      "startMs": 127420,
      "endMs": 129420,
      "translation": "돌아와서 간판에 뭐라고 적혀 있는지 읽어 봐"
    },
    {
      "startMs": 129420,
      "endMs": 132030,
      "translation": "그래, 내가 망하는 걸 보고 싶은 거 알아"
    },
    {
      "startMs": 132030,
      "endMs": 134680,
      "translation": "그래, 넌 교회 다니는 녀석이면서 변장한 도둑처럼 굴지"
    },
    {
      "startMs": 134680,
      "endMs": 137630,
      "translation": "내 사이즈도 아닌데, 내 눈에 탐욕이 보이지"
    },
    {
      "startMs": 137630,
      "endMs": 140500,
      "translation": "애비한테 물어봐, 난 허슬했어, 시카고에 대마를 들여왔지"
    },
    {
      "startMs": 140500,
      "endMs": 143220,
      "translation": "거짓말도 아니야, 제발 믿어 줘"
    },
    {
      "startMs": 143220,
      "endMs": 145730,
      "translation": "위지한테 파이 한 조각을 나눠 줬어, 그리고"
    },
    {
      "startMs": 145730,
      "endMs": 147990,
      "translation": "조지나 레지나한테 물어봐도 돼"
    },
    {
      "startMs": 147990,
      "endMs": 151070,
      "translation": "이제 BMW를 타고 웨스트사이드 전체를 누비지"
    },
    {
      "startMs": 151070,
      "endMs": 155650,
      "translation": "우린 집으로 달려가, 난 크롬 휠을 굴려"
    },
    {
      "startMs": 155650,
      "endMs": 158290,
      "translation": "들어 봐, 친구, 그냥 털어 버려"
    },
    {
      "startMs": 158290,
      "endMs": 160630,
      "translation": "그게 최선이야, 왜냐고, 컨스?"
    },
    {
      "startMs": 160630,
      "endMs": 164170,
      "translation": "친구가 떠났다는 사실 때문에 술을 좀 부어 왔어"
    },
    {
      "startMs": 164170,
      "endMs": 167060,
      "translation": "자식이 떠났다는 사실을 견디는 그 엄마를 도우려고 애쓰면서"
    },
    {
      "startMs": 167060,
      "endMs": 169250,
      "translation": "우린 칼곤 거품 목욕처럼 함께 부글거렸으니까"
    },
    {
      "startMs": 169250,
      "endMs": 171530,
      "translation": "이제부터는 내가 그 엄마를 돕는 게 맞겠지"
    },
    {
      "startMs": 171530,
      "endMs": 174050,
      "translation": "그런데 일이 어떻게 틀어질 뻔했는지 다들 수상해하니까"
    },
    {
      "startMs": 174050,
      "endMs": 176740,
      "translation": "이제 다들 컨스한테 묻지, 이게 얼마나 오래 이어졌냐고"
    },
    {
      "startMs": 176740,
      "endMs": 179200,
      "translation": "어쩌면 이 돈이 내 머리로 다 가 버렸는지도 몰라"
    },
    {
      "startMs": 179200,
      "endMs": 181560,
      "translation": "돈이 연방 요원들한테 갔을지도 모른다는 생각이 들게 하니까"
    },
    {
      "startMs": 181560,
      "endMs": 183270,
      "translation": "그래서 그 드레드 머리한테 갔는데, 그는 자러 가 버렸고"
    },
    {
      "startMs": 183270,
      "endMs": 186510,
      "translation": "다음 날 아침 가 보니 그가 내 돈을 들고 가 버렸더라"
    },
    {
      "startMs": 186510,
      "endMs": 189380,
      "translation": "그러니까 난 본능을 따라"
    },
    {
      "startMs": 189380,
      "endMs": 191950,
      "translation": "사람들이 칵테일을 마시러 가는 데로 가 버렸지"
    },
    {
      "startMs": 191950,
      "endMs": 194610,
      "translation": "지금 돌아보면 집에 갔어야 했어"
    },
    {
      "startMs": 194610,
      "endMs": 196730,
      "translation": "「바람과 함께 사라지다」나 빌려 봤으면 열 시 전엔 들어갔을 텐데"
    },
    {
      "startMs": 196730,
      "endMs": 199210,
      "translation": "그런데 친구랑 같이 가 버렸고, 우린 술집에 갔지"
    },
    {
      "startMs": 199210,
      "endMs": 201770,
      "translation": "어떤 놈이 시비를 거는 게 들려서 차로 가 버렸어"
    },
    {
      "startMs": 201770,
      "endMs": 204490,
      "translation": "이제 판사가 내가 너무 멀리 가 버렸대"
    },
    {
      "startMs": 204490,
      "endMs": 206990,
      "translation": "이제 우린 20년 동안 철창 안으로 가 버렸지"
    },
    {
      "startMs": 206990,
      "endMs": 209590,
      "translation": "하찮은 범죄로 감방에 가 버렸으니"
    },
    {
      "startMs": 209590,
      "endMs": 237920,
      "translation": "우물에 너무 자주 가 버린 셈이야, 이제 난 떠났으니까"
    },
    {
      "startMs": 237920,
      "endMs": 252230,
      "translation": "어어어, 어어어 어 어 오오온, 어 어어 오오온"
    },
    {
      "startMs": 252230,
      "endMs": 254480,
      "translation": "어어 오오온, 어 어어"
    },
    {
      "startMs": 254480,
      "endMs": 256350,
      "translation": "난 시대를 앞서가, 가끔은 몇 년씩이나"
    },
    {
      "startMs": 256350,
      "endMs": 259240,
      "translation": "그래서 윗사람들이 내 아이디어를 세상에 못 내놓게 해"
    },
    {
      "startMs": 259240,
      "endMs": 261500,
      "translation": "그러면 선금을 받아서"
    },
    {
      "startMs": 261500,
      "endMs": 264100,
      "translation": "오클라호마로 가서 그냥 이모 집에서 살고 싶어져"
    },
    {
      "startMs": 264100,
      "endMs": 266430,
      "translation": "그래, 다 두고 떠나는 상상을 해"
    },
    {
      "startMs": 266430,
      "endMs": 269480,
      "translation": "카녜, 각광에서 물러나"
    },
    {
      "startMs": 269480,
      "endMs": 271860,
      "translation": "한창 고생하던 때처럼 가볍게"
    },
    {
      "startMs": 271860,
      "endMs": 274620,
      "translation": "1999년에"
    },
    {
      "startMs": 274620,
      "endMs": 276910,
      "translation": "모델들이 몸을 숙이기 전"
    },
    {
      "startMs": 276910,
      "endMs": 279820,
      "translation": "대리점에서 \"벤츠로 할까요, 로버로 할까요?\" 묻기 전"
    },
    {
      "startMs": 279820,
      "endMs": 282290,
      "translation": "이봐, 호바한테 비트 하나만 넣을 수 있다면"
    },
    {
      "startMs": 282290,
      "endMs": 284470,
      "translation": "이 싸구려 소파에서 일어날 수 있을 텐데"
    },
    {
      "startMs": 284470,
      "endMs": 287760,
      "translation": "시카고의 여름이 열여덟 살한테 줄 수 있는 게 뭐겠어?"
    },
    {
      "startMs": 287760,
      "endMs": 290340,
      "translation": "마약을 팔든지 일자리를 구하든지, 네 역할을 해야지"
    },
    {
      "startMs": 290340,
      "endMs": 292710,
      "translation": "친구가 타코벨에서 일하면서 우리한테 잔뜩 챙겨 줬어"
    },
    {
      "startMs": 292710,
      "endMs": 295150,
      "translation": "일주일 뒤에 잘렸지, 매니저가 추로스를 세어 보더라"
    },
    {
      "startMs": 295150,
      "endMs": 297700,
      "translation": "가끔 거울을 보면 믿기지가 않아"
    },
    {
      "startMs": 297700,
      "endMs": 300780,
      "translation": "우리가 유럽에서 유로를 쓰고 있다니"
    },
    {
      "startMs": 300780,
      "endMs": 303260,
      "translation": "다들 잃고 나서야 가진 걸 안다고 하지"
    },
    {
      "startMs": 303260,
      "endMs": 305880,
      "translation": "난 내가 가진 걸 알아, 너희는 뭘 하고 있는지 모르겠다"
    },
    {
      "startMs": 305880,
      "endMs": 308550,
      "translation": "래퍼 지망생들을 위한 가게를 열 거야"
    },
    {
      "startMs": 308550,
      "endMs": 310890,
      "translation": "꿈을 팔진 않겠지만 영감은 공짜야"
    },
    {
      "startMs": 310890,
      "endMs": 313020,
      "translation": "하지만 아나킨처럼 반대편으로 돌아서면"
    },
    {
      "startMs": 313020,
      "endMs": 315750,
      "translation": "마네킹까지 몽땅 팔게 될 거야"
    },
    {
      "startMs": 315750,
      "endMs": 317860,
      "translation": "저들은 새 여자를 들였고, 이제 넌 제니퍼 애니스턴 신세야"
    },
    {
      "startMs": 317860,
      "endMs": 320510,
      "translation": "잠깐, 내가 처리할게, 당황하지 마, 진정해"
    },
    {
      "startMs": 320510,
      "endMs": 323650,
      "translation": "꼬마들이 문 앞에 와 있어, 더 필요하니까"
    },
    {
      "startMs": 323650,
      "endMs": 326450,
      "translation": "자기 삶과 영혼과 노래를 위한 영감이"
    },
    {
      "startMs": 326450,
      "endMs": 333000,
      "translation": "그들이 그러지, \"죄송합니다, 웨스트 씨는 떠났습니다\""
    }
  ]
}
