    },
    {
      "startMs": 125060,
      "endMs": 127420,
      "translation": "현실이 날 따라잡고 있어"
    },
    {
      "startMs": 127420,
      "endMs": 130490,
      "translation": "내 안의 아이를 두고, 난 양육권 싸움을 하는 중이야"
    },
    {
      "startMs": 130490,
      "endMs": 133530,
      "translation": "사람들이 내게 맡긴 이 책임들과 함께"
    },
    {
      "startMs": 133530,
      "endMs": 136750,
      "translation": "다이아몬드 박힌 목걸이를 내려다보며"
