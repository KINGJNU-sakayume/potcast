  "segments": [
    {
      "startMs": 12800,
      "endMs": 20770,
      "translation": "넌 마음으로 날 웃게 해, 오"
    },
    {
      "startMs": 20770,
      "endMs": 24670,
      "translation": "나쁘다는 건 왜 다 이렇게 기분이 좋을까?"
    },
    {
      "startMs": 24670,
      "endMs": 29150,
      "translation": "하지 말라는 건 꼭 하게 돼"
    },
    {
      "startMs": 29150,
      "endMs": 32620,
      "translation": "끊으려고 했어, 정말 최선을 다했어"
    },
    {
      "startMs": 32620,
      "endMs": 36670,
      "translation": "그런데 넌 날 웃게 해"
    },
    {
      "startMs": 36670,
      "endMs": 40810,
      "translation": "넌 뭐에 중독됐어? 돈이야? 여자야? 대마야?"
    },
    {
      "startMs": 40810,
      "endMs": 44850,
      "translation": "난 하나도 둘도 아니라 셋 다에 빠졌어"
    },
    {
      "startMs": 44850,
      "endMs": 48850,
      "translation": "그녀도 나에 대해 같은 걸 느껴, 아니, 우리에 대해선 더"
    },
    {
      "startMs": 48850,
      "endMs": 53350,
      "translation": "그녀가 오고 있으니, 아마 내가 그녀의 약인가 봐 (넌 날 웃게 해)"
    },
    {
      "startMs": 53350,
      "endMs": 57310,
      "translation": "잠깐만 엿보게 해 줘, 그러니까, 젠장, 너무 궁금해"
    },
    {
      "startMs": 57310,
      "endMs": 61350,
      "translation": "그녀에겐 애인이 있어서 그 거짓말과 욕망이 짜릿해"
    },
    {
      "startMs": 61350,
      "endMs": 65580,
      "translation": "시간이 없어, 즉흥적으로 굴어 줘"
    },
    {
      "startMs": 65580,
      "endMs": 69140,
      "translation": "대마를 말고, 헤네시랑 코, 코, 코카콜라 (넌 마음으로 날 웃게 해, 오)"
    },
    {
      "startMs": 69140,
      "endMs": 74670,
      "translation": "그리고 난 또, 또 가지, 끝나지가, 끝나지가 않으니까"
    },
    {
      "startMs": 74670,
      "endMs": 78860,
      "translation": "나쁘다는 건 왜 다 이렇게 기분이 좋을까?"
    },
    {
      "startMs": 78860,
      "endMs": 83700,
      "translation": "하지 말라는 건 꼭 하게 돼"
    },
    {
      "startMs": 83700,
      "endMs": 86530,
      "translation": "끊으려고 했어, 정말 최선을 다했어"
    },
    {
      "startMs": 86530,
      "endMs": 90560,
      "translation": "그런데 넌 날 웃게 해"
    },
    {
      "startMs": 90560,
      "endMs": 94770,
      "translation": "네 눈에 숨기려는 감정이 보여"
    },
    {
      "startMs": 94770,
      "endMs": 98950,
      "translation": "우린 네가 취했을 때나 마셨을 때나 피웠을 때 제일 가까워져"
    },
    {
      "startMs": 98950,
      "endMs": 103160,
      "translation": "그래서 난 약을 따르지, 둘 다 갈 수 있는 데까지 취하게"
    },
    {
      "startMs": 103160,
      "endMs": 107110,
      "translation": "그리고 로션을 가져와서, 네 허벅지가 드러나면 날 위해 뭔가를 해 줘 (넌 날 웃게 해)"
    },
    {
      "startMs": 107110,
      "endMs": 111380,
      "translation": "이제 돌이킬 수 없어, 그러니까 강요하려는 건 아니야"
    },
    {
      "startMs": 111380,
      "endMs": 115530,
      "translation": "이따가 말고 지금 당장, 옷을 벗고 포즈를 취해 줘"
    },
    {
      "startMs": 115530,
      "endMs": 119500,
      "translation": "난 요즘 그게 좋아, 문이 닫히면 분위기를 타지"
    },
    {
      "startMs": 119500,
      "endMs": 123570,
      "translation": "대마를 말고, 헤네시랑 코, 코, 코카콜라 (넌 마음으로 날 웃게 해)"
    },
    {
      "startMs": 123570,
      "endMs": 128460,
      "translation": "그리고 난 계속 또, 또 가지, 끝나지가, 끝나지가 않으니까"
    },
    {
      "startMs": 128460,
      "endMs": 132930,
      "translation": "나쁘다는 건 왜 다 이렇게 기분이 좋을까?"
    },
    {
      "startMs": 132930,
      "endMs": 137710,
      "translation": "하지 말라는 건 꼭 하게 돼"
    },
    {
      "startMs": 137710,
      "endMs": 140660,
      "translation": "끊으려고 했어, 정말 최선을 다했어"
    },
    {
      "startMs": 140660,
      "endMs": 183020,
      "translation": "그런데 넌 날 웃게 해"
    },
    {
      "startMs": 183020,
      "endMs": 187070,
      "translation": "나쁘다는 건 왜 다 이렇게 기분이 좋을까?"
    },
    {
      "startMs": 187070,
      "endMs": 191720,
      "translation": "하지 말라는 건 꼭 하게 돼"
    },
    {
      "startMs": 191720,
      "endMs": 194870,
      "translation": "끊으려고 했어, 정말 최선을 다했어"
    },
    {
      "startMs": 194870,
      "endMs": 197880,
      "translation": "그런데 넌 날 웃게 해"
    },
    {
      "startMs": 197880,
      "endMs": 199100,
      "translation": "그냥 물어보고 싶었는데"
    },
    {
      "startMs": 199100,
      "endMs": 204670,
      "translation": "그러니까, 음, 어떻게 말해야 할까, 어"
    },
    {
      "startMs": 204670,
      "endMs": 213000,
      "translation": "그러니까, 네 친구들 중에, 그 애 기억나"
    },
    {
      "startMs": 213000,
      "endMs": 217540,
      "translation": "네가 혹시라도 한다면 그 애일 거라고 했던"
    },
    {
      "startMs": 217540,
      "endMs": 221010,
      "translation": "그래, 그래, 그래 (넌 마음으로 날 웃게 해)"
    },
    {
      "startMs": 221010,
      "endMs": 225210,
      "translation": "그러니까 내 생각엔, 가정해서 말이야"
    },
    {
      "startMs": 225210,
      "endMs": 227690,
      "translation": "그러니까, 진지하게 듣지는 말고"
    },
    {
      "startMs": 227690,
      "endMs": 231310,
      "translation": "날 너무 믿지는 말고, 그냥, 어, 곧이곧대로 말고"
    },
    {
      "startMs": 231310,
      "endMs": 235850,
      "translation": "기분이 엄청나게, 그러니까, 그냥 두자"
    },
    {
      "startMs": 235850,
      "endMs": 237960,
      "translation": "그냥 그렇게 두자"
    },
    {
      "startMs": 237960,
      "endMs": 239760,
      "translation": "그러니까 너랑, 그 애랑, 나랑 (넌 마음으로 날 웃게 해)"
    },
    {
      "startMs": 239760,
      "endMs": 241850,
      "translation": "그러니까 너랑, 그 애랑, 나랑"
    },
    {
      "startMs": 241850,
      "endMs": 251090,
      "translation": "어쩌면, 자기, 자기, 자기, 자기"
    },
    {
      "startMs": 251090,
      "endMs": 256030,
      "translation": "농담이었던 거 알지"
    },
    {
      "startMs": 256030,
      "endMs": 267000,
      "translation": "네가 하겠다면 모르겠지만 (넌 날 웃게 해)"
    }
  ]
}
