{
  "schemaVersion": 2,
  "timing": {
    "lrclibId": 14200405,
    "durationMs": 270000
  },
  "segments": [
    {
      "startMs": 12160,
      "endMs": 15250,
      "translation": "동네 카페에서 주디라는 여자를 만났어."
    },
    {
      "startMs": 15250,
      "endMs": 18440,
      "translation": "가슴은 가슴팍 가까이에 있었고, 곱슬머리가 얼굴을 가렸지."
    },
    {
      "startMs": 18440,
      "endMs": 21400,
      "translation": "다리는 에펠탑 같았고, 아빠가 흑인이라는 게 딱 보였어 (아)."
    },
    {
      "startMs": 21400,
      "endMs": 24860,
      "translation": "땅콩버터 젤리 토스트가 그녀 무릎 위에 있었어."
    },
    {
      "startMs": 24860,
      "endMs": 27910,
      "translation": "우린 수다를 떨고 또 떨었고, 난 그녀의 생각이 좋았고 시간이 날아갔어."
    },
    {
      "startMs": 27910,
      "endMs": 30970,
      "translation": "그녀는 계획이 없다며 내가 뭘 할 거냐고 물었어."
    },
    {
      "startMs": 30970,
      "endMs": 34030,
      "translation": "난 우릴 팬텀에 태우고 거리를 누볐어."
    },
    {
      "startMs": 34030,
      "endMs": 36980,
      "translation": "이런 거 처음이라면서도 내가 다정하다고 생각한대."
    },
    {
      "startMs": 36980,
      "endMs": 43410,
      "translation": "그러니 난 주디를 판단하지 않을 거야."
    },
    {
      "startMs": 43410,
      "endMs": 49140,
      "translation": "아니, 난 주디를 판단하지 않을 거야."
    },
    {
      "startMs": 49140,
      "endMs": 53120,
      "translation": "우린 내 집에 도착해서 춤을 추고 단 걸 만들었어 (단 걸 만들었어)."
    },
    {
      "startMs": 53120,
      "endMs": 56510,
      "translation": "혀를 섞기 시작했고 그녀가 내 위에 올라탔어 (내 위에 올라탔어)."
    },
    {
      "startMs": 56510,
      "endMs": 59760,
      "translation": "뭘 좋아하느냐고 물었더니 앞장서래 (네가 먼저, 난 다 좋아)."
    },
    {
      "startMs": 59760,
      "endMs": 62360,
      "translation": "몸 문지르기, 결박, 질내사정, 우린 놀아 볼 수 있어,"
    },
    {
      "startMs": 62360,
      "endMs": 65750,
      "translation": "공공장소에서도 말이야, 이제 어떤 사정이든 페티시가 되지, 내 상상엔 (에이)."
    },
    {
      "startMs": 65750,
      "endMs": 68910,
      "translation": "발 마사지에 환장하고, 입으로 해 주는 게 내 열정이야 (어)."
    },
    {
      "startMs": 68910,
      "endMs": 72070,
      "translation": "내 얼굴에 올라타도 돼, 대가는 바라지 않아 (잠깐)."
    },
    {
      "startMs": 72070,
      "endMs": 74520,
      "translation": "네 경험 인원수나 누구랑 잤는지는 내 관심사가 아니야."
    },
    {
      "startMs": 74520,
      "endMs": 80900,
      "translation": "난 주디를 판단하지 않으니까 (그래, 그래, 그래) (네 페티시가 뭐고 뭘 좋아해?)"
    },
    {
      "startMs": 80900,
      "endMs": 87330,
      "translation": "아니, 난 주디를 판단하지 않아 (상관없어, 여긴 안전해, 널 판단 안 해)"
    },
    {
      "startMs": 87330,
      "endMs": 93620,
      "translation": "아니, 난 주디를 판단하지 않아 (주디, 주디, 주디) (내가, 내가 널 눌러 잡고 박아 줄게)"
    },
    {
      "startMs": 93620,
      "endMs": 123070,
      "translation": "아니, 난 주디를 판단하지 않아."
    },
    {
      "startMs": 123070,
      "endMs": 127490,
      "translation": "그녀는 나랑 똑같아, 어."
    },
    {
      "startMs": 127490,
      "endMs": 132900,
      "translation": "그래, 어, 어, 그래."
    },
    {
      "startMs": 132900,
      "endMs": 139510,
      "translation": "난 주디를 판단할 수 없어 (오, 나-나-나-나)."
    },
    {
      "startMs": 139510,
      "endMs": 143930,
      "translation": "그녀는 밧줄을 좋아해, 목을 감싸는 손도."
    },
    {
      "startMs": 143930,
      "endMs": 148620,
      "translation": "몇 명이 같이하면 살아 있는 기분이 들었대 (그래, 그래, 오)."
    },
    {
      "startMs": 148620,
      "endMs": 153500,
      "translation": "자유로운 영혼이었어, 알잖아? (주디, 주디, 주디)"
    },
    {
      "startMs": 153500,
      "endMs": 159700,
      "translation": "여자들하고도 잘 맞았고, 노출증이었어 (주디, 주디, 주디, 주디)."
    },
    {
      "startMs": 159700,
      "endMs": 164860,
      "translation": "난 관음 쪽이라 잘 맞았지 (주디 판사, 세상에)."
    },
    {
      "startMs": 164860,
      "endMs": 167760,
      "translation": "우리 주파수가 맞았어 (오, 나-나-나-나)."
    },
    {
      "startMs": 167760,
      "endMs": 173840,
      "translation": "부담 없이, 그냥, 그냥."
    },
    {
      "startMs": 173840,
      "endMs": 175810,
      "translation": "그녀가 내게 편지를 썼어."
    },
    {
      "startMs": 175810,
      "endMs": 178970,
      "translation": "연락을 자주 못 해서 미안해."
    },
    {
      "startMs": 178970,
      "endMs": 182010,
      "translation": "지난 한 해가 힘들었고, 그게 머리까지 번졌어 (그래, 그래, 그래)."
    },
    {
      "startMs": 182010,
      "endMs": 185120,
      "translation": "만났을 때부터 알았어, 이걸 읽고 있다면 이미 늦었다는 걸."
    },
    {
      "startMs": 185120,
      "endMs": 188240,
      "translation": "난 이제 저편에 있지만 이 말은 하고 싶어."
    },
    {
      "startMs": 188240,
      "endMs": 191440,
      "translation": "떠나기 전에 붙잡을 수 있었던 순간들, 고마워 (잠깐)."
    },
    {
      "startMs": 191440,
      "endMs": 194410,
      "translation": "네가 후회 없이 가장 너다운 모습으로 살길 바라."
    },
    {
      "startMs": 194410,
      "endMs": 197550,
      "translation": "남은 게 얼마인지 들은 뒤에야 난 제대로 살기 시작했어."
    },
    {
      "startMs": 197550,
      "endMs": 200180,
      "translation": "행운을 빌어, 추신."
    },
    {
      "startMs": 200180,
      "endMs": 206830,
      "translation": "판단하지 않아 줘서 고마워. 주디가."
    },
    {
      "startMs": 206830,
      "endMs": 270000,
      "translation": "젠장."
    }
  ]
}
