  "segments": [
    {
      "startMs": 240,
      "endMs": 3380,
      "translation": "세상이 거꾸로 뒤집힌 채 살아가는 우리에게"
    },
    {
      "startMs": 3380,
      "endMs": 7730,
      "translation": "새로 가져야 할 말은 혁명이다"
    },
    {
      "startMs": 7730,
      "endMs": 9920,
      "translation": "사람들은 이제 설교자의 말조차 듣고 싶어 하지 않는다"
    },
    {
      "startMs": 9920,
      "endMs": 15140,
      "translation": "쏟아 내든 늘어놓든, 신의 패는 이미 샅샅이 들여다보였으니까"
    },
    {
      "startMs": 15140,
      "endMs": 20300,
      "translation": "그리고 이제 미국은 젖과 꿀 대신 피와 눈물이다"
    },
    {
      "startMs": 20300,
      "endMs": 22880,
      "translation": "계속 망가지도록 길들여진"
    },
    {
      "startMs": 22880,
      "endMs": 25270,
      "translation": "젊은이들이 어느 날 밤 깨어나 파헤쳤다"
    },
    {
      "startMs": 25270,
      "endMs": 29220,
      "translation": "폴 리비어와 냇 터너를 좋은 사람들로"
    },
    {
      "startMs": 29220,
      "endMs": 33530,
      "translation": "미국은 잠자리에 들려고 옷을 벗었고, 우리는 아직 다 눈을 감지 않았다"
    },
    {
      "startMs": 33530,
      "endMs": 37720,
      "translation": "진실의 징표가 활짝 열린 몸 위에 문신처럼 새겨져 있었다"
    },
    {
      "startMs": 37720,
      "endMs": 42010,
      "translation": "우리는 놀랍게도 말해지지 않은 추문의 이야기를 알게 되었다"
    },
    {
      "startMs": 42010,
      "endMs": 44890,
      "translation": "두 세기 동안 곰팡내 나는 금고에 묻혀"
    },
    {
      "startMs": 44890,
      "endMs": 48110,
      "translation": "날마다 숨 막히는 향수로 씻겨 온 이야기를"
    },
    {
      "startMs": 48110,
      "endMs": 52430,
      "translation": "미국은 사생아였다, 모국의 혼외 딸"
    },
    {
      "startMs": 52430,
      "endMs": 54770,
      "translation": "그 다리는 세계를 향해 벌려져 있었고"
    },
    {
      "startMs": 54770,
      "endMs": 59750,
      "translation": "자유라는 이름의, 아니 자유로운 파멸이라는 이름의 겁탈자가 있었다"
    },
    {
      "startMs": 59750,
      "endMs": 64520,
      "translation": "민주주의, 자유, 정의는 혁명의 암호명이었다"
    },
    {
      "startMs": 64520,
      "endMs": 68020,
      "translation": "그 뒤를 이은 것은 부글, 부글, 부글, 부글, 끓어오르는 것"
    },
    {
      "startMs": 68020,
      "endMs": 72180,
      "translation": "모국의 사타구니에서"
    },
    {
      "startMs": 72180,
      "endMs": 74790,
      "translation": "웹스터 사전은 소울을 뭐라고 정의하는가?"
    },
    {
      "startMs": 74790,
      "endMs": 77100,
      "translation": "내가 바라는 건 좋은 집과 아내"
    },
    {
      "startMs": 77100,
      "endMs": 80730,
      "translation": "그리고 아이들, 매일 밤 그들을 먹일 음식뿐"
    },
    {
      "startMs": 80730,
      "endMs": 85160,
      "translation": "결국 할 말을 다 하고 나면, 받아 준다면 중국으로 가는 새 길이라도 내라"
    },
    {
      "startMs": 85160,
      "endMs": 86760,
      "translation": "누가 미국에서 살아남을까?"
    },
