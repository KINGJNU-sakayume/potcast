  "segments": [
    {
      "startMs": 20070,
      "endMs": 24850,
      "translation": "도망치고 싶은 밤의 거리, 행방은 아직 불명"
    },
    {
      "startMs": 24850,
      "endMs": 29140,
      "translation": "돌고 돌아 허무해서 곤란해졌네 멍멍멍"
    },
    {
      "startMs": 29140,
      "endMs": 34110,
      "translation": "잃어버린 건 없는데 뭔가 모자란 기분"
    },
    {
      "startMs": 34110,
      "endMs": 39650,
      "translation": "묘하게 들떠서 밟아 댄 네 바퀴 차"
    },
    {
      "startMs": 39650,
      "endMs": 42000,
      "translation": "형제여, 어떻게든 해 보자"
    },
    {
      "startMs": 42000,
      "endMs": 44380,
      "translation": "이제 아무것도 생각하지 않도록"
    },
    {
      "startMs": 44380,
      "endMs": 48960,
      "translation": "은하계 끝자락으로, 안녕"
    },
    {
      "startMs": 48960,
      "endMs": 51080,
      "translation": "진실도 도덕도"
    },
    {
      "startMs": 51080,
      "endMs": 53740,
      "translation": "작동하지 않는 미쳐 버린 밤이라도"
    },
    {
      "startMs": 53740,
      "endMs": 57680,
      "translation": "우리는 손뼉 치며 함께 웃어"
    },
    {
      "startMs": 57680,
      "endMs": 64420,
      "translation": "아무도 모르게"
    },
    {
      "startMs": 64420,
      "endMs": 69150,
      "translation": "단 한순간의 이 반짝임을"
    },
    {
      "startMs": 69150,
      "endMs": 73860,
      "translation": "둘이서 남김없이 먹어 치우자, 뻗을 때까지"
    },
    {
      "startMs": 73860,
      "endMs": 78420,
      "translation": "그리고 행운을, 우리에게 기도를"
    },
    {
      "startMs": 78420,
      "endMs": 83950,
      "translation": "더 가 보자, 아무도 따라잡지 못할 속도로"
    },
    {
      "startMs": 83950,
      "endMs": 88050,
      "translation": "번개처럼 살고 싶을 뿐이야"
    },
    {
      "startMs": 88050,
      "endMs": 90330,
      "translation": "너는 어떡하고 싶어?"
    },
    {
      "startMs": 90330,
      "endMs": 101680,
      "translation": "대답은 필요 없어"
    },
    {
      "startMs": 101680,
      "endMs": 106440,
      "translation": "굴러가는 차창과 풍경, 동기는 아직 불명"
    },
    {
      "startMs": 106440,
      "endMs": 111090,
      "translation": "귀찮고 짜증 나서 길 잃은 야옹야옹야옹"
    },
    {
      "startMs": 111090,
      "endMs": 115620,
      "translation": "이 근처에서 떨어뜨린 지갑, 누구 못 보셨어요?"
    },
    {
      "startMs": 115620,
      "endMs": 121140,
      "translation": "바보처럼 운도 없네, 놀려 줘 하이웨이 스타"
    },
    {
      "startMs": 121140,
      "endMs": 123580,
      "translation": "어이 파트너, 한 판 더"
    },
    {
      "startMs": 123580,
      "endMs": 125850,
      "translation": "만화 같은 싸움 한번 하자"
    },
    {
      "startMs": 125850,
      "endMs": 130430,
      "translation": "농담으로 안 끝날 만한 걸로, 시험 삼아"
    },
    {
      "startMs": 130430,
      "endMs": 132440,
      "translation": "바른말과 막말의"
    },
    {
      "startMs": 132440,
      "endMs": 135280,
      "translation": "구분조차 안 되는 거리를"
    },
    {
      "startMs": 135280,
      "endMs": 139350,
      "translation": "빠져나와 서로 마주 보고 웃어"
    },
    {
      "startMs": 139350,
      "endMs": 146050,
      "translation": "노리는 건 달콤한 엔딩"
    },
    {
      "startMs": 146050,
      "endMs": 150780,
      "translation": "그건 심장을 찰나에 뒤흔드는 것"
    },
    {
      "startMs": 150780,
      "endMs": 155220,
      "translation": "쫓아가는 순간 놓쳐 버리는 것"
    },
    {
      "startMs": 155220,
      "endMs": 159810,
      "translation": "분명 영원이 어딘가에 있을 거라며"
    },
    {
      "startMs": 159810,
      "endMs": 165510,
      "translation": "엉뚱한 모레를 찾아 헤매는 것도 나쁘지 않잖아"
    },
    {
      "startMs": 165510,
      "endMs": 169540,
      "translation": "네가 어딘가로 사라진 아침보다"
    },
    {
      "startMs": 169540,
      "endMs": 171860,
      "translation": "이런 밤이"
    },
    {
      "startMs": 171860,
      "endMs": 174520,
      "translation": "아직 나아"
    },
    {
      "startMs": 174520,
      "endMs": 178720,
      "translation": "폐에는 수련, 멀리서 사이렌"
    },
    {
      "startMs": 178720,
      "endMs": 183730,
      "translation": "함께 울리는 경계선"
    },
    {
      "startMs": 183730,
      "endMs": 188010,
      "translation": "사랑하듯이 싸워 보자고"
    },
    {
      "startMs": 188010,
      "endMs": 192970,
      "translation": "어쩔 줄 모를 서글픔을 끌어안고"
    },
    {
      "startMs": 192970,
      "endMs": 197420,
      "translation": "폐에는 수련, 멀리서 사이렌"
    },
    {
