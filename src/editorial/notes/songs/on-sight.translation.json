      "endMs": 94020,
      "translation": "그 여자애는 오늘 밤을 즐기고 싶어 하고"
    },
    {
      "startMs": 94020,
      "endMs": 96230,
      "translation": "그 친구도 넘어올 준비가 됐어"
    },
    {
      "startMs": 96230,
      "endMs": 98380,
      "translation": "둘 다 해치웠지"
