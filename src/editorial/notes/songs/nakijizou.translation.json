    {
      "startMs": 14750,
      "endMs": 19590,
      "translation": "우리는 소수의 이익을 위한 피라미드야"
    },
    {
      "startMs": 19590,
      "endMs": 21820,
      "translation": "있잖아, 소감은? 아, 안 들어"
    },
    {
