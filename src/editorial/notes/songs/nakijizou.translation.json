    },
    {
      "startMs": 23740,
      "endMs": 25590,
      "translation": "최선을 한 번 더"
    },
    {
      "startMs": 25590,
      "endMs": 27830,
      "translation": "있잖아, 신, 이제 됐잖아 하고"
    },
    {
      "startMs": 27830,
      "endMs": 29700,
