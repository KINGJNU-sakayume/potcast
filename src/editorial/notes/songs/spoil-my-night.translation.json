    },
    {
      "startMs": 31000,
      "endMs": 35930,
      "translation": "내 밤을 망쳐 줘, 내 밤을 망쳐 줘"
    },
    {
      "startMs": 35930,
      "endMs": 38910,
      "translation": "내 목걸이는 저절로 빛이 났어"
    },
    {
      "startMs": 38910,
      "endMs": 42110,
      "translation": "그 여자는 번쩍이는 조명 속에서 춤춰"
    },
    {
      "startMs": 42110,
      "endMs": 47880,
      "translation": "빌어먹게 내 밤을 망쳐 보자 (내 밤을 망쳐 줘)"
    },
    {
      "startMs": 47880,
      "endMs": 50800,
      "translation": "돈을 너무 많이 써서 그 여자를 놓쳤어"
    },
    {
      "startMs": 50800,
      "endMs": 54050,
      "translation": "내 잔은 너무 독했어"
    },
    {
      "startMs": 54050,
      "endMs": 57050,
      "translation": "그 여자의 가운을 벗겼지 (그래)"
    },
    {
      "startMs": 57050,
      "endMs": 60150,
      "translation": "그 여자를 떼어 낼 수가 없었어"
    },
    {
      "startMs": 60150,
      "endMs": 62950,
      "translation": "그 여자 허벅지에 돈을 잔뜩 뿌렸어"
    },
    {
      "startMs": 62950,
      "endMs": 66280,
      "translation": "내 차엔 자리가 넉넉해"
    },
    {
      "startMs": 66280,
      "endMs": 68920,
      "translation": "난 한 번도 피라미였던 적이 없어"
    },
    {
      "startMs": 68920,
      "endMs": 72820,
      "translation": "그 여자가 날 받아들였어, 내 목숨을 걸고 진짜야"
    },
    {
      "startMs": 72820,
      "endMs": 75930,
      "translation": "내 밤을 망쳐 줘, 내 밤을 망쳐 줘"
