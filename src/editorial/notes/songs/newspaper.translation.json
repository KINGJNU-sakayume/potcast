  "segments": [
    {
      "startMs": 33000,
      "endMs": 36900,
      "translation": "나도 한때는 그가 날 자랑스러워하길 바랐어"
    },
    {
      "startMs": 36900,
      "endMs": 40240,
      "translation": "그러다 그냥 그가 잘못을 바로잡길 바랐지"
    },
    {
      "startMs": 40240,
      "endMs": 43820,
      "translation": "그가 너한테 나에 대해 무슨 거짓말을 하고 있을까"
    },
    {
      "startMs": 43820,
      "endMs": 47380,
      "translation": "우리가 절대 친구가 되지 못하게 하려고"
    },
    {
      "startMs": 47380,
      "endMs": 51610,
      "translation": "안타까운 일이야, 너와 나에겐 증인이 없었으니까"
    },
    {
      "startMs": 51610,
      "endMs": 54710,
      "translation": "아는 사람은 우리 둘뿐이야"
    },
    {
      "startMs": 54710,
      "endMs": 57790,
      "translation": "그가 우리에게 입 맞춘 순간 우리는 저주받았어"
    },
    {
      "startMs": 57790,
      "endMs": 61770,
      "translation": "그때부터는 그의 거대한 쇼였지"
    },
    {
      "startMs": 61770,
      "endMs": 64990,
      "translation": "그가 너를 탐내기 시작하는 걸 보고 걱정이 됐어"
    },
    {
      "startMs": 64990,
      "endMs": 68570,
      "translation": "그가 한 짓을 알게 됐을 때 너와 가까워진 기분이 들었어"
    },
    {
      "startMs": 68570,
      "endMs": 72100,
      "translation": "나름의 방식으로 너를 사랑하게 됐어"
    },
    {
      "startMs": 72100,
      "endMs": 75520,
      "translation": "하지만 그는 나를 너한테 유령으로 만들어 버렸지"
    },
    {
      "startMs": 75520,
      "endMs": 79040,
      "translation": "그가 네 손을 놓는 걸 봐, 너희 사이에 서고 싶어"
    },
    {
      "startMs": 79040,
      "endMs": 82640,
      "translation": "하지만 그건 내가 할 일이 아니야"
    },
    {
      "startMs": 82640,
      "endMs": 86080,
      "translation": "그가 너를 짓밟고, 네 말을 자르고, 못되게 구는 걸 봐"
    },
    {
      "startMs": 86080,
      "endMs": 89520,
      "translation": "그리고 그게 너와 가까워진 기분이 들게 해"
    },
    {
      "startMs": 89520,
      "endMs": 93410,
