  "segments": [
    {
      "startMs": 1780,
      "endMs": 6620,
      "translation": "알잖아, 음, 너한테 마음이 무거워, 그래, 비밀도 아니야"
    },
    {
      "startMs": 6620,
      "endMs": 9620,
      "translation": "넌 나한테 너무 쿨해서, 난 얼어붙고 싶지 않아"
    },
    {
      "startMs": 9620,
      "endMs": 12980,
      "translation": "존슨 가족처럼, 헛소리는, 내가 입을 열 거야"
    },
    {
      "startMs": 12980,
      "endMs": 16380,
      "translation": "바다에는 물고기가 많다는 걸 깨닫고, 난 보충할 거야"
    },
    {
      "startMs": 16380,
      "endMs": 19300,
      "translation": "야, 내 음악이 쿵쿵 울리는 거 알아, 이건 습진이야"
    },
    {
      "startMs": 19300,
      "endMs": 22700,
      "translation": "그래서 맞고 온 사람처럼 고개를 숙이고 다니지 않을 거야"
    },
    {
      "startMs": 22700,
      "endMs": 26360,
      "translation": "음, 넌 네 길을 가, 난 내 길을 갈게, 난 그냥 그 조각을 질식시킬 거야"
    },
    {
      "startMs": 26360,
      "endMs": 28330,
      "translation": "난 따라가려고 애쓰지 않아, 왜냐면"
    },
    {
      "startMs": 28330,
      "endMs": 34760,
      "translation": "난 이제 널 사랑하지 않아 (워, 워, 워, 워, 워)"
    },
    {
      "startMs": 34760,
      "endMs": 41820,
      "translation": "난 이제 널 사랑하지 않으니까 (워, 워, 워, 워, 워)"
    },
    {
      "startMs": 41820,
      "endMs": 43160,
      "translation": "난 이제 널 사랑하지 않으니까"
    },
    {
      "startMs": 43160,
      "endMs": 48250,
      "translation": "(넌 내 시간을 낭비했어, 이런 일들이 어렵지 않다는 걸 알아)"
    },
    {
      "startMs": 48250,
      "endMs": 53680,
      "translation": "난 이제 널 사랑하지 않으니까 (워, 워, 워, 워, 워)"
    },
    {
      "startMs": 53680,
      "endMs": 69070,
      "translation": "하지만 이게 우리에게 더 나을 수도 있어, 알지?"
    },
    {
      "startMs": 69070,
      "endMs": 70170,
      "translation": "(난 예전처럼 사랑하지 않으니까)"
    },
    {
      "startMs": 70170,
      "endMs": 72380,
      "translation": "시간이 어디로 갔지, 위치가 필요해"
    },
    {
      "startMs": 72380,
      "endMs": 73270,
      "translation": "(네가 그 얘기를 하고 싶지 않으니까, 베이비)"
    },
    {
      "startMs": 73270,
