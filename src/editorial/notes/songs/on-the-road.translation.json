    {
      "startMs": 142380,
      "endMs": 145940,
      "translation": "처음부터 나랑 함께였던 척 그만해"
    },
    {
      "startMs": 145940,
      "endMs": 147610,
      "translation": "피곤한 것도 이젠 지겨워"
    },
    {
      "startMs": 147610,
      "endMs": 150290,
      "translation": "이게 내 마지막 기회야, 화내지 마, 적어도 난 해 봤어"
    },
    {
      "startMs": 150290,
      "endMs": 153040,
      "translation": "우린 어른이어야 하는데 넌 여전히 애처럼 굴어"
    },
    {
      "startMs": 153040,
      "endMs": 155770,
      "translation": "전용기는 혼자 탈 수 있어, 쓸데없는 짐은 필요 없어"
    },
    {
      "startMs": 155770,
      "endMs": 158550,
      "translation": "올해 난 독해졌어, 목걸이엔 바게트 컷 다이아"
    },
    {
      "startMs": 158550,
      "endMs": 161430,
      "translation": "빠르게 달려도 사고는 안 내, 술은 끊었어야 하는데"
    },
    {
      "startMs": 161430,
      "endMs": 164250,
      "translation": "어쩌다 보니 자꾸 취하게 돼"
    },
    {
      "startMs": 164250,
      "endMs": 167230,
      "translation": "날 꺾으려면 압박 좀으론 안 될 거야"
    },
    {
      "startMs": 167230,
      "endMs": 169700,
      "translation": "할 수 있는 만큼 해 봤지만, 이젠 내 손을 떠났어"
    },
    {
      "startMs": 169700,
      "endMs": 172750,
      "translation": "누구 때문에도, 무엇 때문에도 이 돈을 다 써 버리진 않아"
    },
    {
      "startMs": 172750,
      "endMs": 175460,
      "translation": "그 여자는 내가 개래, 개는 개를 알아보는 법이지"
    },
    {
      "startMs": 175460,
      "endMs": 178490,
      "translation": "죽어라 달려왔어, 혼자였어, 사랑 따윈 필요 없어"
    },
    {
      "startMs": 178490,
