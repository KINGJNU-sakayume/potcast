  "segments": [
    {
      "startMs": 11000,
      "endMs": 14670,
      "translation": "압박에 무너지는 내 모습은 아무도 본 적 없으니까"
    },
    {
      "startMs": 14670,
      "endMs": 17090,
      "translation": "내가 꺾이는 건 절대, 절대 본 적 없어, 아니, 절대"
    },
    {
      "startMs": 17090,
      "endMs": 19910,
      "translation": "난 늘 그놈들보다 한 수 앞서, 너무 영리하거든"
    },
    {
      "startMs": 19910,
      "endMs": 22750,
      "translation": "내 영혼은 절대, 절대 안 팔아, 아니, 절대"
    },
    {
      "startMs": 22750,
      "endMs": 25510,
      "translation": "난 길 위에 있었으니까, 길 위에 있었으니까, 난"
    },
    {
      "startMs": 25510,
      "endMs": 28260,
      "translation": "처음부터 나랑 함께였던 척 그만해"
    },
    {
      "startMs": 28260,
      "endMs": 31020,
      "translation": "난 길 위에 있었으니까, 길 위에 있었으니까, 난"
    },
    {
      "startMs": 31020,
      "endMs": 33840,
      "translation": "처음부터 나랑 함께였던 척 그만해"
    },
    {
      "startMs": 33840,
      "endMs": 35900,
      "translation": "그래, 다들 내가 넘어질 거라는 데 걸지"
    },
    {
      "startMs": 35900,
      "endMs": 38390,
      "translation": "난 고작 스물넷이지만, 이봐, 다 겪어 봤어"
    },
    {
      "startMs": 38390,
      "endMs": 41050,
      "translation": "히트곡이 너무 많아서 다 기억도 못 해"
    },
    {
      "startMs": 41050,
      "endMs": 43960,
      "translation": "볼일 보면서 벽에 걸린 기념패들을 봐"
    },
    {
      "startMs": 43960,
      "endMs": 46130,
      "translation": "너희는 그냥 앉아서 떡고물이나 챙겨"
    },
    {
      "startMs": 46130,
      "endMs": 48930,
      "translation": "네가 한 것처럼 굴지, 존중 따윈 없어"
    },
    {
      "startMs": 48930,
      "endMs": 53080,
      "translation": "인생을 가짜로 사는 놈들한텐, 에이, 에이"
    },
    {
      "startMs": 53080,
      "endMs": 55320,
      "translation": "넌 네가 말하는 그런 사람이 아니야"
    },
    {
      "startMs": 55320,
      "endMs": 58020,
      "translation": "그러니 속도 좀 내, 날 늦출 순 없어"
    },
    {
      "startMs": 58020,
      "endMs": 60730,
      "translation": "내 눈앞에서 꺼져, 전화 좀 그만 할래?"
    },
    {
      "startMs": 60730,
      "endMs": 63820,
      "translation": "내 시간은 비싸거든, 공연 한 번에 백만 달러"
    },
    {
      "startMs": 63820,
      "endMs": 67380,
      "translation": "네가 아침 먹으러 나가기도 전에 새 차를 샀어, 그래"
    },
    {
      "startMs": 67380,
      "endMs": 69920,
      "translation": "압박에 무너지는 내 모습은 아무도 본 적 없으니까"
    },
    {
      "startMs": 69920,
      "endMs": 72750,
      "translation": "내가 꺾이는 건 절대, 절대 본 적 없어, 아니, 절대"
    },
    {
      "startMs": 72750,
      "endMs": 75570,
      "translation": "난 늘 그놈들보다 한 수 앞서, 너무 영리하거든"
    },
    {
      "startMs": 75570,
      "endMs": 78330,
      "translation": "내 영혼은 절대, 절대 안 팔아, 아니, 절대"
    },
    {
