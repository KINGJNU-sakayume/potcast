    },
    {
      "startMs": 97570,
      "endMs": 99240,
      "translation": "이-이제 이게 대체 누구야"
    },
    {
      "startMs": 99240,
      "endMs": 101100,
      "translation": "밤 11시 26분에 이메일을 보내서"
    },
    {
      "startMs": 101100,
