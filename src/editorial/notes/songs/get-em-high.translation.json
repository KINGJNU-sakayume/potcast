    {
      "startMs": 46820,
      "endMs": 49740,
      "translation": "낙제를 시키든 말든 상관없어, 난 따라갈 거야"
    },
    {
      "startMs": 49740,
      "endMs": 52600,
      "translation": "내 마음을, 그리고 차트를 따라가면 상패든 돈다발이든"
    },
    {
      "startMs": 52600,
      "endMs": 54900,
      "translation": "누가 돌아왔는지 맞힐 필요도 없지, 봐"
    },
    {
      "startMs": 54900,
      "endMs": 57010,
      "translation": "난 너무 시카고라서 수줍은 줄 알았겠지만"
    },
    {
      "startMs": 57010,
      "endMs": 59520,
      "translation": "이 녀석의 흐름은 네 머리통을 박살 낼 거야"
    },
    {
      "startMs": 59520,
      "endMs": 62230,
      "translation": "패스터 트로이처럼 네 여자를 가로챌 거고"
    },
    {
      "startMs": 62230,
      "endMs": 65190,
      "translation": "평소엔 안 피우지만 그 대마 좀 넘겨 봐"
    },
    {
      "startMs": 65190,
      "endMs": 67880,
      "translation": "네가 달라는 돈은 안 줄 거야"
    },
    {
      "startMs": 67880,
      "endMs": 70870,
      "translation": "나랑 데임이 왜 잘 맞는 것 같아? 둘 다 재수 없거든"
    },
    {
      "startMs": 70870,
      "endMs": 73550,
      "translation": "그래서 네 음악을 들으면 빨리 감기 해 버려"
    },
    {
      "startMs": 73550,
      "endMs": 76010,
      "translation": "그런 약해 빠진 건 더 듣기 싫으니까"
    },
    {
      "startMs": 76010,
      "endMs": 78840,
