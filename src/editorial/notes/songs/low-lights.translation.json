{
  "schemaVersion": 2,
  "timing": {
    "lrclibId": 574844,
    "durationMs": 132000
  },
  "segments": [
    {
      "startMs": 700,
      "endMs": 7910,
      "translation": "제 삶과 그분이 제게 얼마나 잘해 주셨는지 간증해 달라는 거죠"
    },
    {
      "startMs": 7910,
      "endMs": 10820,
      "translation": "그분에 대해 무슨 말을 해야 할지 모르겠어요"
    },
    {
      "startMs": 10820,
      "endMs": 13830,
      "translation": "마음과 영혼을 다해 그분을 정말 사랑해요"
    },
    {
      "startMs": 13830,
      "endMs": 17390,
      "translation": "온몸의 뼈마디 하나하나로 그분을 정말 사랑해요"
    },
    {
      "startMs": 17390,
      "endMs": 20580,
      "translation": "제게 너무나 많은 일을 해 주셨으니까요"
    },
    {
      "startMs": 20580,
      "endMs": 26250,
      "translation": "매일 아침, 제 삶의 하루하루마다요"
    },
    {
      "startMs": 26250,
      "endMs": 39750,
      "translation": "한밤중에 눈물 흘리는 날이 영원히 이어지지는 않을 거예요. 눈뜰 때마다 혼자서 오늘을 어떻게 버틸지 고민하지 않아도 될 거예요"
    },
    {
      "startMs": 39750,
      "endMs": 52100,
      "translation": "무얼 해야 할지, 어떻게 해낼지, 어떻게 거기까지 갈지 늘 고민하지 않아도 될 거예요. 그분이… 그분이 제 곁에 계실 테니까요"
    },
    {
      "startMs": 52100,
      "endMs": 58660,
      "translation": "언젠가 머리 위 하늘이 열리고, 그분이 손을 뻗어 저를 이끌어 주실 거예요"
    },
    {
      "startMs": 58660,
      "endMs": 60240,
      "translation": "그래요, 반드시 그러실 거예요"
    },
    {
      "startMs": 60240,
      "endMs": 64190,
      "translation": "늘 이렇게 눈물 흘리진 않을 거예요"
    },
    {
      "startMs": 64190,
      "endMs": 67800,
      "translation": "늘 이렇게 우울하진 않을 거예요"
    },
    {
      "startMs": 67800,
      "endMs": 75300,
      "translation": "언젠가 그분이 제게 문을 열어 주시고 제 이름을 부르실 거예요"
    },
    {
      "startMs": 75300,
      "endMs": 79560,
      "translation": "언젠가는 그러실 거예요"
    },
    {
      "startMs": 79560,
      "endMs": 83890,
      "translation": "이게 어떤 기분인지 아는 사람이 있을지 모르겠어요"
    },
    {
      "startMs": 83890,
      "endMs": 94940,
      "translation": "어떤 일을 겪었든, 어디에 있었든, 그분은 늘 두 팔을 활짝 벌리고 계세요"
    },
    {
      "startMs": 94940,
      "endMs": 98810,
      "translation": "있는 그대로의 저를 받아 주시면서요"
    },
    {
      "startMs": 98810,
      "endMs": 102690,
      "translation": "그분을 정말 사랑해요"
    },
    {
      "startMs": 102690,
      "endMs": 107010,
      "translation": "그분 없이는 해낼 수 없어요. 그러고 싶지도 않아요"
    },
    {
      "startMs": 107010,
      "endMs": 110420,
      "translation": "지금 눈물이 나요"
    },
    {
      "startMs": 110420,
      "endMs": 112100,
      "translation": "자유로워지는 건 정말 좋은 기분이에요"
    },
    {
      "startMs": 112100,
      "endMs": 117030,
      "translation": "있는 그대로 받아들여지고, 무슨 일이 있어도 사랑받는다는 건요"
    },
    {
      "startMs": 117030,
      "endMs": 119550,
      "translation": "오, 주님, 감사해요"
    },
    {
      "startMs": 119550,
      "endMs": 120870,
      "translation": "주님은 제 삶의 기쁨이에요"
    }
  ]
}
