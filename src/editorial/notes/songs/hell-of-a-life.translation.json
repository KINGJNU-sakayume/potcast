  "segments": [
    {
      "startMs": 16250,
      "endMs": 19440,
      "translation": "방금 포르노 배우와 사랑에 빠진 것 같아"
    },
    {
      "startMs": 19440,
      "endMs": 21830,
      "translation": "카메라를 켜, 그녀는 타고난 스타야"
    },
    {
      "startMs": 21830,
      "endMs": 24570,
      "translation": "외제차를 타고 모퉁이를 돌아"
    },
    {
      "startMs": 24570,
      "endMs": 27180,
      "translation": "검시관을 불러, 심폐소생술을 해"
    },
    {
      "startMs": 27180,
      "endMs": 29710,
      "translation": "그녀는 그 늙은이에게 위궤양을 안겼지"
    },
    {
      "startMs": 29710,
      "endMs": 32440,
      "translation": "그녀의 달콤씁쓸한 맛에 그의 금니가 시렸어"
    },
    {
      "startMs": 32440,
      "endMs": 35010,
      "translation": "그녀의 무릎이 떨리게, 신부가 기절하게 해"
    },
    {
      "startMs": 35010,
      "endMs": 37680,
      "translation": "수녀마저 무너지게, 그녀가 불태워지게 해"
    },
    {
      "startMs": 37680,
      "endMs": 40360,
      "translation": "시내로 이사해, 근사한 집을 얻어"
    },
    {
      "startMs": 40360,
      "endMs": 43270,
      "translation": "복권에 당첨된 것처럼 살아, 뭐?"
    },
    {
      "startMs": 43270,
      "endMs": 45880,
      "translation": "천국을 위해서라며 지옥으로 향하지"
    },
    {
      "startMs": 45880,
      "endMs": 48540,
      "translation": "그래, 난 공중에 떠올라 악마를 기다리게 할 거야"
    },
    {
      "startMs": 48540,
      "endMs": 50800,
      "translation": "정신 나간 거야?"
    },
    {
      "startMs": 50800,
      "endMs": 53730,
      "translation": "우리가 선을 넘었다고 생각하면 말해 줘"
    },
    {
      "startMs": 53730,
      "endMs": 59010,
      "translation": "난 이제 약은 끊었어, 육체와 종교만 있으면 돼"
    },
    {
      "startMs": 59010,
      "endMs": 81620,
      "translation": "내 손을 잡아, 자기, 우린 끝내주는 인생을 살 거야"
    },
    {
      "startMs": 81620,
      "endMs": 83730,
      "translation": "네가 가장 대담하게 꿈꾼 것보다도"
    },
    {
      "startMs": 83730,
      "endMs": 87140,
      "translation": "네가 가장 대담하게 꿈꾼 것보다도, 가장 대담하게"
    },
    {
      "startMs": 87140,
      "endMs": 88950,
      "translation": "가장 큰 비명이 들려"
    },
    {
      "startMs": 88950,
      "endMs": 92110,
      "translation": "화면 속에서 나오는, 넌 정말 거친 여자야"
    },
    {
      "startMs": 92110,
      "endMs": 94860,
      "translation": "그런 남자가 되려면 내가 뭘 해야 하는지 말해 줘"
    },
    {
      "startMs": 94860,
      "endMs": 97490,
      "translation": "흑인 남자와 해 본 적 있으면 몸값이 떨어진대"
    },
    {
      "startMs": 97490,
      "endMs": 99860,
      "translation": "아니면 다른 짓을 하거나, 여럿이서 하거나"
    },
    {
      "startMs": 99860,
      "endMs": 102800,
      "translation": "그게 다 같은 취급이라니 좀 미친 소리지"
    },
    {
      "startMs": 102800,
      "endMs": 105380,
      "translation": "글쎄, 갱 짓이라면 우리 동네 놈들도 많이 하지"
    },
    {
      "startMs": 105380,
      "endMs": 108250,
      "translation": "줄줄이 엮이면 우린 다 같은 갱이야"
    },
    {
      "startMs": 108250,
      "endMs": 110680,
      "translation": "사슬에 줄줄이 묶인 도망 노예들"
    },
    {
      "startMs": 110680,
      "endMs": 113650,
      "translation": "탕, 탕, 탕, 탕, 탕"
    },
    {
      "startMs": 113650,
      "endMs": 115720,
      "translation": "정신 나간 거야?"
    },
    {
      "startMs": 115720,
