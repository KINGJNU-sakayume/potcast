    },
    {
      "startMs": 89520,
      "endMs": 92390,
      "translation": "여전히 갈 곳이 없어 (갈 곳이 없어)"
    },
    {
      "startMs": 92390,
      "endMs": 93550,
      "translation": "손을 계속 들고 있어 (하늘에 닿을 때까지)"
    },
    {
      "startMs": 93550,
      "endMs": 96190,
      "translation": "허슬러, 허풍쟁이, 좀도둑, 여자들"
    },
    {
      "startMs": 96190,
      "endMs": 97790,
      "translation": "다들, 엿 먹으라 그래"
    },
    {
      "startMs": 97790,
      "endMs": 100720,
      "translation": "여전히 갈 곳이 없어 (갈 곳이 없어)"
    },
    {
      "startMs": 100720,
      "endMs": 103670,
      "translation": "여전히 갈 곳이 없어 (갈 곳이 없어)"
    },
    {
      "startMs": 103670,
      "endMs": 106850,
      "translation": "자, 두 단어, 시카고, 사우스사이드, 전 세계"
    },
    {
      "startMs": 106850,
      "endMs": 109730,
      "translation": "죽을 때까지 난 거길 대표할 거니까"
    },
    {
      "startMs": 109730,
      "endMs": 112590,
      "translation": "목 하나에 체인 둘, 허리 하나에 총 둘"
    },
    {
      "startMs": 112590,
      "endMs": 115330,
      "translation": "벽 하나에 상패 스무 개, 대가는 치렀으니 내놔"
    },
    {
      "startMs": 115330,
      "endMs": 118070,
      "translation": "난 각광, 『블루프린트』, 마이크 다섯 개"
    },
    {
      "startMs": 118070,
      "endMs": 121270,
      "translation": "고 게터스 시절 랩은 두 번은 계약됐어야 했지"
    },
    {
      "startMs": 121270,
      "endMs": 123830,
      "translation": "가장 많이 따라 하는, 그래미 후보"
    },
    {
      "startMs": 123830,
      "endMs": 126600,
      "translation": "호텔 숙박 제공, 치어리더, 프롬 파트너"
    },
    {
      "startMs": 126600,
      "endMs": 129470,
      "translation": "이발소에선 시기받고, 동네 가게에선 해적판"
    },
    {
      "startMs": 129470,
      "endMs": 131980,
      "translation": "지붕이 무너질 때까지 비가 오는 것 같았어"
    },
    {
      "startMs": 131980,
      "endMs": 134880,
      "translation": "두 단어, 시카고가 날 키웠어, 미쳤지"
    },
    {
      "startMs": 134880,
      "endMs": 138430,
      "translation": "그래서 난 두 단어로 살아, \"돈이나 내놔\""
    },
    {
      "startMs": 138430,
      "endMs": 140730,
      "translation": "그리고 외쳐, \"예수님, 살려 주세요\""
    },
    {
      "startMs": 140730,
      "endMs": 143750,
      "translation": "게임이 어떤지 알잖아, 저들이 날 바꾸게 둘 순 없어"
    },
    {
      "startMs": 143750,
      "endMs": 147470,
      "translation": "심판의 날에 넌 나를 탓할 테니까"
    },
    {
      "startMs": 147470,
      "endMs": 148850,
      "translation": "보세요, 하나님, 똑같은 저예요"
    },
    {
      "startMs": 148850,
      "endMs": 152130,
      "translation": "이제 기본적으로 알아, 우린 인종 때문에 표적이 된다는 걸 (손을 높이 들어)"
    },
    {
      "startMs": 152130,
      "endMs": 155190,
      "translation": "수갑 차고 물대포 맞고, 포주처럼 꾸미고 창녀처럼 끌려다니고"
    },
    {
      "startMs": 155190,
      "endMs": 157380,
      "translation": "게다가 난 도시 하나를 지켜야 해"
    },
    {
      "startMs": 157380,
      "endMs": 160020,
      "translation": "바닥에서 왔으니 이제 갈 곳은 꼭대기뿐이야"
    },
    {
      "startMs": 160020,
      "endMs": 160960,
      "translation": "자, 손을 들어 (손을 높이 들어)"
    },
    {
      "startMs": 160960,
      "endMs": 163870,
      "translation": "허슬러, 허풍쟁이, 좀도둑, 여자들"
    },
    {
      "startMs": 163870,
      "endMs": 165470,
      "translation": "다들, 엿 먹으라 그래"
    },
    {
      "startMs": 165470,
      "endMs": 168450,
      "translation": "여전히 갈 곳이 없어 (갈 곳이 없어)"
    },
    {
      "startMs": 168450,
      "endMs": 171630,
      "translation": "여전히 갈 곳이 없어 (갈 곳이 없어)"
    },
    {
      "startMs": 171630,
      "endMs": 174560,
      "translation": "두 단어, 프리웨이, 두 글자, A-R"
    },
    {
      "startMs": 174560,
      "endMs": 177680,
      "translation": "너희 래퍼들을 두 단어로 만들어 주지, 빠른 도망자"
    },
    {
      "startMs": 177680,
      "endMs": 180310,
      "translation": "재키 조이너처럼, 총을 끌어안고 자는 게 좋을 거야"
    },
    {
      "startMs": 180310,
      "endMs": 183660,
      "translation": "총알이 튀고, 네 차 사이로 화환이 날아가, 세상에"
    },
    {
      "startMs": 183660,
      "endMs": 185860,
      "translation": "두 단어, 총 없이, 팔을 부러뜨려"
    },
    {
      "startMs": 185860,
      "endMs": 188390,
      "translation": "목을 부러뜨리고, 등을 부러뜨려, 스티븐 시걸처럼"
    },
    {
      "startMs": 188390,
      "endMs": 191210,
      "translation": "프리, 젊은 보스, 로커펠라의 신입생"
    },
    {
      "startMs": 191210,
      "endMs": 194510,
      "translation": "냄비에 소고기가 끓으면 제이가 싸움개들을 보내지"
    },
    {
      "startMs": 194510,
      "endMs": 196690,
      "translation": "네 패거리는 잊어, 혼자 살아남는 게 좋을 거야"
    },
    {
      "startMs": 196690,
      "endMs": 199990,
      "translation": "네 단어를 외치게 해 줄게, \"경찰을 불러 줘\", 어"
    },
    {
      "startMs": 199990,
      "endMs": 203080,
      "translation": "두 단어, 프리웨이, 살짝 돌았지"
    },
    {
      "startMs": 203080,
      "endMs": 205570,
      "translation": "까불면 네 래퍼한테 탄창을 비우고 그 여자를 데려갈 거야"
    },
    {
      "startMs": 205570,
      "endMs": 208280,
      "translation": "빨강, 하양, 파랑, 검정 (손을 들어)"
    },
    {
      "startMs": 208280,
      "endMs": 211040,
      "translation": "진정해, 물러서 (손을 들어)"
    },
    {
      "startMs": 211040,
      "endMs": 213880,
      "translation": "다들 묻지, \"저게 누구야?\" (손을 들어)"
    },
    {
      "startMs": 213880,
      "endMs": 216670,
      "translation": "전능하신 블랙 잭인 거 알잖아 (손을 들어)"
    },
    {
      "startMs": 216670,
      "endMs": 219470,
      "translation": "모스 데프, K 웨스트 (손을 들어)"
    },
    {
      "startMs": 219470,
      "endMs": 222230,
      "translation": "게토 사람들, 가슴에 맺힌 걸 털어놔 (손을 들어)"
    },
    {
      "startMs": 222230,
      "endMs": 225060,
      "translation": "북에서 남으로, 동에서 서로 (손을 들어)"
    },
    {
      "startMs": 225060,
      "endMs": 229860,
      "translation": "블랙 잭 존슨, 상대가 안 되지 (손을 들어)"
    },
    {
      "startMs": 229860,
      "endMs": 266000,
      "translation": "그리고 그들에게 보여 줘, 이렇게"
    }
  ]
}
