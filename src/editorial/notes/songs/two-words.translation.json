    {
      "startMs": 14060,
      "endMs": 16290,
      "translation": "우린 거리에 있어, 친구, 잘 들어"
    },
    {
      "startMs": 16290,
      "endMs": 18840,
      "translation": "결국 가는 곳은 둘뿐이야, 죽거나 감옥이거나"
    },
    {
      "startMs": 18840,
      "endMs": 21670,
      "translation": "여전히 갈 곳이 없어 (갈 곳이 없어)"
    },
    {
      "startMs": 21670,
      "endMs": 24640,
      "translation": "여전히 갈 곳이 없어 (갈 곳이 없어)"
    },
    {
      "startMs": 24640,
      "endMs": 25710,
      "translation": "자, 손을 들어"
    },
    {
      "startMs": 25710,
      "endMs": 28670,
      "translation": "허슬러, 허풍쟁이, 좀도둑, 여자들"
    },
    {
      "startMs": 28670,
      "endMs": 30040,
      "translation": "다들, 엿 먹으라 그래"
    },
    {
      "startMs": 30040,
      "endMs": 33100,
      "translation": "여전히 갈 곳이 없어 (갈 곳이 없어)"
    },
    {
      "startMs": 33100,
      "endMs": 35260,
      "translation": "여전히 갈 곳이 없어 (갈 곳이 없어)"
    },
    {
      "startMs": 35260,
      "endMs": 36490,
      "translation": "(들어 봐)"
    },
    {
      "startMs": 36490,
      "endMs": 39190,
      "translation": "두 단어, 미합중국, 사랑 없음, 쉴 틈 없음"
    },
    {
      "startMs": 39190,
      "endMs": 41980,
      "translation": "낮은 수준, 높은 판돈, 크랙 연기, 흑인들"
    },
    {
      "startMs": 41980,
      "endMs": 44770,
      "translation": "빅맥, 뚱뚱한 사람들, 엑스터시 캡슐"
    },
    {
      "startMs": 44770,
      "endMs": 47440,
      "translation": "대통령 스캔들, 모두 움직여"
    },
    {
      "startMs": 47440,
      "endMs": 50430,
      "translation": "두 단어, 모스 데프, K 웨스트, 뜨거운 것"
    },
    {
      "startMs": 50430,
      "endMs": 53170,
      "translation": "진정해, 물러서, 게토 사람들이 맡았어"
    },
    {
      "startMs": 53170,
      "endMs": 56080,
      "translation": "게임 장악, 총은 장전"
    },
    {
      "startMs": 56080,
      "endMs": 58750,
      "translation": "우린 안 멈춰, 모두 움직여"
    },
    {
      "startMs": 58750,
      "endMs": 61610,
      "translation": "두 단어, 브루클린, 뉴욕, 베드스타이"
    },
    {
      "startMs": 61610,
      "endMs": 64550,
      "translation": "너무 거칠고, 너무 배고프고, 너무 많아, 그래서야"
    },
    {
      "startMs": 64550,
      "endMs": 67460,
      "translation": "이 거리는 게임을 알아, 놀 줄도 모르고, 장난도 안 쳐"
    },
    {
      "startMs": 67460,
      "endMs": 69910,
      "translation": "꽉 막힌 길, 차선 하나, 모두 움직여"
    },
    {
      "startMs": 69910,
      "endMs": 73000,
      "translation": "두 단어, 모스 데프, 블랙 잭, 뜨거운 것"
    },
    {
      "startMs": 73000,
      "endMs": 75710,
      "translation": "진정해, 물러서, 게토 사람들이 맡았어"
    },
    {
      "startMs": 75710,
      "endMs": 78740,
      "translation": "게임 장악, 총은 장전"
    },
    {
      "startMs": 78740,
