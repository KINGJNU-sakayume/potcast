  "segments": [
    {
      "startMs": 17890,
      "endMs": 22360,
      "translation": "6월 1일, 오늘도 답장은 없어요"
    },
    {
      "startMs": 22360,
      "endMs": 26920,
      "translation": "접시에 올려 둔 동결건조식품은 여전히 그대로예요"
    },
    {
      "startMs": 26920,
      "endMs": 31470,
      "translation": "세제 향이 나고, 정오를 알리는 사이렌이 울려요"
    },
    {
      "startMs": 31470,
      "endMs": 36320,
      "translation": "치울 수 없는 유리의 바다예요"
    },
    {
      "startMs": 36320,
      "endMs": 38960,
      "translation": "루루루루루루루 노래할 수 있어요"
    },
    {
      "startMs": 38960,
      "endMs": 45300,
      "translation": "집안일도 아이 돌보기도 계산도 상담도 맡아 드려요"
    },
    {
      "startMs": 45300,
      "endMs": 47970,
      "translation": "루루루루루루루 웃을 수 있어요"
    },
    {
      "startMs": 47970,
      "endMs": 55330,
      "translation": "당신이 바라는 대로, 지금 당장이라도요"
    },
    {
      "startMs": 55330,
      "endMs": 59760,
      "translation": "있잖아요, 왜 같이 놀 수 없어요?"
    },
    {
      "startMs": 59760,
      "endMs": 64260,
      "translation": "언젠가처럼 악수해요"
    },
    {
      "startMs": 64260,
      "endMs": 67710,
      "translation": "제 손이 차가워서 그래요?"
    },
    {
      "startMs": 67710,
      "endMs": 75290,
      "translation": "그럼 따뜻하게 해 줄게요, 아직 곁에 있어 줘요"
    },
    {
      "startMs": 75290,
      "endMs": 86830,
      "translation": "해가 질 때까지 꽃을 따요"
    },
    {
      "startMs": 86830,
      "endMs": 91620,
      "translation": "그 공원은 이미 불타 버렸지만요"
    },
    {
      "startMs": 91620,
      "endMs": 95970,
      "translation": "도중에 부서진 스토리라이터"
    },
    {
      "startMs": 95970,
      "endMs": 100420,
      "translation": "맡은 역할 없는 맨발의 언더테이커"
    },
    {
      "startMs": 100420,
      "endMs": 103630,
      "translation": "다들 어디로 갔어요 (갔어요)"
    },
    {
      "startMs": 103630,
      "endMs": 109840,
      "translation": "여기는 이제 텅 비었어요"
    },
    {
      "startMs": 109840,
      "endMs": 114030,
      "translation": "의자를 치켜들고 외치던 애지테이터"
    },
    {
      "startMs": 114030,
      "endMs": 118390,
      "translation": "아무래도 제 아빠는 바디 스내처인가 봐요"
    },
    {
      "startMs": 118390,
      "endMs": 126890,
      "translation": "다들 사라졌어요 (졌어요)"
    },
    {
      "startMs": 126890,
      "endMs": 129590,
      "translation": "루루루루루루루 노래할 수 있어요"
    },
    {
      "startMs": 129590,
      "endMs": 135860,
      "translation": "화기도 칼날도 원하신다면 다룰 수 있어요"
    },
    {
      "startMs": 135860,
      "endMs": 138760,
      "translation": "루루루루루루루 웃을 수 있어요"
    },
    {
      "startMs": 138760,
      "endMs": 145130,
      "translation": "당신이 생각하는 것 이상으로 대단하죠?"
    },
    {
      "startMs": 145130,
      "endMs": 154150,
      "translation": "라라라라 라라라 라라라라라라라"
    },
    {
      "startMs": 154150,
      "endMs": 163840,
      "translation": "라라라라 라라라 라라라라라라라"
    },
    {
      "startMs": 163840,
      "endMs": 168420,
      "translation": "있잖아요, 왜 무서워하는 거예요?"
    },
    {
      "startMs": 168420,
      "endMs": 172970,
      "translation": "한 번 더 이야기해 줘요"
    },
    {
      "startMs": 172970,
      "endMs": 176480,
      "translation": "제 손은 차가워요"
    },
    {
      "startMs": 176480,
      "endMs": 184000,
      "translation": "그래도 여기까지 왔어요, 머리를 쓰다듬어 줘요"
    },
    {
      "startMs": 184000,
      "endMs": 195540,
      "translation": "해가 뜰 때까지 그림책을 읽어 줘요"
    },
    {
      "startMs": 195540,
      "endMs": 217000,
      "translation": "그 집은 이미 무너져 버렸지만요"
    },
    {
      "startMs": 217000,
      "endMs": 221670,
      "translation": "6월 1일, 오늘도 답장은 없어요"
    },
    {
      "startMs": 221670,
      "endMs": 226260,
      "translation": "접시에 올려 둔 동결건조식품은 여전히 그대로예요"
    },
    {
      "startMs": 226260,
      "endMs": 230570,
      "translation": "세제 향이 나고, 정오를 알리는 사이렌이 울려요"
    },
    {
      "startMs": 230570,
      "endMs": 244773,
      "translation": "치울 수 없는 유리의 바다예요"
    }
  ]
