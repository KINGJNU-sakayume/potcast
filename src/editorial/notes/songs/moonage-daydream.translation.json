    {
      "startMs": 15080,
      "endMs": 18140,
      "translation": "입 다물어"
    },
    {
      "startMs": 18140,
      "endMs": 21590,
      "translation": "분홍 원숭이 새처럼 꽥꽥대잖아"
    },
    {
      "startMs": 21590,
      "endMs": 30720,
      "translation": "난 그 말을 찾느라 머리를 터뜨리고 있어"
    },
    {
      "startMs": 30720,
      "endMs": 37340,
      "translation": "전기 눈으로 계속 나를 봐, 자기야"
    },
    {
      "startMs": 37340,
      "endMs": 44380,
      "translation": "광선총을 내 머리에 겨눠"
    },
    {
      "startMs": 44380,
      "endMs": 51150,
      "translation": "그 우주 같은 얼굴을 내 얼굴에 바짝 대, 사랑아"
    },
    {
      "startMs": 51150,
      "endMs": 57830,
      "translation": "문에이지 백일몽 속에서 미쳐 봐, 오 예!"
    },
    {
      "startMs": 57830,
      "endMs": 65430,
      "translation": "가짜로 굴지 마, 자기야, 진짜를 내게 보여 줘"
    },
    {
      "startMs": 65430,
      "endMs": 68580,
      "translation": "인간의 교회는, 사랑아"
    },
    {
      "startMs": 68580,
      "endMs": 72060,
      "translation": "있기에 정말 성스러운 곳이야"
    },
    {
      "startMs": 72060,
      "endMs": 78550,
      "translation": "나를 만들어 줘, 자기야, 네가 정말 신경 쓴다는 걸 알게 해 줘"
    },
