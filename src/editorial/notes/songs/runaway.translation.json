    },
    {
      "startMs": 238120,
      "endMs": 241570,
      "translation": "탓할 수도 없지, 베르사체 소파는 본 적도 없을 테니"
    },
    {
      "startMs": 241570,
      "endMs": 245530,
      "translation": "가방 하나, 블라우스 하나, 팔찌 하나마다"
    },
    {
      "startMs": 245530,
      "endMs": 246490,
      "translation": "다 가격표가 붙어 있어, 자기, 받아들여"
    },
    {
      "startMs": 246490,
      "endMs": 249620,
      "translation": "이런 기본도 못 받아들이겠으면 떠나"
    },
    {
      "startMs": 249620,
      "endMs": 253340,
      "translation": "잘나가는 놈들 세계엔 여자가 널렸으니까"
    },
    {
      "startMs": 253340,
      "endMs": 255220,
      "translation": "보이지 않게 박힌 보석, 롤렉스는 얼굴이 없지"
    },
    {
      "startMs": 255220,
      "endMs": 257920,
      "translation": "난 그냥 젊고, 돈 많고, 천박해, 피"
    },
    {
      "startMs": 257920,
      "endMs": 261260,
      "translation": "난 원래 로맨틱한 사람이 아니었어"
