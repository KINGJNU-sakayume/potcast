  "segments": [
    {
      "startMs": 70,
      "endMs": 2650,
      "translation": "네 새 핫콤이 빙글빙글 돌아가 (가)"
    },
    {
      "startMs": 2650,
      "endMs": 5100,
      "translation": "네 새 블로우아웃이 빙글빙글 돌아가 (이리 줘)"
    },
    {
      "startMs": 5100,
      "endMs": 7330,
      "translation": "삼육십 웨이브가 빙글빙글 돌아가 (가)"
    },
    {
      "startMs": 7330,
      "endMs": 10140,
      "translation": "기름이 쌓여 가, 빙글빙글 돌아가"
    },
    {
      "startMs": 10140,
      "endMs": 12260,
      "translation": "나는 일해야 하고, 먹어야 해."
    },
    {
      "startMs": 12260,
      "endMs": 13990,
      "translation": "사람들이 네가 내 위에 올라앉은 걸 보면 (저리)"
    },
    {
      "startMs": 13990,
      "endMs": 15580,
      "translation": "난 떠나야 해, 씨발, 내가 널 죽였어."
    },
    {
      "startMs": 15580,
      "endMs": 17200,
      "translation": "타고난 네 모습은 위협적이었어."
    },
    {
      "startMs": 17200,
      "endMs": 19190,
      "translation": "내가 나 자신을 겨눌 지경까지 (저리)"
    },
    {
      "startMs": 19190,
      "endMs": 20560,
      "translation": "자존감을 앞세워서, 씨발, 내가 널 죽였어."
    },
    {
      "startMs": 20560,
      "endMs": 22840,
      "translation": "알아낼 길은 없었고, 매듭 몇 개가 지도였어."
    },
    {
      "startMs": 22840,
      "endMs": 23990,
      "translation": "우린 그 길에서 도망치는 중이었어 (저리)"
    },
    {
      "startMs": 23990,
      "endMs": 25390,
      "translation": "두피 바로 위에서, 씨발, 내가 널 죽였어."
    },
    {
      "startMs": 25390,
      "endMs": 27030,
      "translation": "널 치워 버려, 장난이 아니야 (저리, 저리)"
    },
    {
      "startMs": 27030,
      "endMs": 28800,
      "translation": "수치심에 차서 널 곧게 폈지 (저-저-저리, 저리)"
    },
    {
      "startMs": 28800,
      "endMs": 30460,
      "translation": "두말할 것도 없이, 씨발, 내가 널 죽였어."
    },
    {
      "startMs": 30460,
      "endMs": 31790,
      "translation": "넌 정말 필수적이었어."
    },
    {
      "startMs": 31790,
      "endMs": 32870,
      "translation": "우리가 널 어떻게 피크 빗으로 빗었는지,"
    },
    {
      "startMs": 32870,
      "endMs": 34190,
      "translation": "넌 단순했으니까 (저리)"
    },
    {
      "startMs": 34190,
      "endMs": 36650,
      "translation": "열매와 오일이면 됐어, 네 본성은 그렇게 단순했어."
    },
    {
      "startMs": 36650,
      "endMs": 39110,
      "translation": "그런데 코일과 꼬불거림이 문제가 됐나 봐 (저리)"
    },
    {
      "startMs": 39110,
      "endMs": 40510,
      "translation": "그래서, 씨발, 내가 널 죽였어."
    },
    {
      "startMs": 40510,
      "endMs": 42690,
      "translation": "제리컬과 미미들로 널 태우고 널 잘랐어."
    },
    {
      "startMs": 42690,
      "endMs": 44010,
      "translation": "약품을 잔뜩 먹였어 (저리)"
    },
    {
      "startMs": 44010,
      "endMs": 45220,
      "translation": "억지로 재발하게 만들었어."
    },
    {
      "startMs": 45220,
      "endMs": 46600,
      "translation": "넌 풍성했고 아름다웠는데 (빙글빙글)"
    },
    {
      "startMs": 46600,
      "endMs": 47430,
      "translation": "열기를 견디지 못했지 (저리)"
    },
    {
      "startMs": 47430,
      "endMs": 48950,
      "translation": "그래서 사람들이 날 볼 때쯤 넌 사라지는 거야 (저-저-저리, 저리)"
    },
    {
      "startMs": 48950,
      "endMs": 50100,
      "translation": "이제 너, 씨발, 내가 널 죽였어."
    },
    {
      "startMs": 50100,
      "endMs": 52120,
      "translation": "이모들, 할머니들, 누이들, 엄마들,"
    },
    {
      "startMs": 52120,
      "endMs": 54020,
      "translation": "피부색이 더 짙은 여자들은 의식하게 돼 (저리)"
    },
    {
      "startMs": 54020,
      "endMs": 55350,
      "translation": "널 잡았어, 씨발, 내가 널 죽였어."
    },
    {
      "startMs": 55350,
      "endMs": 57420,
      "translation": "삼촌들, 아빠들, 형제들, 아들들은 1번 날로 밀리고 (저리)"
    },
    {
      "startMs": 57420,
      "endMs": 59960,
      "translation": "이 짓은 일찍 시작됐어, 씨발, 내가 널 죽였어."
    },
    {
      "startMs": 59960,
      "endMs": 62300,
      "translation": "머릿속이 갇혀서 네가 숨 쉬는 게 보이지 않았어."
    },
    {
      "startMs": 62300,
      "endMs": 63690,
      "translation": "잘라야 한다고 생각했지 (저리)"
    },
    {
      "startMs": 63690,
      "endMs": 64850,
      "translation": "그게 날 망쳐 놨어, 씨발, 내가 널 죽였어."
    },
    {
      "startMs": 64850,
      "endMs": 66380,
      "translation": "우리한텐 이점이 없어 (저리, 저리)"
    },
    {
      "startMs": 66380,
      "endMs": 67590,
      "translation": "우린 에너지가 안 맞아,"
    },
    {
      "startMs": 67590,
      "endMs": 70150,
      "translation": "그래서 피해가 났고, 아, 널 죽이기까지 갔어 (저-저-저리, 저리)"
    },
    {
      "startMs": 70150,
      "endMs": 71640,
      "translation": "나는 일해야 하고, 먹어야 해."
    },
    {
      "startMs": 71640,
      "endMs": 73350,
      "translation": "사람들이 네가 내 위에 올라앉은 걸 보면 (저리)"
    },
    {
      "startMs": 73350,
      "endMs": 74950,
      "translation": "그럼 내가 그 꼴이 되는 거야, 씨발, 내가 널 죽였어."
    },
    {
      "startMs": 74950,
      "endMs": 75940,
      "translation": "넌 내 왕관이었어 (빙글빙글)"
    },
    {
      "startMs": 75940,
      "endMs": 77280,
      "translation": "기름기 없이도 정말 좋았는데,"
    },
    {
      "startMs": 77280,
      "endMs": 78350,
      "translation": "걔네 머릿속엔 꼬불거림이 있지 (저리)"
    },
    {
      "startMs": 78350,
      "endMs": 79910,
      "translation": "걔네는 편치 않아, 씨발, 내가 널 죽였어."
    },
    {
      "startMs": 79910,
      "endMs": 82570,
      "translation": "중력을 거스르는, 이게 그 원소야."
    },
    {
      "startMs": 82570,
      "endMs": 84920,
      "translation": "오, 넌 연약하지, 그래서 섬세하고."
    },
    {
      "startMs": 84920,
      "endMs": 87220,
      "translation": "넌 방 안의 아가고, 걔네가 씨발 그 방 안의 코끼리야 (저리, 저리)"
    },
    {
      "startMs": 87220,
      "endMs": 89540,
      "translation": "내 뿌리 얘기를 하지만, 그건 절대 죽일 수 없어."
    },
    {
      "startMs": 89540,
      "endMs": 93960,
      "translation": "가, 저리"
    },
    {
      "startMs": 93960,
      "endMs": 95770,
      "translation": "이리 줘"
    },
    {
      "startMs": 95770,
      "endMs": 97390,
      "translation": "가, 가"
    },
    {
      "startMs": 97390,
      "endMs": 99880,
      "translation": "그 머리 빗어 (저리), 가, 이리 줘"
    },
    {
      "startMs": 99880,
      "endMs": 104320,
      "translation": "그 짓 그만둬, 씨발 (저리), 이리 줘"
    },
    {
      "startMs": 104320,
      "endMs": 109220,
      "translation": "오, 그래 (저리), 그래, 이리 줘"
    },
    {
      "startMs": 109220,
      "endMs": 111380,
      "translation": "불리한 확률에 갇혀 있어 (걔네 어디 있어?)"
    },
    {
      "startMs": 111380,
      "endMs": 113680,
      "translation": "3형과 4형 (걔네 어디 있어?)"
    },
    {
      "startMs": 113680,
      "endMs": 116000,
      "translation": "엿 먹어, 내려와, 이건 내 왕관이야 (걔네 어디 있어?)"
    },
    {
      "startMs": 116000,
      "endMs": 119600,
      "translation": "네 저택의 왕이 되라고 (걔네 어디 있어?)"
    },
    {
      "startMs": 119600,
      "endMs": 123060,
      "translation": "똑같이 아름다워 (저리)"
    },
    {
      "startMs": 123060,
      "endMs": 128230,
      "translation": "똑같이 아름다워"
    },
    {
      "startMs": 128230,
      "endMs": 133360,
      "translation": "똑같이 아름다워 (저리)"
    },
    {
      "startMs": 133360,
      "endMs": 138020,
      "translation": "똑같이 아름다워 (저리)"
    },
    {
      "startMs": 138020,
      "endMs": 140650,
      "translation": "똑같이 아름다워"
    },
    {
      "startMs": 140650,
      "endMs": 145050,
      "translation": "오, 아, 그래, 그래, 그래 (저리)"
    },
    {
      "startMs": 145050,
      "endMs": 147990,
      "translation": "저리, 저리, 저-저-저리, 저리"
    },
    {
      "startMs": 147990,
      "endMs": 150270,
      "translation": "똑같이 아름다워"
    },
    {
      "startMs": 150270,
      "endMs": 153860,
      "translation": "우우"
    },
    {
      "startMs": 153860,
      "endMs": 157470,
      "translation": "우우"
    },
    {
      "startMs": 157470,
      "endMs": 162260,
      "translation": "둠, 둠, 둠, 둠"
    },
    {
      "startMs": 162260,
      "endMs": 168000,
      "translation": "둠, 둠, 둠, 둠, 둠"
    }
  ]
}
