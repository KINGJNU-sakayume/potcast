  "segments": [
    {
      "startMs": 15560,
      "endMs": 19720,
      "translation": "배짱 한번 좋네, 그렇지, 자기야?"
    },
    {
      "startMs": 19720,
      "endMs": 23490,
      "translation": "내가 연석을 들이받은 건 너 때문이야"
    },
    {
      "startMs": 23490,
      "endMs": 27330,
      "translation": "넌 친구들한테 내가 미쳤다고 떠들고 다녀"
    },
    {
      "startMs": 27330,
      "endMs": 31250,
      "translation": "나 혼자만 그런 것처럼"
    },
    {
      "startMs": 31250,
      "endMs": 34840,
      "translation": "왜 돌을 던졌어"
    },
    {
      "startMs": 34840,
      "endMs": 38380,
      "translation": "너도 한두 번은 미친 짓을 했으면서?"
    },
    {
      "startMs": 38380,
      "endMs": 42430,
      "translation": "전망 좋은 커다란 유리 집에 살면서"
    },
    {
      "startMs": 42430,
      "endMs": 44520,
      "translation": "넌 알 줄 알았는데"
    },
    {
      "startMs": 44520,
      "endMs": 46140,
      "translation": "내가 도움을 좀 받았거든"
    },
    {
      "startMs": 46140,
      "endMs": 49700,
      "translation": "이런 난장판을 나 혼자 만들 수 있는 건 아니잖아"
    },
    {
      "startMs": 49700,
      "endMs": 53580,
      "translation": "선반에서 그 술병 꺼내는 거 안 도와준 척하지 마"
    },
    {
      "startMs": 53580,
      "endMs": 57170,
      "translation": "눈치 못 챘다면, 주말마다 푹 빠져 있었어"
    },
    {
      "startMs": 57170,
      "endMs": 59420,
      "translation": "'팀워크가 꿈을 이룬다'잖아"
    },
    {
      "startMs": 59420,
      "endMs": 64240,
      "translation": "젠장, 난 도움을 좀 받았어 (도움)"
    },
    {
      "startMs": 64240,
      "endMs": 68120,
      "translation": "(도움)"
    },
    {
      "startMs": 68120,
      "endMs": 72120,
      "translation": "우리가 무너진 걸 내가 다 뒤집어쓸 줄 알았지"
    },
    {
      "startMs": 72120,
      "endMs": 75800,
      "translation": "넌 아무 죄도 없는 것처럼 돌아다녀"
    },
    {
      "startMs": 75800,
      "endMs": 79610,
      "translation": "네가 벌이던 게임은 이미 졌어"
    },
    {
      "startMs": 79610,
      "endMs": 83030,
      "translation": "이제 너한테 돌아오나 보네, 응"
    },
    {
      "startMs": 83030,
      "endMs": 87070,
      "translation": "넌 네가 그렇게 순진한 줄 알지"
    },
    {
      "startMs": 87070,
      "endMs": 90950,
      "translation": "그 온갖 짓을 다 해 놓고"
    },
    {
      "startMs": 90950,
      "endMs": 94620,
      "translation": "난 천사가 아니고, 넌 하늘이 보낸 사람이 아니야"
    },
    {
      "startMs": 94620,
      "endMs": 97220,
      "translation": "우리 둘 다 손을 털 수는 없어"
    },
    {
      "startMs": 97220,
      "endMs": 98680,
      "translation": "내가 도움을 좀 받았거든"
    },
    {
      "startMs": 98680,
      "endMs": 102390,
      "translation": "이런 난장판을 나 혼자 만들 수 있는 건 아니잖아"
    },
    {
      "startMs": 102390,
      "endMs": 106010,
      "translation": "선반에서 그 술병 꺼내는 거 안 도와준 척하지 마"
    },
    {
      "startMs": 106010,
      "endMs": 109730,
      "translation": "눈치 못 챘다면, 주말마다 푹 빠져 있었어"
    },
    {
      "startMs": 109730,
      "endMs": 111860,
      "translation": "'팀워크가 꿈을 이룬다'잖아"
    },
    {
      "startMs": 111860,
      "endMs": 116570,
      "translation": "젠장, 난 도움을 좀 받았어 (도움)"
    },
    {
