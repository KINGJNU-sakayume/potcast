    {
      "startMs": 36350,
      "endMs": 37960,
      "translation": "크로마코—"
    },
    {
      "startMs": 37960,
      "endMs": 41110,
      "translation": "진정하고 가만히 앉아 있어, 바퀴 하나당 100만이야."
    },
    {
      "startMs": 41110,
      "endMs": 44480,
      "translation": "톱 텐이 뭐 대수라고, 그놈은 그걸 씨발 어떻게 해낸 거야?"
    },
    {
      "startMs": 44480,
      "endMs": 47490,
      "translation": "내가 씨발 뭘로 보여? 그놈 앞길에서 씨발 꺼져."
    },
    {
      "startMs": 47490,
      "endMs": 50610,
      "translation": "호손이 내 고향이야, 그놈이 사는 건 다른 행성이지."
    },
    {
      "startMs": 50610,
      "endMs": 53800,
      "translation": "새 포드는 현금으로 사, 열아홉부터 돈이 있었어."
    },
    {
      "startMs": 53800,
      "endMs": 57020,
      "translation": "나는 짤랑 소리를 내며 튀어나왔어, 아무래도 난 씨발 돈에 중독됐나 봐."
    },
    {
      "startMs": 57020,
      "endMs": 60190,
      "translation": "이 씨발 판에서 진짜 잘나가, 이 판에서 내가 제일 독해."
    },
    {
      "startMs": 60190,
      "endMs": 63360,
      "translation": "짖는 소리 따윈 좆도 신경 안 써, 난 이 판에서 개들을 쫓아내고 있어."
    },
    {
      "startMs": 63360,
      "endMs": 66120,
      "translation": "엘 세군도는 콜로세움 같았어."
    },
    {
      "startMs": 66120,
      "endMs": 69330,
      "translation": "P가 너도 할 수 있다고 했고, 맙소사, 난 그 말을 믿었지."
    },
    {
      "startMs": 69330,
      "endMs": 72250,
      "translation": "그 사람이 한 말 덕에 자유로 가는 길을 닦았어."
    },
    {
      "startMs": 72250,
      "endMs": 76100,
      "translation": "'전통 따위 좆도 신경 쓰지 마, 죽은 사람들 감동시키려 애쓰지 마.'"
    },
    {
      "startMs": 76100,
      "endMs": 78810,
      "translation": "빠져나갈 거야, 약속해, 반드시 빠져나갈 거야."
    },
    {
      "startMs": 78810,
      "endMs": 82240,
      "translation": "엄마, 나 빠져나갈 거야, 좆밥아, 나는 빠져나갈 거야."
    },
    {
      "startMs": 82240,
      "endMs": 84400,
      "translation": "내 안엔 한 번도 의심이 없었어."
    },
    {
      "startMs": 84400,
      "endMs": 87240,
      "translation": "있었다고 말한 적이 있다면 그건 씨발 거짓말이야."
    },
    {
      "startMs": 87240,
      "endMs": 90420,
      "translation": "빛이 느껴져? 네 안에서?"
    },
    {
      "startMs": 90420,
      "endMs": 94870,
      "translation": "그 불이 느껴져? (느껴져? 느껴져? 오)"
    },
    {
      "startMs": 94870,
      "endMs": 100010,
      "translation": "오, 불이야 (느껴져? 느껴져? 우, 오, 불이야)"
    },
    {
      "startMs": 100010,
      "endMs": 103230,
      "translation": "네 안의 빛이 느껴져?"
    },
    {
      "startMs": 103230,
      "endMs": 107520,
      "translation": "그 불이 느껴져? (느껴져?)"
    },
    {
      "startMs": 107520,
      "endMs": 117630,
      "translation": "오, 불, 불, 불 (우)"
    },
    {
      "startMs": 117630,
