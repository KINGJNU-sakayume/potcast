      "endMs": 79640,
      "translation": "젠장, 저 찌질이들 엿이나 먹으라지. 걔들은 아무것도 원하지 않아."
    },
    {
      "startMs": 79640,
      "endMs": 81200,
      "translation": "저 찌질이들 엿이나 먹으라지, 원하는 것도 없는 것들."
    },
    {
      "startMs": 81200,
      "endMs": 83490,
      "translation": "저 새끼들 엿이나 먹으라지."
    },
    {
      "startMs": 83490,
      "endMs": 84910,
      "translation": "저 새끼들 엿이나 먹으라지, 원하는 것도 없는 것들."
    },
    {
      "startMs": 84910,
      "endMs": 87390,
      "translation": "저 새끼들 엿이나 먹으라지."
    },
    {
      "startMs": 87390,
      "endMs": 88840,
      "translation": "너희 새끼들도 엿이나 먹어."
    },
    {
      "startMs": 88840,
      "endMs": 95670,
      "translation": "내가 너희를 깎아내리려 했다면 나도 엿 먹어야지."
    },
    {
      "startMs": 95670,
      "endMs": 98470,
      "translation": "난 계속 여기 있을 거야."
    },
    {
