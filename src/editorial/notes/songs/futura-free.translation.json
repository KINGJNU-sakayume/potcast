  "segments": [
    {
      "startMs": 29500,
      "endMs": 36330,
      "translation": "잠깐만. 솔직히 말하면, 하루에 세 번 하고도 끼니 안 거를 수 있으면 난 그걸로 됐어."
    },
    {
      "startMs": 36330,
      "endMs": 39080,
      "translation": "예전엔 시급 7달러 받으면서 하루 종일 서서 일했어."
    },
    {
      "startMs": 39080,
      "endMs": 40280,
      "translation": "엄마한테 전화해서 이랬지."
    },
    {
      "startMs": 40280,
      "endMs": 42470,
      "translation": "\"엄마, 나 이제 최저시급 받는 사람 아니야.\""
    },
    {
      "startMs": 42470,
      "endMs": 45400,
      "translation": "\"나 잘나가, 엄마, 잘나간다고.\""
    },
    {
      "startMs": 45400,
      "endMs": 50150,
      "translation": "\"이제 40만, 60만, 80만 달러씩 벌어, 엄마. 내 힘으로 서려고 말이야.\""
    },
    {
      "startMs": 50150,
      "endMs": 52090,
      "translation": "\"이 노래들을 하는 게 치료야, 엄마.\""
    },
    {
      "startMs": 52090,
      "endMs": 55980,
      "translation": "\"나한테 돈을 줘, 엄마. 내가 오히려 내야 하는데.\""
    },
    {
      "startMs": 55980,
      "endMs": 60210,
      "translation": "내가 너희한테 돈을 내야 해, 정말이야."
    },
    {
      "startMs": 60210,
      "endMs": 62830,
      "translation": "난 그냥 사람이야, 신이 아니야."
    },
    {
      "startMs": 62830,
      "endMs": 67620,
      "translation": "가끔은 내가 신 같지만, 신은 아니야."
    },
    {
      "startMs": 67620,
      "endMs": 71450,
      "translation": "만약 신이라면, 어느 천국이 나를 받아 줄지 모르겠어, 엄마."
    },
    {
      "startMs": 71450,
      "endMs": 72670,
      "translation": "이 판은 내가 쥐고 흔들 거야."
    },
    {
      "startMs": 72670,
      "endMs": 75940,
      "translation": "끝장날 때까지 밀어붙일 거야, 엄마, 은하 전체를."
    },
    {
