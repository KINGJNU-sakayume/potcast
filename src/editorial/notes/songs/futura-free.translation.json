      "endMs": 457720,
      "translation": "가끔은 꽤 퀴퀴해."
    },
    {
      "startMs": 457720,
      "endMs": 460200,
      "translation": "재능, 숨은 재능 같은 거 있어?"
    },
    {
      "startMs": 460200,
      "endMs": 466430,
      "translation": "없는 것 같아, 내가 하는 건 다 꽤 드러내 놓고 하니까."
    },
    {
      "startMs": 466430,
      "endMs": 473660,
      "translation": "재능? 음, 테레민을 칠 수 있어."
    },
    {
      "startMs": 473660,
      "endMs": 479120,
      "translation": "아마 내 형제, 하루에 일을 얼마나 하는지 보려고."
    },
    {
      "startMs": 479120,
      "endMs": 481510,
      "translation": "아마 타일러, 삶이 꽤 멋져 보여서."
    },
    {
      "startMs": 481510,
      "endMs": 487170,
      "translation": "아니, 사실 아니야, 걔는 엿이나 먹으라지, 어."
    },
    {
      "startMs": 487170,
      "endMs": 488550,
      "translation": "모르겠어."
    },
    {
      "startMs": 488550,
      "endMs": 491720,
      "translation": "아마 딜, 아무것도 안 해도 되니까."
    },
    {
      "startMs": 491720,
      "endMs": 495120,
      "translation": "그냥 집에 앉아 있으면 되잖아."
    },
    {
      "startMs": 495120,
      "endMs": 496250,
      "translation": "이름이 뭐야?"
    },
    {
      "startMs": 496250,
      "endMs": 498100,
      "translation": "세이지 엘서서."
    },
    {
      "startMs": 498100,
      "endMs": 499540,
      "translation": "무슨 일 해?"
    },
    {
      "startMs": 499540,
      "endMs": 502660,
      "translation": "축구해."
    },
    {
      "startMs": 502660,
      "endMs": 507000,
      "translation": "그리고 학교 다녀."
    },
    {
      "startMs": 507000,
      "endMs": 511740,
      "translation": "음, 스케이트를 더 잘 타고 싶어."
    },
    {
      "startMs": 511740,
      "endMs": 514620,
      "translation": "아마 아주 높은 데서 뛰어내릴 거야."
    },
    {
      "startMs": 514620,
      "endMs": 520320,
      "translation": "엄청 높은 데서, 물구나무로 착지해 보려고 하거나 뭐 그런 거."
    },
    {
      "startMs": 520320,
      "endMs": 523020,
      "translation": "좋아, 그게 다야."
    },
    {
      "startMs": 523020,
      "endMs": 528210,
      "translation": "모르겠어, 할 일이 엄청 많을 거야."
    },
    {
      "startMs": 528210,
      "endMs": 529750,
      "translation": "아마 가족이랑 시간을 많이 보낼 거야."
    },
    {
      "startMs": 529750,
      "endMs": 536280,
      "translation": "가족이랑 몇 시간 보내고, 해 보려고 생각만 했던 건 전부 하러 나갈 거야."
    },
    {
      "startMs": 536280,
      "endMs": 541570,
      "translation": "모르겠어, 할 수 있는 게 정말 많잖아."
    },
    {
      "startMs": 541570,
      "endMs": 544760,
      "translation": "그게 다야."
    },
    {
      "startMs": 544760,
      "endMs": 555070,
      "translation": "1광년은 얼마나 멀까? 1광년은 얼마나 멀까?"
    },
    {
      "startMs": 555070,
      "endMs": 564000,
      "translation": "(한 천 년쯤?)"
    }
  ]
}
