  },
  "segments": [
    {
      "startMs": 16230,
      "endMs": 18400,
      "translation": "밤새 마셨는데 아직 안 끝났어 (아직)"
    },
    {
      "startMs": 18400,
      "endMs": 20320,
      "translation": "약 파는 놈을 기다리는데 아직 안 왔어 (아직)"
    },
    {
      "startMs": 20320,
      "endMs": 22530,
      "translation": "아직 뭐가 필요해? 돈 걸어 (돈 걸어)"
    },
    {
      "startMs": 22530,
      "endMs": 24580,
      "translation": "베이프 로고 박힌 큰 가방을 들었어 (큰 가방)"
    },
    {
      "startMs": 24580,
      "endMs": 26470,
      "translation": "누가 뭐라 해도 파티는 안 끝나 (뭐라 해도)"
    },
    {
      "startMs": 26470,
      "endMs": 28350,
      "translation": "해가 세 번 뜰 때까지 안 자 (해가 세 번)"
    },
    {
      "startMs": 28350,
      "endMs": 30490,
      "translation": "파티는 셋이서 끝날 거야 (셋이서)"
    },
    {
      "startMs": 30490,
      "endMs": 32740,
      "translation": "피임도 안 하고, 아마 아들 셋은 생기겠지"
    },
    {
      "startMs": 32740,
      "endMs": 36770,
      "translation": "누구랑 퍼코셋을 들이켜, 그건 날 실망시킨 적이 없어 (음)"
    },
    {
      "startMs": 36770,
      "endMs": 41260,
      "translation": "다들 돈 벌러 일하러 가지만 우린 날뛰면서 벌어 (음)"
    },
    {
      "startMs": 41260,
      "endMs": 42550,
      "translation": "그르르르아!"
    },
    {
      "startMs": 42550,
      "endMs": 44930,
      "translation": "우린 지금 잔을 들이켜 (지금 잔을)"
    },
    {
      "startMs": 44930,
      "endMs": 46350,
      "translation": "그르르르아!"
    },
    {
      "startMs": 46350,
      "endMs": 48440,
      "translation": "그래, 우린 지금 잔을 들이켜 (잔을)"
    },
    {
      "startMs": 48440,
      "endMs": 50300,
      "translation": "페라리 타고 부릉부릉 가는 날 봐 (끽끽)"
    },
    {
      "startMs": 50300,
      "endMs": 52360,
      "translation": "차 안에도 섹시한 놈이 있지"
    },
    {
      "startMs": 52360,
      "endMs": 54370,
      "translation": "생로랑, 새 정장에 4만 달러"
    },
    {
      "startMs": 54370,
      "endMs": 56410,
      "translation": "버드 라이트를 홀짝여, 그게 새로운 그레이 구스야"
    },
    {
      "startMs": 56410,
      "endMs": 58480,
      "translation": "자기야, 우후 하고 흔들어 봐"
    },
    {
      "startMs": 58480,
      "endMs": 60350,
      "translation": "다이아몬드는 생채기처럼 깎였어"
    },
    {
      "startMs": 60350,
      "endMs": 62210,
      "translation": "주머니가 너무 두둑해서 헐렁한 드레스를 입어"
    },
    {
      "startMs": 62210,
      "endMs": 64530,
      "translation": "나랑 드레는 여자들 보러 왔어"
    },
    {
      "startMs": 64530,
      "endMs": 68910,
      "translation": "번쩍번쩍, 여자들이 내 수백만 달러를 노려"
    },
    {
      "startMs": 68910,
      "endMs": 72870,
      "translation": "형제를 어시스트로 도와, 난 제이슨 윌리엄스야"
    },
    {
      "startMs": 72870,
      "endMs": 76890,
      "translation": "파티가 있다길래 들러 볼까 해"
    },
    {
      "startMs": 76890,
      "endMs": 80390,
      "translation": "그 순간 개구리처럼 개굴개굴 뛰어내렸지 (끽!)"
    },
    {
      "startMs": 80390,
      "endMs": 82490,
      "translation": "문으로 들어설 때 이미 취해 있었어"
    },
    {
      "startMs": 82490,
      "endMs": 84520,
      "translation": "너무 취해서, 그래, 안녕"
    },
    {
      "startMs": 84520,
      "endMs": 86430,
      "translation": "그 여자한테 더 따르라고 했지"
    },
    {
      "startMs": 86430,
      "endMs": 88580,
      "translation": "그랬더니 곧장 코카인으로 갔어 (코카인)"
    },
    {
      "startMs": 88580,
      "endMs": 90450,
      "translation": "여자 서른 명이 더 따라오고 싶대"
    },
    {
      "startMs": 90450,
      "endMs": 92440,
      "translation": "이 차 출발시키자 (출발)"
    },
    {
      "startMs": 92440,
      "endMs": 94400,
      "translation": "이미 통제가 안 돼"
    },
    {
      "startMs": 94400,
      "endMs": 96490,
      "translation": "이게 우리가 고른 삶이야"
    },
    {
      "startMs": 96490,
      "endMs": 98320,
      "translation": "밤새 마셨는데 아직 안 끝났어 (아직)"
    },
