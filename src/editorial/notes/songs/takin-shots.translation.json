    },
    {
      "startMs": 126500,
      "endMs": 128490,
      "translation": "그래, 우린 지금 잔을 들이켜 (잔을)"
    },
    {
      "startMs": 128490,
      "endMs": 130370,
      "translation": "나한테 센 척하지만 넌 좋아하잖아 (좋아하잖아)"
    },
    {
      "startMs": 130370,
      "endMs": 132480,
      "translation": "관심 없는 척하려고 하지 (없는 척)"
    },
    {
      "startMs": 132480,
      "endMs": 134650,
      "translation": "다들 알아, 너도 만지고 싶어 하는 거 (만지고)"
    },
    {
      "startMs": 134650,
      "endMs": 136380,
      "translation": "사람들 앞에서 해 본 적 있어?"
    },
    {
      "startMs": 136380,
      "endMs": 137930,
      "translation": "밤새 홀짝여, 돌려 마셔"
    },
    {
      "startMs": 137930,
      "endMs": 140160,
      "translation": "자기야, 오늘 밤만은 네가 내 영혼의 짝이야"
    },
    {
      "startMs": 140160,
      "endMs": 142060,
      "translation": "보드카에 샴페인을 섞어"
    },
    {
      "startMs": 142060,
      "endMs": 144220,
      "translation": "말해 봐, 남자가 술을 얼마나 마실 수 있는지"
    },
    {
      "startMs": 144220,
      "endMs": 146350,
      "translation": "내가 음반을 몇 장이나 팔았냐고?"
    },
    {
      "startMs": 146350,
      "endMs": 148350,
      "translation": "나도 몰라, 셀 수가 없어 (몰라)"
    },
    {
      "startMs": 148350,
      "endMs": 150430,
      "translation": "요즘 내가 잘나가는 거 알잖아"
    },
    {
      "startMs": 150430,
      "endMs": 152180,
      "translation": "내가 나타나면 인생을 축하하지 (나타나면)"
    },
    {
      "startMs": 152180,
      "endMs": 153940,
      "translation": "밤새 홀짝여, 종일 홀짝여"
    },
    {
      "startMs": 153940,
      "endMs": 156000,
      "translation": "경기장 앞 주차장처럼 맥주 깔때기를 꺼냈어"
    },
    {
      "startMs": 156000,
      "endMs": 158020,
      "translation": "말할 수도 없는 어려운 단어를 붙잡고 있어"
    },
    {
      "startMs": 158020,
      "endMs": 160040,
      "translation": "날 취한 말로 떠들게 만들어, 통역 좀 해 줄래?"
    },
    {
      "startMs": 160040,
      "endMs": 162380,
      "translation": "문으로 들어설 때 이미 취해 있었어"
    },
