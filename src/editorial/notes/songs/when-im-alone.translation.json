  "segments": [
    {
      "startMs": 28190,
      "endMs": 34620,
      "translation": "우린 약속했지, 넌 언제나 날 다시 받아 줄 거라고"
    },
    {
      "startMs": 34620,
      "endMs": 41480,
      "translation": "난 피 흘리고 있어, 지금 네가 필요해, 네가 이기게 둘 순 없어"
    },
    {
      "startMs": 41480,
      "endMs": 48580,
      "translation": "다 갖고 싶어, 다 갖고 싶어, 너무 세게 밀어붙여서 부숴 버려"
    },
    {
      "startMs": 48580,
      "endMs": 51760,
      "translation": "내 유일한 집은 연기 속에 무너졌어"
    },
    {
      "startMs": 51760,
      "endMs": 54830,
      "translation": "씁쓸하고 달콤해, 그 맛이 느껴져"
    },
    {
      "startMs": 54830,
      "endMs": 58230,
      "translation": "그래서, 넌 외로워? 난 천천히 낫고 있으니까"
    },
    {
      "startMs": 58230,
      "endMs": 61640,
      "translation": "한순간에 네 기억이 흐려져 가"
    },
    {
      "startMs": 61640,
      "endMs": 65070,
      "translation": "버림받은 지금은 기대 같은 것도 없어"
    },
    {
      "startMs": 65070,
      "endMs": 68850,
      "translation": "내가 뭘로 만들어졌는지, 견딜 수 있는지 보자, 이제"
    },
    {
      "startMs": 68850,
      "endMs": 75990,
      "translation": "혼자 있을 때면 널 놓아주는 척해"
    },
    {
      "startMs": 75990,
      "endMs": 79390,
      "translation": "그냥 누구 탓인지 말해 줘"
    },
    {
      "startMs": 79390,
      "endMs": 83130,
      "translation": "이게"
    },
    {
      "startMs": 83130,
      "endMs": 89660,
      "translation": "눈을 뜨는 게 배에 주먹을 맞은 것 같을 때"
    },
    {
      "startMs": 89660,
      "endMs": 93210,
      "translation": "그냥 말해 줘, 누구 탓인지"
    },
    {
      "startMs": 93210,
      "endMs": 95770,
      "translation": "이게?"
    },
    {
      "startMs": 95770,
      "endMs": 98880,
      "translation": "내가 원한 건 곁에 둘 괜찮은 사람 하나였어"
    },
    {
      "startMs": 98880,
      "endMs": 102610,
      "translation": "잠자리에 들면 그 여자가 내 쪽으로 슬금슬금 와"
    },
    {
      "startMs": 102610,
      "endMs": 105670,
      "translation": "종일 술을 마셨고, 그 여자를 재워 줬어"
    },
    {
      "startMs": 105670,
      "endMs": 108910,
      "translation": "집에 데려다줬더니 내 차에 뭘 두고 내렸어, 내 차에"
    },
    {
      "startMs": 108910,
      "endMs": 109550,
      "translation": "젠장!"
    },
    {
      "startMs": 109550,
      "endMs": 116140,
      "translation": "그리고 내 여자가 알게 돼서 이젠 호텔에 살아, 호텔에 살아"
    },
    {
      "startMs": 116140,
      "endMs": 124250,
      "translation": "그렇게 나쁘진 않아, 룸서비스가 있으니까, 호텔에 살아, 호텔에 살아"
    },
    {
      "startMs": 124250,
      "endMs": 127070,
      "translation": "네 삶은 어때? 지금 당장 생명줄이 필요해"
    },
    {
      "startMs": 127070,
      "endMs": 130870,
      "translation": "정신 차리려고 아흔아홉 밤을 애쓰고 있어"
    },
    {
      "startMs": 130870,
      "endMs": 134540,
      "translation": "지금 스포트라이트 속에 있어도 삶은 시큼해"
    },
    {
      "startMs": 134540,
      "endMs": 137870,
      "translation": "그래도 어떻게든 애써"
    },
    {
      "startMs": 137870,
      "endMs": 144470,
      "translation": "혼자 있을 때면 널 놓아주는 척해"
    },
    {
      "startMs": 144470,
      "endMs": 147890,
      "translation": "그냥 누구 탓인지 말해 줘"
    },
    {
      "startMs": 147890,
      "endMs": 151530,
      "translation": "이게"
    },
    {
      "startMs": 151530,
      "endMs": 157930,
      "translation": "눈을 뜨는 게 배에 주먹을 맞은 것 같을 때"
    },
    {
      "startMs": 157930,
      "endMs": 161680,
      "translation": "그냥 말해 줘, 누구 탓인지"
    },
    {
      "startMs": 161680,
      "endMs": 195000,
      "translation": "이게?"
    }
  ]
}
