  "segments": [
    {
      "startMs": 16360,
      "endMs": 20420,
      "translation": "왜 그렇게 의심이 많아?"
    },
    {
      "startMs": 20420,
      "endMs": 24410,
      "translation": "그렇게 의심하지 마"
    },
    {
      "startMs": 24410,
      "endMs": 26250,
      "translation": "그렇게 굴지 마"
    },
    {
      "startMs": 26250,
      "endMs": 30340,
      "translation": "자기야, 걱정하지 마"
    },
    {
      "startMs": 30340,
      "endMs": 34490,
      "translation": "레이디, 그런 생각은 하지도 마"
    },
    {
      "startMs": 34490,
      "endMs": 38460,
      "translation": "넌 엉뚱한 걸 걱정해, 엉뚱한 것들을"
    },
    {
      "startMs": 38460,
      "endMs": 42790,
      "translation": "넌 엉뚱한 걸 걱정해, 엉뚱한 것들을"
    },
    {
      "startMs": 42790,
      "endMs": 46920,
      "translation": "넌 엉뚱한 걸 걱정해, 엉뚱한 것들을"
    },
    {
      "startMs": 46920,
      "endMs": 51080,
      "translation": "넌 엉뚱한 걸 걱정해, 엉뚱한 것들을"
    },
    {
      "startMs": 51080,
      "endMs": 52130,
      "translation": "지금 말해 봐"
    },
    {
      "startMs": 52130,
      "endMs": 55180,
      "translation": "정말 평생 혼자 지내고 싶어?"
    },
    {
      "startMs": 55180,
      "endMs": 57850,
      "translation": "잠깐 떨어져 있는 게 너한테 좋을지도 몰라, 우리한테 좋을지도"
    },
    {
      "startMs": 57850,
      "endMs": 59430,
      "translation": "우리가 영영 끝나 버리기 전에"
    },
    {
      "startMs": 59430,
      "endMs": 61370,
      "translation": "난 좋게 해 줄 수도, 거칠게 해 줄 수도 있으니까"
    },
    {
      "startMs": 61370,
      "endMs": 63770,
      "translation": "널 오게 할 수도, 가게 할 수도 있어"
    },
    {
      "startMs": 63770,
      "endMs": 65550,
      "translation": "널 들뜨게 할 수도, 날게 할 수도 있어"
    },
    {
      "startMs": 65550,
      "endMs": 67860,
      "translation": "하늘에 닿게 할 수도 있어, 헤이, 아마도"
    },
    {
      "startMs": 67860,
      "endMs": 68860,
      "translation": "맨날"
    },
    {
      "startMs": 68860,
      "endMs": 71950,
      "translation": "내 일에 끼어들어 휴대폰을 뒤지지, 자기야, 그러지 마"
    },
    {
      "startMs": 71950,
      "endMs": 73760,
      "translation": "또 하룻밤 분위기를 망치고 싶은 거지"
    },
    {
      "startMs": 73760,
      "endMs": 76120,
      "translation": "또 싸움이야, 오, 또 시작이네"
    },
    {
      "startMs": 76120,
      "endMs": 80490,
      "translation": "자기야, 걱정하지 마"
    },
    {
      "startMs": 80490,
      "endMs": 84230,
      "translation": "레이디, 우리 플로어로 나가자"
    },
    {
      "startMs": 84230,
      "endMs": 90150,
      "translation": "어쨌든 사람들은 나만큼 너를 몰라"
    },
    {
      "startMs": 90150,
      "endMs": 92240,
      "translation": "절대 너를 알 수 없어"
    },
    {
      "startMs": 92240,
      "endMs": 98480,
      "translation": "어쨌든 사람들은 나만큼 너를 몰라"
    },
    {
      "startMs": 98480,
      "endMs": 100430,
      "translation": "절대 너를 알 수 없어"
    },
    {
      "startMs": 100430,
      "endMs": 102220,
      "translation": "맨날"
    },
    {
      "startMs": 102220,
      "endMs": 105240,
      "translation": "혼자 보내는 밤이 싫다고 불평하더니"
    },
    {
      "startMs": 105240,
      "endMs": 106500,
      "translation": "이제 나랑 여기 있잖아"
    },
    {
      "startMs": 106500,
      "endMs": 109580,
      "translation": "고마운 줄 알고, 그 태도는 집에 두고 와"
    },
    {
      "startMs": 109580,
      "endMs": 110570,
      "translation": "그래, 사람들이 쳐다보는 거 보여"
    },
    {
      "startMs": 110570,
      "endMs": 113520,
      "translation": "자기야, 보라고 해, 우리가 멋져 보이니까 차가운 눈길을 보내는 거야"
    },
    {
      "startMs": 113520,
      "endMs": 115330,
      "translation": "그래, 이런저런 소문 들었겠지"
    },
    {
      "startMs": 115330,
      "endMs": 117820,
      "translation": "우리가 어쩔 수 없는 건 걱정하지 마"
    },
    {
      "startMs": 117820,
      "endMs": 119210,
      "translation": "세상의 온갖 말은 세상 속에서 사라져"
    },
    {
      "startMs": 119210,
      "endMs": 121990,
      "translation": "네가 마침내 그걸 놓아 버릴 때까지"
    },
    {
