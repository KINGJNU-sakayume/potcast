    },
    {
      "startMs": 99980,
      "endMs": 102180,
      "translation": "18년, 18년 (내가 필요할 때)"
    },
    {
      "startMs": 102180,
      "endMs": 104630,
      "translation": "네 애를 낳았으면 18년 동안 너를 붙잡는 거야 (그녀는 내 돈을 가져가)"
    },
    {
      "startMs": 104630,
      "endMs": 107330,
      "translation": "애 하나 때문에 양육비를 내는 사람을 알아 (내가 필요할 때)"
    },
    {
      "startMs": 107330,
      "endMs": 110070,
      "translation": "애 엄마의 차랑 집이 그 사람보다 더 커"
    },
    {
      "startMs": 110070,
      "endMs": 112960,
      "translation": "일요일마다 TV에서 볼 수 있는 사람인데"
    },
    {
      "startMs": 112960,
      "endMs": 115350,
      "translation": "슈퍼볼에서 우승하고도 현대차를 몰고 가"
    },
    {
      "startMs": 115350,
      "endMs": 118160,
      "translation": "그녀는 네 돈으로 애한테 장난감을 사 줘야 했는데"
    },
    {
      "startMs": 118160,
      "endMs": 120610,
      "translation": "네 돈으로 병원에 가서 지방 흡입을 했지 (그래, 그녀는 내 돈을 가져가)"
    },
    {
      "startMs": 120610,
      "endMs": 123070,
      "translation": "네 돈으로 마이클처럼 하고 돌아다녀 (내가 필요할 때)"
    },
    {
      "startMs": 123070,
      "endMs": 127080,
      "translation": "보험이라도 들어 두지 그랬어, 네 돈을 위해 가이코라도, 돈, 돈 (그녀는 내 돈을 가져가)"
    },
    {
      "startMs": 127080,
      "endMs": 131670,
      "translation": "겁쟁이가 아니라면 외쳐, \"혼전 계약서! 혼전 계약서!\" 그래"
    },
    {
      "startMs": 131670,
      "endMs": 133250,
      "translation": "그건 꼭 있어야 해"
    },
    {
      "startMs": 133250,
      "endMs": 136440,
      "translation": "그녀가 널 떠날 땐 반을 갖고 떠날 테니까"
    },
    {
      "startMs": 136440,
      "endMs": 138650,
      "translation": "18년, 18년"
    },
    {
      "startMs": 138650,
      "endMs": 141600,
      "translation": "그리고 아이의 열여덟 번째 생일에 그는 자기 애가 아니란 걸 알았지 (그래, 그녀는 내 돈을 가져가)"
    },
    {
      "startMs": 141600,
