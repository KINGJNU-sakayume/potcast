    },
    {
      "startMs": 27640,
      "endMs": 30390,
      "translation": "흔들어, 자기, 계속해, 흔들어 (난 떠나야 해)"
    },
    {
      "startMs": 30390,
      "endMs": 32840,
      "translation": "흔들어, 자기, 계속해, 흔들어 (난 떠나야 해)"
    },
    {
      "startMs": 32840,
      "endMs": 35520,
      "translation": "흔들어, 자기, 계속해, 흔들어 (난 떠나야 해)"
    },
    {
      "startMs": 35520,
      "endMs": 37500,
      "translation": "흔들어, 자기, 계속해 (그래, 그녀는 내 돈을 가져가)"
    },
    {
      "startMs": 37500,
      "endMs": 39860,
      "translation": "끝내주는 여자, 미용실에서 만났지 (내가 필요할 때)"
    },
    {
      "startMs": 39860,
      "endMs": 42330,
      "translation": "겨드랑이에 작은 루이 비통 가방을 끼고 (그녀는 내 돈을 가져가)"
    },
    {
      "startMs": 42330,
      "endMs": 45020,
      "translation": "그녀가 그러더라, \"잘나가는 거 알겠어, 매력을 보면 알지 (내가 필요할 때)"
    },
    {
      "startMs": 45020,
      "endMs": 48240,
      "translation": "여자들도 줄줄이 따르겠네, 매력이랑 팔에 찬 시계를 보면 알아\""
    },
    {
      "startMs": 48240,
      "endMs": 50690,
      "translation": "그런데 난 그 한 사람을 찾고 있어, 그녀 본 적 있어?"
    },
    {
      "startMs": 50690,
      "endMs": 53150,
      "translation": "점쟁이가 그러는데 그녀는 세리나 같은 엉덩이를 가졌대"
    },
    {
      "startMs": 53150,
      "endMs": 55890,
      "translation": "트리나, 제니퍼 로페즈, 애가 넷"
    },
    {
      "startMs": 55890,
      "endMs": 58450,
      "translation": "그 말썽꾸러기들을 전부 쇼비즈 피자까지 데려가야 해?"
    },
    {
      "startMs": 58450,
      "endMs": 61150,
      "translation": "좋아, 애들을 데려와, 그런데 애들 친구들까지"
    },
    {
      "startMs": 61150,
      "endMs": 63600,
      "translation": "벤츠를 대니까 다들 우르르 올라타"
    },
    {
      "startMs": 63600,
      "endMs": 65990,
      "translation": "다 같이 밥 먹으러 가서 결국 내가 계산했지"
    },
    {
      "startMs": 65990,
      "endMs": 68450,
      "translation": "이 여자랑 놀려면 돈이 많아야 할 거야"
    },
    {
      "startMs": 68450,
      "endMs": 71540,
      "translation": "왜냐고? 그녀를 만지려면 너무 많이 들거든"
    },
    {
      "startMs": 71540,
      "endMs": 73920,
      "translation": "듣기로는 버스타 라임스랑 사이에 애가 있대"
    },
    {
      "startMs": 73920,
      "endMs": 76630,
      "translation": "내 절친 말로는 어셔랑도 놀았대"
    },
    {
      "startMs": 76630,
      "endMs": 79460,
      "translation": "너희가 뭐라든 상관없어, 난 여전히 그녀를 사랑해 (그래, 그녀는 내 돈을 가져가)"
    },
    {
      "startMs": 79460,
      "endMs": 81850,
      "translation": "그녀가 꽃뱀이라는 건 아니야, 어 (내가 필요할 때)"
    },
    {
      "startMs": 81850,
      "endMs": 84260,
      "translation": "그래도 빈털터리랑은 안 놀지, 어 (그녀는 내 돈을 가져가)"
    },
    {
