  "segments": [
    {
      "startMs": 9600,
      "endMs": 16690,
      "translation": "학교 가는 길에 거리를 걸으며 보이지 않는 박자에 맞춰 이를 갈곤 했다"
    },
    {
      "startMs": 16690,
      "endMs": 24070,
      "translation": "죽은 낙엽들이 오직 나를 위해, 심벌즈가 되려고 나무에서 떨어진 것처럼 발로 밟아 부쉈다"
    },
    {
      "startMs": 24070,
      "endMs": 28910,
      "translation": "수업 시간엔 초침이 지나갈 때마다 빗금을 하나씩 그으며 시간을 보냈다"
    },
    {
      "startMs": 28910,
      "endMs": 31420,
      "translation": "다섯 개 묶음을 열두 번 그으면 일 분이었다"
    },
    {
      "startMs": 31420,
      "endMs": 32260,
      "translation": "그런데"
    },
    {
      "startMs": 32260,
      "endMs": 35830,
      "translation": "샤메이카는 내게 가능성이 있다고 했다"
    },
    {
      "startMs": 35830,
      "endMs": 39530,
      "translation": "샤메이카는 내게 가능성이 있다고 했다"
    },
    {
      "startMs": 39530,
      "endMs": 43360,
      "translation": "샤메이카는 내게 가능성이 있다고 했다"
    },
    {
      "startMs": 43360,
      "endMs": 54240,
      "translation": "샤메이카는 내게 가능성이 있다고 했다"
    },
    {
      "startMs": 54240,
      "endMs": 59600,
      "translation": "바람 부는 인도를 행진하듯 걸으며 승마용 채찍으로 다리를 때리곤 했다"
    },
    {
      "startMs": 59600,
      "endMs": 61460,
      "translation": "그러면 내가 꽤 거칠어 보일 거라 생각하면서"
    },
    {
      "startMs": 61460,
      "endMs": 65240,
      "translation": "웃지 않았다, 웃음은 늘 연습한 것처럼 보였으니까"
    },
    {
      "startMs": 65240,
      "endMs": 69380,
      "translation": "난 괴롭히는 애들이 무섭지 않았고, 그래서 괴롭힘은 더 심해졌다"
    },
    {
      "startMs": 69380,
      "endMs": 73790,
      "translation": "수업 시간엔 초침이 지나갈 때마다 빗금을 하나씩 그으며 시간을 보냈다"
