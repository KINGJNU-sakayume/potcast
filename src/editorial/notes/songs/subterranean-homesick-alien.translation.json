    },
    {
      "startMs": 129160,
      "endMs": 138680,
      "translation": "밤늦게 시골길을 달릴 때 그들이 내려와 주면 좋겠다"
    },
    {
      "startMs": 138680,
      "endMs": 143170,
      "translation": "그 아름다운 우주선에 나를 태우고"
    },
    {
      "startMs": 143170,
      "endMs": 157390,
      "translation": "내가 보고 싶은 모습 그대로 세상을 보여 주면 좋겠다"
    },
    {
      "startMs": 157390,
      "endMs": 161700,
      "translation": "친구들에게 다 말하겠지만 아무도 믿지 않을 것이다"
    },
    {
      "startMs": 161700,
      "endMs": 167120,
      "translation": "내가 결국 완전히 돌아 버렸다고 생각하겠지"
    },
    {
      "startMs": 167120,
      "endMs": 171560,
      "translation": "그들에게 별들과 삶의 의미를 보여 주겠지만"
    },
    {
      "startMs": 171560,
      "endMs": 176320,
      "translation": "그들은 나를 가둬 버릴 것이다"
    },
    {
      "startMs": 176320,
      "endMs": 183930,
      "translation": "그래도 나는 괜찮을 것이다"
