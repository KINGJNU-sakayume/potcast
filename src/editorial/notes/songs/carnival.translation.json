  "segments": [
    {
      "startMs": 18210,
      "endMs": 26400,
      "translation": "이미 큰 논쟁이야, 꺼 버릴 수 없을 만큼 부채질된 불씨는"
    },
    {
      "startMs": 26400,
      "endMs": 34460,
      "translation": "마치 용광로 같아, 들어 보면 불어도 날아가지 않는 티끌의 전쟁인가"
    },
    {
      "startMs": 34460,
      "endMs": 42650,
      "translation": "치솟는 열광, 그건 불씨의 살과 피를 낚아채는 카니발리즘"
    },
    {
      "startMs": 42650,
      "endMs": 50620,
      "translation": "하지만 그게 절정의 소용돌이, 슬픈 날이네 마지막 카니발"
    },
    {
      "startMs": 50620,
      "endMs": 53120,
      "translation": "우, 우우"
    },
    {
      "startMs": 53120,
      "endMs": 58030,
      "translation": "붓끝이 흐려질 만큼 선명한 카니발"
    },
    {
      "startMs": 58030,
      "endMs": 58880,
      "translation": "또야"
    },
    {
      "startMs": 58880,
      "endMs": 61240,
      "translation": "우, 우우"
    },
    {
      "startMs": 61240,
      "endMs": 67320,
      "translation": "질리지도 않고 또 부추기는, 작은 리듬"
    },
    {
      "startMs": 67320,
      "endMs": 75580,
      "translation": "쌓이고 쌓이는 질투, 그건 뚫린 구멍을 메우는 언젠가의 카니발"
    },
    {
      "startMs": 75580,
      "endMs": 84050,
      "translation": "하지만 그건 환상, 거품이야 터지면 구멍은 다시 넓어져"
    },
    {
      "startMs": 84050,
      "endMs": 98230,
      "translation": "행복이 있는 곳을 필사적으로 찾으니까, 길게 자란 그 손톱도 깎지 않은 채"
    },
    {
      "startMs": 98230,
      "endMs": 107250,
      "translation": "사람은 서로 독을 마시며 거기서 뭔가 함께 걸을 이유를 찾고 있어"
    },
    {
      "startMs": 107250,
      "endMs": 115150,
      "translation": "서로 상처를 핥아 주다 그 아픔이 지독하게 커져 버린다 해도"
    },
    {
      "startMs": 115150,
      "endMs": 123600,
      "translation": "있잖아, 봐 봐, 봐, 보면 좋은 경치야"
    },
    {
      "startMs": 123600,
      "endMs": 132670,
      "translation": "응, 봐 봐 봐"
    },
    {
      "startMs": 132670,
      "endMs": 135180,
      "translation": "우, 우우"
    },
    {
      "startMs": 135180,
      "endMs": 140910,
      "translation": "불행의 구멍에 발이 미끄러지는, 불씨를 든 천사"
    },
    {
      "startMs": 140910,
      "endMs": 143380,
      "translation": "우, 우우"
    },
    {
      "startMs": 143380,
      "endMs": 149460,
      "translation": "그러니 솔직하게 울며 매달려, 흠뻑 젖은 채로"
    },
    {
      "startMs": 149460,
      "endMs": 158610,
      "translation": "사람은 서로 독을 마시며 거기서 뭔가 함께 걸을 이유를 찾고 있어"
    },
    {
      "startMs": 158610,
      "endMs": 166990,
      "translation": "서로 상처를 핥아 주다 그 아픔이 지독하게 커져 버린다 해도"
    },
    {
      "startMs": 166990,
      "endMs": 174690,
      "translation": "서로 노려보다 눈이 마주치면, 그런 삐뚤어짐에 희망을 깃들이고"
    },
    {
      "startMs": 174690,
      "endMs": 176820,
      "translation": "왜일까"
    },
    {
      "startMs": 176820,
      "endMs": 181630,
      "translation": "견딜 수 없는 아픔일 텐데"
    },
    {
      "startMs": 181630,
      "endMs": 189780,
      "translation": "보면 좋은 경치야"
    },
    {
      "startMs": 189780,
