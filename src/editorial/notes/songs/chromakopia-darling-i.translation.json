  "segments": [
    {
      "startMs": 1330,
      "endMs": 6580,
      "translation": "뭘 하든, 어떤 년한테도 사랑한다고 절대 말하지 마."
    },
    {
      "startMs": 6580,
      "endMs": 9640,
      "translation": "진심이 아니면 말하지 마 (확인)"
    },
    {
      "startMs": 9640,
      "endMs": 14690,
      "translation": "달링, 나는 계속— (계속 사랑에 빠져)"
    },
    {
      "startMs": 14690,
      "endMs": 19320,
      "translation": "달링, 나는 계속— (계속 사랑에 빠져)"
    },
    {
      "startMs": 19320,
      "endMs": 24640,
      "translation": "다-다, 다, 계속 (계속 사랑에 빠져)"
    },
    {
      "startMs": 24640,
      "endMs": 29280,
      "translation": "영원은 너무 길어 (어서)"
    },
    {
      "startMs": 29280,
      "endMs": 34150,
      "translation": "우, 나한텐 문제가 있어, 떨쳐 낼 수 있을지 모르겠어."
    },
    {
      "startMs": 34150,
      "endMs": 38930,
      "translation": "오, 걔네는 날 묶어 두고 싶어 해, 그 속박이 부러질지도 몰라."
    },
    {
      "startMs": 38930,
      "endMs": 41230,
      "translation": "점선 위에 서명은 못 해."
    },
    {
      "startMs": 41230,
      "endMs": 49380,
      "translation": "영원이란 대체 얼마나 긴 거야? (너무 길어)"
    },
    {
      "startMs": 49380,
      "endMs": 54250,
      "translation": "달링, 나는 계속— (계속 사랑에 빠져, 오-오)"
    },
    {
      "startMs": 54250,
      "endMs": 58650,
      "translation": "달링, 나는 계속— (계속 사랑에 빠져)"
    },
    {
      "startMs": 58650,
      "endMs": 63670,
      "translation": "다-다, 다, 계속 (계속 사랑에 빠져)"
    },
    {
      "startMs": 63670,
      "endMs": 68020,
      "translation": "영원은 너무 길어 (어, 이게 불이지, 들어 봐, 요)"
    },
    {
      "startMs": 68020,
      "endMs": 70520,
      "translation": "여름에 드리프트하고 싶을 땐 내 BMW를 몰아."
    },
    {
      "startMs": 70520,
      "endMs": 73020,
      "translation": "라페라리는 핸들링이 더 좋고, 좆나게 예뻐."
    },
    {
      "startMs": 73020,
      "endMs": 75540,
      "translation": "롤스에선 안전하게 느껴져, 내가 몰면 거물이지."
    },
    {
      "startMs": 75540,
      "endMs": 77960,
      "translation": "다 사랑해, 이유는 제각각이고, 같은 순간에 말이야 (오, 예)"
    },
    {
      "startMs": 77960,
      "endMs": 80220,
      "translation": "봐, 일부일처제, 그건 나한테 안 맞아 (아니)"
    },
    {
      "startMs": 80220,
      "endMs": 82620,
      "translation": "모두에게 선택지가 하나라고? 거짓말하지 마 (거짓말하지 마)"
    },
    {
      "startMs": 82620,
      "endMs": 85130,
      "translation": "규칙이 너무 많고, 난 호기심이 너무 많아서 그런 사람이 되려고 해 볼 수가 없어."
    },
    {
      "startMs": 85130,
      "endMs": 87410,
      "translation": "숨기면서 수치심이 내 안에 쌓여 가."
    },
    {
      "startMs": 87410,
      "endMs": 90570,
      "translation": "솔직히 T는 완벽하지 않으니까."
    },
    {
      "startMs": 90570,
      "endMs": 93020,
      "translation": "그런데 어떻게 한 사람에게서 전부를 얻어?"
    },
    {
      "startMs": 93020,
      "endMs": 95730,
      "translation": "식장 제단 앞에 섰는데도 난 여전히 찾고 있어."
    },
    {
      "startMs": 95730,
      "endMs": 98430,
      "translation": "난 그냥 사람이야, 안 맞으면 상황은 바뀌는 거야."
    },
    {
      "startMs": 98430,
      "endMs": 99880,
      "translation": "그리고 아무것도 그대로 있지 않아, 난 그렇게 믿어."
    },
    {
      "startMs": 99880,
      "endMs": 102350,
      "translation": "음, 어쩌면 놓아주는 건 아름다운 일일지도 몰라."
    },
    {
      "startMs": 102350,
      "endMs": 104900,
      "translation": "당분간은 완벽했어, 너희가 잘못한 건 없어."
    },
    {
      "startMs": 104900,
      "endMs": 107040,
      "translation": "인생은 짧은데 영원은 존나게 길어."
    },
    {
      "startMs": 107040,
      "endMs": 109690,
      "translation": "난 긴 시간이 좋아, 난 내 시간대로 살아 (우)"
    },
    {
      "startMs": 109690,
      "endMs": 111970,
      "translation": "그래도 이 애는 사랑해, 금광을 터뜨렸거든."
    },
    {
      "startMs": 111970,
      "endMs": 114480,
      "translation": "새집을 생각하고, 아이 둘을 생각해."
    },
    {
      "startMs": 114480,
      "endMs": 117480,
      "translation": "새로운 년에게 홀려 버리기 전까지는 말이야."
    },
    {
      "startMs": 117480,
      "endMs": 119700,
      "translation": "그래도 드디어 흰머리가 나면 (응)"
    },
    {
      "startMs": 119700,
      "endMs": 122130,
      "translation": "'그 사람'을 못 찾았어도 적어도 뭔가는 느낄 거야 (예)"
    },
    {
      "startMs": 122130,
      "endMs": 124370,
      "translation": "이 음악 지랄만큼 날 채워 주는 건 없어."
    },
    {
      "startMs": 124370,
      "endMs": 127160,
      "translation": "그러니 다 끝나고 나면 이 그래미들이랑 외롭게 지내겠지, 어서."
    },
    {
      "startMs": 127160,
      "endMs": 131860,
      "translation": "달링, 나는 계속— (계속 사랑에 빠져, 자기야, 나는)"
    },
    {
      "startMs": 131860,
      "endMs": 135310,
      "translation": "달링, 나는 계속— (계속 사랑에 빠져)"
