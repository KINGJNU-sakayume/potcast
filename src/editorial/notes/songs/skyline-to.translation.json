{
  "schemaVersion": 2,
  "timing": { "lrclibId": 422327, "durationMs": 185000 },
  "segments": [
    { "startMs": 130, "endMs": 4030, "translation": "이게 기쁨이야, 이게 여름이야" },
    { "startMs": 4030, "endMs": 12180, "translation": "버텨, 살아 있어" },
    { "startMs": 12180, "endMs": 19560, "translation": "네 쇠붙이를 걸치고, 우리 둘뿐이야" },
    { "startMs": 19560, "endMs": 29870, "translation": "달콤하게 사랑을 나누며, 천천히 시간을 들여, 신이 우리를 내리칠 때까지" },
    { "startMs": 29870, "endMs": 37020, "translation": "한 해가 정말 빌어먹게 빠르게 지나갔어" },
    { "startMs": 37020, "endMs": 40010, "translation": "이 차의 3단 기어는 꽤나 길어" },
    { "startMs": 40010, "endMs": 41910, "translation": "5번 도로 위를 미끄러지듯" },
    { "startMs": 41910, "endMs": 46440, "translation": "사슴이 길을 가로질러 뛰어, 헤드라이트를 꺼" },
    { "startMs": 46440, "endMs": 50820, "translation": "엄청나게, 이제 달빛 아래야" },
    { "startMs": 50820, "endMs": 57220, "translation": "엄청나게, 해돋이가 눈앞이야" },
    { "startMs": 57220, "endMs": 61630, "translation": "아침이 들이닥쳐, 빛줄기로 우리를 따라다녀" },
    { "startMs": 61630, "endMs": 65310, "translation": "하지가 예전만큼 멀지 않아" },
    { "startMs": 65310, "endMs": 71970, "translation": "모든 게 흐려지기 시작해, 우리는 나이 들어 (흐려져, 흐려져)" },
    { "startMs": 71970, "endMs": 76420, "translation": "여름이 예전만큼 길지 않아" },
    { "startMs": 76420, "endMs": 82830, "translation": "하루하루가 미친 듯이 소중해 (연기, 안개)" },
    { "startMs": 82830, "endMs": 85330, "translation": "흠뻑 젖어 볼래?" },
    { "startMs": 85330, "endMs": 87280, "translation": "스피드보트에서 테이프 하나 찍어 볼래?" },
    { "startMs": 87280, "endMs": 89650, "translation": "우리한테서 캘리포니케이션 냄새가 나" },
    { "startMs": 89650, "endMs": 90690, "translation": "포즈를 취해" },
    { "startMs": 90690, "endMs": 92640, "translation": "콩고에서는 모든 게 자라" },
    { "startMs": 92640, "endMs": 93990, "translation": "모든 게 자라" },
    { "startMs": 93990, "endMs": 130570, "translation": "내가 다시 부르면 와 줄 수 있어?" },
    { "startMs": 130570, "endMs": 138280, "translation": "저녁이 오고, 금을 쫓는 일도 끝나" },
    { "startMs": 138280, "endMs": 144680, "translation": "내 손안의 평화는 친구보다 두 배의 값어치야" },
    { "startMs": 144680, "endMs": 154300, "translation": "두 팔다리를 어깨에 걸친 채, 휩쓸려 가" },
    { "startMs": 154300, "endMs": 161330, "translation": "내가 더 강해졌으니까, 콩고는 어둑해 (연기)" },
    { "startMs": 161330, "endMs": 167770, "translation": "아침이 와, 아-아 (연기)" },
    { "startMs": 167770, "endMs": 185000, "translation": "아침이 와, 아아 (안개)" }
  ]
}
