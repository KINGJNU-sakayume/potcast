{
  "schemaVersion": 2,
  "timing": {
    "lrclibId": 150128,
    "durationMs": 180000
  },
  "segments": [
    {
      "startMs": 14660,
      "endMs": 17860,
      "translation": "지금 Dawn FM에 채널을 맞추셨어요"
    },
    {
      "startMs": 17860,
      "endMs": 20710,
      "translation": "다이얼 위 어디도 아닌 곳의 한가운데예요"
    },
    {
      "startMs": 20710,
      "endMs": 24640,
      "translation": "그러니 편히 앉아 짐을 푸세요"
    },
    {
      "startMs": 24640,
      "endMs": 27320,
      "translation": "여기 한동안 머무시게 될지도 몰라요"
    },
    {
      "startMs": 27320,
      "endMs": 30570,
      "translation": "모든 미래의 계획이 미뤄진 지금"
    },
    {
      "startMs": 30570,
      "endMs": 33720,
      "translation": "당신이 가졌다고 생각한 것들을 돌아볼 시간이에요"
    },
    {
      "startMs": 33720,
      "endMs": 35450,
      "translation": "그것들을 잘 기억하나요?"
    },
    {
      "startMs": 35450,
      "endMs": 39180,
      "translation": "취해 있었나요, 아니면 그냥 멍했나요?"
    },
    {
      "startMs": 39180,
      "endMs": 42130,
      "translation": "그리고 얼마나 많은 원한을 무덤까지 가져갔나요?"
    },
    {
      "startMs": 42130,
      "endMs": 45690,
      "translation": "아무도 좋아해 주지도, 따라 주지도 않을 때 어떻게 행동했나요?"
    },
    {
      "startMs": 45690,
      "endMs": 49050,
      "translation": "당신이 퉁기던 건 어긋난 불협화음이었나요?"
    },
    {
      "startMs": 49050,
      "endMs": 53360,
      "translation": "삶이 흥얼거리던 노래와 한 번이라도 음이 맞았나요?"
    },
    {
      "startMs": 53360,
      "endMs": 56810,
      "translation": "몸이 사라진 지 오래인데도 고통이 계속 살아 있다면"
    },
    {
      "startMs": 56810,
      "endMs": 60280,
      "translation": "그리고 당신의 유령 같은 후회가 아직 그걸 놓아주지 않았다면"
    },
    {
      "startMs": 60280,
      "endMs": 63270,
      "translation": "당신은 마땅히 죽어야 할 방식으로 죽지 못했는지도 몰라요"
    },
    {
      "startMs": 63270,
      "endMs": 67290,
      "translation": "모든 유령은 저마다의 불신에 시달리니까요"
    },
    {
      "startMs": 67290,
      "endMs": 70210,
      "translation": "시간이 다 떨어지면 남는 건 공간뿐이에요"
    },
    {
      "startMs": 70210,
      "endMs": 74000,
      "translation": "사냥도, 채집도, 나라도, 인종도 없어요"
    },
    {
      "startMs": 74000,
      "endMs": 77620,
      "translation": "그리고 천국은 당신 얼굴 위의 그 눈물보다 가까워요"
    },
    {
      "startMs": 77620,
      "endMs": 85490,
      "translation": "그리고 보랏빛 비가 내리는 곳에서 나는 그 은총에 몸을 씻을 거예요"
    },
    {
      "startMs": 85490,
      "endMs": 88660,
      "translation": "천국은 후회를 내려놓은 사람들을 위한 곳이에요"
    },
    {
      "startMs": 88660,
      "endMs": 93620,
      "translation": "그리고 아직 다 오지 못했다면 여기서 기다려야 해요"
    },
    {
      "startMs": 93620,
      "endMs": 96830,
      "translation": "하지만 이 노래가 끝날 때쯤엔 그곳에 닿을 수도 있어요"
    },
    {
      "startMs": 96830,
      "endMs": 100350,
      "translation": "위켄드가 너무 좋아서 일주일 내내 트는 그곳에요"
    },
    {
      "startMs": 100350,
      "endMs": 107000,
      "translation": "징을 울려, 신나게 놀아"
    },
    {
      "startMs": 107000,
      "endMs": 110710,
      "translation": "그리고 부서진 마음이 무거워 저울에 올라서면"
    },
    {
      "startMs": 110710,
      "endMs": 113940,
      "translation": "베일이 걷힐 때 그 마음은 공기보다 가벼워질 거예요"
    },
    {
      "startMs": 113940,
      "endMs": 117400,
      "translation": "꽃들을 보세요, 잘 보이려 애쓰지 않아요"
    },
    {
      "startMs": 117400,
      "endMs": 122040,
      "translation": "그저 꽃잎을 열고 빛을 향해 돌아설 뿐이에요"
    },
    {
      "startMs": 122040,
      "endMs": 126520,
      "translation": "정말 귀 기울여 듣고 있나요? 천국은 저게 아니라 이거예요"
    },
    {
      "startMs": 126520,
      "endMs": 131170,
      "translation": "이 순간의 깊이예요, 행복을 향해 손을 뻗는 게 아니에요"
    },
    {
      "startMs": 131170,
      "endMs": 137410,
      "translation": "삶이 혼돈이라는 건 신도 알지만, 그분은 한 가지를 진실로 만드셨어요"
    },
    {
      "startMs": 137410,
      "endMs": 141430,
      "translation": "마음을 풀고, 영혼이 나란히 서도록 다듬고"
    },
    {
      "startMs": 141430,
      "endMs": 149630,
      "translation": "그 신성한 부갈루를 찾을 때까지 춤춰야 해요"
    },
    {
      "startMs": 149630,
      "endMs": 158330,
      "translation": "다시 말해, 당신이 천국이 되어야 해요"
    },
    {
      "startMs": 158330,
      "endMs": 161310,
      "translation": "천국을 보려면"
    },
    {
      "startMs": 161310,
      "endMs": 180000,
      "translation": "평화가 함께하길"
    }
  ]
}
