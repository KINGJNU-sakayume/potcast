    {
      "startMs": 12570,
      "endMs": 15710,
      "translation": "대마 한 봉지로 시작했어, 좋아 (좋아)"
    },
    {
      "startMs": 15710,
      "endMs": 18660,
      "translation": "그러다 내 인생을 바꿔 버렸지 (내 인생)"
    },
    {
      "startMs": 18660,
      "endMs": 21480,
      "translation": "오늘 밤엔 레이스를 끌고 나갈지도 몰라 (오늘 밤)"
    },
    {
      "startMs": 21480,
      "endMs": 23690,
      "translation": "날 꼭 안아 줘, 자기야"
    },
    {
      "startMs": 23690,
      "endMs": 25770,
      "translation": "난 그냥 날고 싶어"
    },
    {
      "startMs": 25770,
      "endMs": 28500,
      "translation": "죽기 전에 오래 가게 하자"
    },
    {
      "startMs": 28500,
      "endMs": 31530,
      "translation": "네가 타고 싶어 하는 거 알아"
    },
    {
      "startMs": 31530,
      "endMs": 35220,
      "translation": "무슨 생각 해? 무슨 생각 해?"
    },
    {
      "startMs": 35220,
      "endMs": 38110,
      "translation": "내 92년식 차엔 람보르기니 같은 문이 달렸어"
    },
    {
      "startMs": 38110,
      "endMs": 41080,
      "translation": "마지막 월급은 탄약 사는 데 썼어"
    },
    {
      "startMs": 41080,
      "endMs": 43900,
      "translation": "우린 유행을 따르지 않아, 얌스, 편히 잠들길"
    },
    {
      "startMs": 43900,
      "endMs": 47150,
      "translation": "네 신곡은 별로야, 앤서니 판타노가 된 기분으로 말하지 (우)"
    },
    {
      "startMs": 47150,
      "endMs": 49750,
      "translation": "작년엔 빈털터리였어, 다시는 거기로 못 돌아가"
    },
    {
      "startMs": 49750,
      "endMs": 52650,
      "translation": "니코틴 중독인데 담배 한 갑도 못 샀지, 그래"
    },
    {
      "startMs": 52650,
      "endMs": 55550,
      "translation": "그 여자는 내 음악을 몰라, 화 안 났다고 말해 줬어, 그래"
    },
    {
      "startMs": 55550,
      "endMs": 58680,
      "translation": "내 플래티넘 기념패 위에서 코카인을 자르게 둬, 그래 (와)"
    },
    {
      "startMs": 58680,
      "endMs": 61420,
      "translation": "돈뭉치에 손가락을 베였어, 오, 그래"
    },
    {
      "startMs": 61420,
      "endMs": 64320,
      "translation": "신경안정제로 머리를 잠가 버렸어, 오, 그래"
    },
    {
      "startMs": 64320,
      "endMs": 67330,
      "translation": "돈은 미리 세어서 줘, 오, 그래"
    },
    {
      "startMs": 67330,
      "endMs": 70980,
      "translation": "백스트리트 다이아몬드, 네 위에서 춤추는 걸 봐, 그래"
    },
    {
      "startMs": 70980,
      "endMs": 74040,
      "translation": "대마 한 봉지로 시작했어, 좋아 (좋아)"
    },
