  "segments": [
    {
      "startMs": 29780,
      "endMs": 34270,
      "translation": "밤새 잠들 수가 없었어"
    },
    {
      "startMs": 34270,
      "endMs": 38370,
      "translation": "온 힘을 다해 애썼는데"
    },
    {
      "startMs": 38370,
      "endMs": 46660,
      "translation": "네가 원하는 걸 안다고 생각했어"
    },
    {
      "startMs": 46660,
      "endMs": 50730,
      "translation": "그렇게 좋진 않지만"
    },
    {
      "startMs": 50730,
      "endMs": 55010,
      "translation": "그래도 이 정도면 되겠지"
    },
    {
      "startMs": 55010,
      "endMs": 64550,
      "translation": "네가 뭘 원하는지 알기 어려워"
    },
    {
      "startMs": 64550,
      "endMs": 69540,
      "translation": "네가 조금만"
    },
    {
      "startMs": 69540,
      "endMs": 73580,
      "translation": "덜 시면 좋을 텐데, 우린 시시각각 썩어 가"
    },
    {
      "startMs": 73580,
      "endMs": 77750,
      "translation": "내 마음도 썩었어"
    },
    {
      "startMs": 77750,
      "endMs": 86890,
      "translation": "내가 보는 영화마다 난 악당 편이야"
    },
    {
      "startMs": 86890,
      "endMs": 93220,
      "translation": "그러니 돌아서서 내가 더 낫다는 걸 보여 줘"
    },
    {
      "startMs": 93220,
      "endMs": 96380,
      "translation": "어떤 사람들은 사과를 얻었고"
    },
    {
      "startMs": 96380,
      "endMs": 102640,
      "translation": "어떤 사람들은 귤을 얻었어"
    },
    {
      "startMs": 102640,
      "endMs": 108980,
      "translation": "둘러보면 보이는 건 받은 것에 만족하는 사람들뿐"
    },
    {
      "startMs": 108980,
      "endMs": 112950,
      "translation": "인생은 꽤 달콤하다고들 하지"
    },
    {
      "startMs": 112950,
      "endMs": 119430,
      "translation": "난 그냥 운이 지지리도 없나 봐, 레몬 나무를 키우고 있으니"
    },
    {
      "startMs": 119430,
      "endMs": 122170,
      "translation": "다 불태워 버릴 거야"
    },
    {
      "startMs": 122170,
      "endMs": 145680,
      "translation": "그리고 더 나은 걸 키울 거야, 헤이-예"
    },
    {
      "startMs": 145680,
      "endMs": 149560,
      "translation": "손엔 피, 망설이다가 판돈을 두 배로 걸어"
    },
    {
      "startMs": 149560,
      "endMs": 153960,
      "translation": "헛스윙, 옆구리를 걷어차여, 이제 곤경에 빠졌어"
    },
    {
      "startMs": 153960,
      "endMs": 157760,
      "translation": "흙에서 왔으니 죽으면 다시 땅으로 돌아가"
    },
    {
      "startMs": 157760,
      "endMs": 163750,
      "translation": "그래도 난 살아남을 거야, 내 방식이 있으니까, 오"
    },
    {
      "startMs": 163750,
      "endMs": 168670,
