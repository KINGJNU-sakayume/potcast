  "segments": [
    {
      "startMs": 8480,
      "endMs": 11850,
      "translation": "브루클린을 어슬렁거리다 정착할 타입의 여자를 만났어"
    },
    {
      "startMs": 11850,
      "endMs": 15790,
      "translation": "그 여자 아빠는 세상을 쥐고 흔든다고 생각하는 외교관이었지"
    },
    {
      "startMs": 15790,
      "endMs": 19420,
      "translation": "인맥이 두터운 사람이라 내가 앞뒤를 맞추게 도와줬어"
    },
    {
      "startMs": 19420,
      "endMs": 23500,
      "translation": "떠나라고 돈을 줬는데, 꽤 많이 줬다고만 해 두지, 그러니까"
    },
    {
      "startMs": 23500,
      "endMs": 26980,
      "translation": "엠, 이, 엑스, 아이, 씨, 오, 멕시코행이야"
    },
    {
      "startMs": 26980,
      "endMs": 30850,
      "translation": "코코넛 나무 그늘 아래 드러누워"
    },
    {
      "startMs": 30850,
      "endMs": 35230,
      "translation": "사랑은 지옥에나 가라고 했지만, 난 더 있고 싶은 곳이 있어"
    },
    {
      "startMs": 35230,
      "endMs": 39670,
      "translation": "그러니 내겐 엠, 이, 엑스, 아이, 씨, 오야"
    },
    {
      "startMs": 39670,
      "endMs": 43870,
      "translation": "그래서 그 여자 아빠 돈을 챙겼지만 먼저 베이거스에 들렀어"
    },
    {
      "startMs": 43870,
      "endMs": 47550,
      "translation": "스트립에서 댄서를 만나 사랑에 빠졌지"
    },
    {
      "startMs": 47550,
      "endMs": 51460,
      "translation": "엘비스가 이의 있냐고 물을 때 결혼할 뻔했는데"
    },
    {
      "startMs": 51460,
      "endMs": 54960,
      "translation": "그 여자의 조폭 남자 친구가 AK-47을 들고 쳐들어왔어"
    },
    {
      "startMs": 54960,
      "endMs": 55450,
      "translation": "그러니까"
    },
    {
      "startMs": 55450,
      "endMs": 59060,
      "translation": "엠, 이, 엑스, 아이, 씨, 오, 멕시코행이야"
    },
    {
      "startMs": 59060,
      "endMs": 62720,
      "translation": "코코넛 나무 그늘 아래 드러누워"
    },
    {
      "startMs": 62720,
      "endMs": 66990,
      "translation": "사랑은 지옥에나 가라고 했지만, 난 더 있고 싶은 곳이 있어"
    },
    {
      "startMs": 66990,
      "endMs": 104630,
      "translation": "그러니 내겐 엠, 이, 엑스, 아이, 씨, 오야"
    },
    {
      "startMs": 104630,
      "endMs": 106650,
      "translation": "엘패소 남쪽까지 내려갔어"
    },
    {
      "startMs": 106650,
      "endMs": 108540,
      "translation": "거기서 사업하는 여자를 만났지"
    },
    {
      "startMs": 108540,
      "endMs": 110690,
      "translation": "부자인 줄은 알았지만"
    },
    {
      "startMs": 110690,
      "endMs": 112230,
      "translation": "어떻게 버는지는 신경 안 썼어"
    },
    {
      "startMs": 112230,
      "endMs": 116320,
      "translation": "경찰이 문을 박차고 들어와 코카인이 든 가방을 찾았어"
    },
    {
      "startMs": 116320,
      "endMs": 119440,
      "translation": "그 여자는 연방 경찰이랑 사라졌고 죄는 내가 다 뒤집어썼지"
    },
    {
      "startMs": 119440,
      "endMs": 120110,
      "translation": "그러니까"
    },
    {
      "startMs": 120110,
      "endMs": 123580,
      "translation": "엠, 이, 엑스, 아이, 씨, 오, 멕시코행이야"
    },
    {
      "startMs": 123580,
      "endMs": 127270,
      "translation": "이 감방에선 코코넛 나무 하나 안 보여"
    },
    {
      "startMs": 127270,
      "endMs": 133720,
      "translation": "사랑은 지옥에나 가라고 했고, 이제 난 절대 못 떠나"
    },
    {
      "startMs": 133720,
      "endMs": 138230,
      "translation": "그러니 내겐 엠, 이, 엑스, 아이, 씨, 오야"
    },
    {
