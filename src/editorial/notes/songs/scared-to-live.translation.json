  "segments": [
    {
      "startMs": 14220,
      "endMs": 19360,
      "translation": "징조가 보였을 때 널 보내 줬어야 했는데"
    },
    {
      "startMs": 19360,
      "endMs": 24750,
      "translation": "난 널 곁에 붙잡아 뒀지"
    },
    {
      "startMs": 24750,
      "endMs": 30290,
      "translation": "널 붙잡아 뒀대도, 적어도 꼭 안고 있었어 (예)"
    },
    {
      "startMs": 30290,
      "endMs": 34630,
      "translation": "네가 외로웠다는 걸 알았어야 했어"
    },
    {
      "startMs": 34630,
      "endMs": 38400,
      "translation": "다시는 예전 같지 않으리란 걸 알아"
    },
    {
      "startMs": 38400,
      "endMs": 41090,
      "translation": "우리가 잃은 시간은 결코 되돌릴 수 없어"
    },
    {
      "startMs": 41090,
      "endMs": 45320,
      "translation": "네가 사랑하는 법을 잊은 건 나 때문이야"
    },
    {
      "startMs": 45320,
      "endMs": 52500,
      "translation": "그러니 다시 살아가길 두려워하지 마"
    },
    {
      "startMs": 52500,
      "endMs": 56040,
      "translation": "(다시 살아가길 두려워 마)"
    },
    {
      "startMs": 56040,
      "endMs": 63100,
      "translation": "아니, 다시 살아가길 두려워하지 마"
    },
    {
      "startMs": 63100,
      "endMs": 68580,
      "translation": "(다시 살아가길 두려워 마)"
    },
    {
      "startMs": 68580,
      "endMs": 73850,
      "translation": "넌 늘 다른 사람에게 빠질 기회를 놓치지 (다른 사람)"
    },
    {
      "startMs": 73850,
      "endMs": 79330,
      "translation": "네 마음은 나밖에 모르니까"
    },
    {
      "startMs": 79330,
      "endMs": 84590,
      "translation": "다들 네 사랑을 얻으려 했지만, 남은 게 없었어 (남은 게 없었어)"
    },
    {
      "startMs": 84590,
      "endMs": 90320,
      "translation": "그들은 널 외롭게 했을 뿐이야 (오)"
    },
    {
      "startMs": 90320,
      "endMs": 93040,
      "translation": "난 예전의 내가 아니야"
    },
    {
      "startMs": 93040,
      "endMs": 95670,
      "translation": "네게 보여 줄 수 없는 일들도 저질렀어"
    },
    {
      "startMs": 95670,
      "endMs": 99950,
      "translation": "네 마음을 더럽히는 사람이 되긴 싫었어"
    },
    {
      "startMs": 99950,
      "endMs": 107130,
      "translation": "그러니 다시 살아가길 두려워하지 마"
    },
    {
      "startMs": 107130,
      "endMs": 110480,
      "translation": "(다시 살아가길 두려워 마)"
    },
    {
      "startMs": 110480,
      "endMs": 118240,
      "translation": "아니, 다시 살아가길 두려워하지 마, 베이비"
    },
    {
      "startMs": 118240,
      "endMs": 122260,
      "translation": "(다시 살아가길 두려워 마) (오)"
    },
    {
      "startMs": 122260,
      "endMs": 124880,
      "translation": "알아 줬으면 해 (오), 알아 줬으면 해"
    },
    {
      "startMs": 124880,
      "endMs": 127650,
      "translation": "네가 너 자신을 찾길 기도할게"
    },
    {
      "startMs": 127650,
      "endMs": 130250,
      "translation": "알아 줬으면 해 (오), 알아 줬으면 해"
    },
    {
      "startMs": 130250,
      "endMs": 136970,
      "translation": "우린 처음부터 무너지고 있었어"
    },
    {
      "startMs": 136970,
      "endMs": 141920,
      "translation": "널 나의 유일한 사람으로 삼았어야 했는데"
    },
    {
      "startMs": 141920,
      "endMs": 149000,
      "translation": "모든 게 끝나고 나면"
    },
    {
