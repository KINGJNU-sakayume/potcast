{
  "schemaVersion": 2,
  "timing": {
    "lrclibId": 1595939,
    "durationMs": 358000
  },
  "segments": [
    {
      "startMs": 21380,
      "endMs": 26500,
      "translation": "의심할 것 없어, 원하면 가져야 해"
    },
    {
      "startMs": 26500,
      "endMs": 31630,
      "translation": "그게 천천히 내게서 멀어져 가는 게 느껴져"
    },
    {
      "startMs": 31630,
      "endMs": 35770,
      "translation": "난 벼랑 끝에 있어, 그런데 왜 장난이야? 내 말은"
    },
    {
      "startMs": 35770,
      "endMs": 42360,
      "translation": "이 일은 절대, 절대 잊게 두지 않을 거야"
    },
    {
      "startMs": 42360,
      "endMs": 47460,
      "translation": "괜히 하는 말 아니야, 내다봤어, 꿈에서 봤어"
    },
    {
      "startMs": 47460,
      "endMs": 52810,
      "translation": "그게 천천히 내게서 멀어져 가는 게 느껴져"
    },
    {
      "startMs": 52810,
      "endMs": 56840,
      "translation": "더는 기회 없어, 이걸 날리면 넌 가짜야"
    },
    {
      "startMs": 56840,
      "endMs": 62020,
      "translation": "이 일은 절대, 절대 잊게 두지 않을 거야"
    },
    {
      "startMs": 62020,
      "endMs": 64570,
      "translation": "감옥에 갈 확률, 악마는 춤추다가"
    },
    {
      "startMs": 64570,
      "endMs": 67020,
      "translation": "결국엔 가을의 부름에 답하지"
    },
    {
      "startMs": 67020,
      "endMs": 69650,
      "translation": "다들 쓰러져, 성공하고 싶은 마음에"
    },
    {
      "startMs": 69650,
      "endMs": 72380,
      "translation": "코카인 서른 덩이를 들고 걸렸는데, 경찰은 알렉 볼드윈을 닮았지"
    },
    {
      "startMs": 72380,
      "endMs": 75740,
      "translation": "도심의 울분에서 나온 세기의 송가"
    },
    {
      "startMs": 75740,
      "endMs": 77690,
      "translation": "우리가 낙인찍힌 방식에서 나온"
    },
    {
      "startMs": 77690,
      "endMs": 80250,
      "translation": "인정해, 제롬은 브랜든보다 형을 더 받아"
    },
    {
      "startMs": 80250,
      "endMs": 82560,
      "translation": "공항에선 내 가방을 샅샅이 뒤지고"
    },
    {
      "startMs": 82560,
      "endMs": 83910,
      "translation": "그냥 무작위라고 하지"
    },
    {
      "startMs": 83910,
      "endMs": 86980,
      "translation": "그래도 우린 계속 이겨, 이번 주는 엉망인 마사지 같았어"
    },
    {
      "startMs": 86980,
      "endMs": 89570,
      "translation": "해피 엔딩이 필요해, 새로운 시작도"
    },
    {
      "startMs": 89570,
      "endMs": 93390,
      "translation": "새 모자도, 돈 되는 일자리도"
    },
    {
      "startMs": 93390,
      "endMs": 96110,
      "translation": "여긴 현실이야, 친구, 학교는 끝났어"
    },
    {
      "startMs": 96110,
      "endMs": 98600,
      "translation": "누가 네 꿈을 훔쳐 갔는데, 누군지도 모르지"
    },
    {
      "startMs": 98600,
      "endMs": 101320,
      "translation": "난 정부가 에이즈를 다루듯 돈을 다뤄"
    },
    {
      "startMs": 101320,
      "endMs": 104490,
      "translation": "내 사람들 모두에게 퍼질 때까지 만족 못 해, 알겠어?"
    },
    {
      "startMs": 104490,
      "endMs": 109560,
      "translation": "의심할 것 없어, 원하면 가져야 해"
    },
    {
      "startMs": 109560,
      "endMs": 114620,
      "translation": "그게 천천히 내게서 멀어져 가는 게 느껴져"
    },
    {
      "startMs": 114620,
      "endMs": 119330,
      "translation": "난 벼랑 끝에 있어, 그런데 왜 장난이야? 내 말은"
    },
    {
      "startMs": 119330,
      "endMs": 124850,
      "translation": "이 일은 절대, 절대 잊게 두지 않을 거야"
    },
    {
      "startMs": 124850,
      "endMs": 127600,
      "translation": "힙합은 그저 새로운 종교를 돌려 말한 걸까?"
    },
    {
      "startMs": 127600,
      "endMs": 130110,
      "translation": "요즘 젊은이들이 잊은 노예들의 소울 음악"
    },
    {
      "startMs": 130110,
      "endMs": 132840,
      "translation": "하지만 이건 내 구원의 길 그 이상이야"
    },
    {
      "startMs": 132840,
      "endMs": 135500,
      "translation": "말콤 웨스트가 온 나라를 차렷 자세로 세웠지"
    },
    {
      "startMs": 135500,
      "endMs": 138150,
      "translation": "내가 폴로를 입고 웃는 동안엔 날 손에 쥐었다고 생각해"
    },
    {
      "startMs": 138150,
      "endMs": 140820,
      "translation": "하지만 흑인다운 내 모습을 보면 날 깨부수려 하겠지"
    },
    {
      "startMs": 140820,
      "endMs": 143370,
      "translation": "해고당하지 않을 분야를 골랐다고 생각했어"
    },
    {
      "startMs": 143370,
      "endMs": 145910,
      "translation": "점프 슛을 쏘거나 육상 트랙을 뛰는 흑인이 아니라면 말이야"
    },
    {
      "startMs": 145910,
      "endMs": 148730,
      "translation": "하지만 이 포주는 올림포스산 꼭대기에 있어"
    },
    {
      "startMs": 148730,
      "endMs": 151130,
      "translation": "세계 대회에 나갈 준비가 됐지, 이건 내 올림픽이야"
    },
    {
      "startMs": 151130,
      "endMs": 154030,
      "translation": "판이 이렇게 포주 같으니 다들 굽신거리게 만들지"
    },
    {
      "startMs": 154030,
      "endMs": 156510,
      "translation": "사우스 파크 작가 목구멍에 생선 튀김을 쑤셔 넣어 줘"
    },
    {
      "startMs": 156510,
      "endMs": 159340,
      "translation": "이제 그만 내게 매달리라고 했어"
    },
    {
      "startMs": 159340,
      "endMs": 161680,
      "translation": "그리고 이 약들, 다들 못 참지"
    },
    {
      "startMs": 161680,
      "endMs": 164100,
      "translation": "알리를 징집하려던 때가 떠올라"
    },
    {
      "startMs": 164100,
      "endMs": 167480,
      "translation": "내가 가장 위대한 놈이 아니었던 적이 있다면, 난 그걸 놓쳤나 봐"
    },
    {
      "startMs": 167480,
      "endMs": 172480,
      "translation": "의심할 것 없어, 원하면 가져야 해"
    },
    {
      "startMs": 172480,
      "endMs": 177650,
      "translation": "그게 천천히 내게서 멀어져 가는 게 느껴져"
    },
    {
      "startMs": 177650,
      "endMs": 181940,
      "translation": "난 벼랑 끝에 있어, 그런데 왜 장난이야? 내 말은"
    },
    {
      "startMs": 181940,
      "endMs": 187590,
      "translation": "이 일은 절대, 절대 잊게 두지 않을 거야"
    },
    {
      "startMs": 187590,
      "endMs": 189340,
      "translation": "술은 더, 조명은 덜 필요해"
    },
    {
      "startMs": 189340,
      "endMs": 191910,
      "translation": "타이츠만 입은 아메리칸 어패럴 모델 같은 여자도"
    },
    {
      "startMs": 191910,
      "endMs": 194590,
      "translation": "그녀는 감독한테 학교에 들어가려는 중이라고 했대"
    },
    {
      "startMs": 194590,
      "endMs": 197250,
      "translation": "감독은 \"안경 벗고 수영장에 들어가\" 했지"
    },
    {
      "startMs": 197250,
      "endMs": 199020,
      "translation": "텔레비전 안 본 지 꽤 됐어"
    },
    {
      "startMs": 199020,
      "endMs": 203220,
      "translation": "크립 갱처럼 파란 게 너무 많아서, 나쁜 소식은 더 못 견뎌"
    },
    {
      "startMs": 203220,
      "endMs": 205940,
      "translation": "이력서를 보니 오늘따라 내가 참 근사해"
    },
    {
      "startMs": 205940,
      "endMs": 208680,
      "translation": "다들 역사를 고쳐 쓰니, 난 어제를 믿지 않아"
    },
    {
      "startMs": 208680,
      "endMs": 211540,
      "translation": "흑인 비틀스가 뭐겠어, 그냥 바퀴벌레지"
    },
    {
      "startMs": 211540,
      "endMs": 214080,
      "translation": "그래서 날 이코노미석에 앉히나 봐"
    },
    {
      "startMs": 214080,
      "endMs": 216240,
      "translation": "친구가 그러더라, 다른 방법이 필요하다고"
    },
    {
      "startMs": 216240,
      "endMs": 218740,
      "translation": "사람들이 날 코카인 하는 놈 보듯 쳐다보니까"
    },
    {
      "startMs": 218740,
      "endMs": 221490,
      "translation": "이제 하나도 안 웃겨, 다른 농담 해 봐"
    },
    {
      "startMs": 221490,
      "endMs": 224090,
      "translation": "내 엉덩이에 포옹이랑 키스나 하라고 해, 엑스 앤드 오"
    },
    {
      "startMs": 224090,
      "endMs": 226950,
      "translation": "그러는 김에 반지에 입 맞추고, 내가 가진 동안 내 일 하게 둬"
    },
    {
      "startMs": 226950,
      "endMs": 229540,
      "translation": "그 시시한 것들의 극적인 결말엔 현악을 깔아"
    },
    {
      "startMs": 229540,
      "endMs": 231910,
      "translation": "두 체급에서 벨트를 가져 본 적 없는 것처럼 굴어"
    },
    {
      "startMs": 231910,
      "endMs": 234730,
      "translation": "가진 게 없으면, 가진 놈을 쫓아갈 거야"
    },
    {
      "startMs": 234730,
      "endMs": 237560,
      "translation": "쫓아갈 거야, 누가 가졌지?"
    },
    {
      "startMs": 237560,
      "endMs": 239750,
      "translation": "너 뜨고 있다고? 잘됐네, 환상적이야"
    },
    {
      "startMs": 239750,
      "endMs": 242250,
      "translation": "그런 거야, 다들, 원래 그래"
    },
    {
      "startMs": 242250,
      "endMs": 244600,
      "translation": "난 정말 하나도 신경 안 써"
    },
    {
      "startMs": 244600,
      "endMs": 247260,
      "translation": "날 따돌리려던 그 사람들이"
    },
    {
      "startMs": 247260,
      "endMs": 251000,
      "translation": "두 가지를 잊었거든, 내 검은 두 쪽을"
    },
    {
      "startMs": 251000,
      "endMs": 256190,
      "translation": "의심할 것 없어, 원하면 가져야 해"
    },
    {
      "startMs": 256190,
      "endMs": 260860,
      "translation": "그게 천천히 내게서 멀어져 가는 게 느껴져"
    },
    {
      "startMs": 260860,
      "endMs": 265480,
      "translation": "난 벼랑 끝에 있어, 그런데 왜 장난이야? 내 말은"
    },
    {
      "startMs": 265480,
      "endMs": 270170,
      "translation": "이 일은 절대, 절대 잊게 두지 않을 거야"
    },
    {
      "startMs": 270170,
      "endMs": 273320,
      "translation": "어이, 팀버랜드 신고, 렌즈 너머로 살았지, 꼬마"
    },
    {
      "startMs": 273320,
      "endMs": 276330,
      "translation": "아르마니 정장, 신선한 과일, 발리 부츠에 벤츠"
    },
    {
      "startMs": 276330,
      "endMs": 278380,
      "translation": "돈을 세고, 피우고, 수갑 한쪽 찬 채로"
    },
    {
      "startMs": 278380,
      "endMs": 281570,
      "translation": "빨간 재규어처럼 살아, 루이 가방, 대마를 집어, 될 대로 되라"
    },
    {
      "startMs": 281570,
      "endMs": 283640,
      "translation": "백한 개쯤 말아 피워"
    },
    {
      "startMs": 283640,
      "endMs": 286660,
      "translation": "감옥에 편지 보내고, 운동복 사고, 스테트슨 매장에 들이닥쳐"
    },
    {
      "startMs": 286660,
      "endMs": 288820,
      "translation": "그 녀석 모자 센스는 특별했어"
    },
    {
      "startMs": 288820,
      "endMs": 292060,
      "translation": "검은 나이키 한 켤레마다 맞췄지, 주사위로 푼돈을 걸고"
    },
    {
      "startMs": 292060,
      "endMs": 294780,
      "translation": "나이 든 대담한 형님은 병사를 길러 냈어"
    },
    {
      "startMs": 294780,
      "endMs": 298060,
      "translation": "현장에서 제대로 하게, 죽은 병사가 되지 않게"
    },
    {
      "startMs": 298060,
      "endMs": 300650,
      "translation": "그건 비상사태란 뜻이었어, 검은 스컹크에 취해서"
    },
    {
      "startMs": 300650,
      "endMs": 302730,
      "translation": "검은 시가를 말아, 낡은 창고 뒤에서"
    },
    {
      "startMs": 302730,
      "endMs": 305640,
      "translation": "못 살면 죽는 거야, 내주든가 사들이든가"
    },
    {
      "startMs": 305640,
      "endMs": 307510,
      "translation": "진짜로 살든가 계속 움직이든가, 계속 버텨"
    },
    {
      "startMs": 307510,
      "endMs": 310680,
      "translation": "계속 빛나, 모든 젊은이에게 이게 계획이야"
    },
    {
      "startMs": 310680,
      "endMs": 313550,
      "translation": "레이와 카녜 같은 형제들에게서 배워"
    },
    {
      "startMs": 313550,
      "endMs": 318690,
      "translation": "괜히 하는 말 아니야, 내다봤어, 꿈에서 봤어"
    },
    {
      "startMs": 318690,
      "endMs": 323830,
      "translation": "그게 천천히 내게서 멀어져 가는 게 느껴져"
    },
    {
      "startMs": 323830,
      "endMs": 328080,
      "translation": "더는 기회 없어, 이걸 날리면 넌 가짜야"
    },
    {
      "startMs": 328080,
      "endMs": 358000,
      "translation": "이 일은 절대, 절대 잊게 두지 않을 거야"
    }
  ]
}
