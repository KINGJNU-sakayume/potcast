    {
      "startMs": 6290,
      "endMs": 8360,
      "translation": "아, 그녀는 혀를 꼬이게 하는 폭풍이야"
    },
    {
      "startMs": 8360,
      "endMs": 9850,
      "translation": "오늘 밤 공연에 오지"
    },
    {
      "startMs": 9850,
      "endMs": 14190,
      "translation": "빛의 기계에 기도하면서"
    },
    {
      "startMs": 14190,
      "endMs": 15890,
      "translation": "그녀가 원하는 건 내 돈이 아니라 내 꿀이야"
    },
    {
      "startMs": 15890,
      "endMs": 17530,
      "translation": "그녀는 펑키한 허벅지를 수집하고"
    },
