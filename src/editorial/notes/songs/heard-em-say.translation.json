  "segments": [
    {
      "startMs": 230,
      "endMs": 840,
      "translation": "미스터 웨스트, 미스터 웨스트, 미스터 웨스트"
    },
    {
      "startMs": 840,
      "endMs": 10840,
      "translation": "어, 그래, 어, 그래, 어, 그래"
    },
    {
      "startMs": 10840,
      "endMs": 14820,
      "translation": "사람들이 그러더라, 오늘은 내일을 약속해 주지 않는다고"
    },
    {
      "startMs": 14820,
      "endMs": 16770,
      "translation": "시카고 출신이라, 팀처럼 더 험한 길이지"
    },
    {
      "startMs": 16770,
      "endMs": 19480,
      "translation": "그러니 이건 로버트 말처럼 사랑의 이름으로 하는 거야"
    },
    {
      "startMs": 19480,
      "endMs": 22100,
      "translation": "오늘 당장 일자리를 구하라고 하기 전에"
    },
    {
      "startMs": 22100,
      "endMs": 24540,
      "translation": "최저임금이라도 좀 올려 줄 수 없을까?"
    },
    {
      "startMs": 24540,
      "endMs": 27200,
      "translation": "그리고 정부가 에이즈를 퍼뜨린다는 것도 알아"
    },
    {
      "startMs": 27200,
      "endMs": 29770,
      "translation": "그러니 목사님 말처럼 그냥 기도나 하는 수밖에"
    },
    {
      "startMs": 29770,
      "endMs": 32760,
      "translation": "알라후 아크바르, 그리고 그에게 뜨거운 차나 던져 줘"
    },
    {
      "startMs": 32760,
      "endMs": 35170,
      "translation": "화면에서 보는 것들은 우리 것이 아니지"
    },
    {
      "startMs": 35170,
      "endMs": 37670,
      "translation": "그래도 이 녀석들은 동네 출신이라 그 꿈이 멀지 않아"
    },
    {
      "startMs": 37670,
      "endMs": 39940,
      "translation": "내가 온 곳에선 마약상들이 록스타야"
    },
    {
      "startMs": 39940,
      "endMs": 42500,
      "translation": "하지만 차를 사려 해도 경찰차부터 마주치지"
    },
    {
      "startMs": 42500,
      "endMs": 45230,
      "translation": "우릴 다 감옥에 넣고 싶은가 봐, 난 알아"
    },
    {
      "startMs": 45230,
      "endMs": 50800,
      "translation": "어, 사람들이 그러더라 (우), 오늘은 내일을 약속해 주지 않는다고"
    },
    {
      "startMs": 50800,
      "endMs": 52820,
      "translation": "사람들이 그러더라"
    },
    {
      "startMs": 52820,
      "endMs": 56130,
      "translation": "오늘은 내일을 약속해 주지 않는다고 (오늘은 내일을 약속해 주지 않아)"
    },
    {
      "startMs": 56130,
      "endMs": 57940,
      "translation": "그래도 우린 방법을 찾을 거야"
    },
    {
      "startMs": 57940,
      "endMs": 62740,
      "translation": "영원한 건 없지만 솔직해 줘, 자기"
    },
    {
      "startMs": 62740,
      "endMs": 65810,
      "translation": "아프지만 그게 유일한 길일지도 몰라"
    },
    {
      "startMs": 65810,
      "endMs": 67760,
      "translation": "사람들은 인생의 사람들이 계절 같다고 하지"
    },
    {
      "startMs": 67760,
      "endMs": 70380,
      "translation": "일어나는 모든 일엔 이유가 있다고"
    },
    {
      "startMs": 70380,
      "endMs": 72870,
      "translation": "그리고 녀석들은 총을 쏘고 또 방아쇠를 당기고"
    },
    {
      "startMs": 72870,
      "endMs": 75290,
      "translation": "할머니는 계속 기도하고 계속 믿어"
    },
    {
      "startMs": 75290,
      "endMs": 77470,
      "translation": "예수님을, 그리고 언젠가 그분을 볼 거라고"
    },
    {
      "startMs": 77470,
      "endMs": 80460,
      "translation": "그때까진 그분의 발자취를 따라 그분처럼 살라고"
    },
    {
      "startMs": 80460,
      "endMs": 82980,
      "translation": "악마는 살아 있어, 숨소리가 느껴져"
    },
    {
      "startMs": 82980,
      "endMs": 85640,
      "translation": "돈이 열쇠라고 하면서 계속 꿈이나 꾸라고"
    },
    {
      "startMs": 85640,
      "endMs": 87820,
      "translation": "복권은 그냥 우릴 놀리려고 있는 거야"
    },
    {
      "startMs": 87820,
      "endMs": 90220,
      "translation": "팸 고모는 그 담배를 끊지 못해"
    },
    {
      "startMs": 90220,
      "endMs": 92680,
      "translation": "그래서 이제 내 어린 사촌도 그 담배를 피워"
    },
    {
      "startMs": 92680,
      "endMs": 95370,
      "translation": "사촌 직장에선 걔가 너무 '흑인 티'가 난다고 한대"
    },
    {
      "startMs": 95370,
      "endMs": 97740,
      "translation": "피부가 감초 사탕보다 검어서 그런 걸까"
    },
    {
      "startMs": 97740,
      "endMs": 100560,
      "translation": "도무지 모르겠어, 이젠 지긋지긋해"
    },
    {
      "startMs": 100560,
      "endMs": 106450,
      "translation": "어, 어, 사람들이 그러더라, 오늘은 내일을 약속해 주지 않는다고"
    },
    {
      "startMs": 106450,
      "endMs": 108240,
      "translation": "사람들이 그러더라"
    },
    {
      "startMs": 108240,
      "endMs": 111600,
      "translation": "오늘은 내일을 약속해 주지 않는다고 (오늘은 내일을 약속해 주지 않아)"
    },
    {
      "startMs": 111600,
      "endMs": 113260,
      "translation": "그래도 우린 방법을 찾을 거야"
    },
    {
      "startMs": 113260,
      "endMs": 117910,
      "translation": "영원한 건 없지만 솔직해 줘, 자기"
    },
    {
      "startMs": 117910,
      "endMs": 123670,
      "translation": "아프지만 그게 유일한 길일지도 몰라"
    },
    {
      "startMs": 123670,
      "endMs": 128230,
      "translation": "쓸모없는 말이 하나씩 늘 때마다 우린 더 멀어져"
    },
    {
      "startMs": 128230,
      "endMs": 133480,
      "translation": "그리고 오늘은 내일을 약속해 주지 않아"
    },
    {
      "startMs": 133480,
      "endMs": 138610,
      "translation": "영원한 건 없지만 솔직해 줘, 자기"
    },
    {
      "startMs": 138610,
      "endMs": 142340,
      "translation": "아프지만 그게 유일한 길일지도 몰라"
    },
    {
      "startMs": 142340,
      "endMs": 147930,
      "translation": "우우우"
    },
    {
      "startMs": 147930,
      "endMs": 151120,
      "translation": "우우, 오, 오, 오"
    },
    {
      "startMs": 151120,
      "endMs": 206000,
      "translation": "오오, 오오오"
    }
  ]
}
