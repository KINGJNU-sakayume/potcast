  "segments": [
    {
      "startMs": 230,
      "endMs": 2480,
      "translation": "세워 총, 하"
    },
    {
      "startMs": 2480,
      "endMs": 5350,
      "translation": "요"
    },
    {
      "startMs": 5350,
      "endMs": 7940,
      "translation": "우린 전쟁 중이야"
    },
    {
      "startMs": 7940,
      "endMs": 12600,
      "translation": "테러리즘과, 인종주의와 전쟁 중이고"
    },
    {
      "startMs": 12600,
      "endMs": 17190,
      "translation": "무엇보다 우린 우리 자신과 전쟁 중이야"
    },
    {
      "startMs": 17190,
      "endMs": 19130,
      "translation": "(예수가 걸어가)"
    },
    {
      "startMs": 19130,
      "endMs": 22380,
      "translation": "하나님, 길을 보여 주세요, 악마가 날 무너뜨리려 해요"
    },
    {
      "startMs": 22380,
      "endMs": 27850,
      "translation": "(예수님, 나와 함께 걸어 주세요)"
    },
    {
      "startMs": 27850,
      "endMs": 30720,
      "translation": "중서부가 뭔지 알아? 젊고 불안한 곳"
    },
    {
      "startMs": 30720,
      "endMs": 33510,
      "translation": "불안한 놈들이 네 목걸이를 낚아챌 수도 있고"
    },
    {
      "startMs": 33510,
      "endMs": 36230,
      "translation": "그다음엔 그놈들이 네 렉서스를 털 수도 있는 곳"
    },
    {
      "startMs": 36230,
      "endMs": 39190,
      "translation": "누가 저놈들한테 카녜 웨스트가 누군지 좀 알려 줘"
    },
    {
      "startMs": 39190,
      "endMs": 41970,
      "translation": "난 죽음이 도사린 시카고의 골짜기를 걸어"
    },
    {
      "startMs": 41970,
      "endMs": 45150,
      "translation": "꼭대기 층에서 보는 경치만으로도 숨이 멎을 거야"
    },
    {
      "startMs": 45150,
      "endMs": 47140,
      "translation": "잡으려 해 봐, 좀 어려울 거야"
    },
    {
      "startMs": 47140,
      "endMs": 49910,
      "translation": "형사들한테 목을 졸리면서, 그래, 그래, 이제 수법을 봐"
    },
    {
      "startMs": 49910,
      "endMs": 52850,
      "translation": "우리한테 질문을 퍼붓고, 괴롭히고, 체포해"
    },
    {
      "startMs": 52850,
      "endMs": 55600,
      "translation": "\"너 같은 쓰레기는 아침거리로 먹어 치운다\"면서"
    },
    {
      "startMs": 55600,
      "endMs": 58380,
      "translation": "뭐? 쓰레기를 먹는다고? 근거가 뭔데?"
    },
    {
      "startMs": 58380,
      "endMs": 61160,
      "translation": "우린 갈 데도 없는데 정장이랑 가방은 있지"
    },
    {
      "startMs": 61160,
      "endMs": 63980,
      "translation": "트렁크엔 코카인이 가득, 차는 에이비스 렌터카"
    },
    {
      "startMs": 63980,
      "endMs": 66540,
      "translation": "엄마는 늘 예수만이 우릴 구할 수 있다고 했어"
    },
    {
      "startMs": 66540,
      "endMs": 68980,
      "translation": "그래, 엄마, 내가 멍청하게 구는 거 알아"
    },
    {
      "startMs": 68980,
      "endMs": 72400,
      "translation": "그래도 11월까진 떠나 있을 거야, 팔아야 할 물건이 있거든, 부디"
    },
    {
      "startMs": 72400,
      "endMs": 73860,
      "translation": "(예수가 걸어가)"
    },
    {
      "startMs": 73860,
      "endMs": 79210,
      "translation": "하나님, 길을 보여 주세요, 악마가 날 무너뜨리려 해요"
    },
    {
      "startMs": 79210,
      "endMs": 84650,
      "translation": "내가 비는 건 하나뿐이야, 지금 내 발이 날 버리지 않기를"
    },
    {
      "startMs": 84650,
      "endMs": 90350,
      "translation": "이제 와서 내 잘못을 바로잡을 방법은 없을 것 같아"
    },
    {
      "startMs": 90350,
      "endMs": 95730,
      "translation": "하나님께 말을 걸고 싶은데 겁이 나, 너무 오래 얘기하지 않았거든"
    },
    {
      "startMs": 95730,
      "endMs": 101280,
      "translation": "하나님, 길을 보여 주세요, 악마가 날 무너뜨리려 해요"
    },
    {
      "startMs": 101280,
      "endMs": 106740,
      "translation": "내가 비는 건 하나뿐이야, 지금 내 발이 날 버리지 않기를"
    },
    {
      "startMs": 106740,
      "endMs": 112190,
      "translation": "이제 와서 내 잘못을 바로잡을 방법은 없을 것 같아"
    },
    {
      "startMs": 112190,
      "endMs": 117720,
      "translation": "하나님께 말을 걸고 싶은데 겁이 나, 너무 오래 얘기하지 않았거든"
    },
    {
      "startMs": 117720,
      "endMs": 120440,
      "translation": "너무 오래"
    },
    {
      "startMs": 120440,
      "endMs": 126780,
      "translation": "너무 오래"
    },
    {
      "startMs": 126780,
      "endMs": 130650,
      "translation": "허슬러들, 살인자들, 마약상들, 그리고 스트리퍼들에게도"
    },
    {
      "startMs": 130650,
      "endMs": 132030,
      "translation": "(예수는 그들을 위해 걸어)"
    },
    {
      "startMs": 132030,
      "endMs": 136230,
      "translation": "생활 보조금의 희생자들에게, 우린 여기 지옥에서 살고 있으니까, 그래, 지옥이야"
    },
    {
      "startMs": 136230,
      "endMs": 137680,
      "translation": "(예수는 그들을 위해 걸어)"
    },
    {
      "startMs": 137680,
      "endMs": 140850,
      "translation": "자, 들어라, 들어라, 당신을 더 똑똑히 보고 싶어"
    },
    {
      "startMs": 140850,
      "endMs": 143350,
      "translation": "내 발이 지칠 때 그분이 내 말을 들으신다는 걸 알아"
    },
    {
      "startMs": 143350,
      "endMs": 146170,
      "translation": "우린 거의 멸종하다시피 했으니까"
    },
    {
      "startMs": 146170,
      "endMs": 148920,
      "translation": "우리 래퍼들은 롤 모델이지, 랩은 하는데 생각은 안 해"
    },
    {
      "startMs": 148920,
      "endMs": 151710,
      "translation": "난 그분의 얼굴 생김새를 두고 따지러 온 게 아니야"
    },
    {
      "startMs": 151710,
      "endMs": 154510,
      "translation": "무신론자를 신자로 바꾸러 온 것도 아니고"
    },
    {
      "startMs": 154510,
      "endMs": 156740,
      "translation": "그냥 학교에 선생이 필요하듯"
    },
    {
      "startMs": 156740,
      "endMs": 159960,
      "translation": "캐시 리에게 레지스가 필요했듯, 나에겐 예수가 필요하다는 거야"
    },
    {
      "startMs": 159960,
      "endMs": 162430,
      "translation": "그러니 여기 내 싱글이야, 라디오엔 이게 필요하거든"
    },
    {
      "startMs": 162430,
      "endMs": 165420,
      "translation": "다들 그러지, 예수만 빼고 뭐든 랩으로 해도 된다고"
    },
    {
      "startMs": 165420,
      "endMs": 167830,
      "translation": "그러니까 총, 섹스, 거짓말, 비디오테이프는 되고"
    },
    {
      "startMs": 167830,
      "endMs": 171510,
      "translation": "하나님 얘길 하면 내 노래는 안 틀어 준다는 거지, 응?"
    },
    {
      "startMs": 171510,
      "endMs": 173770,
      "translation": "그래, 이걸로 내 방송 횟수가 줄고"
    },
    {
      "startMs": 173770,
      "endMs": 175620,
      "translation": "그래서 아마 내 수입도 줄겠지만"
    },
    {
      "startMs": 175620,
      "endMs": 177530,
      "translation": "그만큼 내 죄도 줄었으면 좋겠어"
    },
    {
      "startMs": 177530,
      "endMs": 179530,
      "translation": "그리고 내가 꿈꾸는 그날이 오기를"
    },
    {
      "startMs": 179530,
      "endMs": 181980,
      "translation": "다음에 클럽에 가면 모두가 외치는 날"
    },
    {
      "startMs": 181980,
      "endMs": 183850,
      "translation": "(예수가 걸어가)"
    },
    {
      "startMs": 183850,
      "endMs": 189190,
      "translation": "하나님, 길을 보여 주세요, 악마가 날 무너뜨리려 해요"
    },
    {
      "startMs": 189190,
      "endMs": 194000,
      "translation": "내가 비는 건 하나뿐이야, 지금 내 발이 날 버리지 않기를"
    }
  ]
}
