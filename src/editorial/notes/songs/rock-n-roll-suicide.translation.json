  "segments": [
    {
      "startMs": 14440,
      "endMs": 21680,
      "translation": "시간은 담배 한 개비를 집어 네 입에 물린다"
    },
    {
      "startMs": 21680,
      "endMs": 28950,
      "translation": "넌 손가락 하나를 빨고, 또 하나를 빨고, 그러다 담배를 문다"
    },
    {
      "startMs": 28950,
      "endMs": 35930,
      "translation": "온 벽이 널 부르고, 그 소리가 맴돌다 넌 잊어버려"
    },
    {
      "startMs": 35930,
      "endMs": 44030,
      "translation": "오, 넌 로큰롤 자살자야"
    },
    {
      "startMs": 44030,
      "endMs": 49180,
      "translation": "놓아 버리기엔 너무 늙었고, 선택하기엔 너무 젊어"
    },
    {
      "startMs": 49180,
      "endMs": 55450,
      "translation": "시계는 네 노래를 아주 참을성 있게 기다리고"
    },
    {
      "startMs": 55450,
      "endMs": 62950,
      "translation": "카페를 지나치지만, 너무 오래 살아 버리면 먹지도 않지"
    },
    {
      "startMs": 62950,
      "endMs": 71380,
      "translation": "오, 아니, 아니, 아니, 넌 로큰롤 자살자야"
    },
    {
      "startMs": 71380,
      "endMs": 79020,
      "translation": "쉐보레 브레이크가 으르렁거리고 네가 비틀거리며 길을 건널 때"
    },
    {
      "startMs": 79020,
      "endMs": 85010,
      "translation": "하지만 대신 날이 밝아 와서 넌 집으로 서둘러"
    },
    {
      "startMs": 85010,
      "endMs": 88910,
      "translation": "햇빛이 네 그림자를 날려 버리게 두지 마"
    },
    {
      "startMs": 88910,
      "endMs": 92540,
      "translation": "우유 배달차가 네 정신을 휘젓게 두지 마"
    },
    {
      "startMs": 92540,
      "endMs": 97860,
      "translation": "그들은 너무 자연스럽고, 종교처럼 무심하게 잔인해"
    },
    {
      "startMs": 97860,
      "endMs": 102020,
      "translation": "아니야, 사랑아, 넌 혼자가 아니야"
    },
    {
      "startMs": 102020,
      "endMs": 105920,
      "translation": "넌 자신을 지켜보고 있지만, 너 자신에게 너무 가혹해"
    },
    {
      "startMs": 105920,
      "endMs": 112630,
      "translation": "머릿속이 온통 엉켜 있지만, 내가 네가 스스로를 아끼게만 할 수 있다면"
    },
    {
      "startMs": 112630,
      "endMs": 115710,
      "translation": "아니야, 사랑아, 넌 혼자가 아니야"
    },
    {
      "startMs": 115710,
      "endMs": 119170,
      "translation": "네가 무엇이었든 누구였든 상관없어"
    },
    {
      "startMs": 119170,
      "endMs": 122620,
      "translation": "언제 어디에서 무엇을 봤든 상관없어"
    },
    {
      "startMs": 122620,
      "endMs": 125530,
      "translation": "모든 칼날이 네 머리를 찢는 것 같아도"
    },
    {
      "startMs": 125530,
      "endMs": 130030,
      "translation": "나도 내 몫만큼 겪었어, 그 아픔을 함께 덜어 줄게"
    },
    {
      "startMs": 130030,
      "endMs": 135580,
      "translation": "넌 혼자가 아니야"
    },
    {
      "startMs": 135580,
      "endMs": 142150,
      "translation": "나와 함께 깨어나, 넌 혼자가 아니야"
    },
    {
      "startMs": 142150,
      "endMs": 148690,
      "translation": "함께 깨어나서 혼자가 아니게 되자"
    },
    {
      "startMs": 148690,
      "endMs": 155340,
      "translation": "손을 줘, 넌 멋진 사람이니까"
    },
    {
      "startMs": 155340,
      "endMs": 161790,
      "translation": "손을 줘, 넌 멋진 사람이니까"
    },
    {
      "startMs": 161790,
      "endMs": 177000,
      "translation": "오, 손을 줘"
    }
  ]
}
