  "segments": [
    {
      "startMs": 40,
      "endMs": 1000,
      "translation": "자, 이걸 이겨 봐"
    },
    {
      "startMs": 1000,
      "endMs": 2680,
      "translation": "엄마는 \"대학 가라\" 하시지"
    },
    {
      "startMs": 2680,
      "endMs": 5280,
      "translation": "그래서 대학을 마치면, 아주 멋져"
    },
    {
      "startMs": 5280,
      "endMs": 6620,
      "translation": "기분이 정말 좋지"
    },
    {
      "startMs": 6620,
      "endMs": 8740,
      "translation": "파티랑 온갖 난리를 다 치르고 나면"
    },
    {
      "startMs": 8740,
      "endMs": 12630,
      "translation": "아, 학교에서 친구들이랑 어울리다 생긴 마약 습관도 잊지 말고"
    },
    {
      "startMs": 12630,
      "endMs": 16120,
      "translation": "자, 이제 연봉 2만 5천 달러짜리 직장을 얻는 거야"
    },
    {
      "startMs": 16120,
      "endMs": 19290,
      "translation": "그리고 그 돈을 몽땅 크랙에 쓰겠지"
    },
    {
      "startMs": 19290,
      "endMs": 20320,
      "translation": "하지만 그건 네 돈이야"
    },
    {
      "startMs": 20320,
      "endMs": 22930,
      "translation": "약값 때문에 엄마한테 손 벌릴 일은 이제 없어"
    },
    {
      "startMs": 22930,
      "endMs": 25370,
      "translation": "그러니 이제 학위를 등에 문신으로 새겨"
    },
    {
      "startMs": 25370,
      "endMs": 27150,
      "translation": "너무 신나니까"
    },
    {
      "startMs": 27150,
      "endMs": 31820,
      "translation": "갭에서 계속 일하다 보면, 면접을 몇 번 보고 나서, 세상에"
    },
    {
      "startMs": 31820,
      "endMs": 33930,
      "translation": "신입 자리로 들어가게 될 거야"
    },
    {
      "startMs": 33930,
      "endMs": 35580,
      "translation": "그렇게 들어가서"
    },
    {
      "startMs": 35580,
      "endMs": 39300,
      "translation": "아부를 충분히 하면 다음 단계로 올라가지"
    },
    {
      "startMs": 39300,
      "endMs": 41810,
      "translation": "그게 뭐냐면 비서의 비서야"
    },
    {
      "startMs": 41810,
      "endMs": 43430,
      "translation": "와, 그거 정말 대단하지"
    },
    {
      "startMs": 43430,
      "endMs": 45560,
      "translation": "비서한테 온 메시지를 대신 받아 적어야 하거든"
    },
    {
      "startMs": 45560,
      "endMs": 47360,
      "translation": "그 비서는 대학도 안 나왔는데"
    },
    {
      "startMs": 47360,
      "endMs": 49090,
      "translation": "알고 보니 사장 조카야"
    },
    {
      "startMs": 49090,
      "endMs": 51630,
      "translation": "그러니 이제 너도 가족이 된 거지"
    },
    {
      "startMs": 51630,
      "endMs": 53290,
      "translation": "대학이 너한테 뭘 해 주는지 알아?"
    },
    {
      "startMs": 53290,
      "endMs": 54780,
      "translation": "진짜 똑똑하게 만들어 줘"
    },
    {
      "startMs": 54780,
      "endMs": 56960,
      "translation": "너희는 다 교실 뒤에서 떠들고 싶어 했지"
    },
    {
      "startMs": 56960,
      "endMs": 59540,
      "translation": "난 아니었어, 난 귀 기울여 들었다고, 알겠어?"
    },
    {
      "startMs": 59540,
      "endMs": 61940,
      "translation": "난 복도 감독이었어"
    },
    {
      "startMs": 61940,
      "endMs": 63740,
      "translation": "이건 운명이었지"
    },
    {
      "startMs": 63740,
      "endMs": 65080,
      "translation": "내가 수업을 몇 개나 들었는지 알아?"
    },
    {
      "startMs": 65080,
      "endMs": 66360,
      "translation": "추가 수업, 추가 수업"
    },
    {
      "startMs": 66360,
      "endMs": 67990,
      "translation": "아니, 섹스는 해 본 적 없어"
    },
    {
      "startMs": 67990,
      "endMs": 69090,
      "translation": "그런데 그거 알아?"
    },
    {
      "startMs": 69090,
      "endMs": 72130,
      "translation": "내 학위가 날 만족시켜 줘"
    },
    {
      "startMs": 72130,
      "endMs": 73470,
      "translation": "어떤 여자가 다가와서 이렇게 말하면"
    },
    {
      "startMs": 73470,
      "endMs": 74200,
      "translation": "\"저기, 섹시한 게 뭔지 알아요?\""
    },
    {
      "startMs": 74200,
      "endMs": 75880,
      "translation": "난 이렇게 대답해, \"아니, 그게 뭔지는 몰라"
    },
    {
      "startMs": 75880,
      "endMs": 79000,
      "translation": "하지만 당신 지갑 속 잔돈은 아주 빨리 다 더할 수 있어\""
    }
  ]
}
