  "segments": [
    {
      "startMs": 840,
      "endMs": 9470,
      "translation": "네가 사랑한다고 말했을 때 꿈인 줄 알았어. 아무것도 아닌 것의 시작이었지."
    },
    {
      "startMs": 9470,
      "endMs": 16940,
      "translation": "준비할 틈도 없었고, 네가 올 줄은 보지 못했어. 아무것도 아닌 것의 시작이었지."
    },
    {
      "startMs": 16940,
      "endMs": 21130,
      "translation": "아, 이제 널 미워해도 되겠지."
    },
    {
      "startMs": 21130,
      "endMs": 25580,
      "translation": "너도 이제 날 미워해도 괜찮아."
    },
    {
      "startMs": 25580,
      "endMs": 33720,
      "translation": "우리 둘 다 마음 깊은 곳에서는 알잖아. 그 느낌만은 여전히 좋다는 걸."
    },
    {
      "startMs": 33720,
      "endMs": 37920,
      "translation": "벽 너머까지 볼 수 있다면, 네가 거짓으로 꾸미고 있다는 걸 알 텐데."
    },
    {
      "startMs": 37920,
      "endMs": 41400,
      "translation": "네가 내 생각을 볼 수 있다면, 우리 얼굴이 보일 거야."
    },
    {
      "startMs": 41400,
      "endMs": 46270,
      "translation": "그때는 빌린 차 안이 장갑 트럭처럼 안전했지."
    },
    {
      "startMs": 46270,
      "endMs": 48830,
      "translation": "그땐 좆도 신경 안 썼어."
    },
    {
      "startMs": 48830,
      "endMs": 52260,
      "translation": "난 더 이상 어린애가 아니야."
    },
    {
      "startMs": 52260,
      "endMs": 57060,
      "translation": "우리는 그때의 애들로 다시는 돌아가지 못해."
    },
    {
      "startMs": 57060,
      "endMs": 64590,
      "translation": "우린 시드네 집으로 차를 몰곤 했지, 그때는. 그때는."
    },
    {
      "startMs": 64590,
      "endMs": 71120,
      "translation": "내가 뭘 했어도 그때는 내 기세가 꺾이지 않았어."
    },
    {
      "startMs": 71120,
      "endMs": 73670,
      "translation": "그때는 모든 게 별로였는데,"
    },
    {
      "startMs": 73670,
      "endMs": 74920,
      "translation": "우린 친구였어."
    },
    {
      "startMs": 74920,
      "endMs": 83240,
      "translation": "네가 사랑한다고 말했을 때 꿈인 줄 알았어. 아무것도 아닌 것의 시작이었지."
    },
    {
      "startMs": 83240,
      "endMs": 91290,
      "translation": "준비할 틈도 없었고, 네가 올 줄은 보지 못했어. 아무것도 아닌 것의 시작이었지."
    },
    {
      "startMs": 91290,
      "endMs": 95290,
      "translation": "아, 이제 널 미워해도 되겠지."
    },
    {
      "startMs": 95290,
      "endMs": 99790,
      "translation": "너도 이제 날 미워해도 괜찮아."
    },
    {
      "startMs": 99790,
      "endMs": 108760,
      "translation": "하지만 우리 둘 다 마음 깊은 곳에서는 알잖아. 그 느낌만은 여전히 좋다는 걸."
    },
    {
      "startMs": 108760,
      "endMs": 115740,
      "translation": "네 호텔 복도에서, 내 어깨에 팔을 두르던 그 손길로 알 수 있었어."
    },
    {
      "startMs": 115740,
      "endMs": 120340,
      "translation": "내가 네게 얼마나 큰 의미였는지, 그때는 진심이었다는 걸."
    },
    {
      "startMs": 120340,
      "endMs": 122920,
      "translation": "그땐 죽일 시간이 넘쳐 났지."
    },
    {
      "startMs": 122920,
      "endMs": 126670,
      "translation": "너도 이제 어린애가 아니야."
    },
    {
      "startMs": 126670,
      "endMs": 131180,
      "translation": "우리는 그때의 애들로 다시는 돌아가지 못해."
    },
    {
      "startMs": 131180,
      "endMs": 135000,
      "translation": "예전 같지 않아. 상아는 불법이니까."
    },
    {
      "startMs": 135000,
      "endMs": 139440,
      "translation": "기억 안 나?"
    },
    {
      "startMs": 139440,
      "endMs": 145180,
      "translation": "내가 지난주에 네 마음을 아프게 했지. 주말쯤엔 아마 나아지겠지."
    },
    {
      "startMs": 145180,
      "endMs": 149870,
      "translation": "그래도 기억나. 네가 미칠 듯이 내 이름을 외치던 거."
    },
    {
      "startMs": 149870,
      "endMs": 157180,
      "translation": "마음 깊은 곳의 그 느낌은 좋아."
    },
    {
      "startMs": 157180,
      "endMs": 165700,
      "translation": "네가 사랑한다고 말했을 때 꿈인 줄 알았어. 아무것도 아닌 것의 시작이었지."
    },
    {
      "startMs": 165700,
      "endMs": 173700,
      "translation": "준비할 틈도 없었고, 네가 올 줄은 몰랐어. 그렇게 우린 아무것도 없는 데서 시작했지."
    },
    {
      "startMs": 173700,
      "endMs": 177720,
      "translation": "아, 이제 널 미워해도 되겠지."
    },
    {
      "startMs": 177720,
      "endMs": 182330,
      "translation": "너도 이제 날 미워해도 괜찮아."
    },
    {
      "startMs": 182330,
      "endMs": 190140,
      "translation": "우리 둘 다 마음 깊은 곳에서는 알잖아. 그 느낌만은 여전히 좋다는 걸."
    },
    {
      "startMs": 190140,
      "endMs": 198360,
      "translation": "내가 하려던 게 아니었던 말들, 하려던 게 아니었던 행동들."
    },
    {
      "startMs": 198360,
      "endMs": 205560,
      "translation": "너도 굳이 할 필요 없던 말들이 있었어. 일부러 그랬던 거야? 일부러?"
    },
    {
      "startMs": 205560,
      "endMs": 221870,
      "translation": "계속 네 꿈을 꾸고 있어, 네 꿈을."
    },
    {
      "startMs": 221870,
      "endMs": 249000,
      "translation": "계속 꿈꾸고 있어, 꿈을 꾸고 있어."
    }
  ]
