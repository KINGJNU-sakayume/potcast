  "segments": [
    {
      "startMs": 20560,
      "endMs": 25940,
      "translation": "슬퍼서 걷어찼어, 땅을 세게"
    },
    {
      "startMs": 25940,
      "endMs": 31060,
      "translation": "튕겨 오르는 빛에 손가락을 치켜들고"
    },
    {
      "startMs": 31060,
      "endMs": 36220,
      "translation": "사랑하고 싶어서 물어뜯었어, 숨통 깊숙이"
    },
    {
      "startMs": 36220,
      "endMs": 51460,
      "translation": "그 모습이 너무나 아름다워서 말이야"
    },
    {
      "startMs": 51460,
      "endMs": 56780,
      "translation": "혀를 차며 황야 한가운데서 바람에 맞서"
    },
    {
      "startMs": 56780,
      "endMs": 62060,
      "translation": "밤새도록 쉰 첫울음으로 노래해"
    },
    {
      "startMs": 62060,
      "endMs": 67450,
      "translation": "멀리 더 멀리 응시하고 있었지, 얼어붙은 별 너머까지"
    },
    {
      "startMs": 67450,
      "endMs": 72040,
      "translation": "멍투성이 마음을 빛내며"
    },
    {
      "startMs": 72040,
      "endMs": 77440,
      "translation": "그 모습을 언제나 나는 쫓고 있었어"
    },
    {
      "startMs": 77440,
      "endMs": 82400,
      "translation": "구르듯 선을 꿰뚫고 찔러 들어가는 칼끝을"
    },
    {
      "startMs": 82400,
      "endMs": 87680,
      "translation": "그늘에 핀 해바라기가 지금도 여름을 기다리고 있어"
    },
    {
      "startMs": 87680,
      "endMs": 93240,
      "translation": "사람들의 열기를 가르고 웃어 줘, 내 안에서 한 번 더"
    },
    {
      "startMs": 93240,
      "endMs": 98390,
      "translation": "날아가 버려, 산탄총을 쏘아 갈겨, 내일을 향해"
    },
    {
      "startMs": 98390,
      "endMs": 113330,
      "translation": "토해 내, 북극성으로 키를 잡아, 그 손으로"
    },
    {
      "startMs": 113330,
      "endMs": 118680,
      "translation": "상처 입고, 정맥을 불쑥 휘도는 일렉"
    },
    {
      "startMs": 118680,
      "endMs": 124210,
      "translation": "쥐어뜯고 휘몰아치며 울리는 애가"
    },
    {
      "startMs": 124210,
      "endMs": 129360,
      "translation": "들리고 있어, 그때부터 조금도 끊이지 않은 채"
    },
    {
      "startMs": 129360,
      "endMs": 134160,
      "translation": "떨릴 만큼 전부, 사라지지 않아"
    },
    {
      "startMs": 134160,
      "endMs": 139460,
      "translation": "그 모습이 언제나 나를 비추고 있었어"
    },
    {
      "startMs": 139460,
      "endMs": 144320,
      "translation": "만약 같은 거리에서 태어났다면 너처럼 될 수 있었을까"
    },
    {
      "startMs": 144320,
      "endMs": 149650,
      "translation": "그늘에 핀 해바라기가 지금도 바다를 바라보고 있어"
    },
    {
      "startMs": 149650,
      "endMs": 155130,
      "translation": "들린다면 힘껏 외쳐 줘, 내 이름을 한 번 더"
    },
    {
      "startMs": 155130,
      "endMs": 160020,
      "translation": "울음소리, 쨍쨍 내리쬐는 거리에서 쓸쓸히 노닐며"
    },
    {
      "startMs": 160020,
      "endMs": 185840,
      "translation": "풀어놓아, 난반사하며 멀리, 울려 퍼져"
    },
    {
      "startMs": 185840,
      "endMs": 191100,
      "translation": "그 모습을 언제나 나는 쫓고 있었어"
    },
    {
      "startMs": 191100,
      "endMs": 196000,
      "translation": "구르듯 선을 꿰뚫고 찔러 들어가는 칼끝을"
    },
