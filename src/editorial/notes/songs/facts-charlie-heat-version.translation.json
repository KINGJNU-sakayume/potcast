  "segments": [
    {
      "startMs": 660,
      "endMs": 20140,
      "translation": "안에 쌓인 먼지와 때와 오물, 내 평생의 이야기야. 속이고 훔치며 형제의 고통은 느끼지도 않았지, 네 더러운 엄마"
    },
    {
      "startMs": 20140,
      "endMs": 26580,
      "translation": "하, 하, 하, 우리가 얼마나 멀리 왔는지 봐, 봐, 봐, 봐, 봐, 봐, 봐"
    },
    {
      "startMs": 26580,
      "endMs": 27750,
      "translation": "완벽해!"
    },
    {
      "startMs": 27750,
      "endMs": 30990,
      "translation": "이지, 이지, 이지가 방금 점프맨을 뛰어넘었어"
    },
    {
      "startMs": 30990,
      "endMs": 33720,
      "translation": "이지, 이지, 이지가 방금 점프맨을 뛰어넘었어"
    },
    {
      "startMs": 33720,
      "endMs": 34580,
      "translation": "요!"
    },
    {
      "startMs": 34580,
      "endMs": 37530,
      "translation": "이지, 이지, 이지, 너무 뿌듯해"
    },
    {
      "startMs": 37530,
      "endMs": 40880,
      "translation": "말도 많이 했지만 숫자로도 보여 줬어"
    },
    {
      "startMs": 40880,
      "endMs": 44150,
      "translation": "헤르초크와 아디다스, 걔들이 좋아하는 거 알잖아"
    },
    {
      "startMs": 44150,
      "endMs": 47830,
      "translation": "나이키에 드리지마저 없었다면 아무것도 없었을 거야, 우!"
    },
    {
      "startMs": 47830,
      "endMs": 51070,
      "translation": "나이키에 돈 씨마저 없었다면 아무것도 없었을 거야, 오!"
    },
    {
      "startMs": 51070,
      "endMs": 54470,
      "translation": "하지만 가족은 모두 응원해, 돈 벌라고 전해"
    },
    {
      "startMs": 54470,
      "endMs": 57850,
      "translation": "이지, 이지, 이지, 며칠씩 줄을 서"
    },
    {
      "startMs": 57850,
      "endMs": 61160,
      "translation": "나이키는 상태가 나빠, 공짜로 줘도 안 가져가"
    },
    {
      "startMs": 61160,
      "endMs": 64660,
      "translation": "뿌리를 지켰어, 지미 팰런처럼"
    },
    {
      "startMs": 64660,
      "endMs": 68250,
      "translation": "앨범도 안 냈는데 신발이 플래티넘이 됐어, 우!"
    },
    {
      "startMs": 68250,
      "endMs": 71360,
      "translation": "내가 말할 때마다 너무 공격적이라고 해"
    },
    {
      "startMs": 71360,
      "endMs": 74820,
      "translation": "밖에서 난리를 쳤어, 다들 뜻을 알아들었어?"
    },
    {
      "startMs": 74820,
      "endMs": 77990,
      "translation": "경기장에선 지나치게 무모해, 오델 베컴 모드야"
    },
    {
      "startMs": 77990,
      "endMs": 81730,
      "translation": "2020년, 선거 전체를 휘어잡을 거야, 야!"
    },
    {
      "startMs": 81730,
      "endMs": 85150,
      "translation": "난 몇 년째 화제야, 너희는 며칠이고"
    },
    {
      "startMs": 85150,
      "endMs": 88440,
      "translation": "이지가 여기 있어, 막 가치를 평가받았지"
    },
    {
      "startMs": 88440,
      "endMs": 91880,
      "translation": "나이키, 나이키는 직원을 노예처럼 대해"
    },
    {
      "startMs": 91880,
      "endMs": 95130,
      "translation": "르브론이 떠나지 못하게 십억 달러를 줬어, 요!"
    },
    {
      "startMs": 95130,
      "endMs": 98420,
      "translation": "노리에게 줄 만 달러짜리 모피를 막 샀어, 요!"
    },
    {
      "startMs": 98420,
      "endMs": 101540,
      "translation": "네 아이 아빠는 딸을 쇼핑에 데려가지도 않아, 요!"
    },
    {
      "startMs": 101540,
      "endMs": 105200,
      "translation": "다시는 안 입을 디자이너 옷도 입어 봤어"
    },
    {
      "startMs": 105200,
      "endMs": 108880,
      "translation": "그 놈들을 유명하게 만들어 주면 거만해져"
    },
    {
      "startMs": 108880,
      "endMs": 112170,
      "translation": "이지, 이지, 이지가 방금 점프맨을 뛰어넘었어, 아!"
    },
    {
      "startMs": 112170,
      "endMs": 114920,
      "translation": "이지, 이지, 이지가 방금 점프맨을 뛰어넘었어"
    },
    {
      "startMs": 114920,
      "endMs": 115730,
      "translation": "소닉 붐!"
    },
    {
      "startMs": 115730,
      "endMs": 118620,
      "translation": "이지, 이지, 이지, 이건 순수한 사치야"
    },
    {
      "startMs": 118620,
      "endMs": 122210,
      "translation": "DJ 머스터드 위에 그레이 푸퐁을 얹어 줘, 아!"
    },
    {
      "startMs": 122210,
      "endMs": 125590,
      "translation": "허세를 떨 것도 없으면 왜 랩해, 응?"
    },
    {
      "startMs": 125590,
      "endMs": 128910,
      "translation": "게다가 키모지가 앱스토어를 멈춰 버렸어, 아!"
    },
    {
      "startMs": 128910,
      "endMs": 131440,
      "translation": "우린 일 분에 백만을 벌었어, 일 분에 백만을 벌었어"
    },
    {
      "startMs": 131440,
      "endMs": 132370,
      "translation": "그랬지"
    },
    {
      "startMs": 132370,
      "endMs": 135750,
      "translation": "그래, 우린 일 분에 백만을 벌었어, 일 분에 백만을 벌었어, 아!"
    },
    {
      "startMs": 135750,
      "endMs": 138920,
      "translation": "빌 코스비를 안타깝게 생각하는 사람 있어?"
    },
    {
      "startMs": 138920,
      "endMs": 142320,
      "translation": "스티브 하비처럼 이름을 잊어버렸나? 요!"
    },
    {
      "startMs": 142320,
      "endMs": 145580,
      "translation": "아디다스에 생산량 백만이 필요하다고 말해, 요!"
    },
    {
      "startMs": 145580,
      "endMs": 148890,
      "translation": "말했잖아, 내게 필요했던 건 기반뿐이라고, 붐!"
    },
    {
      "startMs": 148890,
      "endMs": 152300,
      "translation": "이젠 거리에서 우리가 제일 뜨거워, 논쟁할 것 없어"
    },
    {
      "startMs": 152300,
      "endMs": 155730,
      "translation": "제임스 하든과 스웨기 피가 예산을 키워, 요가 플레임!"
    },
    {
      "startMs": 155730,
      "endMs": 158960,
      "translation": "물건은 내 아이 엄마의 엄마 집에 둬"
    },
    {
      "startMs": 158960,
      "endMs": 162460,
      "translation": "난 못된 놈이야, 일이 필요하면 내 배우자에게 전화해"
    },
    {
      "startMs": 162460,
      "endMs": 165890,
      "translation": "이지, 이지, 로데오에서 나랑 사진 찍어"
    },
    {
      "startMs": 165890,
      "endMs": 169120,
      "translation": "이지, 이지, 이지, 내 호텔을 할 수도 있어"
    },
    {
      "startMs": 169120,
      "endMs": 172480,
      "translation": "소파, 소파, 소파, 소파, 어느 걸 고를까?"
    },
    {
      "startMs": 172480,
      "endMs": 176080,
      "translation": "아주 깊은 게 필요해, 난 여자 몸도 아주 풍만한 게 좋아, 소닉 붐!"
    },
    {
      "startMs": 176080,
      "endMs": 179360,
      "translation": "뉴스를 볼 때마다 고향이 떠올라"
    },
    {
      "startMs": 179360,
      "endMs": 182630,
      "translation": "DJ 마노에게 전화해, 트와일라이트 톤에게 인사해"
    },
    {
      "startMs": 182630,
      "endMs": 186030,
      "translation": "그냥 살아 있다는 게 축복이야, 그래, 정말 그렇잖아?"
    },
    {
      "startMs": 186030,
      "endMs": 189240,
      "translation": "그러니 팀벅투의 삶을 기리자"
    },
    {
      "startMs": 189240,
      "endMs": 190370,
      "translation": "팀벅투, 팀벅투, 팀벅투"
    },
    {
      "startMs": 190370,
      "endMs": 191950,
      "translation": "팀벅투, 팀벅투"
    },
    {
      "startMs": 191950,
      "endMs": 192990,
      "translation": "팀벅투, 팀벅투"
    },
    {
      "startMs": 192990,
      "endMs": 198980,
      "translation": "하, 하, 하, 우리가 얼마나 멀리 왔는지 봐, 봐, 봐, 봐, 봐, 봐, 봐"
    },
    {
      "startMs": 198980,
      "endMs": 199830,
      "translation": "완벽해!"
    }
  ]
