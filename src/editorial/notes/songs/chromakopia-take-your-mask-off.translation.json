{
  "schemaVersion": 2,
  "timing": {
    "lrclibId": 14207008,
    "durationMs": 253936
  },
  "segments": [
    {
      "startMs": 1080,
      "endMs": 5310,
      "translation": "음-흠, 음-흠."
    },
    {
      "startMs": 5310,
      "endMs": 10390,
      "translation": "(아, 아, 우) 랄랄랄랄랄랄랄."
    },
    {
      "startMs": 10390,
      "endMs": 13640,
      "translation": "어. 큰 총, 큰 총, 가진 게 뭐야, 어?"
    },
    {
      "startMs": 13640,
      "endMs": 16300,
      "translation": "슬랫, 슬랫 하다가 적들한테 되받아쳐, 어?"
    },
    {
      "startMs": 16300,
      "endMs": 18190,
      "translation": "갱이 어쩌고 갱이 저쩌고 하면서"
    },
    {
      "startMs": 18190,
      "endMs": 20730,
      "translation": "네가 그렇게 된 걸 후회한다는 건 걔들이 모르게 해."
    },
    {
      "startMs": 20730,
      "endMs": 23400,
      "translation": "착한 애에, 번듯한 집에, 사진 속엔 엄마 아빠가 있고"
    },
    {
      "startMs": 23400,
      "endMs": 26260,
      "translation": "중산층 돈이 좀 있어서 크리스마스마다 제대로 지냈지."
    },
    {
      "startMs": 26260,
      "endMs": 28890,
      "translation": "가족 여행, 살짝 얽매인 채로 살다가 어느 날 스위치를 눌렀어."
    },
    {
      "startMs": 28890,
      "endMs": 30970,
      "translation": "계집애 취급받기 싫었던 거지, 왜냐면"
    },
    {
      "startMs": 30970,
      "endMs": 33790,
      "translation": "얼굴 문신 따위로는 네가 슬프다는 사실을 못 가려, 형."
    },
    {
      "startMs": 33790,
      "endMs": 36140,
      "translation": "넌 깡패가 아니야, 연극부였잖아, 배우였다고."
    },
    {
      "startMs": 36140,
      "endMs": 39500,
      "translation": "근데 이젠 멍청하고 헷갈리는 놈들한테 인정받겠다고 (에이, 블러드)"
    },
    {
      "startMs": 39500,
      "endMs": 42710,
      "translation": "증명할 게 있다고 징역 5년에서 10년을 마주하고 있네, 얘기 좀 해 보자."
    },
    {
      "startMs": 42710,
      "endMs": 45290,
      "translation": "그리고 네가 너 자신을 찾길 바라 (어)"
    },
    {
      "startMs": 45290,
      "endMs": 47810,
      "translation": "그리고 네가 너 자신을 찾길 바라 (그래)"
    },
    {
      "startMs": 47810,
      "endMs": 52920,
      "translation": "그리고 네가 가면을 벗길 바라 (슬픈 이야기네, 아하하, 그래)"
    },
    {
      "startMs": 52920,
      "endMs": 54900,
      "translation": "설교자 양반, 설교자 양반, 설교해 봐."
    },
    {
      "startMs": 54900,
      "endMs": 58430,
      "translation": "사람들한테 가르칠 게 있다고 믿게 만들지, 거짓말 안 하는 척하면서."
    },
    {
      "startMs": 58430,
      "endMs": 60950,
      "translation": "헌금 걷은 걸로 두둑하게 챙겼는데, 그래서 뭘 사는데?"
    },
    {
      "startMs": 60950,
      "endMs": 63900,
      "translation": "게이들 별로 안 좋아하잖아, 부인 안 하지, 잠깐."
    },
    {
      "startMs": 63900,
      "endMs": 65920,
      "translation": "어릴 때부터 뭔가 다르다는 걸 알았지."
    },
    {
      "startMs": 65920,
      "endMs": 68520,
      "translation": "신이 널 미워할 거라고 생각하게 돼서 덮어 버렸어."
    },
    {
      "startMs": 68520,
      "endMs": 71150,
      "translation": "어떻게 사는지, 진짜 뭘 좋아하는지 숨겨야 했고"
    },
    {
      "startMs": 71150,
      "endMs": 73920,
      "translation": "그래서 아내도 얻고 애도 얻었는데, 남자애들이랑 떡치고 다니잖아."
    },
    {
      "startMs": 73920,
      "endMs": 76560,
      "translation": "수치도, 안에 쌓인 고통도 지긋지긋하고"
    },
    {
      "startMs": 76560,
      "endMs": 79000,
      "translation": "들키는 게 두렵고, 죄를 꾸짖는 것도 지쳤어."
    },
    {
      "startMs": 79000,
      "endMs": 81890,
      "translation": "다 내주고 자유로워져서 해처럼 환하게 빛나고 싶은데"
    },
    {
      "startMs": 81890,
      "endMs": 85050,
      "translation": "사정하자마자 다시 그 종교 타령으로 돌아가네, 얘기 좀 해 보자."
    },
    {
      "startMs": 85050,
      "endMs": 87980,
      "translation": "그리고 네가 너 자신을 찾길 바라 (네가 너 자신을 찾길 바라)"
    },
    {
      "startMs": 87980,
      "endMs": 90390,
      "translation": "그리고 네가 너 자신을 찾길 바라"
    },
    {
      "startMs": 90390,
      "endMs": 94150,
      "translation": "그리고 네가 가면을 벗길 바라 (가면을 벗길 바라)"
    },
    {
      "startMs": 94150,
      "endMs": 96040,
      "translation": "언덕 위의 어마어마한 집 (언덕)"
    },
    {
      "startMs": 96040,
      "endMs": 98040,
      "translation": "차고에는 어마어마한 바퀴들 (차고)"
    },
    {
      "startMs": 98040,
      "endMs": 99840,
      "translation": "품에는 귀여운 애가 셋"
    },
    {
      "startMs": 99840,
      "endMs": 101840,
      "translation": "남편은 방금 또 100만 달러를 벌었고"
    },
    {
      "startMs": 101840,
      "endMs": 103880,
      "translation": "넌 네 삶을 돌려받고 마사지를 받고 싶어."
    },
    {
      "startMs": 103880,
      "endMs": 106540,
      "translation": "집에만 있는 게 지치고, 개성은 사라졌어."
    },
    {
      "startMs": 106540,
      "endMs": 110510,
      "translation": "몸은 예전 같지 않고, 산후 회복은 길고, 정체성은 사라졌지."
    },
    {
      "startMs": 110510,
      "endMs": 113070,
      "translation": "이름 대신 '엄마'로 불리고, 성은 바뀌었어."
    },
    {
      "startMs": 113070,
      "endMs": 116620,
      "translation": "다들 네 둥지를 꿈꾸는데 넌 혼자 날기를 갈망해, 이봐."
    },
    {
      "startMs": 116620,
      "endMs": 119120,
      "translation": "솔직히 말하면 넌 처음부터 다시 시작하고 싶을 거야."
    },
    {
      "startMs": 119120,
      "endMs": 121840,
      "translation": "지금의 삶은 가득 찼는데 채워진 느낌은 안 들고"
    },
    {
      "startMs": 121840,
      "endMs": 124160,
      "translation": "선반에 올려 둔 꿈을 공상하지."
    },
    {
      "startMs": 124160,
      "endMs": 126670,
      "translation": "혼자만의 시간이 없어서 자살을 생각할 틈조차 없어."
    },
    {
      "startMs": 126670,
      "endMs": 127590,
      "translation": "얘기 좀 해 보자."
    },
    {
      "startMs": 127590,
      "endMs": 129980,
      "translation": "그리고 네가 너 자신을 찾길 바라 (아, 좁아지는 느낌이야)"
    },
    {
      "startMs": 129980,
      "endMs": 132620,
      "translation": "그리고 네가 너 자신을 찾길 바라"
    },
    {
      "startMs": 132620,
      "endMs": 146220,
      "translation": "그리고 네가 가면을 벗길 바라 (오)"
    },
    {
      "startMs": 146220,
      "endMs": 151880,
      "translation": "너한테, 너 자신한테 100퍼센트 솔직해져."
    },
    {
      "startMs": 151880,
      "endMs": 154080,
      "translation": "아무 의상도 입을 필요 없어."
    },
    {
      "startMs": 154080,
      "endMs": 157300,
      "translation": "어울리려고 거짓말할 필요 없어."
    },
    {
      "startMs": 157300,
      "endMs": 161200,
      "translation": "그래, 물건은 안 서고 가슴은 아프고"
    },
    {
      "startMs": 161200,
      "endMs": 163760,
      "translation": "머리카락은 빠지는데 스트레스 탓은 안 하지."
    },
    {
      "startMs": 163760,
      "endMs": 166030,
      "translation": "새 상대 탓이라 하고, 전 애인 탓을 하고"
    },
    {
      "startMs": 166030,
      "endMs": 168360,
      "translation": "가슴 통증은 반사작용이라 우기고, 요리사 탓을 하려 들지."
    },
    {
      "startMs": 168360,
      "endMs": 171420,
      "translation": "봐, 애송이, 계속 뛰면 발에 쥐 날 테니까."
    },
    {
      "startMs": 171420,
      "endMs": 174150,
      "translation": "초조한데, 알고 보니 후크(hook)에는 신호가 안 잡히고"
    },
    {
      "startMs": 174150,
      "endMs": 176650,
      "translation": "열아홉 때부터 편집증이었고 신경계가 흔들려."
    },
    {
      "startMs": 176650,
      "endMs": 179780,
      "translation": "당장 앉아, 씨발, 안 그러면 그 두개골 털린다."
    },
    {
      "startMs": 179780,
      "endMs": 183070,
      "translation": "천만 달러를 투자했는데 정당화할 길이 없어."
    },
    {
      "startMs": 183070,
      "endMs": 185660,
      "translation": "이상한 옷을 팔려고 하는데 아무도 안 사."
    },
    {
      "startMs": 185660,
      "endMs": 188270,
      "translation": "취지는 맞아, 근데 네 관객은 충분히 쌓이지 않았어."
    },
    {
      "startMs": 188270,
      "endMs": 190760,
      "translation": "그건 실패작이야, 야, 어서 짐 싸."
    },
    {
      "startMs": 190760,
      "endMs": 191920,
      "translation": "그리고 트렁크에 처박아."
    },
    {
      "startMs": 191920,
      "endMs": 194610,
      "translation": "1등도 아니면서 허세는 엄청 부리네 (아니)"
    },
    {
      "startMs": 194610,
      "endMs": 198750,
      "translation": "네 비트는 안 팔리고, 곡들은 안 터지고, 랩은 순위에 못 들어."
    },
    {
      "startMs": 198750,
      "endMs": 202340,
      "translation": "네 무대 장악력은 걔들 얘기에 끼지도 못해, 집에 가."
    },
    {
      "startMs": 202340,
      "endMs": 203980,
      "translation": "진실로부터 숨을 필요 없어."
    },
    {
      "startMs": 203980,
      "endMs": 205950,
      "translation": "가족한테 말해, 왜 그렇게 틀어박혀 사는지."
    },
    {
      "startMs": 205950,
      "endMs": 208590,
      "translation": "네 영혼에게 말해, 왜 부스 안에서 끝났다고 느끼는지."
    },
    {
      "startMs": 208590,
      "endMs": 210520,
      "translation": "이봐, 감히 그 여자 결혼을 망치려 들어 (제발)"
    },
    {
      "startMs": 210520,
      "endMs": 213180,
      "translation": "가면을 쓴 적 없다고 우기면서 창피하지도 않나."
    },
    {
      "startMs": 213180,
      "endMs": 216330,
      "translation": "야, 넌 존나 이기적이야, 그래서 부모 되는 게 진짜 무서운 거지."
    },
    {
      "startMs": 216330,
      "endMs": 219780,
      "translation": "야, 상담 치료가 필요해, 받아 보라고 하고 싶지만 내기에서 지겠지."
    },
    {
      "startMs": 219780,
      "endMs": 222350,
      "translation": "네 존경은 우리가 네 부고를 올릴 때까지 안 돌아와."
    },
    {
      "startMs": 222350,
      "endMs": 224830,
      "translation": "살아 있을 때 꽃을 받았으면 했던 게 뻔해."
    },
    {
      "startMs": 224830,
      "endMs": 227470,
      "translation": "균형 맞추겠다고 비료를 먹고 있지."
    },
    {
      "startMs": 227470,
      "endMs": 230970,
      "translation": "이제 가서 햇볕 아래 서, 가짜 눈물로 네 뿌리에 물을 줘."
    },
    {
      "startMs": 230970,
      "endMs": 233450,
      "translation": "그 가면 벗고 걔들한테 진실을 말해, 얘기 좀 해 보자, 야."
    },
    {
      "startMs": 233450,
      "endMs": 236060,
      "translation": "그리고 네가 너 자신을 찾길 바라"
    },
    {
      "startMs": 236060,
      "endMs": 238660,
      "translation": "그리고 네가 너 자신을 찾길 바라"
    },
    {
      "startMs": 238660,
      "endMs": 253936,
      "translation": "그리고 네가 가면을 벗길 바라"
    }
  ]
}