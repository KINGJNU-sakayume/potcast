  "segments": [
    {
      "startMs": 17150,
      "endMs": 22260,
      "translation": "시장 광장을 헤치고 지나간다"
    },
    {
      "startMs": 22260,
      "endMs": 27020,
      "translation": "수많은 어머니들이 한숨 쉬고 있었다"
    },
    {
      "startMs": 27020,
      "endMs": 30320,
      "translation": "막 뉴스가 전해졌다"
    },
    {
      "startMs": 30320,
      "endMs": 36430,
      "translation": "우리에게 울며 버틸 시간이 5년 남았다고"
    },
    {
      "startMs": 36430,
      "endMs": 40210,
      "translation": "뉴스 진행자는 울면서 우리에게 말했다"
    },
    {
      "startMs": 40210,
      "endMs": 45770,
      "translation": "지구가 정말 죽어 가고 있다고"
    },
    {
      "startMs": 45770,
      "endMs": 49320,
      "translation": "너무 울어 얼굴이 흠뻑 젖어 있었고"
    },
    {
      "startMs": 49320,
      "endMs": 54230,
      "translation": "그제야 나는 그가 거짓말하지 않는다는 걸 알았다"
    },
    {
      "startMs": 54230,
      "endMs": 55930,
      "translation": "전화기 소리를 들었다"
    },
    {
      "startMs": 55930,
      "endMs": 57080,
      "translation": "오페라 극장을"
    },
    {
      "startMs": 57080,
      "endMs": 58750,
      "translation": "좋아하던 선율들을"
    },
    {
      "startMs": 58750,
      "endMs": 60390,
      "translation": "소년들을 보았다"
    },
    {
      "startMs": 60390,
      "endMs": 61440,
      "translation": "장난감들을"
    },
    {
      "startMs": 61440,
      "endMs": 63690,
      "translation": "전기다리미와 TV들을"
    },
    {
      "startMs": 63690,
      "endMs": 65970,
      "translation": "내 머리는 창고처럼 아팠다"
    },
    {
      "startMs": 65970,
      "endMs": 68180,
      "translation": "더 들어갈 자리가 없었다"
    },
    {
      "startMs": 68180,
      "endMs": 70080,
      "translation": "너무 많은 걸 쑤셔 넣어야 했다"
    },
    {
      "startMs": 70080,
      "endMs": 72410,
      "translation": "그 안에 전부 저장해 두려고"
    },
    {
      "startMs": 72410,
      "endMs": 76430,
      "translation": "뚱뚱한 사람도 마른 사람도 모두"
    },
    {
      "startMs": 76430,
      "endMs": 80970,
      "translation": "키 큰 사람도 작은 사람도 모두"
    },
    {
      "startMs": 80970,
      "endMs": 85860,
      "translation": "아무것도 아닌 사람도 모두"
    },
    {
      "startMs": 85860,
      "endMs": 88860,
      "translation": "누군가인 사람도 모두"
    },
    {
      "startMs": 88860,
      "endMs": 97210,
      "translation": "이렇게 많은 사람이 필요할 줄은 몰랐다"
    },
    {
      "startMs": 97210,
      "endMs": 101940,
      "translation": "나와 또래인 한 소녀가 이성을 잃고"
    },
    {
      "startMs": 101940,
      "endMs": 106320,
      "translation": "어린아이들을 때렸다"
    },
    {
      "startMs": 106320,
      "endMs": 110170,
      "translation": "흑인 남자가 떼어놓지 않았더라면"
    },
    {
      "startMs": 110170,
      "endMs": 115710,
      "translation": "아마 그 아이들을 죽였을 거다"
    },
    {
      "startMs": 115710,
      "endMs": 119650,
      "translation": "팔이 부러진 군인이"
    },
    {
      "startMs": 119650,
      "endMs": 125180,
      "translation": "캐딜락 바퀴를 뚫어지게 바라봤고"
    },
    {
      "startMs": 125180,
      "endMs": 128830,
      "translation": "경찰은 무릎 꿇고 신부의 발에 입 맞췄고"
    },
    {
      "startMs": 128830,
      "endMs": 134590,
      "translation": "그 퀴어는 그 광경을 보고 토했다"
    },
    {
      "startMs": 134590,
      "endMs": 139050,
      "translation": "아이스크림 가게에서 너를 본 것 같다"
    },
    {
      "startMs": 139050,
      "endMs": 142760,
      "translation": "차가운 밀크셰이크를 오래 마시며"
    },
    {
      "startMs": 142760,
      "endMs": 147810,
      "translation": "웃고 손 흔들고 정말 멋져 보였다"
    },
    {
      "startMs": 147810,
      "endMs": 151680,
      "translation": "네가 이 노래 안에 있는 줄은 몰랐을 거다"
    },
    {
      "startMs": 151680,
      "endMs": 154170,
      "translation": "춥고 비가 내렸고"
    },
    {
      "startMs": 154170,
      "endMs": 156590,
      "translation": "그래서 배우가 된 기분이었다"
    },
    {
      "startMs": 156590,
      "endMs": 158620,
      "translation": "엄마가 생각났고"
    },
    {
      "startMs": 158620,
      "endMs": 161300,
      "translation": "그곳으로 돌아가고 싶었다"
    },
    {
      "startMs": 161300,
      "endMs": 162430,
      "translation": "네 얼굴"
    },
    {
