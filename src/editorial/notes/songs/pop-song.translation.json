{
  "schemaVersion": 2,
  "timing": {
    "lrclibId": 16344547,
    "durationMs": 199193
  },
  "segments": [
    {
      "startMs": 17050,
      "endMs": 21730,
      "translation": "들뜬 사랑을 노래하고 있구나, 베이비 반짝이는 세련된 멜로디로"
    },
    {
      "startMs": 21730,
      "endMs": 25650,
      "translation": "아무도 보이지 않아, 밤이 또 하나 쌓여 가"
    },
    {
      "startMs": 25650,
      "endMs": 30340,
      "translation": "머리는 텅 비고 값싼 하모니, 누구든 사랑받고 싶은데"
    },
    {
      "startMs": 30340,
      "endMs": 34500,
      "translation": "필요 없는 말만 입 밖으로 튀어나오는 꼴이야"
    },
    {
      "startMs": 34500,
      "endMs": 38760,
      "translation": "다들 왜 그래, 그런 얼굴로 쳐다보지 마"
    },
    {
      "startMs": 38760,
      "endMs": 43270,
      "translation": "정상이 아니야, 당신들 아— 갑론을박 실컷 떠들어 대네"
    },
    {
      "startMs": 43270,
      "endMs": 47510,
      "translation": "빗속에서 노래하다니, 참 화창하기도 해라"
    },
    {
      "startMs": 47510,
      "endMs": 56480,
      "translation": "분명 엄청나게 즐거우시겠지 아— 린린 란란 앗빠빠라빠—"
    },
    {
      "startMs": 56480,
      "endMs": 60850,
      "translation": "하나, 둘, 셋 사랑을 담아서 이제 평생 놀자"
    },
    {
      "startMs": 60850,
      "endMs": 65010,
      "translation": "준비해 온 걸 전부 흩뿌리고"
    },
    {
      "startMs": 65010,
      "endMs": 69530,
      "translation": "그래, 어차피 뭐든 전부 시시해"
    },
    {
      "startMs": 69530,
      "endMs": 74010,
      "translation": "너만의 노래를 불러 줘"
    },
    {
      "startMs": 74010,
      "endMs": 84670,
      "translation": "그것도 전부 시시해"
    },
    {
      "startMs": 84670,
      "endMs": 89390,
      "translation": "나른한 사랑이 하고 싶어, 레이디 도덕주의자도 어이없어할 이론이지"
    },
    {
      "startMs": 89390,
      "endMs": 93390,
      "translation": "싫은 일뿐인 채로 봄이 지나가"
    },
    {
      "startMs": 93390,
      "endMs": 98090,
      "translation": "고양이 발 욕조에서 플라이 바이, 날아가 버리면 식은 죽 먹기"
    },
    {
      "startMs": 98090,
      "endMs": 101620,
      "translation": "외우는 주문은 비비디 바비디 부"
    },
    {
      "startMs": 101620,
      "endMs": 117430,
      "translation": "우—후"
    },
    {
      "startMs": 117430,
      "endMs": 119080,
      "translation": "(하나, 둘, 셋)"
    },
    {
      "startMs": 119080,
      "endMs": 122750,
      "translation": "나의 이야기는 사랑이 이루는 대로"
    },
    {
      "startMs": 122750,
      "endMs": 128340,
      "translation": "살아 있고 싶어, 푹 빠져서 모든 게 놀이인 것처럼"
    },
    {
      "startMs": 128340,
      "endMs": 132700,
      "translation": "유난히 시시해, 뭐든 전부"
    },
    {
      "startMs": 132700,
      "endMs": 136290,
      "translation": "너만의 노래를 불러 줘 (하나, 둘, 셋)"
    },
    {
      "startMs": 136290,
      "endMs": 140720,
      "translation": "제정신이 아니야 제정신이 아니야 저 녀석도 이 녀석도 다들 이상해"
    },
    {
      "startMs": 140720,
      "endMs": 145180,
      "translation": "좀 따라갈 수가 없어 즐길 수가 없어 미쳐 버린 엑스터시"
    },
    {
      "startMs": 145180,
      "endMs": 150460,
      "translation": "제정신이 아니야 제정신이 아니야 모든 게 전부 시시할 뿐이야"
    },
    {
      "startMs": 150460,
      "endMs": 153620,
      "translation": "너만의 노래를 불러 줘"
    },
    {
      "startMs": 153620,
      "endMs": 154510,
      "translation": "(하나, 둘, 셋)"
    },
    {
      "startMs": 154510,
      "endMs": 156320,
      "translation": "굉장할 만큼 어처구니없어"
    },
    {
      "startMs": 156320,
      "endMs": 158990,
      "translation": "이게 바로 바라던 인생이야"
    },
    {
      "startMs": 158990,
      "endMs": 161370,
      "translation": "너는 누구야? 알려 줘"
    },
    {
      "startMs": 161370,
      "endMs": 163150,
      "translation": "어차피 아무것도 없겠지?"
    },
    {
      "startMs": 163150,
      "endMs": 165040,
      "translation": "시끄러운 것도 정도가 있지"
    },
    {
      "startMs": 165040,
      "endMs": 167610,
      "translation": "이게 바로 가치 있는 인생이야"
    },
    {
      "startMs": 167610,
      "endMs": 170050,
      "translation": "누구라도 좋지만 네가 좋아"
    },
    {
      "startMs": 170050,
      "endMs": 172100,
      "translation": "사랑을 노래해 줘"
    },
    {
      "startMs": 172100,
      "endMs": 199193,
      "translation": "그것도 전부 시시해"
    }
  ]
}
