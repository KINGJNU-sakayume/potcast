    {
      "startMs": 23190,
      "endMs": 24900,
      "translation": "새벽 다섯 시, 또 내 시간이야"
    },
    {
      "startMs": 24900,
      "endMs": 30810,
      "translation": "달빛을 흠뻑 들이켰어, 잠이 안 와"
    },
    {
      "startMs": 30810,
      "endMs": 32820,
      "translation": "새벽 다섯 시, 또 내 시간이야"
    },
    {
      "startMs": 32820,
      "endMs": 38620,
      "translation": "전화를 걸면 너도 나인 줄 알지"
    },
    {
      "startMs": 38620,
      "endMs": 40400,
      "translation": "난 나 자신을 더 몰아붙여"
    },
    {
      "startMs": 40400,
      "endMs": 46590,
      "translation": "그저 내 심장이 뛰는 걸 느끼고 싶을 뿐이야 (뛰는 걸)"
    },
    {
      "startMs": 46590,
      "endMs": 48360,
      "translation": "네 목을 두 손으로 감싸"
    },
    {
      "startMs": 48360,
      "endMs": 54360,
      "translation": "내가 늘 조일 때 넌 좋아하지"
    },
    {
      "startMs": 54360,
      "endMs": 56240,
      "translation": "새벽 다섯 시, 또 취했어"
    },
    {
      "startMs": 56240,
      "endMs": 62010,
      "translation": "내가 아프다는 거 너도 보이잖아"
    },
    {
      "startMs": 62010,
      "endMs": 64070,
      "translation": "공허 속으로 떨어졌어"
    },
    {
      "startMs": 64070,
      "endMs": 69910,
      "translation": "너를 원해, 우린 둘 다 미쳤으니까"
    },
    {
      "startMs": 69910,
      "endMs": 71830,
      "translation": "심연을 들여다봐"
    },
    {
      "startMs": 71830,
      "endMs": 77740,
      "translation": "또다시 나 자신을 보고 있어"
    },
    {
      "startMs": 77740,
      "endMs": 79550,
      "translation": "R.E.M.을 들으며 꾸벅 졸아"
    },
    {
      "startMs": 79550,
      "endMs": 84010,
      "translation": "믿음을 잃지 않으려고 애쓰는 중이야"
    },
    {
      "startMs": 84010,
      "endMs": 87950,
      "translation": "그리고 네가 잠든 날 지켜볼 때가 좋아"
    },
    {
      "startMs": 87950,
      "endMs": 91880,
      "translation": "넌 날 빙글 돌려 숨 쉬게 해"
    },
    {
      "startMs": 91880,
      "endMs": 95830,
      "translation": "너랑 나, 우리 둘일 때만 안전해"
    },
    {
      "startMs": 95830,
      "endMs": 99860,
      "translation": "넌 내가 약물 과다로 쓰러지게 두지 않을 거야"
    },
    {
      "startMs": 99860,
      "endMs": 103650,
      "translation": "그리고 내가 마침내 평화롭게 죽게 되면"
    },
    {
      "startMs": 103650,
      "endMs": 107590,
      "translation": "이 시트로 내 몸을 감싸고"
    },
    {
      "startMs": 107590,
      "endMs": 111420,
      "translation": "휘발유를 부어 줘"
    },
    {
      "startMs": 111420,
      "endMs": 116860,
      "translation": "그건 내게 별 의미 없어"
    },
    {
      "startMs": 116860,
      "endMs": 118670,
      "translation": "새벽 다섯 시, 난 허무주의자야"
    },
    {
      "startMs": 118670,
      "endMs": 124550,
      "translation": "이다음엔 아무것도 없다는 걸 알아 (이다음엔)"
    },
    {
      "startMs": 124550,
      "endMs": 126560,
      "translation": "뒷일에 집착해"
    },
    {
      "startMs": 126560,
      "endMs": 132200,
      "translation": "종말과 절망에 (절망에)"
    },
    {
      "startMs": 132200,
      "endMs": 134270,
      "translation": "내가 이해하는 유일한 건"
    },
    {
      "startMs": 134270,
      "endMs": 140030,
      "translation": "다정함의 제로섬뿐이야 (다정함)"
    },
    {
      "startMs": 140030,
      "endMs": 142200,
      "translation": "오, 베이비, 제발 날 꼭 안아 줘"
    },
    {
      "startMs": 142200,
      "endMs": 148070,
      "translation": "살아갈 이유가 더 있다고 믿게 해 줘"
    },
    {
      "startMs": 148070,
      "endMs": 154050,
      "translation": "빙글, 빙글, 빙글, 빙글 우린 돌아"
    },
    {
      "startMs": 154050,
      "endMs": 161820,
      "translation": "인생이라는 이 게임에서 우린 자유롭지 않아"
    },
    {
