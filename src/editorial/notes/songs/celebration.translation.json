    {
      "startMs": 14630,
      "endMs": 17590,
      "translation": "그래, 이게 뭔지 알지"
    },
    {
      "startMs": 17590,
      "endMs": 20550,
      "translation": "축하 파티야, 얘들아!"
    },
    {
      "startMs": 20550,
      "endMs": 23250,
      "translation": "술 들고, 잔 들고"
    },
    {
      "startMs": 23250,
      "endMs": 25670,
      "translation": "그다음엔 네 엉덩이를 잡을 거야"
    },
    {
      "startMs": 25670,
      "endMs": 27120,
      "translation": "왜 그렇게"
    },
    {
      "startMs": 27120,
      "endMs": 28310,
      "translation": "수줍은 척해"
    },
    {
      "startMs": 28310,
      "endMs": 29810,
      "translation": "너희는 왜"
    },
    {
      "startMs": 29810,
      "endMs": 30840,
      "translation": "거짓말을 해?"
    },
    {
      "startMs": 30840,
      "endMs": 32960,
      "translation": "\"이런 거 처음이야…\""
    },
    {
      "startMs": 32960,
      "endMs": 34020,
      "translation": "그만해"
    },
    {
      "startMs": 34020,
      "endMs": 35930,
      "translation": "파트론 좀 줄까?"
    },
    {
      "startMs": 35930,
      "endMs": 37030,
      "translation": "있어"
    },
    {
      "startMs": 37030,
      "endMs": 38510,
      "translation": "약속하는데"
    },
    {
      "startMs": 38510,
      "endMs": 39870,
      "translation": "너 정말 예뻐"
    },
    {
      "startMs": 39870,
      "endMs": 41720,
      "translation": "네 친구도 꽤 끝내주지만"
    },
    {
      "startMs": 41720,
      "endMs": 44630,
      "translation": "너 같진 않아"
    },
    {
      "startMs": 44630,
      "endMs": 48030,
      "translation": "아니, 너 같진 않아"
    },
    {
      "startMs": 48030,
      "endMs": 51980,
      "translation": "지금은 그 독백 좀 꺼 줘"
    },
    {
      "startMs": 51980,
      "endMs": 54950,
      "translation": "그렇게 떠들면 두통약이 필요해질 거야"
    },
    {
      "startMs": 54950,
      "endMs": 57690,
      "translation": "사람 졸리게 하네, 너희한테 질렸어"
    },
    {
      "startMs": 57690,
      "endMs": 60840,
      "translation": "이제 루이 비통 돈은 여기서 마칠게"
    },
    {
      "startMs": 60840,
      "endMs": 63190,
      "translation": "그래도 알려 줘야 할 것 같았어"
    },
    {
      "startMs": 63190,
      "endMs": 64580,
      "translation": "우리가 술 가게에 들러서"
    },
    {
      "startMs": 64580,
      "endMs": 65090,
      "translation": "크리스털이랑 모엣을 샀어"
    },
    {
      "startMs": 65090,
      "endMs": 73180,
      "translation": "이제 흘러가게 둘 거야"
    },
    {
      "startMs": 73180,
      "endMs": 76310,
      "translation": "전에 문제가 좀 있었지만, 봐, 다 흘려보냈어"
    },
    {
      "startMs": 76310,
      "endMs": 78230,
      "translation": "대마도 한 온스 있어"
    },
    {
      "startMs": 78230,
      "endMs": 86370,
      "translation": "이제 피워 버릴 거야"
    },
    {
      "startMs": 86370,
      "endMs": 89060,
      "translation": "그래, 이게 뭔지 알지"
    },
    {
      "startMs": 89060,
