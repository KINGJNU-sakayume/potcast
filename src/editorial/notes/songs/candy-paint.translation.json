  "segments": [
    {
      "startMs": 4280,
      "endMs": 10450,
      "translation": "그래, 음"
    },
    {
      "startMs": 10450,
      "endMs": 12940,
      "translation": "흰 지붕을 얹은 캔디 페인트"
    },
    {
      "startMs": 12940,
      "endMs": 15690,
      "translation": "람보르기니 문짝을 단 오픈카"
    },
    {
      "startMs": 15690,
      "endMs": 18310,
      "translation": "내가 가진 걸 노리느라 바쁘다면"
    },
    {
      "startMs": 18310,
      "endMs": 20960,
      "translation": "네 집 문을 걷어차고 들어갈 거야, 그건 특수부대야"
    },
    {
      "startMs": 20960,
      "endMs": 23590,
      "translation": "테이블 위엔 10만 달러"
    },
    {
      "startMs": 23590,
      "endMs": 26270,
      "translation": "내 차는 반값, 내 시계랑 같은 값"
    },
    {
      "startMs": 26270,
      "endMs": 28920,
      "translation": "점프슛은 없어도 난 펑펑 써"
    },
    {
      "startMs": 28920,
      "endMs": 31640,
      "translation": "난 젊은 스토니야, 하고 싶은 대로 해"
    },
    {
      "startMs": 31640,
      "endMs": 34370,
      "translation": "흰 지붕을 얹은 캔디 페인트"
    },
