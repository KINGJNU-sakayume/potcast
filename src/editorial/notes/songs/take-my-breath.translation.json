  "segments": [
    {
      "startMs": 85350,
      "endMs": 89320,
      "translation": "네 눈 속의 불꽃을 봤어"
    },
    {
      "startMs": 89320,
      "endMs": 93520,
      "translation": "네 눈을 들여다볼 때 그 불꽃을 봤어"
    },
    {
      "startMs": 93520,
      "endMs": 97340,
      "translation": "해 보고 싶은 것들을 내게 말하지, 어"
    },
    {
      "startMs": 97340,
      "endMs": 101280,
      "translation": "유혹은 변장한 악마라는 걸 알아"
    },
    {
      "startMs": 101280,
      "endMs": 105040,
      "translation": "넌 살아 있다고 느끼려고 모든 걸 걸어, 오, 예"
    },
    {
      "startMs": 105040,
      "endMs": 109080,
      "translation": "넌 제물처럼 너 자신을 내게 바치고 있어"
    },
    {
      "startMs": 109080,
      "endMs": 112940,
      "translation": "늘 이런다고 말했지"
    },
    {
      "startMs": 112940,
      "endMs": 118140,
      "translation": "내가 널 빛으로 데려가면 날 사랑한다고 말해 줘"
    },
    {
      "startMs": 118140,
      "endMs": 122090,
      "translation": "그녀가 나와 느끼는 건 꿈같아"
    },
    {
      "startMs": 122090,
      "endMs": 126290,
      "translation": "그녀는 벼랑 끝에 서는 걸 좋아해"
    },
    {
      "startMs": 126290,
      "endMs": 130050,
      "translation": "그녀의 환상, 난 괜찮아"
    },
    {
      "startMs": 130050,
      "endMs": 133840,
      "translation": "그러다 갑자기 베이비가 말해"
    },
    {
      "startMs": 133840,
      "endMs": 137510,
      "translation": "내 숨을 앗아 가 줘"
    },
    {
      "startMs": 137510,
      "endMs": 139640,
      "translation": "그리고 영원히 이어지게 해 줘, 베이브"
    },
    {
      "startMs": 139640,
      "endMs": 142060,
      "translation": "지금 아니면 안 돼, 베이브 (아)"
    },
    {
      "startMs": 142060,
      "endMs": 145550,
      "translation": "내 숨을 앗아 가 줘"
    },
    {
      "startMs": 145550,
      "endMs": 147660,
      "translation": "너보다 잘하는 사람은 없어, 베이브"
    },
    {
      "startMs": 147660,
      "endMs": 148600,
      "translation": "날 가까이 데려가—"
    },
    {
      "startMs": 148600,
      "endMs": 152670,
      "translation": "너를 꼭 붙잡아 주길 원하지"
    },
    {
      "startMs": 152670,
      "endMs": 157000,
      "translation": "넌 날 끌어당기고, 네 허벅지 사이의 열기가 느껴져 (어, 말해)"
    },
    {
      "startMs": 157000,
      "endMs": 160690,
      "translation": "넌 삶을 끝내기엔 너무 어려, 어"
    },
    {
      "startMs": 160690,
      "endMs": 164960,
      "translation": "걸, 대가를 치르는 사람이 되고 싶진 않아"
    },
    {
