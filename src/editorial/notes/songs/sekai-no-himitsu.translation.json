  "segments": [
    {
      "startMs": 13520,
      "endMs": 18720,
      "translation": "분명 우리는 무언가에 쫓기고 있어, 막연하긴 하지만"
    },
    {
      "startMs": 18720,
      "endMs": 25680,
      "translation": "온종일 흐리멍덩함과 따끔거림이 흘러, 그 물결에 올라타 넷서핑"
    },
    {
      "startMs": 25680,
      "endMs": 29150,
      "translation": "이건 이러쿵저러쿵 떠들더니 낡았네"
    },
    {
      "startMs": 29150,
      "endMs": 31650,
      "translation": "그건 그대로 이러쿵저러쿵 떠들더니 새롭네"
    },
    {
      "startMs": 31650,
      "endMs": 34620,
      "translation": "그런 쓸데없는 반복을 또 반복하면서"
    },
    {
      "startMs": 34620,
      "endMs": 37750,
      "translation": "우리, 살아가는 동안에"
    },
    {
      "startMs": 37750,
      "endMs": 39400,
      "translation": "미안"
    },
    {
      "startMs": 39400,
      "endMs": 43790,
      "translation": "알아채 버렸어 음, 음"
    },
    {
      "startMs": 43790,
      "endMs": 45460,
      "translation": "미안"
    },
    {
      "startMs": 45460,
      "endMs": 50080,
      "translation": "알아채 버렸어 세상에 대해"
    },
    {
      "startMs": 50080,
      "endMs": 55290,
      "translation": "스텝만, 스텝만 두고 와 버렸어"
    },
    {
      "startMs": 55290,
      "endMs": 62050,
      "translation": "우리, 눈물에 맞춰 리듬을 타고 있을 거야"
    },
    {
      "startMs": 62050,
      "endMs": 67110,
      "translation": "스텝만, 스텝만 두고 와 버렸어도"
    },
    {
      "startMs": 67110,
      "endMs": 73350,
      "translation": "우리, 웃음의 수만큼 브레이크할 수 있을 거야"
    },
    {
      "startMs": 73350,
      "endMs": 79890,
      "translation": "그러니까 미안, 알아채 버렸어도 음, 음"
    },
    {
      "startMs": 79890,
      "endMs": 85790,
      "translation": "미안, 잊어 줘 음"
    },
    {
      "startMs": 85790,
      "endMs": 88630,
      "translation": "오늘 어디선가 악당이 죽었대"
    },
    {
      "startMs": 88630,
      "endMs": 91950,
      "translation": "그래도 많은 목숨이 구해졌대"
    },
    {
      "startMs": 91950,
      "endMs": 98050,
      "translation": "정의와 윤리와 목숨을 저울에 달아 잰 성명으로"
    },
    {
      "startMs": 98050,
      "endMs": 101030,
      "translation": "어려운 건 이제 모르겠지만"
    },
    {
      "startMs": 101030,
      "endMs": 105140,
      "translation": "사실 우리가 악당이었을지도 몰라"
    },
    {
