    },
    {
      "startMs": 168250,
      "endMs": 171330,
      "translation": "하늘이 지켜보고, 신이 핫라인으로 전화해"
    },
    {
      "startMs": 171330,
      "endMs": 173790,
      "translation": "왜 자꾸 나한테 뜨거운 가사를 주시는 걸까?"
    },
    {
      "startMs": 173790,
      "endMs": 175700,
      "translation": "난 스타야, 어떻게 안 빛나겠어?"
    },
    {
      "startMs": 175700,
      "endMs": 177620,
      "translation": "여기 숙녀분들 몇 명이나 있어?"
    },
    {
      "startMs": 177620,
      "endMs": 180530,
      "translation": "남편 없는 숙녀분들은 몇 명이나 있어?"
    },
    {
      "startMs": 180530,
      "endMs": 183880,
      "translation": "네 블라우스 속 뭔가가 날 달아오르게 해"
