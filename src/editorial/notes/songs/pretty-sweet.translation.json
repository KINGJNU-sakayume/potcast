  "segments": [
    { "startMs": 660, "endMs": 3520, "translation": "이제, 벼랑 끝을 향해 달린다" },
    { "startMs": 3520, "endMs": 4940, "translation": "끝까지 해내고야 만다" },
    { "startMs": 4940, "endMs": 6030, "translation": "위험은 전부 내가 떠안는다" },
    { "startMs": 6030, "endMs": 8180, "translation": "친구 넷과 머리를 흔들어 댄다" },
    { "startMs": 8180, "endMs": 9020, "translation": "죽은 이들을 위해 한 모금 바닥에 따른다" },
    { "startMs": 9020, "endMs": 12060, "translation": "이것이 지금의 피, 몸, 삶이다" },
    { "startMs": 12060, "endMs": 13590, "translation": "지금이 정점이다" },
    { "startMs": 13590, "endMs": 16630, "translation": "어쩌면 내게 필요한 건 이것이다" },
    { "startMs": 16630, "endMs": 19690, "translation": "어쩌면 내게 필요한 건 이것이다" },
    { "startMs": 19690, "endMs": 23060, "translation": "지금 나를 해치고 싶다고 했다" },
    { "startMs": 23060, "endMs": 25770, "translation": "너는 지금 나를 끝낼 수 없다" },
    { "startMs": 25770, "endMs": 32180, "translation": "그게 네게 필요한 건지도 모른다, 이쪽 편에서 살아 있다는 게 무슨 뜻인지" },
    { "startMs": 32180, "endMs": 35590, "translation": "지금 나를 죽이고 싶다고 했다, 이쪽 편에서" },
    { "startMs": 35590, "endMs": 37220, "translation": "나를 실망시키지 마라" },
    { "startMs": 37220, "endMs": 39030, "translation": "이쪽 편에서, 아래로, 아래로" },
    { "startMs": 39030, "endMs": 42690, "translation": "저쪽 편은 좆까라" },
    { "startMs": 42690, "endMs": 52170, "translation": "나는 이쪽 편이다, 이쪽 편이다, 이쪽 편이다" },
    { "startMs": 52170, "endMs": 54930, "translation": "도착했다는 게 어떤 기분인지" },
    { "startMs": 54930, "endMs": 60130, "translation": "나는 안에 있다, 안에 있다" },
    { "startMs": 60130, "endMs": 67160, "translation": "저 놈들은 평생 내 놈들이다" },
    { "startMs": 67160, "endMs": 78610, "translation": "우리의 어머니여, 우리가 기대는 아버지들에게 너그럽기를" },
    { "startMs": 78610, "endMs": 94710, "translation": "우리의 아버지여, 우리가 기대는 어머니들에게 너그럽기를" },
    { "startMs": 123730, "endMs": 132910, "translation": "우리는 안다, 네가 설탕이라는 걸, 사탕처럼 달콤하다는 걸" },
    { "startMs": 132910, "endMs": 142230, "translation": "꽤 달콤하다" },
    { "startMs": 142230, "endMs": 158000, "translation": "꽤 달콤하다" }
  ]
