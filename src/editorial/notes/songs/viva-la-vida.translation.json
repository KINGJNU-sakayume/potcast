  "segments": [
    {
      "startMs": 13230,
      "endMs": 16980,
      "translation": "나는 한때 세상을 다스렸다"
    },
    {
      "startMs": 16980,
      "endMs": 19640,
      "translation": "내가 한마디 하면 바다가 솟아올랐다"
    },
    {
      "startMs": 19640,
      "endMs": 23590,
      "translation": "이제 아침이면 나는 홀로 잠든다"
    },
    {
      "startMs": 23590,
      "endMs": 40720,
      "translation": "한때 내 것이었던 거리를 쓸면서"
    },
    {
      "startMs": 40720,
      "endMs": 44640,
      "translation": "나는 주사위를 굴리곤 했다"
    },
    {
      "startMs": 44640,
      "endMs": 47780,
      "translation": "적의 눈에 어린 두려움을 느끼면서"
    },
    {
      "startMs": 47780,
      "endMs": 51550,
      "translation": "군중이 노래하는 소리를 들었다"
    },
    {
      "startMs": 51550,
      "endMs": 54730,
      "translation": "\"옛 왕은 죽었다, 새 왕이여 만수무강하소서\""
    },
    {
      "startMs": 54730,
      "endMs": 58430,
      "translation": "한순간 나는 열쇠를 쥐고 있었다"
    },
    {
      "startMs": 58430,
      "endMs": 61280,
      "translation": "다음 순간 벽이 나를 가두었다"
    },
    {
      "startMs": 61280,
      "endMs": 65450,
      "translation": "그리고 나는 알게 되었다, 내 성들이 서 있던 곳이"
    },
    {
      "startMs": 65450,
      "endMs": 69060,
      "translation": "소금 기둥과 모래 기둥 위였다는 것을"
    },
    {
      "startMs": 69060,
      "endMs": 72970,
      "translation": "예루살렘의 종소리가 울리는 것이 들린다"
    },
    {
      "startMs": 72970,
      "endMs": 76420,
      "translation": "로마 기병대의 합창이 노래하고 있다"
    },
    {
      "startMs": 76420,
      "endMs": 79820,
      "translation": "나의 거울이, 나의 칼과 방패가 되어 다오"
    },
    {
      "startMs": 79820,
      "endMs": 83210,
      "translation": "낯선 땅에 나가 있는 나의 선교사들이 되어 다오"
    },
    {
      "startMs": 83210,
      "endMs": 86740,
      "translation": "이유는 설명할 수 없지만"
    },
    {
      "startMs": 86740,
      "endMs": 93220,
      "translation": "네가 떠난 뒤로는 정직한 말을 단 한마디도 들을 수 없었다"
    },
    {
      "startMs": 93220,
      "endMs": 110020,
      "translation": "그때가 내가 세상을 다스리던 때였다"
    },
    {
      "startMs": 110020,
      "endMs": 114230,
      "translation": "사악하고 거친 바람이었다"
    },
    {
      "startMs": 114230,
      "endMs": 117110,
      "translation": "문들을 날려 버리고 나를 안으로 들여보냈다"
    },
    {
      "startMs": 117110,
      "endMs": 121170,
      "translation": "깨진 유리창과 북소리"
    },
    {
      "startMs": 121170,
      "endMs": 124520,
      "translation": "사람들은 내가 어떤 존재가 되었는지 믿지 못했다"
    },
    {
      "startMs": 124520,
      "endMs": 128230,
      "translation": "혁명가들이 기다린다"
    },
    {
      "startMs": 128230,
      "endMs": 131130,
      "translation": "은쟁반에 담길 내 목을"
    },
    {
      "startMs": 131130,
      "endMs": 135180,
      "translation": "외로운 줄에 매달린 꼭두각시일 뿐인데"
    },
    {
      "startMs": 135180,
      "endMs": 138850,
      "translation": "아, 누가 왕이 되고 싶어 하겠는가?"
    },
    {
      "startMs": 138850,
      "endMs": 142690,
      "translation": "예루살렘의 종소리가 울리는 것이 들린다"
    },
    {
      "startMs": 142690,
      "endMs": 146040,
      "translation": "로마 기병대의 합창이 노래하고 있다"
    },
    {
      "startMs": 146040,
      "endMs": 149690,
      "translation": "나의 거울이, 나의 칼과 방패가 되어 다오"
    },
    {
      "startMs": 149690,
      "endMs": 153070,
      "translation": "낯선 땅에 나가 있는 나의 선교사들이 되어 다오"
    },
    {
      "startMs": 153070,
      "endMs": 156480,
      "translation": "이유는 설명할 수 없지만"
    },
    {
      "startMs": 156480,
      "endMs": 159580,
      "translation": "성 베드로가 내 이름을 부르지 않으리란 걸 안다"
    },
    {
      "startMs": 159580,
      "endMs": 163100,
      "translation": "정직한 말은 단 한마디도 없었다"
    },
    {
      "startMs": 163100,
      "endMs": 195130,
      "translation": "하지만 그때가 내가 세상을 다스리던 때였다"
    },
    {
      "startMs": 195130,
      "endMs": 198170,
      "translation": "예루살렘의 종소리가 울리는 것이 들린다"
    },
