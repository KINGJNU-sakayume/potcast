    {
      "startMs": 14460,
      "endMs": 18550,
      "translation": "인생이 너무 달콤해, 코디가 된 기분이야 (코디)"
    },
    {
      "startMs": 18550,
      "endMs": 22060,
      "translation": "일어나면 빌어먹을 코데인으로 입을 헹궈 (코데인)"
    },
    {
      "startMs": 22060,
      "endMs": 25320,
      "translation": "서른 병, 그래, 계산은 내가 해 (내가)"
    },
    {
      "startMs": 25320,
      "endMs": 28950,
      "translation": "빠르게 살아왔어, 아니, 천천히는 못 해 (천천히)"
    },
    {
      "startMs": 28950,
      "endMs": 32230,
      "translation": "인생이 너무 달콤해, 코디가 된 기분이야 (코디)"
    },
    {
      "startMs": 32230,
      "endMs": 35720,
      "translation": "일어나면 빌어먹을 코데인으로 입을 헹궈 (코데인)"
    },
    {
      "startMs": 35720,
      "endMs": 39440,
      "translation": "우린 며칠째 퍼마시는 중, 잠은 한숨도 안 자 (안 자)"
    },
    {
      "startMs": 39440,
      "endMs": 43200,
      "translation": "호텔 로비를 파티장으로 만들었어"
    },
    {
      "startMs": 43200,
      "endMs": 46700,
      "translation": "외제차를 몰아, 비틀 같은 건 못 몰아"
    },
    {
      "startMs": 46700,
      "endMs": 50010,
      "translation": "민소매 위에 생로랑을 걸쳐"
    },
    {
      "startMs": 50010,
      "endMs": 53620,
      "translation": "이블 크니블처럼 아슬아슬하게 폼 잡는 게 좋아"
    },
    {
      "startMs": 53620,
      "endMs": 56030,
      "translation": "그래도 내 사람들 없이는 아무 의미 없어"
    },
    {
      "startMs": 56030,
      "endMs": 59390,
      "translation": "무대에 오르면 손을 하늘로"
    },
    {
      "startMs": 59390,
      "endMs": 62780,
      "translation": "내가 하는 사소한 것 하나하나 다들 분석해"
    },
    {
      "startMs": 62780,
      "endMs": 66270,
      "translation": "그 여자한테 코카인을 조금 줬더니 살아났어"
    },
    {
      "startMs": 66270,
      "endMs": 69850,
      "translation": "내 테이블 위에서 춤추기 시작했지"
    },
    {
      "startMs": 69850,
      "endMs": 73300,
      "translation": "난 누구랑도 안 엮여, 그래, 넌 날 거의 몰라"
    },
    {
      "startMs": 73300,
      "endMs": 74740,
      "translation": "날 뭐로 보는 거야?"
    },
    {
      "startMs": 74740,
      "endMs": 76740,
      "translation": "아니, 난 네 영혼을 구해 줄 수 없어"
    },
    {
      "startMs": 76740,
      "endMs": 81060,
      "translation": "난 누구랑도 안 엮여, 그래, 넌 날 거의 몰라"
    },
    {
      "startMs": 81060,
      "endMs": 84390,
      "translation": "제발, 그냥 날 내버려 둬"
    },
    {
      "startMs": 84390,
