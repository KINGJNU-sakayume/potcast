    },
    {
      "startMs": 32520,
      "endMs": 33580,
      "translation": "번쩍이는 불빛 (불빛, 불빛)"
    },
    {
      "startMs": 33580,
      "endMs": 42380,
      "translation": "번쩍이는 불빛 (불빛, 불빛)"
    },
    {
      "startMs": 42380,
      "endMs": 45160,
      "translation": "그녀는 별똥별은 안 믿어"
    },
    {
      "startMs": 45160,
      "endMs": 47730,
      "translation": "그래도 신발이랑 차는 믿지"
    },
    {
      "startMs": 47730,
      "endMs": 50430,
      "translation": "새 아파트의 원목 바닥"
    },
    {
      "startMs": 50430,
      "endMs": 53040,
      "translation": "백화점의 오트 쿠튀르"
    },
    {
      "startMs": 53040,
      "endMs": 55570,
      "translation": "넌 시비를 즐기는 쪽에 가깝고"
    },
    {
      "startMs": 55570,
      "endMs": 58150,
      "translation": "난 플로리다 여행 쪽에 가깝지"
    },
    {
      "startMs": 58150,
      "endMs": 60890,
      "translation": "전채 요리를 시키고, 바다가 보이는 곳"
    },
    {
      "startMs": 60890,
      "endMs": 64380,
      "translation": "네가 좋아하는 작가의 책에서 그대로 나온 장면"
    },
    {
      "startMs": 64380,
      "endMs": 66130,
      "translation": "바람은 산들산들"
    },
    {
      "startMs": 66130,
      "endMs": 68860,
      "translation": "이런, 왜 인생은 늘 이렇게 쉬울 수 없을까"
    },
    {
      "startMs": 68860,
      "endMs": 71300,
      "translation": "그녀는 거울 앞에서 야하게 춤추고"
    },
    {
      "startMs": 71300,
      "endMs": 74280,
      "translation": "전화가 와, \"어디야, 이지?\""
    },
    {
      "startMs": 74280,
      "endMs": 76880,
      "translation": "그래서 너한테 그 수작을 걸어 보려는데"
    },
    {
      "startMs": 76880,
      "endMs": 79910,
      "translation": "파파라치의 플래시가 터졌지"
    },
    {
      "startMs": 79910,
      "endMs": 82170,
      "translation": "젠장, 저놈들한테 걸렸어"
    },
    {
      "startMs": 82170,
      "endMs": 84200,
      "translation": "나치보다 저놈들이 더 싫어"
    },
    {
      "startMs": 84200,
      "endMs": 88850,
      "translation": "내가 기억하기로, 넌 과시하는 걸 좋아했지"
    },
    {
      "startMs": 88850,
      "endMs": 93940,
      "translation": "하지만 이렇게까지 할 줄은 몰랐어"
    },
    {
      "startMs": 93940,
      "endMs": 96750,
      "translation": "하지만 내가 뭘 알겠어?"
    },
    {
      "startMs": 96750,
      "endMs": 99270,
      "translation": "번쩍이는 불빛 (불빛, 불빛)"
    },
    {
      "startMs": 99270,
      "endMs": 101570,
      "translation": "내가 뭘 알겠어?"
    },
    {
      "startMs": 101570,
      "endMs": 106740,
      "translation": "번쩍이는 불빛 (불빛, 불빛)"
    },
    {
      "startMs": 106740,
      "endMs": 109170,
      "translation": "오랜만이야, 자기"
    },
    {
      "startMs": 109170,
      "endMs": 112470,
      "translation": "우린 거의 말을 안 했지, 난 내 일만 했어"
    },
    {
      "startMs": 112470,
      "endMs": 114180,
      "translation": "내가 못되게 굴었던 거 알아, 자기"
    },
    {
      "startMs": 114180,
      "endMs": 117430,
      "translation": "에이, 자기, 요즘 네 생각뿐이야"
    },
    {
      "startMs": 117430,
      "endMs": 119830,
      "translation": "한 달 전에 누가 나한테 말해 줬다면"
    },
    {
      "startMs": 119830,
      "endMs": 123080,
      "translation": "센 척하면서, 그래, 난 알고 싶지 않았을 거야"
    },
    {
      "startMs": 123080,
      "endMs": 125060,
      "translation": "1년 전에 누가 나한테 말해 줬다면"
    },
    {
      "startMs": 125060,
      "endMs": 127720,
      "translation": "이렇게 힘들어질 거라고"
    },
    {
      "startMs": 127720,
      "endMs": 130270,
      "translation": "연방재난관리청 없는 카트리나 같은 기분이야"
    },
    {
      "startMs": 130270,
      "endMs": 133020,
      "translation": "지나 없는 마틴 같고"
    },
    {
      "startMs": 133020,
      "endMs": 135260,
      "translation": "비자 없는 비행 같아"
    },
    {
      "startMs": 135260,
      "endMs": 137610,
      "translation": "일등석에서 등받이를 젖혀도 여전히 네가 보여"
    },
    {
      "startMs": 137610,
      "endMs": 141180,
      "translation": "내 과거 속에서, 유리 저편에 있는 너"
    },
    {
      "startMs": 141180,
      "endMs": 143330,
      "translation": "내 기억의 박물관에"
    },
    {
      "startMs": 143330,
      "endMs": 145670,
      "translation": "그냥 하는 말이야, 헤이, 모나리자"
    },
    {
      "startMs": 145670,
      "endMs": 148060,
      "translation": "돌아와, 카이사르 없이는 떠돌 수 없다는 거 알잖아"
    },
    {
      "startMs": 148060,
      "endMs": 152310,
      "translation": "내가 기억하기로, 넌 과시하는 걸 좋아했지"
    },
