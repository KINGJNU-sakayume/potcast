  "segments": [
    {
      "startMs": 2080,
      "endMs": 6710,
      "translation": "일그러지고 상처투성이인 봄"
    },
    {
      "startMs": 6710,
      "endMs": 12040,
      "translation": "마취도 하지 않고 걸었어"
    },
    {
      "startMs": 12040,
      "endMs": 17120,
      "translation": "몸 깊은 곳에서 울려"
    },
    {
      "startMs": 17120,
      "endMs": 22010,
      "translation": "아직 덜 살았다고, 강하게"
    },
    {
      "startMs": 22010,
      "endMs": 27260,
      "translation": "아직 맛볼 거야, 다 씹은 껌의 맛을"
    },
    {
      "startMs": 27260,
      "endMs": 32260,
      "translation": "다 식지 못한 마음으로"
    },
    {
      "startMs": 32260,
      "endMs": 37650,
      "translation": "하나씩 잃어버린 끝에"
    },
    {
      "startMs": 37650,
      "endMs": 45310,
      "translation": "겨우 남은 것"
    },
    {
      "startMs": 45310,
      "endMs": 51870,
      "translation": "이게 사랑이 아니라면 뭐라고 불러야 할까"
    },
    {
      "startMs": 51870,
      "endMs": 55720,
      "translation": "나는 몰랐어"
    },
    {
      "startMs": 55720,
      "endMs": 63590,
      "translation": "불러, 꽃의 이름을 단 하나만"
    },
    {
      "startMs": 63590,
      "endMs": 67130,
      "translation": "터질 듯이"
    },
    {
      "startMs": 67130,
      "endMs": 72520,
      "translation": "코끝이 닿아, 숨이 멎어"
    },
    {
      "startMs": 72520,
      "endMs": 93470,
      "translation": "아픔은 사라지지 않은 채여도 좋아"
    },
    {
      "startMs": 93470,
      "endMs": 98990,
      "translation": "지친 그 눈으로 무슨 말을 해"
    },
    {
      "startMs": 98990,
      "endMs": 104500,
      "translation": "흉터를 감추고 걸었어"
    },
    {
      "startMs": 104500,
      "endMs": 109610,
      "translation": "그러면서도 그림자는 흩뿌렸지"
    },
    {
      "startMs": 109610,
      "endMs": 114520,
      "translation": "알아주길 바랐어"
    },
    {
      "startMs": 114520,
      "endMs": 119520,
      "translation": "아직 걸을 수 있을까, 곱씹은 모래의 맛"
    },
    {
      "startMs": 119520,
      "endMs": 124500,
      "translation": "밤이슬에 젖은 잔디 위"
    },
    {
      "startMs": 124500,
      "endMs": 130190,
      "translation": "들뜬 가슴에 묻는 말"
    },
    {
      "startMs": 130190,
      "endMs": 137460,
      "translation": "끝내기엔 아직 이르잖아"
    },
    {
      "startMs": 137460,
      "endMs": 143960,
      "translation": "아무도 슬퍼하지 않도록 미소 짓는 일이"
    },
    {
      "startMs": 143960,
      "endMs": 148140,
      "translation": "잘되지 않았어"
    },
    {
      "startMs": 148140,
      "endMs": 155610,
      "translation": "하나, 단 하나면 돼, 지킬 수만 있다면"
    },
    {
      "startMs": 155610,
      "endMs": 159770,
      "translation": "그걸로 충분했는데"
    },
    {
      "startMs": 159770,
      "endMs": 164910,
      "translation": "너무나 하찮은 소원이 사라지지 않아"
    },
    {
      "startMs": 164910,
      "endMs": 179720,
      "translation": "누구도 빼앗을 수 없는 영혼"
    },
    {
      "startMs": 179720,
      "endMs": 185540,
      "translation": "무엇에 비유할까, 너와 나를"
    },
    {
      "startMs": 185540,
      "endMs": 190340,
      "translation": "발뒤꿈치에 남은 닮은 상처를"
    },
    {
      "startMs": 190340,
      "endMs": 195710,
      "translation": "갠 하늘을 이어 가면 아직 계속돼"
    },
    {
      "startMs": 195710,
      "endMs": 198350,
      "translation": "가자 (가자)"
    },
    {
      "startMs": 198350,
      "endMs": 210180,
      "translation": "꽃도 피기 전에"
    },
    {
      "startMs": 210180,
      "endMs": 216730,
      "translation": "이게 사랑이 아니라면 뭐라고 불러야 할까"
    },
    {
      "startMs": 216730,
      "endMs": 220960,
      "translation": "나는 몰랐어"
    },
    {
      "startMs": 220960,
      "endMs": 228450,
      "translation": "불러, 두려운 그대로 꽃의 이름을"
    },
    {
      "startMs": 228450,
      "endMs": 232390,
      "translation": "너 아니면 안 된다고"
    },
    {
      "startMs": 232390,
      "endMs": 237420,
      "translation": "코끝이 닿아, 숨이 멎어"
    },
    {
      "startMs": 237420,
      "endMs": 243060,
      "translation": "아픔은 사라지지 않은 채여도 좋아"
    },
    {
      "startMs": 243060,
      "endMs": 250670,
      "translation": "너무나 하찮은 소원이 사라지지 않아"
    },
    {
      "startMs": 250670,
      "endMs": 265333,
      "translation": "그치지 않아"
    }
  ]
