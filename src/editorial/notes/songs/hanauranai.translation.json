  "segments": [
    {
      "startMs": 870,
      "endMs": 7720,
      "translation": "거리의 저녁노을에 녹아든 우리는 아직 둘일까"
    },
    {
      "startMs": 7720,
      "endMs": 11170,
      "translation": "바람이 불어 우리를 태우고"
    },
    {
      "startMs": 11170,
      "endMs": 32160,
      "translation": "둘이서 뜯은 꽃에 소원을 담아"
    },
    {
      "startMs": 32160,
      "endMs": 39270,
      "translation": "바란다면, 우리를 만나는 것보다 훨씬 먼 곳으로"
    },
    {
      "startMs": 39270,
      "endMs": 46260,
      "translation": "이루어진다면, 우리의 운명마저 더 먼 곳으로"
    },
    {
      "startMs": 46260,
      "endMs": 53360,
      "translation": "그렇게 웃으며 내뱉고 내던지고는 너를 떠올려, 그런 마음을"
    },
    {
      "startMs": 53360,
      "endMs": 60130,
      "translation": "품고 껴안고 몸부림친 끝에는 늘 네가 있어, 그런 것보다"
    },
    {
      "startMs": 60130,
      "endMs": 66540,
      "translation": "사랑길의 끝에는 뭐가 있을까"
    },
    {
      "startMs": 66540,
      "endMs": 73510,
      "translation": "시시한 얘기를 둘이서 하자"
    },
    {
      "startMs": 73510,
      "endMs": 80640,
      "translation": "우리의 천 년의 사랑은 깊은 흙에서 꺾이는 꽃 같아"
    },
    {
      "startMs": 80640,
      "endMs": 86730,
      "translation": "우리는 천 년 뒤에도 아직 똑같이 기다리고 있어"
    },
    {
      "startMs": 86730,
      "endMs": 90080,
      "translation": "웃기지"
    },
    {
      "startMs": 90080,
      "endMs": 91810,
      "translation": "와, 오"
    },
    {
      "startMs": 91810,
      "endMs": 93660,
      "translation": "와, 오"
    },
    {
      "startMs": 93660,
      "endMs": 96350,
      "translation": "와, 오"
    },
    {
      "startMs": 96350,
      "endMs": 100660,
      "translation": "너 말고는 이제 어디에도 갈 수 없어"
    },
    {
      "startMs": 100660,
      "endMs": 103220,
      "translation": "빗속에서 (그래)"
    },
    {
      "startMs": 103220,
      "endMs": 110130,
      "translation": "섞이지 않는 나날 속에서 둘은 서 있어, 영겁토록"
    },
    {
      "startMs": 110130,
      "endMs": 117340,
      "translation": "그렇게 웃으며 내뱉고 내던지고는 너를 떠올려, 그런 마음을"
    },
    {
      "startMs": 117340,
      "endMs": 124200,
      "translation": "품고 껴안고 몸부림친 끝에는 늘 네가 있어, 그런 것보다"
    },
    {
      "startMs": 124200,
      "endMs": 130410,
      "translation": "소원은 너와의 앞날에 있어"
    },
    {
      "startMs": 130410,
      "endMs": 137420,
      "translation": "하찮은 얘기를 둘이서 하자"
    },
    {
      "startMs": 137420,
      "endMs": 144690,
      "translation": "우리의 천 년의 사랑은 맞장구에 꺾이는 꽃 같아"
    },
    {
      "startMs": 144690,
      "endMs": 150970,
      "translation": "우리는 천 년 뒤에도 아직 똑같이 기다리고 있어"
    },
    {
      "startMs": 150970,
      "endMs": 159750,
      "translation": "웃기지"
    },
    {
      "startMs": 159750,
      "endMs": 165930,
      "translation": "몇 해가 지나도 망상이 뿌리를 내려도 이렇게 넘쳐 나고 있어"
    },
    {
      "startMs": 165930,
      "endMs": 170960,
      "translation": "소원은 꽃이 질 만큼 넘쳐 나가"
    },
    {
      "startMs": 170960,
      "endMs": 173190,
      "translation": "꽃점 치는 사랑 노래"
    },
    {
      "startMs": 173190,
