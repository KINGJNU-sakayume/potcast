{
  "schemaVersion": 2,
  "timing": {
    "lrclibId": 503800,
    "durationMs": 222000
  },
  "segments": [
    {
      "startMs": 13640,
      "endMs": 16670,
      "translation": "누가 언제 와서 내 목숨을 노릴지 몰라"
    },
    {
      "startMs": 16670,
      "endMs": 19570,
      "translation": "거의 매일 밤 45구경을 끼고 자"
    },
    {
      "startMs": 19570,
      "endMs": 22580,
      "translation": "차 안에서 경광등이 번쩍이지 않기를 신께 빌어"
    },
    {
      "startMs": 22580,
      "endMs": 25630,
      "translation": "젠장, 바로 뒤에 붙었어"
    },
    {
      "startMs": 25630,
      "endMs": 27330,
      "translation": "그리고 매일 아침 눈을 뜨면"
    },
    {
      "startMs": 27330,
      "endMs": 31680,
      "translation": "매일 이 불안을 안고 눈을 떠"
    },
    {
      "startMs": 31680,
      "endMs": 33260,
      "translation": "그놈들은 내가 어디 사는지 알아"
    },
    {
      "startMs": 33260,
      "endMs": 34720,
      "translation": "번호판에 '말론'이라고 박혀 있으니까"
    },
    {
      "startMs": 34720,
      "endMs": 36480,
      "translation": "그리고 날 따라오고 있어"
    },
    {
      "startMs": 36480,
      "endMs": 39820,
      "translation": "부엌 바닥 밑에 20만 달러"
    },
    {
      "startMs": 39820,
      "endMs": 42860,
      "translation": "벽이랑 천장에도 조금 더 숨겨 놨어"
    },
    {
      "startMs": 42860,
      "endMs": 45800,
      "translation": "가족이랑 친구들까지 돌아서기 시작했어"
    },
    {
      "startMs": 45800,
      "endMs": 49770,
      "translation": "내가 그 수표를 받은 뒤로 다들 몸이 근질거리는 게 보여"
    },
    {
      "startMs": 49770,
      "endMs": 53830,
      "translation": "눈 뜨고 있어, 네가 보여, 지켜보고 있어"
    },
    {
      "startMs": 53830,
      "endMs": 60370,
      "translation": "너처럼 되고 싶은 사람은 더 많아져, 아무도 믿지 마"
    },
    {
      "startMs": 60370,
      "endMs": 66560,
      "translation": "왜 난 숨 돌릴 틈이 없는지 말해 줘 (잠을 잘 수가 없어)"
    },
    {
      "startMs": 66560,
      "endMs": 72310,
      "translation": "그놈들이 언제 날 잡으러 올지 생각해"
    },
    {
      "startMs": 72310,
      "endMs": 75590,
      "translation": "편집증 걸린 남자는 편집증 같은 계획을 세워"
    },
    {
      "startMs": 75590,
      "endMs": 78540,
      "translation": "할 수 있는 건 하지만 내 손을 떠난 일이야"
    },
    {
      "startMs": 78540,
      "endMs": 85220,
      "translation": "마음의 평화를 찾으려고 발버둥 칠 뿐"
    },
    {
      "startMs": 85220,
      "endMs": 88270,
      "translation": "가끔은 친구가 하나도 없는 것 같아"
    },
    {
      "startMs": 88270,
      "endMs": 91120,
      "translation": "스노든처럼 누구도 믿을 수 없어"
    },
    {
      "startMs": 91120,
      "endMs": 94330,
      "translation": "침대 바로 옆에 장전해 둬"
    },
    {
      "startMs": 94330,
      "endMs": 96540,
      "translation": "그놈들이 쳐들어오면 주여, 자비를"
    },
    {
      "startMs": 96540,
      "endMs": 99430,
      "translation": "난 절대 안 자, 그래, 눈을 부릅뜨고 있어"
    },
    {
      "startMs": 99430,
      "endMs": 102590,
      "translation": "우리 집 앞에 차를 대려고 하면"
    },
    {
      "startMs": 102590,
      "endMs": 105590,
      "translation": "1마일 밖에서부터 조준 빛이 널 비출 거야"
    },
    {
      "startMs": 105590,
      "endMs": 108290,
      "translation": "맹세해, 오늘 우리 중 하나는 죽어"
    },
    {
      "startMs": 108290,
      "endMs": 111260,
      "translation": "하늘엔 헬리콥터"
    },
    {
      "startMs": 111260,
      "endMs": 114160,
      "translation": "아니, 그는 그 눈을 피할 수 없어"
    },
    {
      "startMs": 114160,
      "endMs": 117330,
      "translation": "정치인들과 거짓말"
    },
    {
      "startMs": 117330,
      "endMs": 120340,
      "translation": "말해 봐, 편을 고르는 게 무슨 의미가 있어?"
    },
    {
      "startMs": 120340,
      "endMs": 126640,
      "translation": "왜 난 숨 돌릴 틈이 없는지 말해 줘 (잠을 잘 수가 없어)"
    },
    {
      "startMs": 126640,
      "endMs": 132320,
      "translation": "그놈들이 언제 날 잡으러 올지 생각해"
    },
    {
      "startMs": 132320,
      "endMs": 135470,
      "translation": "편집증 걸린 남자는 편집증 같은 계획을 세워"
    },
    {
      "startMs": 135470,
      "endMs": 138480,
      "translation": "할 수 있는 건 하지만 내 손을 떠난 일이야"
    },
    {
      "startMs": 138480,
      "endMs": 145600,
      "translation": "마음의 평화를 찾으려고 발버둥 칠 뿐"
    },
    {
      "startMs": 145600,
      "endMs": 147540,
      "translation": "에이, 머릿속은 종일 쉬지 않고 돌아가"
    },
    {
      "startMs": 147540,
      "endMs": 151800,
      "translation": "돈보다 더 큰 걸 잃었고, 난 그 대가를 치르고 있어, 그래"
    },
    {
      "startMs": 151800,
      "endMs": 153470,
      "translation": "난 어디에도 안 가"
    },
    {
      "startMs": 153470,
      "endMs": 156160,
      "translation": "삶을 일구려고 나를 죽이고 있어, 그래"
    },
    {
      "startMs": 156160,
      "endMs": 160070,
      "translation": "매 순간, 한계 같은 건 없었어"
    },
    {
      "startMs": 160070,
      "endMs": 162970,
      "translation": "매일 아침 눈을 뜨면 그냥 손에 넣어야 한다는 걸 알았어"
    },
    {
      "startMs": 162970,
      "endMs": 165930,
      "translation": "창문은 늘 선팅돼 있어, 넌 안을 들여다볼 수 없어"
    },
    {
      "startMs": 165930,
      "endMs": 168500,
      "translation": "어쨌든 그놈들이 또 날 잡으러 올 거란 걸 알아"
    },
    {
      "startMs": 168500,
      "endMs": 174630,
      "translation": "왜 난 숨 돌릴 틈이 없는지 말해 줘 (잠을 잘 수가 없어)"
    },
    {
      "startMs": 174630,
      "endMs": 180300,
      "translation": "그놈들이 언제 날 잡으러 올지 생각해"
    },
    {
      "startMs": 180300,
      "endMs": 183520,
      "translation": "편집증 걸린 남자는 편집증 같은 계획을 세워"
    },
    {
      "startMs": 183520,
      "endMs": 186530,
      "translation": "할 수 있는 건 하지만 내 손을 떠난 일이야"
    },
    {
      "startMs": 186530,
      "endMs": 222000,
      "translation": "마음의 평화를 찾으려고 발버둥 칠 뿐"
    }
  ]
}
