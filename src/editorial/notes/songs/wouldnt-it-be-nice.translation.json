  "segments": [
    {
      "startMs": 7310,
      "endMs": 15090,
      "translation": "우리가 좀 더 나이가 많으면 좋지 않을까? 그럼 이렇게 오래 기다리지 않아도 될 텐데"
    },
    {
      "startMs": 15090,
      "endMs": 23890,
      "translation": "그리고 우리한테 맞는 세상에서 함께 살면 좋지 않을까?"
    },
    {
      "startMs": 23890,
      "endMs": 34330,
      "translation": "잘 자라고 인사하고도 같이 있을 수 있게 되면 훨씬 더 좋을 거야"
    },
    {
      "startMs": 34330,
      "endMs": 41750,
      "translation": "새날이 밝은 아침에 함께 눈뜰 수 있다면 좋지 않을까"
    },
    {
      "startMs": 41750,
      "endMs": 50900,
      "translation": "하루를 같이 보내고 나서 밤새 서로 꼭 안고 있을 수 있다면?"
    },
    {
      "startMs": 50900,
      "endMs": 54890,
      "translation": "우린 함께 행복한 시간을 보내 왔지"
    },
    {
      "startMs": 54890,
      "endMs": 61420,
      "translation": "키스가 하나하나 끝나지 않으면 좋겠어"
    },
    {
      "startMs": 61420,
      "endMs": 66490,
      "translation": "좋지 않을까?"
    },
    {
      "startMs": 66490,
      "endMs": 74920,
      "translation": "생각하고 바라고 기대하고 기도하면 이루어질지도 몰라 (너와 함께 달려)"
    },
    {
      "startMs": 74920,
      "endMs": 81310,
      "translation": "그럼 우리가 못 할 일은 하나도 없을 거야"
    },
    {
      "startMs": 81310,
      "endMs": 85020,
      "translation": "우린 결혼할 수 있을 거야 (결혼할 수 있을 거야)"
    },
    {
      "startMs": 85020,
      "endMs": 88690,
      "translation": "그럼 행복해지겠지 (그럼 행복해지겠지)"
    },
    {
      "startMs": 88690,
      "endMs": 102470,
      "translation": "아, 좋지 않을까?"
    },
    {
      "startMs": 102470,
      "endMs": 112340,
      "translation": "있잖아, 그 얘기를 하면 할수록 그것 없이 사는 게 더 힘들어지는 것 같아"
    },
    {
      "startMs": 112340,
      "endMs": 118010,
      "translation": "그래도 얘기하자"
    },
    {
      "startMs": 118010,
      "endMs": 127550,
      "translation": "좋지 않을까?"
    },
    {
      "startMs": 127550,
      "endMs": 130800,
      "translation": "잘 자, 내 사랑"
    },
    {
