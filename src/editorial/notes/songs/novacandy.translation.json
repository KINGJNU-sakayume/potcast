    {
      "startMs": 480,
      "endMs": 5750,
      "translation": "노바캔디"
    },
    {
      "startMs": 5750,
      "endMs": 12230,
      "translation": "넌 그냥 더 쉬워"
    },
    {
      "startMs": 12230,
      "endMs": 17910,
      "translation": "그 여자를 못 봤어"
    },
    {
      "startMs": 17910,
      "endMs": 26020,
      "translation": "그리고 그게 내가 제일 좋아하는 여자야"
    },
    {
      "startMs": 26020,
      "endMs": 28890,
      "translation": "아니, 이보다 좋은 기분은 느껴 본 적 없어"
    },
    {
      "startMs": 28890,
      "endMs": 32370,
      "translation": "내 얼굴만 봐도 알 수 있잖아"
    },
    {
      "startMs": 32370,
      "endMs": 35060,
      "translation": "영원한 건 없으니까 손목시계를 봐"
    },
    {
      "startMs": 35060,
      "endMs": 37840,
      "translation": "도파민 과다 복용"
    },
    {
      "startMs": 37840,
      "endMs": 40820,
      "translation": "아니, 이보다 좋은 기분은 느껴 본 적 없어"
    },
    {
      "startMs": 40820,
      "endMs": 44150,
      "translation": "한 번 맛볼 수 있다면 혀라도 내줄 거야"
    },
    {
      "startMs": 44150,
      "endMs": 47610,
      "translation": "잡았다 놓아주는 거란 걸 알면서도"
    },
    {
      "startMs": 47610,
      "endMs": 50580,
      "translation": "도파민 과다 복용"
    },
    {
      "startMs": 50580,
      "endMs": 53460,
      "translation": "낡은 코트를 입었다가 새 약을 찾았어"
    },
    {
      "startMs": 53460,
      "endMs": 56090,
      "translation": "날 엉망으로 만들어 준 어린 나한테 고마워"
    },
    {
      "startMs": 56090,
      "endMs": 59250,
      "translation": "그리고 먼 친척이 방금 세상을 떠났어"
    },
    {
      "startMs": 59250,
      "endMs": 62390,
      "translation": "어쩌다 보니 백만 달러 유산을 받게 됐지"
    },
    {
      "startMs": 62390,
      "endMs": 65720,
      "translation": "그리고 자기야, 방금 디즈니랜드 무료 여행에 당첨됐어"
    },
    {
      "startMs": 65720,
      "endMs": 68860,
      "translation": "인스타그램 파란 인증 마크를 하나 더 받았어"
    },
    {
      "startMs": 68860,
      "endMs": 72460,
      "translation": "오, 오늘 밤은 정말 기분 좋아"
    },
    {
      "startMs": 72460,
      "endMs": 75410,
      "translation": "다시는 못 돌아올 것처럼 어울리자"
    },
    {
      "startMs": 75410,
      "endMs": 78360,
