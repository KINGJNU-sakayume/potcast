    },
    {
      "startMs": 103380,
      "endMs": 106660,
      "translation": "평생이라 했는데, 그러다 내 삶을 바꿨지"
    },
    {
      "startMs": 106660,
      "endMs": 109530,
      "translation": "펜트하우스인데 방 열쇠를 잃어버렸어"
    },
    {
      "startMs": 109530,
      "endMs": 112640,
      "translation": "또 1분, 또 뾰로통, 또 맥주 한 캔"
    },
    {
      "startMs": 112640,
      "endMs": 115280,
      "translation": "그래, 알잖아, 일이 돌아가는 게 참 웃겨"
    },
    {
