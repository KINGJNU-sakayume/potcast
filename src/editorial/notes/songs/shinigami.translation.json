  "segments": [
    {
      "startMs": 15820,
      "endMs": 20030,
      "translation": "시시해. 언제쯤 끝나려나?"
    },
    {
      "startMs": 20030,
      "endMs": 24280,
      "translation": "어쩐지 죽고 싶은 기분으로 어슬렁 어슬렁 어슬렁"
    },
    {
      "startMs": 24280,
      "endMs": 28130,
      "translation": "안타깝지만 몸 둘 곳이 없어"
    },
    {
      "startMs": 28130,
      "endMs": 31600,
      "translation": "아자라카모쿠렌 테케렛츠노 파"
    },
    {
      "startMs": 31600,
      "endMs": 35320,
      "translation": "짜증 나, 까부는 얼간이가"
    },
    {
      "startMs": 35320,
      "endMs": 39430,
      "translation": "못 해먹겠어, 허풍이나 떨며 어슬렁 어슬렁 어슬렁"
    },
    {
      "startMs": 39430,
      "endMs": 43480,
      "translation": "더러운 돈을 끌어안고 어디로 가?"
    },
    {
      "startMs": 43480,
      "endMs": 46970,
      "translation": "아자라카모쿠렌 테케렛츠노 파"
    },
    {
      "startMs": 46970,
      "endMs": 50790,
      "translation": "응, 응. 제발, 제발 도와줘"
    },
    {
      "startMs": 50790,
      "endMs": 54230,
      "translation": "잠깐 헷갈려서 눈이 핑 돈 것뿐이야"
    },
    {
      "startMs": 54230,
      "endMs": 58660,
      "translation": "응, 응. 제발, 제발 도와줘"
    },
    {
      "startMs": 58660,
      "endMs": 63050,
      "translation": "그런 해괴한 소리만 하지 말고 좀 봐줘"
    },
    {
      "startMs": 63050,
      "endMs": 69650,
      "translation": "아아, 불이 꺼져. 불이, 불이 꺼져. 날이 밝기도 전에"
    },
    {
      "startMs": 69650,
      "endMs": 71040,
      "translation": "(아차차차차차차)"
    },
    {
      "startMs": 71040,
      "endMs": 78060,
      "translation": "아아, 재미나게, 재 재미나게 될 참이었는데"
    },
    {
      "startMs": 78060,
      "endMs": 81880,
      "translation": "(아차차차차차차)"
    },
    {
      "startMs": 81880,
      "endMs": 85610,
      "translation": "(아차차차차차차)"
    },
    {
      "startMs": 85610,
      "endMs": 87380,
      "translation": "(아차차차차차차)"
    },
    {
      "startMs": 87380,
      "endMs": 91250,
      "translation": "칠칠치 못해, 의리고 뭐고 없어"
    },
    {
      "startMs": 91250,
      "endMs": 95310,
      "translation": "어중간한 소리 하고 있네, 죽을 때까지 어슬렁 어슬렁 어슬렁"
    },
    {
      "startMs": 95310,
      "endMs": 99330,
      "translation": "잡념, 그거 마침 잘됐지"
    },
    {
      "startMs": 99330,
      "endMs": 102710,
      "translation": "아자라카모쿠렌 테케렛츠노 파"
    },
    {
      "startMs": 102710,
      "endMs": 106570,
      "translation": "괴로워, 까부는 꼬맹이가"
    },
    {
      "startMs": 106570,
      "endMs": 110690,
      "translation": "제멋대로 저지르고, 윗분들은 어슬렁 어슬렁 어슬렁"
    },
    {
      "startMs": 110690,
      "endMs": 114590,
      "translation": "원한, 이래서는 속이 안 풀려"
    },
    {
      "startMs": 114590,
      "endMs": 118090,
      "translation": "아자라카모쿠렌 테케렛츠노 파"
    },
    {
      "startMs": 118090,
      "endMs": 121520,
      "translation": "자, 어디서부터 어디까지 하면 좋을까"
    },
    {
      "startMs": 121520,
      "endMs": 125430,
      "translation": "괴롭힌 끝에 들여다볼 수 있는 쪽이 좋아"
    },
    {
      "startMs": 125430,
      "endMs": 129280,
      "translation": "날고 미끄러지고 울고불고 소리친 얼굴이 보고 싶어"
    },
    {
      "startMs": 129280,
      "endMs": 133050,
      "translation": "어차피 우리 한패가 될 텐데"
    },
    {
      "startMs": 133050,
      "endMs": 136500,
      "translation": "응, 응. 제발, 제발 도와줘"
    },
    {
      "startMs": 136500,
      "endMs": 138990,
      "translation": "그래, 실수는 인지상정이지"
    },
    {
      "startMs": 138990,
      "endMs": 141020,
      "translation": "이봐, 당신은 어쩔 거야?"
    },
    {
      "startMs": 141020,
      "endMs": 144550,
      "translation": "응, 응. 제발, 제발 도와줘"
    },
    {
      "startMs": 144550,
      "endMs": 147220,
      "translation": "그렇게 좋은 걸 가지면 이렇게 되는 법이야"
    },
    {
      "startMs": 147220,
      "endMs": 149310,
      "translation": "그건 당신 탓이잖아"
    },
    {
      "startMs": 149310,
      "endMs": 153120,
      "translation": "아아, 어디로 가, 어디, 어디로 가"
    },
    {
      "startMs": 153120,
      "endMs": 155890,
      "translation": "처자식도 있어요"
    },
    {
      "startMs": 155890,
      "endMs": 157270,
      "translation": "(아차차차차차차)"
    },
    {
      "startMs": 157270,
      "endMs": 161150,
      "translation": "아아, 향기가 피어올라, 향, 향기가 피어올라"
    },
    {
      "startMs": 161150,
      "endMs": 163840,
      "translation": "끝을 알리는 향기"
    },
    {
      "startMs": 163840,
      "endMs": 165310,
      "translation": "(아차차차차차차)"
    },
    {
      "startMs": 165310,
      "endMs": 171800,
      "translation": "아아, 불이 꺼져. 불이, 불이 꺼져. 날이 밝기도 전에"
    },
    {
      "startMs": 171800,
      "endMs": 173780,
      "translation": "(아차차차차차차)"
