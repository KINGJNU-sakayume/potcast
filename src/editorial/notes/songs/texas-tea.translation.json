  "segments": [
    {
      "startMs": 16830,
      "endMs": 18940,
      "translation": "네모나고 큼직한 83년식 캐딜락"
    },
    {
      "startMs": 18940,
      "endMs": 22160,
      "translation": "바퀴는 차체 안으로 쏙 들어가 있어"
    },
    {
      "startMs": 22160,
      "endMs": 24810,
      "translation": "담배를 씹으며 날 쳐다봐"
    },
    {
      "startMs": 24810,
      "endMs": 28120,
      "translation": "대체 뭘 피우는 건지, 웃기네"
    },
    {
      "startMs": 28120,
      "endMs": 29340,
      "translation": "아빠가 전화하래"
    },
    {
      "startMs": 29340,
      "endMs": 34200,
      "translation": "버섯 몇 개를 털어 넣고 스며들게 둬"
    },
    {
      "startMs": 34200,
      "endMs": 41240,
      "translation": "파티에 들어가, 내 목엔 부가티 한 대 값, 오, 꽁꽁 얼었지"
    },
    {
      "startMs": 41240,
      "endMs": 46820,
      "translation": "젠장, 내 발에 신은 부츠 좀 봐"
    },
    {
      "startMs": 46820,
      "endMs": 52870,
      "translation": "다리가 저릴 때까지 액셀을 밟아"
    },
    {
      "startMs": 52870,
      "endMs": 58820,
      "translation": "일이 어떻게 흘러가는지 알잖아, 달콤하지 않아?"
    },
    {
      "startMs": 58820,
      "endMs": 62730,
      "translation": "텍사스 티"
    },
    {
      "startMs": 62730,
      "endMs": 66120,
      "translation": "뼈대가 다 보이는 스켈레톤 시계, 자기야"
    },
    {
      "startMs": 66120,
      "endMs": 69140,
      "translation": "음반사들은 날 복제하려고 안달이야"
    },
    {
      "startMs": 69140,
      "endMs": 72120,
      "translation": "이놈이 노래방 가수처럼 따라 부르게 만들었지"
    },
    {
      "startMs": 72120,
      "endMs": 75450,
      "translation": "아니, 이건 진짜야, 그래도 다들 내 조랑말에 올라타겠지"
    },
    {
      "startMs": 75450,
      "endMs": 78180,
      "translation": "가슴을 드러내니 다들 날 알아봐"
    },
    {
      "startMs": 78180,
      "endMs": 81100,
      "translation": "그래, 난 정말 예뻐서 다들 보고 싶어 해"
    },
    {
      "startMs": 81100,
      "endMs": 84190,
      "translation": "다들 왔다 갔다 하는 데 꽤 익숙해"
    },
    {
      "startMs": 84190,
      "endMs": 89580,
      "translation": "이제 내가 하는 그 요들을 그 여자가 하게 만들었어"
    },
    {
      "startMs": 89580,
      "endMs": 94650,
      "translation": "단두대 위에 목걸이 스무 개"
    },
    {
      "startMs": 94650,
      "endMs": 100650,
      "translation": "날 아빠라 부르는 그 여자는 애빌린 출신"
    },
    {
      "startMs": 100650,
      "endMs": 106690,
      "translation": "일이 어떻게 흘러가는지 알잖아, 달콤하지 않아?"
    },
    {
      "startMs": 106690,
      "endMs": 112750,
      "translation": "텍사스 티"
    },
    {
      "startMs": 112750,
      "endMs": 118720,
      "translation": "나보다 키 큰 잔에 뭐라도 따라 줘"
    },
    {
      "startMs": 118720,
      "endMs": 124800,
      "translation": "내 차를 마시면 황홀해"
    },
    {
      "startMs": 124800,
      "endMs": 130660,
      "translation": "일이 어떻게 흘러가는지 알잖아, 달콤하지 않아?"
    },
    {
      "startMs": 130660,
      "endMs": 139000,
      "translation": "텍사스 티"
    }
  ]
}
