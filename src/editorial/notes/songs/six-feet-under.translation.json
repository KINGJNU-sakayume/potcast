    {
      "startMs": 13800,
      "endMs": 17480,
      "translation": "그녀에 대해 주변에 물어봐"
    },
    {
      "startMs": 17480,
      "endMs": 20820,
      "translation": "그녀는 감정에 휘둘리지 않아"
    },
    {
      "startMs": 20820,
      "endMs": 24270,
      "translation": "모든 감정을 죽여 버렸지"
    },
    {
      "startMs": 24270,
      "endMs": 27960,
      "translation": "그래서 가까이 다가갈 수 없어"
    },
    {
      "startMs": 27960,
      "endMs": 31740,
      "translation": "그녀는 자기 몸에 팬층이 있다는 걸 알아 (아냐, 아냐, 아냐)"
    },
    {
      "startMs": 31740,
      "endMs": 35090,
      "translation": "서류 가방을 든 놈 몇 명이 있고"
    },
    {
      "startMs": 35090,
      "endMs": 38390,
      "translation": "정장에 넥타이를 맨 놈들이 역할극을 해"
    },
    {
      "startMs": 38390,
      "endMs": 41860,
      "translation": "돈 얘기가 나오면 그녀는 장난하지 않아"
    },
    {
      "startMs": 41860,
      "endMs": 45410,
      "translation": "그녀는 사탕처럼 핥아 먹어 (사탕)"
    },
    {
      "startMs": 45410,
      "endMs": 48840,
      "translation": "그들이 가정을 떠나게 만들고 싶어 해 (가정)"
    },
    {
      "startMs": 48840,
      "endMs": 52250,
      "translation": "아주 화려한 삶을 살려고 해 (화려한)"
    },
    {
      "startMs": 52250,
      "endMs": 55630,
      "translation": "벤틀리를 타고 나타나고 싶어 해"
    },
    {
      "startMs": 55630,
      "endMs": 59100,
      "translation": "그녀에겐 사랑할 시간이 없어 (사랑)"
    },
    {
      "startMs": 59100,
      "endMs": 62530,
      "translation": "루이 비통이 그녀의 남편이야 (남편)"
    },
    {
      "startMs": 62530,
      "endMs": 65620,
      "translation": "그녀는 욕망 속에서 죽는 쪽을 택해 (욕망)"
