  "segments": [
    {
      "startMs": 17650,
      "endMs": 24560,
      "translation": "사람들은 그의 얼굴 화장을 빤히 쳐다봤다"
    },
    {
      "startMs": 24560,
      "endMs": 32020,
      "translation": "그의 긴 검은 머리와 짐승 같은 우아함을 비웃었다"
    },
    {
      "startMs": 32020,
      "endMs": 37050,
      "translation": "새파란 청바지를 입은 그 소년은"
    },
    {
      "startMs": 37050,
      "endMs": 39530,
      "translation": "무대 위로 뛰어올랐고"
    },
    {
      "startMs": 39530,
      "endMs": 43720,
      "translation": "레이디 스타더스트는 자신의 노래를 불렀다"
    },
    {
      "startMs": 43720,
      "endMs": 46040,
      "translation": "어둠과 치욕에 관한"
    },
    {
      "startMs": 46040,
      "endMs": 54000,
      "translation": "그는 괜찮았다, 밴드는 모두 한데 모여 있었다"
    },
    {
      "startMs": 54000,
      "endMs": 61500,
      "translation": "그래, 그는 괜찮았다, 노래는 영원히 이어졌다"
    },
    {
      "startMs": 61500,
      "endMs": 65010,
      "translation": "그는 정말 너무 멋졌다"
    },
    {
      "startMs": 65010,
      "endMs": 79220,
      "translation": "정말 현실감 없을 만큼 멋졌고, 밤새도록 노래했다"
    },
    {
      "startMs": 79220,
      "endMs": 81930,
      "translation": "팜 파탈들이 그림자 속에서 모습을 드러냈다"
    },
    {
      "startMs": 81930,
      "endMs": 85490,
      "translation": "이 아름다운 존재를 보려고"
    },
    {
      "startMs": 85490,
      "endMs": 88380,
      "translation": "소년들은 의자 위에 올라섰다"
    },
    {
      "startMs": 88380,
      "endMs": 92370,
      "translation": "더 잘 보려고"
    },
    {
      "startMs": 92370,
      "endMs": 99250,
      "translation": "나는 따를 수 없는 사랑 때문에 슬프게 웃었다"
    },
    {
      "startMs": 99250,
      "endMs": 104000,
      "translation": "레이디 스타더스트는 자신의 노래를 불렀다"
    },
    {
      "startMs": 104000,
      "endMs": 106530,
      "translation": "어둠과 불안에 관한"
    },
    {
      "startMs": 106530,
      "endMs": 113840,
      "translation": "그는 괜찮았다, 밴드는 모두 한데 모여 있었다"
    },
    {
      "startMs": 113840,
      "endMs": 121160,
      "translation": "그래, 그는 괜찮았다, 노래는 영원히 이어졌다"
    },
    {
      "startMs": 121160,
      "endMs": 125590,
      "translation": "그리고 그는 정말 너무 멋졌다"
    },
    {
      "startMs": 125590,
      "endMs": 136080,
      "translation": "정말 현실감 없을 만큼 멋졌고, 밤새도록 노래했다"
    },
    {
      "startMs": 136080,
      "endMs": 143700,
      "translation": "사람들이 그의 이름을 아느냐고 물었을 때 나는 얼마나 한숨지었던가"
    },
    {
      "startMs": 143700,
      "endMs": 151990,
      "translation": "그래도 그는 괜찮았고, 노래는 영원히 이어졌다"
    },
    {
      "startMs": 151990,
      "endMs": 157170,
      "translation": "그래, 그는 괜찮았고 노래는 함께 이어졌다"
    },
    {
      "startMs": 157170,
      "endMs": 164440,
      "translation": "그는 정말 너무 멋졌다"
    },
    {
      "startMs": 164440,
      "endMs": 201000,
      "translation": "정말 천국 같았다, 그는 밤새도록 노래했다"
    }
  ]
}
