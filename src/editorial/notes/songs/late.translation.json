    },
    {
      "startMs": 137750,
      "endMs": 140290,
      "translation": "늦으면 신호등에 다 걸린다는 거 알지"
    },
    {
      "startMs": 140290,
      "endMs": 143560,
      "translation": "맞아 (맞아), 맞아 (맞아)"
    },
    {
      "startMs": 143560,
      "endMs": 146640,
      "translation": "그리고 돌아가면 그녀가 싸움을 걸 거야"
    },
    {
      "startMs": 146640,
      "endMs": 149030,
      "translation": "그날 밤 (그날 밤), 그날 밤"
    },
    {
      "startMs": 149030,
      "endMs": 152340,
      "translation": "자기, 이젠 너무 늦었어, 요즘 난 천천히 가"
    },
    {
      "startMs": 152340,
      "endMs": 155510,
      "translation": "게스트 명단이 닫히기 전에 파티에 가 보려고"
    },
    {
      "startMs": 155510,
      "endMs": 158310,
      "translation": "제일 잘나가는 여자들이랑, 교수들도 알지"
    },
    {
      "startMs": 158310,
      "endMs": 161680,
      "translation": "우리가 곧 아주 비전문적으로 놀 거라는 걸"
    },
    {
      "startMs": 161680,
      "endMs": 164610,
      "translation": "에스키모처럼, 클론다이크 아이스크림을 위해 뭘 할 수 있어?"
    },
    {
      "startMs": 164610,
      "endMs": 167700,
      "translation": "아니면 크리스티나 밀리언 닮은 두 여자를 위해서라면?"
    },
    {
      "startMs": 167700,
      "endMs": 170140,
      "translation": "흠, 그건 제시간에 갈게"
    },
    {
      "startMs": 170140,
      "endMs": 173510,
      "translation": "거기에 맞는 운율이 하나도 안 떠오르네"
    },
    {
      "startMs": 173510,
      "endMs": 176730,
      "translation": "야, 5분 안에 갈게, 다섯 시간 뒤에?"
    },
    {
      "startMs": 176730,
      "endMs": 179910,
      "translation": "\"5분 안에 갈게\", 그래, 그냥 받아들여"
    },
    {
      "startMs": 179910,
      "endMs": 182840,
      "translation": "난 이렇게 살아, 내가 해낸 걸 봐"
    },
    {
      "startMs": 182840,
      "endMs": 186330,
      "translation": "딴짓만 하다가 결국 해내고 도착했어"
    },
    {
      "startMs": 186330,
      "endMs": 189190,
      "translation": "늦은 거 알아, 일 년 내내 걸렸지만"
    },
    {
      "startMs": 189190,
      "endMs": 193730,
      "translation": "불평은 그만해도 돼, 드디어 내가 왔으니까, 그래"
    },
    {
      "startMs": 193730,
      "endMs": 199790,
      "translation": "내가 지워 줄게"
    },
