    {
      "startMs": 9970,
      "endMs": 12270,
      "translation": "어린 아가씨 (아하하하하)"
    },
    {
      "startMs": 12270,
      "endMs": 17960,
      "translation": "이제 그만 울어"
    },
    {
      "startMs": 17960,
      "endMs": 21600,
      "translation": "그 일엔 늦겠지만, 자기, 기다릴게"
    },
    {
      "startMs": 21600,
      "endMs": 24630,
      "translation": "맛을 한번 보면 아마 돈이라도 내겠지"
    },
    {
      "startMs": 24630,
      "endMs": 26720,
      "translation": "난 내키면 들어갈 거야"
    },
    {
      "startMs": 26720,
      "endMs": 29910,
      "translation": "그러니 기분이 맞을 때만 이거 볼륨을 키워"
    },
    {
      "startMs": 29910,
      "endMs": 33590,
      "translation": "그 일엔 늦겠지만, 기다릴 수가 없어"
    },
    {
      "startMs": 33590,
      "endMs": 36780,
      "translation": "난 그러려고 태어난 것 같아"
    },
    {
      "startMs": 36780,
      "endMs": 38850,
      "translation": "그러니 난 내키면 들어갈 거야"
    },
    {
      "startMs": 38850,
      "endMs": 48830,
      "translation": "그러니 기분이 맞을 때만 이거 볼륨을 키워"
    },
    {
      "startMs": 48830,
      "endMs": 52570,
      "translation": "그만 좀 울어, 난 날아왔어"
    },
    {
      "startMs": 52570,
      "endMs": 55450,
      "translation": "겨우 등록할 시간에 맞춰 학교에 도착했지"
    },
    {
      "startMs": 55450,
      "endMs": 58350,
      "translation": "그래, 알람 소리 들려, 그래, 엄마 말도 들려"
    },
    {
      "startMs": 58350,
      "endMs": 61670,
      "translation": "그래, 그래, 서른한 살에 빈털터리는 싫어"
    },
    {
      "startMs": 61670,
      "endMs": 64890,
      "translation": "좋은 수업은 빨리 온 사람한테 간대, 미안해요, 웨스트 군"
    },
    {
      "startMs": 64890,
      "endMs": 67870,
      "translation": "좋은 수업은 하나도 없어, 그게 네 꼴이야"
    },
    {
      "startMs": 67870,
      "endMs": 70640,
      "translation": "교양 과목도 없어요? 선수 과목도요?"
    },
    {
      "startMs": 70640,
      "endMs": 73770,
      "translation": "그러니까 몇 초 차이로 전공을 놓쳤다는 거예요?"
    },
    {
      "startMs": 73770,
      "endMs": 76640,
      "translation": "이제 난 목공 수업이나 바구니 짜기 수업에"
    },
    {
      "startMs": 76640,
      "endMs": 79690,
      "translation": "공부 못하는 나머지 녀석들이랑 같이 있어"
    },
    {
      "startMs": 79690,
      "endMs": 81980,
      "translation": "이거 완전 모욕이야"
    },
    {
      "startMs": 81980,
      "endMs": 84990,
      "translation": "중학교 때부터 다 같이 다녔는데 다들 느렸다고"
    },
    {
      "startMs": 84990,
      "endMs": 87920,
      "translation": "비트를 잡을 수 있으면 템포를 늦춰"
    },
    {
      "startMs": 87920,
      "endMs": 91000,
      "translation": "인트로에 너무 늦으면 그냥 끝에 넣어 버려"
    },
    {
      "startMs": 91000,
      "endMs": 94020,
      "translation": "학자금 대출에서 벤츠까지 갈 수 있을까?"
    },
    {
      "startMs": 94020,
      "endMs": 102990,
      "translation": "노인네 오줌 누듯 결국 다 기저귀 하기 나름이지, 오, 오"
    },
    {
      "startMs": 102990,
      "endMs": 105950,
      "translation": "그만 울어, 자기"
    },
    {
      "startMs": 105950,
      "endMs": 109470,
