    "durationMs": 240000
  },
  "segments": [
    {
      "startMs": 910,
      "endMs": 6570,
      "translation": "아니, 아니, 아니"
    },
    {
      "startMs": 6570,
      "endMs": 10430,
      "translation": "널 실망시켰고, 헛된 기대를 품게 했어"
    },
    {
      "startMs": 10430,
      "endMs": 14930,
      "translation": "너 없이 여기 있게 될 줄은 몰랐어"
    },
    {
      "startMs": 14930,
      "endMs": 18570,
      "translation": "네 품 안에서 날 가라앉게 두지 마"
    },
    {
      "startMs": 18570,
      "endMs": 21330,
      "translation": "머릿속엔 나쁜 생각들뿐"
    },
    {
      "startMs": 21330,
      "endMs": 24970,
      "translation": "어둠이 오면 넌 내 빛이야, 베이비"
    },
    {
      "startMs": 24970,
      "endMs": 30460,
      "translation": "내 빛, 베이비, 어두울 때 내 빛, 예"
    },
    {
      "startMs": 30460,
      "endMs": 34760,
      "translation": "난 너무 취했어, 베이비, 너무 높이 떠 있어"
    },
    {
      "startMs": 34760,
      "endMs": 39980,
      "translation": "이제 알거든, 내가 다 놓쳐 버렸다는 걸 (헤이)"
    },
    {
      "startMs": 39980,
      "endMs": 48180,
      "translation": "우리 영혼을 구하기엔 너무 늦었어, 베이비 (오, 오, 예)"
    },
    {
      "startMs": 48180,
      "endMs": 55760,
      "translation": "너무 늦었어, 우린 각자 혼자야 (베이비, 나 혼자)"
    },
    {
      "startMs": 55760,
      "endMs": 63890,
      "translation": "난 실수했고, 너한테 잘못했어, 베이비 (오, 오, 예)"
    },
    {
      "startMs": 63890,
      "endMs": 71000,
      "translation": "구하기엔 너무 늦었어, 내—"
    },
    {
      "startMs": 71000,
      "endMs": 78650,
      "translation": "이젠 내가 사는 곳을 믿을 수가 없어 (믿을 수가 없어, 사는 곳을) (더는, 더는, 더는)"
    },
    {
      "startMs": 78650,
      "endMs": 86660,
      "translation": "소식통은 우리가 끝났대, 그 사람들이 어떻게 알아? (알거든, 다 알거든)"
    },
    {
      "startMs": 86660,
      "endMs": 94870,
      "translation": "우린 지옥에 있어, 번쩍이는 불빛으로 낙원처럼 꾸며진 지옥"
    },
    {
      "startMs": 94870,
      "endMs": 103600,
      "translation": "그보다 더 많은 게 있다고 믿고 싶을 뿐이야 (헤이, 우, 헤이, 우, 헤이)"
    },
    {
      "startMs": 103600,
      "endMs": 111730,
      "translation": "우리 영혼을 구하기엔 너무 늦었어, 베이비 (오, 오, 예)"
    },
    {
      "startMs": 111730,
      "endMs": 119480,
      "translation": "너무 늦었어, 우린 각자 혼자야 (베이비, 나 혼자)"
    },
    {
      "startMs": 119480,
      "endMs": 127380,
      "translation": "난 실수했고, 너한테 잘못했어, 베이비 (오, 오, 예)"
    },
    {
      "startMs": 127380,
      "endMs": 134680,
      "translation": "구하기엔 너무 늦었어, 내—"
    },
    {
      "startMs": 134680,
      "endMs": 141260,
      "translation": "그리고, 우, 널 잊어야 한다고 스스로 말해"
    },
    {
      "startMs": 141260,
      "endMs": 148620,
      "translation": "우, 그래도 잊기보단 온통 너에게 빠져 있고 싶어"
    },
    {
      "startMs": 148620,
      "endMs": 156780,
      "translation": "애쓰고, 애쓰는데, 난, 난 그냥 네 몸을 원해"
    },
    {
      "startMs": 156780,
      "endMs": 162050,
      "translation": "내 위에서 천천히 움직여 줘, 내 위에서"
    },
    {
      "startMs": 162050,
      "endMs": 167340,
      "translation": "널 원해, 베이브, 우-우"
    },
    {
      "startMs": 167340,
      "endMs": 175390,
      "translation": "너무 늦었어 (늦었어), 우리 영혼을 구하기엔, 베이비 (영혼, 베이비, 오, 오, 오-오-오)"
    },
    {
      "startMs": 175390,
      "endMs": 183350,
      "translation": "너무 늦었어, 우린 각자 혼자야 (베이비, 나 혼자)"
    },
    {
      "startMs": 183350,
      "endMs": 191210,
      "translation": "난 실수했고 (실수), 너한테 잘못했어, 베이비 (오, 오, 예)"
    },
    {
      "startMs": 191210,
      "endMs": 240000,
      "translation": "구하기엔 너무 늦었어, 내—"
    }
  ]
}
