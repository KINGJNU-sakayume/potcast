  "segments": [
    {
      "startMs": 730,
      "endMs": 11020,
      "translation": "누군가가 지금 눈물을 삼키고 있다, 삼키고 또 삼키고 있다"
    },
    {
      "startMs": 11020,
      "endMs": 20150,
      "translation": "힘이 따르는 악의를 뿌리치지만 귀는 들리지 않는다"
    },
    {
      "startMs": 20150,
      "endMs": 28980,
      "translation": "그러나 용사는 지금 힘이 필요 없다, 몸을 맡긴 채"
    },
    {
      "startMs": 28980,
      "endMs": 40170,
      "translation": "작은 이 손은 지금 사랑해 버렸다, 전부 다"
    },
    {
      "startMs": 40170,
      "endMs": 45960,
      "translation": "덮쳐 온 저주도 전부"
    },
    {
      "startMs": 45960,
      "endMs": 59510,
      "translation": "이미 사랑해 버린 마음을 전부 지킬 수 있을 만큼의 빛을"
    },
    {
      "startMs": 59510,
      "endMs": 71040,
      "translation": "어디선가 다시 슬픔이 날아다닌다, 날아다니고 있다"
    },
    {
      "startMs": 71040,
      "endMs": 81950,
      "translation": "잃고 또 잃고 무릎을 꿇은 채 숨을 쉬고 있다"
    },
    {
      "startMs": 81950,
      "endMs": 88920,
      "translation": "그것은 눈물과 짝을 이루고 슬픔과 함께 힘이 되어"
    },
    {
      "startMs": 88920,
      "endMs": 93880,
      "translation": "애틋함이 무언가를 부숴 간다"
    },
    {
      "startMs": 93880,
      "endMs": 99680,
      "translation": "거기는 눈물과 짝을 이루고 의심이 넘쳐흘러"
    },
    {
      "startMs": 99680,
      "endMs": 110830,
      "translation": "이 모든 것을 짊어진 손으로 사랑해 버렸다, 전부 다"
    },
    {
      "startMs": 110830,
      "endMs": 116670,
      "translation": "덮쳐 온 저주도 전부"
    },
    {
      "startMs": 116670,
      "endMs": 129150,
      "translation": "이미 사랑해 버린 마음을 전부 지킬 수 있을 만큼의 빛을"
    },
    {
      "startMs": 129150,
      "endMs": 140960,
      "translation": "누구나 원했던 검도 녹투성이라 쓸 수 없었다"
    },
    {
      "startMs": 140960,
      "endMs": 152460,
      "translation": "누군가가 남기고 간 이 무딘 칼이 어둠을 가르기 전에"
    },
    {
      "startMs": 152460,
      "endMs": 158020,
      "translation": "사랑해 버렸다, 전부 다"
    },
