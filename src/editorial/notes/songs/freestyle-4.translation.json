      "endMs": 23390,
      "translation": "라, 라"
    },
    {
      "startMs": 27920,
      "endMs": 30980,
      "translation": "눈을 감으면 뭔가 보여"
    },
    {
      "startMs": 30980,
      "endMs": 32890,
      "translation": "불을 붙여, 약에 취해"
    },
    {
      "startMs": 32890,
      "endMs": 34700,
      "translation": "넌 내 야한 꿈에 나와"
    },
    {
      "startMs": 34700,
      "endMs": 36730,
      "translation": "넌 내 야한 꿈에 나와"
    },
    {
      "startMs": 36730,
      "endMs": 38460,
      "translation": "섹시한 여자, 알아듣겠지"
    },
    {
      "startMs": 38460,
      "endMs": 40260,
      "translation": "돈다발을 벌고 차를 몰아"
    },
    {
      "startMs": 40260,
      "endMs": 42190,
      "translation": "꺼내, 여자도 나와"
    },
    {
      "startMs": 42190,
      "endMs": 44320,
      "translation": "가슴을 드러내, 오, 젠장"
    },
    {
      "startMs": 44320,
      "endMs": 46180,
      "translation": "내 좆도 꺼냈어, 지금 빨아 줄 수 있어?"
    },
    {
      "startMs": 46180,
      "endMs": 48280,
      "translation": "젠장, 지금 섹스할 수 있어?"
    },
    {
      "startMs": 48280,
      "endMs": 50260,
      "translation": "이제 두 번이나 물었어"
    },
    {
      "startMs": 50260,
      "endMs": 52530,
      "translation": "값 좀 낮출 수 있어?"
    },
    {
      "startMs": 52530,
      "endMs": 54130,
      "translation": "릴 부지처럼 닦아 내"
    },
    {
      "startMs": 54130,
      "endMs": 56040,
      "translation": "조금 어지럽지만 지금 기분은 좋아"
    },
    {
      "startMs": 56040,
      "endMs": 58170,
      "translation": "지금 대체 뭐야?"
    },
    {
      "startMs": 58170,
      "endMs": 59950,
      "translation": "지금 대체 뭐야?"
    },
    {
      "startMs": 59950,
      "endMs": 61690,
      "translation": "지금 대체, 대체 뭐야?"
    },
    {
      "startMs": 61690,
      "endMs": 63680,
      "translation": "지금 우리가 섹스하면 어떨까?"
    },
    {
      "startMs": 63680,
      "endMs": 66560,
      "translation": "이 빌어먹을 식탁 한가운데서 섹스하면 어떨까?"
    },
    {
      "startMs": 66560,
      "endMs": 68400,
      "translation": "그냥 보그 파티에서 섹스하면 어떨까?"
    },
    {
      "startMs": 68400,
      "endMs": 70270,
      "translation": "우리가 파티 전체의 중심이 될까?"
    },
    {
      "startMs": 70270,
      "endMs": 72180,
      "translation": "파티 전체를 멈춰 버려"
    },
    {
      "startMs": 72180,
      "endMs": 73710,
      "translation": "모두가 섹스하기 시작할까?"
    },
    {
      "startMs": 73710,
      "endMs": 74870,
      "translation": "모두가 섹스하기 시작할까?"
    },
    {
      "startMs": 74870,
      "endMs": 77200,
      "translation": "모두가 섹스하기 시작할까? 걔들은 아무것도 원하지 않아"
    },
    {
      "startMs": 77200,
      "endMs": 81450,
      "translation": "너희 새끼들은 네 수준의 절반, 네 삶의 절반만 살고 있어"
    },
    {
      "startMs": 81450,
      "endMs": 83940,
      "translation": "걔가 거리 출신이면 엉덩이를 때려, 거짓말 안 해"
    },
    {
      "startMs": 83940,
      "endMs": 90250,
      "translation": "우린 화장실에서 섹스해, 자기야, 너무 큰 소리는 내지 마"
    },
    {
      "startMs": 90250,
      "endMs": 92170,
      "translation": "난, 난 노래할 수 있어, 그래"
    },
    {
      "startMs": 92170,
      "endMs": 93170,
      "translation": "지금 당장 원해"
    },
    {
      "startMs": 93170,
      "endMs": 95340,
      "translation": "내 친구들은 이제 시카고에서 한몫 챙길 거야"
    },
    {
      "startMs": 95340,
      "endMs": 96970,
      "translation": "이제 넌 파이에 맞아"
    },
    {
      "startMs": 96970,
      "endMs": 99370,
      "translation": "엄청난 돈을 가진 놈들과 어울려, 이제 살아가"
    },
    {
      "startMs": 99370,
      "endMs": 100980,
      "translation": "지금 당장, 지금 당장"
    },
    {
      "startMs": 100980,
      "endMs": 103030,
      "translation": "지금 난 네 쪽에 갔던 놈들과 함께 있어"
    },
    {
      "startMs": 103030,
      "endMs": 104190,
      "translation": "네 쪽에, 옆으로 내려"
