    {
      "startMs": 6250,
      "endMs": 8700,
      "translation": "브로크 파이 브로크 (우린 가진 게 없어)"
    },
    {
      "startMs": 8700,
      "endMs": 10860,
      "translation": "그래, 우린 돈이 없어, 청바지도 나눠 입지"
