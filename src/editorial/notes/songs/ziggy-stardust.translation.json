{
  "schemaVersion": 2,
  "timing": {
    "lrclibId": 889487,
    "durationMs": 193000
  },
  "segments": [
    {
      "startMs": 25830,
      "endMs": 32590,
      "translation": "지기는 기타를 쳤다, 위어드와 길리와 끝내주게 잼을 하며"
    },
    {
      "startMs": 32590,
      "endMs": 38270,
      "translation": "그리고 화성에서 온 스파이더스와. 그는 왼손으로 연주했다"
    },
    {
      "startMs": 38270,
      "endMs": 41850,
      "translation": "하지만 너무 멀리 가 버렸다"
    },
    {
      "startMs": 41850,
      "endMs": 49590,
      "translation": "특별한 사람이 되었고, 우리는 지기의 밴드가 되었다"
    },
    {
      "startMs": 49590,
      "endMs": 56430,
      "translation": "이제 지기는 정말 노래했다, 눈을 찡그리고 머리는 눌러 빗은 채"
    },
    {
      "startMs": 56430,
      "endMs": 62170,
      "translation": "일본에서 온 어떤 녀석처럼, 그는 미소 하나로 그들을 녹일 수 있었고"
    },
    {
      "startMs": 62170,
      "endMs": 66060,
      "translation": "그들을 애태우게 둘 수도 있었다"
    },
    {
      "startMs": 66060,
      "endMs": 73250,
      "translation": "잔뜩 취해 나타났지, 물건도 큼직하고 눈처럼 하얗게 그을린 채"
    },
    {
      "startMs": 73250,
      "endMs": 84730,
      "translation": "그렇다면 스파이더스는 어디 있었나, 그 파리가 우리를 들들 볶을 때"
    },
    {
      "startMs": 84730,
      "endMs": 89750,
      "translation": "우릴 이끈 건 맥주 불빛뿐이었고"
    },
    {
      "startMs": 89750,
      "endMs": 108840,
      "translation": "우린 그의 팬들을 욕하며, 저 고운 손을 부숴 버릴까 떠들었다"
    },
    {
      "startMs": 108840,
      "endMs": 115400,
      "translation": "지기는 시간을 벌며, 우리가 부두의 주술사들이라고 우리를 구슬렸다"
    },
    {
      "startMs": 115400,
      "endMs": 121160,
      "translation": "그 녀석은 그저 천박했고, 동시에 최고의 존재였다"
    },
    {
      "startMs": 121160,
      "endMs": 125070,
      "translation": "신이 내린 엉덩이를 가진"
    },
    {
      "startMs": 125070,
      "endMs": 132210,
      "translation": "모든 걸 너무 멀리 끌고 갔지만, 젠장 기타는 정말 잘 쳤다"
    },
    {
      "startMs": 132210,
      "endMs": 144380,
      "translation": "자기 자아와 사랑을 나누며 지기는 자기 머릿속으로 빨려 들어갔다"
    },
    {
      "startMs": 144380,
      "endMs": 148750,
      "translation": "나병 환자 같은 메시아처럼"
    },
    {
      "startMs": 148750,
      "endMs": 178210,
      "translation": "아이들이 그 사람을 죽였을 때 나는 밴드를 해체할 수밖에 없었다"
    },
    {
      "startMs": 178210,
      "endMs": 193000,
      "translation": "지기는 기타를 쳤다"
    }
  ]
}
