    },
    {
      "startMs": 89210,
      "endMs": 92160,
      "translation": "저들은 우릴 스티로폼처럼 상자에 다 쑤셔 넣고 싶어 해"
    },
    {
      "startMs": 92160,
      "endMs": 94550,
