  "segments": [
    {
      "startMs": 4660,
      "endMs": 6480,
      "translation": "(내놔)"
    },
    {
      "startMs": 6480,
      "endMs": 11170,
      "translation": "야, 나 늙어 가, 손주가 필요해, 제발 (내놔)"
    },
    {
      "startMs": 11170,
      "endMs": 14420,
      "translation": "딱 하나만, 제발, 하나면 돼 (내놔-내놔)"
    },
    {
      "startMs": 14420,
      "endMs": 16830,
      "translation": "쪼그만 꼬마 타일러가 여기저기 어슬렁거려야 한다니까, 알겠지?"
    },
    {
      "startMs": 16830,
      "endMs": 20270,
      "translation": "쪼그만 '두키 우디'가 여기저기 뛰어다녀야 한다니까, 알겠지?"
    },
    {
      "startMs": 20270,
      "endMs": 25260,
      "translation": "엄마 손이 예전 같지 않아."
    },
    {
      "startMs": 25260,
      "endMs": 29140,
      "translation": "이 새까만 가닥들이 희어지고 있어."
    },
    {
      "startMs": 29140,
      "endMs": 31660,
      "translation": "살도 찌고, 차라리 쉬고 싶어."
    },
    {
      "startMs": 31660,
      "endMs": 34110,
      "translation": "아이 생각을 하면 스트레스가 밀려와."
    },
    {
      "startMs": 34110,
      "endMs": 39670,
      "translation": "시간이 바뀌고 있으니까"
    },
    {
      "startMs": 39670,
      "endMs": 44680,
      "translation": "날 기다리지 마 (마), 난 괜찮을 거야."
    },
    {
      "startMs": 44680,
      "endMs": 49660,
      "translation": "날 기다리지 마, 난 괜찮을 거야 (마, 마)"
    },
    {
      "startMs": 49660,
      "endMs": 52150,
      "translation": "날 기다리지는 마."
    },
    {
      "startMs": 52150,
      "endMs": 62830,
      "translation": "시간이 하는 일은 하나도 맞는 게 없으니까, 하지 마, 어 (하지 마)"
    },
    {
      "startMs": 62830,
      "endMs": 64850,
      "translation": "내일 걱정은 (하지 마, 하지 마)"
    },
    {
      "startMs": 64850,
      "endMs": 67000,
      "translation": "내일 걱정은 하지 마"
    },
    {
      "startMs": 67000,
      "endMs": 72780,
      "translation": "내일 걱정을 할 수 있겠어? 에이, 에이, 에이 (내일)"
    },
    {
      "startMs": 72780,
      "endMs": 78940,
      "translation": "내일 걱정은 하지 마 (내일)"
    },
    {
      "startMs": 78940,
      "endMs": 82390,
      "translation": "그래, 나한테 무슨 일이 생긴 거지? 아니, 그런 에너지가 아니야."
    },
    {
      "startMs": 82390,
      "endMs": 84730,
      "translation": "네가 알던 T는 이미 기억일 뿐이야."
    },
    {
      "startMs": 84730,
      "endMs": 87280,
      "translation": "그게 누구냐고? 너희 놈들은 너무 매달려서 이 소리를 못 듣지,"
    },
    {
      "startMs": 87280,
      "endMs": 89710,
      "translation": "그걸 두려워하지, 얼굴은 말끔한데 내 영혼엔 주름이 몇 줄 생겼어."
    },
    {
      "startMs": 89710,
      "endMs": 91960,
      "translation": "자, 사촌, 이건 욕조에 들어앉는 얘기가 아니야."
    },
    {
      "startMs": 91960,
      "endMs": 94350,
      "translation": "난 새장이 싫어, 차라리 물에 잠기는 편이 낫지."
    },
    {
      "startMs": 94350,
      "endMs": 96860,
      "translation": "이 일을 곰곰이 생각했어, 오븐을 들고 튀어나올게."
    },
    {
      "startMs": 96860,
      "endMs": 99920,
      "translation": "그 새로운 버전의 나한테 내가 간다고 전해, 그래."
    },
    {
      "startMs": 99920,
      "endMs": 102750,
      "translation": "내 절친이 아기를 또 낳았어, 벌써 둘째야 (둘째)"
    },
    {
      "startMs": 102750,
      "endMs": 104930,
      "translation": "내 여사친은 결혼했어, 서른둘쯤 됐고 (서른둘)"
    },
    {
      "startMs": 104930,
      "endMs": 107320,
      "translation": "걔들은 그런 순간들 사진을 공유하는데, 진짜 귀여워."
    },
    {
      "startMs": 107320,
      "endMs": 109940,
      "translation": "나한텐 내 '라리(Ferrari)'랑 우스꽝스러운 정장 사진뿐이야 (이봐)"
    },
    {
      "startMs": 109940,
      "endMs": 112400,
      "translation": "음, 스위치를 눌러서 드디어 정착할까?"
    },
    {
      "startMs": 112400,
      "endMs": 115000,
      "translation": "음, 아니면 반대로 가서 계속 팬티를 내린 채로 살까?"
    },
    {
      "startMs": 115000,
      "endMs": 117310,
      "translation": "응, 난 너무 편집증적이라 다 드러내 놓을 거야."
    },
    {
      "startMs": 117310,
      "endMs": 119820,
      "translation": "그리고 네가 나한테 주는 압박은 뭐든 부숴 버릴 거야."
    },
    {
      "startMs": 119820,
      "endMs": 124930,
      "translation": "날 기다리지 마, 난 괜찮을 거야."
    },
    {
      "startMs": 124930,
      "endMs": 129990,
      "translation": "날 기다리지 마, 난 괜찮을 거야."
    },
    {
      "startMs": 129990,
      "endMs": 132190,
      "translation": "날 기다리지는 마."
    },
    {
      "startMs": 132190,
      "endMs": 182000,
      "translation": "시간이 하는 일은 하나도 맞는 게 없으니까."
    }
  ]
}