    },
    {
      "startMs": 167180,
      "endMs": 169980,
      "translation": "우리는 모두 저마다의 길 위에 이유가 있어 여기 있다"
    },
    {
      "startMs": 169980,
      "endMs": 173260,
      "translation": "자신이 이 셈의 일부라는 걸 아는 데 교과 과정은 필요 없다"
    },
    {
      "startMs": 173260,
      "endMs": 176330,
      "translation": "사람들은 내가 헛소리한다고 생각하지만 나는 진지하다"
    },
    {
