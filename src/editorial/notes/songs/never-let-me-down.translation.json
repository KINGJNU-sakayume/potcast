    },
    {
      "startMs": 194360,
      "endMs": 198500,
      "translation": "나의 리듬의 대열은 선율의 음표를 몰아 너의 영혼과 정신으로 향한다"
    },
    {
      "startMs": 198500,
      "endMs": 200470,
      "translation": "그래서 나는 악기이자 도구다"
    },
    {
      "startMs": 200470,
