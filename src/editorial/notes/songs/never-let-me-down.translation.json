    },
    {
      "startMs": 273440,
      "endMs": 276040,
      "translation": "맨바닥에서 시작했는데 이렇게 강해졌지 (로커펠라가 왔다)"
    },
    {
      "startMs": 276040,
      "endMs": 278530,
      "translation": "조약돌 하나로 로커펠라를 세웠고, 널 만나기 전엔 돌을 팔았어"
    },
    {
      "startMs": 278530,
      "endMs": 281490,
      "translation": "자전거를 굴렸고, 조카들한테도 자전거를 사 줬지, 특별한 애들이니까"
    },
    {
      "startMs": 281490,
      "endMs": 282800,
      "translation": "그 사람한테 내가 무너진다고 전해 보든가"
    },
    {
      "startMs": 282800,
      "endMs": 284590,
      "translation": "그런데 누가 그를 받아 줬나 봐, 왜냐면"
    },
    {
      "startMs": 284590,
      "endMs": 287360,
      "translation": "4쿼터만 되면 난 마이클 조던처럼 해치우거든"
    },
    {
      "startMs": 287360,
      "endMs": 290370,
      "translation": "1위 앨범? 내가 몇 장 있지? 네 장쯤"
    },
    {
      "startMs": 290370,
      "endMs": 293130,
      "translation": "더 나올 거야, 여덟 번째 불가사의가 오고 있어"
    },
    {
      "startMs": 293130,
      "endMs": 294440,
      "translation": "길을 비켜, 난 계속 여기 있을 거야"
    },
    {
      "startMs": 294440,
      "endMs": 297140,
      "translation": "수다는 집어치워, 이러쿵저러쿵 제이를 디스하는 거"
    },
    {
      "startMs": 297140,
      "endMs": 299230,
      "translation": "제이를 디스하면 최루액 맛을 볼 거야"
    },
    {
      "startMs": 299230,
      "endMs": 302470,
      "translation": "내가 가사를 뱉기 시작하면 다들 아주 경건해지지"
    },
    {
      "startMs": 302470,
      "endMs": 304380,
      "translation": "성모송 여섯 번, \"아버지, 우리를 용서하소서\""
    },
    {
      "startMs": 304380,
      "endMs": 308200,
      "translation": "젊은 대주교, 너희들의 교황 요한 바오로"
    },
    {
      "startMs": 308200,
      "endMs": 310440,
      "translation": "너희가 다 지가를 따르는 걸 보면"
    },
    {
      "startMs": 310440,
      "endMs": 312710,
      "translation": "호브는 살아 있는 전설이야, 이유를 말해 줄게"
    },
    {
      "startMs": 312710,
      "endMs": 316270,
      "translation": "모두 호브가 되고 싶어 하는데 호브는 아직 살아 있거든"
    },
    {
      "startMs": 316270,
      "endMs": 324000,
      "translation": "내려가, 내려가, 내려가, 내려가, 내려가"
    }
  ]
}
