    },
    {
      "startMs": 233430,
      "endMs": 235880,
      "translation": "그래서 내 숨결은 듣지 못하는 이에게도 느껴지고"
    },
    {
      "startMs": 235880,
      "endMs": 239060,
      "translation": "내 말은 보지 못하는 이의 귀에 들리고 머문다"
    },
    {
      "startMs": 239060,
      "endMs": 241520,
      "translation": "나 역시 색으로, 그리고 운율로 꿈꾼다"
    },
    {
      "startMs": 241520,
      "endMs": 244270,
      "translation": "그러니 꽉 찬 집에서도 나는 하나뿐인 존재인가 보다"
    },
    {
      "startMs": 244270,
      "endMs": 247520,
      "translation": "내가 마음을, 영혼을, 입을 열 때마다"
    },
    {
      "startMs": 247520,
      "endMs": 251060,
      "translation": "신의 손길이 비처럼 쏟아지니까"
    },
    {
