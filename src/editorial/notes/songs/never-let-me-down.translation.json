    },
    {
      "startMs": 40270,
      "endMs": 42060,
      "translation": "리본 단 레인지로버가 굴러 들어오는 것도 봤고"
    },
    {
      "startMs": 42060,
      "endMs": 44770,
      "translation": "그 차가 압류되고, 되팔리고, 다른 사람이 모는 것도 봤지"
    },
    {
      "startMs": 44770,
      "endMs": 47760,
      "translation": "그러니 내가 재장전하면 그는 1위 자리를 지켜"
    },
    {
      "startMs": 47760,
      "endMs": 49220,
      "translation": "네가 뜨거울 때 나도 뜨겁고"
    },
    {
      "startMs": 49220,
      "endMs": 51510,
      "translation": "네 발이 식을 때 내 발은 지글거려"
    },
    {
      "startMs": 51510,
      "endMs": 54650,
      "translation": "뻔하잖아, 아무도 날 못 건드려"
    },
    {
      "startMs": 54650,
      "endMs": 57840,
      "translation": "난 평생 이런 놈일 거니까, 이건 만든 이미지가 아니야"
    },
    {
      "startMs": 57840,
      "endMs": 59180,
      "translation": "이건 신이 준 거야"
    },
    {
      "startMs": 59180,
      "endMs": 61950,
      "translation": "고된 삶에 크리스털 한 모금을 섞은 거지"
    },
    {
      "startMs": 61950,
      "endMs": 63290,
      "translation": "가장 꾸준한 놈, 호브"
    },
    {
      "startMs": 63290,
      "endMs": 64220,
      "translation": "디스크 한 장에 다 들어갈 만큼"
    },
    {
      "startMs": 64220,
      "endMs": 66380,
      "translation": "가장 많은 히트곡을 주는"
    },
    {
      "startMs": 66380,
      "endMs": 69030,
      "translation": "난 이 차트에 사는 사람이고, 너흰 다 손님이야"
    },
    {
      "startMs": 69030,
      "endMs": 71680,
      "translation": "이게 호브의 전통이지, 랩계의 제프 고든"
    },
    {
      "startMs": 71680,
      "endMs": 73460,
      "translation": "폴 포지션을 되찾으러 돌아왔어"
    },
    {
      "startMs": 73460,
      "endMs": 75500,
      "translation": "이 몸한테 인사해 (내려가)"
    },
    {
      "startMs": 75500,
      "endMs": 76670,
      "translation": "일어나, 난 (내려가)"
    },
    {
      "startMs": 76670,
      "endMs": 77650,
      "translation": "일어나, 난 (내려가)"
    },
    {
      "startMs": 77650,
      "endMs": 79360,
      "translation": "일어나, 난 (내려가)"
    },
    {
      "startMs": 79360,
      "endMs": 79960,
      "translation": "일어나, 난"
    },
    {
      "startMs": 79960,
      "endMs": 81860,
      "translation": "난 할아버지를 위해 함께해"
    },
    {
      "startMs": 81860,
      "endMs": 84360,
      "translation": "엄마를 데려가 그 자리에 앉혔던 분"
    },
    {
      "startMs": 84360,
      "endMs": 86120,
      "translation": "백인들이 우리가 밥 먹는 걸 원치 않던 그 자리에"
    },
    {
      "startMs": 86120,
      "endMs": 88990,
      "translation": "여섯 살 어린 나이에 엄마는 연좌 농성으로 체포됐어"
    },
    {
      "startMs": 88990,
      "endMs": 91830,
      "translation": "그 피가 흐르니 난 다르게 태어날 수밖에"
    },
    {
      "startMs": 91830,
      "endMs": 94750,
      "translation": "이제 우린 지도자를 뽑으러 투표소엔 못 가도"
    },
    {
      "startMs": 94750,
      "endMs": 97740,
      "translation": "보석상이나 자동차 대리점엔 갈 수 있지"
    },
    {
      "startMs": 97740,
      "endMs": 100680,
      "translation": "맹세컨대, 새 음악을 들어도 와닿질 않아"
    },
    {
      "startMs": 100680,
      "endMs": 103530,
      "translation": "인종주의는 아직 살아 있어, 숨기고 있을 뿐"
    },
    {
      "startMs": 103530,
      "endMs": 106220,
      "translation": "그래도 저들이 날 클럽에 들이기 싫어하는 건 알아"
    },
    {
      "startMs": 106220,
      "endMs": 109440,
      "translation": "샘스 클럽에 들어갈 때조차 신분증을 보여 줘야 했다니까"
    },
    {
      "startMs": 109440,
      "endMs": 112400,
      "translation": "더러운 짓도 했고, 손을 씻으려 교회에도 갔어"
    },
    {
      "startMs": 112400,
      "endMs": 114580,
      "translation": "맹세컨대 세례를 적어도 서너 번은 받았어"
    },
    {
      "startMs": 114580,
      "endMs": 117770,
      "translation": "하지만 우릴 떠받드는 이 땅에서 돈 버는 건 사기꾼들이야"
    },
    {
      "startMs": 117770,
      "endMs": 120420,
      "translation": "우리가 구원받으려면 할인 쿠폰 따위론 어림없어"
    },
    {
      "startMs": 120420,
      "endMs": 123330,
      "translation": "두건 하나로 머리에 물결이 생기지 않듯이"
    },
    {
      "startMs": 123330,
      "endMs": 125920,
      "translation": "내 여자의 아버지가 세상을 떠난 날만큼 슬픈 날은 없었어"
    },
    {
      "startMs": 125920,
      "endMs": 129110,
      "translation": "그래서 레이니 아저씨께 약속했지, 따님과 결혼하겠다고"
    },
    {
      "startMs": 129110,
      "endMs": 131990,
      "translation": "따님을 그렇게 키워 주셔서 고맙다고 해야겠어요"
    },
    {
      "startMs": 131990,
      "endMs": 135010,
      "translation": "내가 그녀에게 사 준 차를 보고 웃으셨을 거란 것도 알아요"
    },
    {
      "startMs": 135010,
      "endMs": 137830,
      "translation": "내 차가 박살 났을 땐 하늘에서 눈물을 보내셨겠죠"
    },
    {
      "startMs": 137830,
      "endMs": 141280,
      "translation": "그래도 사고가 내 왼쪽 눈에 한 짓을 불평할 순 없어"
    },
    {
      "startMs": 141280,
      "endMs": 143960,
      "translation": "사고가 레프트 아이에게 한 짓을 봐"
    },
    {
      "startMs": 143960,
      "endMs": 146320,
      "translation": "먼저 알리야, 이제 로미오도 죽어야 하나"
    },
    {
      "startMs": 146320,
      "endMs": 149220,
      "translation": "저편에서 천사들이 날 지켜보고 있다는 걸 알아"
    },
    {
      "startMs": 149220,
      "endMs": 153780,
      "translation": "진실함에 관해서라면, 적어도 나 자신에게 진실하다면"
    },
    {
      "startMs": 153780,
      "endMs": 156690,
      "translation": "내가 찾은 한 가지, 내가 찾은 한 가지"
    },
    {
      "startMs": 156690,
      "endMs": 158500,
      "translation": "오, 넌 절대 날 실망시키지 않아"
    },
    {
