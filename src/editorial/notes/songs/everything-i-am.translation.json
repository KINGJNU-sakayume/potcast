    },
    {
      "startMs": 142510,
      "endMs": 145610,
      "translation": "사람들이 보통 이런 랩은 안 한다는 거 알아"
    },
    {
      "startMs": 145610,
      "endMs": 147760,
      "translation": "그래도 뒷받침할 사실이 있어"
    },
    {
      "startMs": 147760,
      "endMs": 151540,
      "translation": "작년에만 시카고에서 관이 600개 넘게 나갔어"
    },
    {
      "startMs": 151540,
      "endMs": 153800,
      "translation": "이봐, 사람 죽이는 건 정말 끔찍한 짓이야"
    },
    {
      "startMs": 153800,
      "endMs": 157210,
      "translation": "아, 깜빡했네, 랩할 때만 빼고 말이야"
    },
    {
      "startMs": 157210,
      "endMs": 160300,
      "translation": "사람들이 떠나갈 때 어떤 기분인지 알아?"
    },
    {
      "startMs": 160300,
      "endMs": 162990,
      "translation": "애슐랜드에서 한 블록 떨어진 곳에서 목걸이 때문에 그가 쓰러졌어"
    },
    {
      "startMs": 162990,
      "endMs": 165590,
      "translation": "누군가와 얘기해야겠어, 목사님"
    },
    {
      "startMs": 165590,
      "endMs": 168410,
      "translation": "교회는 시간을 원하는데, 난 돈을 낼 여유가 없어"
    },
    {
      "startMs": 168410,
      "endMs": 171430,
      "translation": "문에 붙은 쪽지, 더 머물 형편이 안 되니까"
    },
    {
      "startMs": 171430,
      "endMs": 174490,
