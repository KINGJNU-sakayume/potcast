    {
      "startMs": 79920,
      "endMs": 82920,
      "translation": "내가 아닌 모든 것이 지금의 나를 만들었어"
    },
    {
      "startMs": 82920,
      "endMs": 85210,
      "translation": "그리고 난 다시 다 뒤집어 놓으러 왔어"
    },
    {
      "startMs": 85210,
      "endMs": 86500,
      "translation": "미워하는 사람들, 시동을 걸어"
    },
    {
      "startMs": 86500,
      "endMs": 88050,
      "translation": "기어 넣는 소리가 들리네"
    },
    {
      "startMs": 88050,
      "endMs": 91600,
      "translation": "이발소에서 다들 내 얘기를 하도 해서"
    },
    {
      "startMs": 91600,
      "endMs": 94340,
      "translation": "머리 깎는 것도 잊어버려"
    },
    {
      "startMs": 94340,
      "endMs": 97070,
      "translation": "좋아, 그럴 만도 하지, 거리가 들끓어"
    },
    {
      "startMs": 97070,
      "endMs": 100190,
      "translation": "다들 총 얘기를 원하는데 난 안 하니까, 아니면 내가 충분히 안 입으니까"
    },
    {
      "startMs": 100190,
      "endMs": 103580,
      "translation": "헐렁한 옷, 리복이나 아디다스를"
    },
    {
      "startMs": 103580,
      "endMs": 106380,
      "translation": "그리고 공연에서 흥분해 버린다는 말도 덧붙여 볼까"
    },
    {
      "startMs": 106380,
      "endMs": 109720,
      "translation": "그러니 NAACP 상이랑은 작별이야"
    },
    {
      "startMs": 109720,
      "endMs": 112700,
      "translation": "인디아 아리 상이랑도 작별이고"
    },
    {
      "startMs": 112700,
      "endMs": 115580,
      "translation": "저들은 차라리 나한테 '어림없지' 상을 주고 싶겠지"
    },
    {
      "startMs": 115580,
      "endMs": 120760,
      "translation": "그래도 난 '돈 많이 번' 상이나 받을게"
