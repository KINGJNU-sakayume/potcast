    },
    {
      "startMs": 20660,
      "endMs": 23480,
      "translation": "내가 아닌 모든 것이 지금의 나를 만들었어"
    },
    {
      "startMs": 23480,
      "endMs": 26540,
      "translation": "난 절대 사진처럼 완벽한 비욘세가 될 수 없어"
    },
    {
      "startMs": 26540,
      "endMs": 29370,
      "translation": "앨비처럼 피부가 밝지도, 촌시처럼 검지도 않지"
    },
    {
      "startMs": 29370,
      "endMs": 31070,
      "translation": "블랙스트리트의 그 사람 기억나지"
    },
    {
      "startMs": 31070,
      "endMs": 32330,
      "translation": "거리만큼이나 검었던"
    },
    {
      "startMs": 32330,
      "endMs": 35250,
      "translation": "난 이 비트처럼 느긋해질 수 없을 거야"
    },
    {
      "startMs": 35250,
      "endMs": 38310,
      "translation": "사람들이 왜 유지하지도 못할"
    },
    {
      "startMs": 38310,
      "endMs": 41180,
      "translation": "가짜 겉치레에 손을 뻗는지 모르겠어"
    },
    {
      "startMs": 41180,
      "endMs": 42460,
      "translation": "내가 어떻게 슬그머니 올라왔는지 보여?"
    },
    {
      "startMs": 42460,
      "endMs": 47230,
      "translation": "퀸 라티파처럼 시카고에서 큰 역할을 했는지 보여?"
    },
    {
      "startMs": 47230,
      "endMs": 50430,
      "translation": "난 킬라 캠처럼 겨울에 밍크코트를 입지도 않고"
    },
    {
      "startMs": 50430,
      "endMs": 53050,
      "translation": "윌아이엠처럼 여름에 밍크 부츠를 신지도 않아"
    },
    {
      "startMs": 53050,
      "endMs": 56100,
      "translation": "느껴지면 말해 줘"
    },
    {
      "startMs": 56100,
      "endMs": 61330,
      "translation": "내가 아닌 모든 것이 지금의 나를 만들었으니까"
    },
    {
      "startMs": 61330,
      "endMs": 64850,
      "translation": "젠장, 또 시작이군"
    },
    {
      "startMs": 64850,
      "endMs": 67980,
      "translation": "다들 그건 그에게 안 맞는다고 하지"
    },
    {
      "startMs": 67980,
      "endMs": 73260,
      "translation": "내가 아닌 모든 것이 지금의 나를 만들었어"
    },
    {
      "startMs": 73260,
      "endMs": 77210,
      "translation": "젠장, 또 시작이군"
    },
    {
      "startMs": 77210,
