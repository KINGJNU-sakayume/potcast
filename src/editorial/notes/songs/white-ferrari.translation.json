{
  "schemaVersion": 2,
  "timing": { "lrclibId": 425233, "durationMs": 249000 },
  "segments": [
    { "startMs": 50, "endMs": 8650, "translation": "이런 드라이브에서 말을 꺼내면 재수 없대" },
    { "startMs": 8650, "endMs": 14400, "translation": "정신은 도로에 가 있고, 네 눈동자는 풀려 있었지" },
    { "startMs": 14400, "endMs": 20260, "translation": "구름이 떠가는 걸 봤어, 화이트 페라리" },
    { "startMs": 20260, "endMs": 21800, "translation": "좋은 시간이었어" },
    { "startMs": 21800, "endMs": 26290, "translation": "열여섯 살에 내가 뭘 알 수 있었겠어?" },
    { "startMs": 26290, "endMs": 35160, "translation": "센트럴에서 널 내려 줬어" },
    { "startMs": 35160, "endMs": 40780, "translation": "뻔한 사실을 굳이 입 밖에 내고 싶지 않았어" },
    { "startMs": 40780, "endMs": 42970, "translation": "입을 다물고 있었지" },
    { "startMs": 42970, "endMs": 51620, "translation": "우리 둘은 서로 너무 익숙했으니까" },
    { "startMs": 51620, "endMs": 56020, "translation": "화이트 페라리, 좋았던 시절" },
    { "startMs": 56020, "endMs": 59970, "translation": "내 곁에 있어, 바싹 붙어 있어" },
    { "startMs": 59970, "endMs": 61560, "translation": "넌 괜찮았어" },
    { "startMs": 61560, "endMs": 62940, "translation": "여기선 넌 괜찮았어" },
    { "startMs": 62940, "endMs": 65860, "translation": "그냥 굼뜬 몸일 뿐이야" },
    { "startMs": 65860, "endMs": 69710, "translation": "내가 말하는 걸 잊었을 때 넌 떠났어" },
    { "startMs": 69710, "endMs": 72660, "translation": "그래서 음성 변환으로 문자를 보내, 더 느린 속도로" },
    { "startMs": 72660, "endMs": 74880, "translation": "텍사스 속도로, 그래" },
    { "startMs": 74880, "endMs": 80050, "translation": "평범한 일상이 나를 갉아먹어, 결국에는, 결국에는, 그래" },
    { "startMs": 80050, "endMs": 85530, "translation": "아, 결국엔 나한테, 결국에는, 그래" },
    { "startMs": 85530, "endMs": 94440, "translation": "난 아직도 널 아껴, 앞으로도 영원히" },
    { "startMs": 94440, "endMs": 100100, "translation": "그게 내가 맡은 약속의 몫이었어, 정말이야" },
    { "startMs": 100100, "endMs": 105580, "translation": "우린 너무 익숙해졌어" },
    { "startMs": 105580, "endMs": 113040, "translation": "일 년 내내 하루하루를 보내며, 화이트 페라리" },
    { "startMs": 113040, "endMs": 117890, "translation": "좋았던 시절" },
    { "startMs": 117890, "endMs": 122130, "translation": "이 삶에서, 삶에서" },
    { "startMs": 122130, "endMs": 132080, "translation": "이 삶에서, 삶에서" },
    { "startMs": 132080, "endMs": 140560, "translation": "너무 많이 쌓인 세월, 페이스리프트한 얼굴 위에 문신한 눈꺼풀" },
    { "startMs": 140560, "endMs": 144350, "translation": "정신이 물질을 이기는 건 마법이야" },
    { "startMs": 144350, "endMs": 148560, "translation": "난 마법을 부려" },
    { "startMs": 148560, "endMs": 152920, "translation": "생각해 보면 금방 끝나 버릴 거야" },
    { "startMs": 152920, "endMs": 187050, "translation": "그게 인생이지" },
    { "startMs": 187050, "endMs": 191530, "translation": "다른 차원에서는 우리 키가 더 클 거야, 분명히" },
    { "startMs": 191530, "endMs": 195920, "translation": "넌 우리가 작아서 입에 올릴 가치도 없다고 하지" },
    { "startMs": 195920, "endMs": 200440, "translation": "넌 움직이는 데 지쳤고 몸이 쑤신다고 하지" },
    { "startMs": 200440, "endMs": 204500, "translation": "휴가를 떠나도 돼, 갈 곳은 많아" },
    { "startMs": 204500, "endMs": 208700, "translation": "분명 이게 전부는 아니야" },
    { "startMs": 208700, "endMs": 211110, "translation": "주어진 걸 그대로 받아들일 수 없어" },
    { "startMs": 211110, "endMs": 215620, "translation": "그래도 여기선 우리 정말 괜찮아, 잘 지내고 있어" },
    { "startMs": 215620, "endMs": 217930, "translation": "원초적으로, 벌거벗은 채로" },
    { "startMs": 217930, "endMs": 222390, "translation": "넌 우리를 가두는 벽을 꿈꾸지" },
    { "startMs": 222390, "endMs": 226680, "translation": "그냥 두개골일 뿐이야, 적어도 사람들은 그렇게 불러" },
    { "startMs": 226680, "endMs": 249000, "translation": "그리고 우린 마음껏 떠돌 수 있어" }
  ]
}
