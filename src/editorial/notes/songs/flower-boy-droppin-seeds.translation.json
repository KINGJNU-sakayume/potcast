  "segments": [
    {
      "startMs": 8890,
      "endMs": 12220,
      "translation": "물라!"
    },
    {
      "startMs": 12220,
      "endMs": 14780,
      "translation": "에덴동산의 아담처럼"
    },
    {
      "startMs": 14780,
      "endMs": 17530,
      "translation": "내 여자는 애플 바텀 엉덩이에 내 씨를 삼켜"
    },
    {
      "startMs": 17530,
      "endMs": 20680,
      "translation": "내 뒤를 따라와, 난 불을 뿜고 내 바다에 물을 줘"
    },
    {
      "startMs": 20680,
      "endMs": 22850,
      "translation": "그리고 앉아서 돈이 나무에서 자라는 걸 구경해"
    },
    {
      "startMs": 22850,
      "endMs": 25930,
      "translation": "수업처럼 C를 떨어뜨리고, 이 여자들은 엉덩이를 흔들어 떨어뜨려"
    },
    {
      "startMs": 25930,
      "endMs": 29070,
      "translation": "걔 팬티에 씨를 떨어뜨리는데, 팬지 냄새가 나면 어쩔 건데"
    },
    {
      "startMs": 29070,
      "endMs": 32170,
      "translation": "난 걔 팬티 안에서 밴시야, 야, 네 엄마한테 물어봐"
    },
    {
      "startMs": 32170,
      "endMs": 35150,
      "translation": "골프는 안 쳐 봤어도 드라이버랑 캐디는 있지"
    },
    {
      "startMs": 35150,
      "endMs": 38770,
      "translation": "온 팀이 오닉스처럼 들이받아, 스티키 핑거즈 알지"
    },
    {
      "startMs": 38770,
      "endMs": 41960,
      "translation": "누구는 과학을 떨어뜨렸다지만, 난 영어를 떨궈"
    },
    {
      "startMs": 41960,
      "endMs": 44750,
      "translation": "타일러가 노래 제목을 꽃이라고 지었어도"
    },
    {
      "startMs": 44750,
      "endMs": 47560,
      "translation": "꽃봉오리엔 씨가 없어, 그래도 벌레는 못 믿어"
    },
    {
      "startMs": 47560,
      "endMs": 48220,
      "translation": "난 좋아"
    },
    {
      "startMs": 48220,
      "endMs": 49390,
      "translation": "이 새끼들한테 씨를 뿌려"
    },
    {
      "startMs": 49390,
      "endMs": 50730,
      "translation": "걔들은 이 녀석을 못 건드려 (물라!)"
    },
    {
      "startMs": 50730,
      "endMs": 52250,
      "translation": "이 여자들한테 씨를 뿌려"
    },
    {
      "startMs": 52250,
      "endMs": 53540,
      "translation": "이 판을 향한 사랑으로"
    },
    {
      "startMs": 53540,
      "endMs": 55180,
      "translation": "씨를 뿌려, 나한텐 이 정원이 있으니까"
    },
    {
      "startMs": 55180,
      "endMs": 56630,
      "translation": "당연히 꽃들이 피어나"
    },
    {
      "startMs": 56630,
      "endMs": 58020,
      "translation": "씨를 뿌려, 이 개새끼야"
    },
    {
      "startMs": 58020,
      "endMs": 60000,
      "translation": "위지 베이비가 최고야! 으!"
    }
  ]
}
