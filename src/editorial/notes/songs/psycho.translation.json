  "segments": [
    {
      "startMs": 12400,
      "endMs": 16150,
      "translation": "젠장, 내 오데마 피게가 미쳐 날뛰어, 저 아가씨는 마이클 잭슨처럼 '배드'해"
    },
    {
      "startMs": 16150,
      "endMs": 19520,
      "translation": "이렇게 보석을 두르고 있으면 누구도 믿을 수 없어"
    },
    {
      "startMs": 19520,
      "endMs": 22870,
      "translation": "내 차 지붕은 결석한 것처럼 없고, 다이아몬드는 배로 실어 날라"
    },
    {
      "startMs": 22870,
      "endMs": 26410,
      "translation": "광대랑 얼간이들한텐 토니 로모처럼 나가지"
    },
    {
      "startMs": 26410,
      "endMs": 29760,
      "translation": "내 오데마 피게가 미쳐 날뛰어, 저 아가씨는 마이클 잭슨처럼 '배드'해"
    },
    {
      "startMs": 29760,
      "endMs": 33180,
      "translation": "이렇게 보석을 두르고 있으면 누구도 믿을 수 없어"
    },
    {
      "startMs": 33180,
      "endMs": 36700,
      "translation": "내 차 지붕은 결석한 것처럼 없고, 다이아몬드는 배로 실어 날라"
    },
    {
      "startMs": 36700,
      "endMs": 40370,
      "translation": "내가 우리 동네를 지날 때 친구인 척하지는 마"
    },
    {
      "startMs": 40370,
      "endMs": 44400,
      "translation": "넌 친구 자리에 갇혀 있어, 내 45구경한텐 입 다물라고 해, 에이"
    },
    {
      "startMs": 44400,
      "endMs": 47730,
      "translation": "반바지 안에 돈뭉치 백 개, 디치노가 최고야, 에이"
    },
    {
      "startMs": 47730,
      "endMs": 51210,
      "translation": "다 쑤셔 넣으려 해도 들어가지도 않아, 에이"
    },
    {
      "startMs": 51210,
      "endMs": 54610,
      "translation": "꼬맹이 때부터 난 이런 거랑 함께였어, 에이"
    },
    {
      "startMs": 54610,
      "endMs": 58180,
      "translation": "처음 백만 달러를 벌었을 때 '젠장, 이거다' 싶었지, 에이"
    },
    {
      "startMs": 58180,
      "endMs": 61600,
      "translation": "잠깐 얼굴 비추는 데 3만 달러, 이봐, 우린 거길 불태웠어, 에이"
    },
    {
      "startMs": 61600,
      "endMs": 64750,
      "translation": "병이 너무 많아서 못생긴 여자한테도 한 모금 줬어"
    },
    {
      "startMs": 64750,
      "endMs": 68050,
      "translation": "벤츠 창밖으로, 사람들은 렌터카에 탄 우릴 봐"
    },
    {
      "startMs": 68050,
      "endMs": 70450,
      "translation": "그리고 난 이래, 워"
    },
    {
      "startMs": 70450,
      "endMs": 73850,
      "translation": "이봐, 내 목걸이는 빌어먹게 차가워"
    },
    {
      "startMs": 73850,
      "endMs": 77580,
      "translation": "다이아몬드는 젖어 있고, 내 티셔츠는 흠뻑 젖었어"
    },
    {
      "startMs": 77580,
      "endMs": 84120,
      "translation": "내겐 친구들이 있어, 그냥 흘려보내, 오"
    },
    {
      "startMs": 84120,
      "endMs": 87620,
      "translation": "내 돈은 두툼해, 절대 접히지 않아"
    },
    {
      "startMs": 87620,
      "endMs": 91130,
      "translation": "그 여자가 '나도 좀 쥐어 봐도 돼?' 하고 물어"
    },
    {
      "startMs": 91130,
      "endMs": 94780,
      "translation": "그리고 난 절대 너한테 안 된다고 못 해"
    },
    {
      "startMs": 94780,
      "endMs": 98330,
      "translation": "젠장, 내 오데마 피게가 미쳐 날뛰어, 저 아가씨는 마이클 잭슨처럼 '배드'해"
    },
    {
      "startMs": 98330,
      "endMs": 101700,
      "translation": "이렇게 보석을 두르고 있으면 누구도 믿을 수 없어"
    },
    {
      "startMs": 101700,
      "endMs": 105320,
      "translation": "내 차 지붕은 결석한 것처럼 없고, 다이아몬드는 배로 실어 날라"
    },
    {
