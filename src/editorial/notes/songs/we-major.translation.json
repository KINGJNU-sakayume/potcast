    },
    {
      "startMs": 217330,
      "endMs": 222920,
      "translation": "오늘은 그 어느 때보다 기분이 좋아"
    },
    {
      "startMs": 222920,
      "endMs": 227950,
      "translation": "늦더라도 안 하는 것보다 낫지, 이건 오리엔테이션이야"
