    {
      "startMs": 21460,
      "endMs": 23700,
      "translation": "너희들 할 일 제대로 하고 하나 말아"
    },
    {
      "startMs": 23700,
      "endMs": 25400,
      "translation": "우리가 어떻게 노는지 봐, 그리고"
    },
    {
      "startMs": 25400,
      "endMs": 28060,
      "translation": "감당이 안 돼, 주체를 못 하겠어, 완전 미쳤어"
    },
    {
      "startMs": 28060,
      "endMs": 30980,
      "translation": "코냑 한 모금 마시면 하고 싶어져"
    },
    {
      "startMs": 30980,
      "endMs": 33480,
      "translation": "그거 한 모금 빨면 그대로 굳어 버려"
    },
    {
      "startMs": 33480,
      "endMs": 36330,
      "translation": "그래도 진짜 놀라운 건 내가 계속 피운다는 거야"
    },
    {
      "startMs": 36330,
      "endMs": 39220,
      "translation": "문 밑에 수건 깔고 해 질 때까지 피워"
    },
    {
