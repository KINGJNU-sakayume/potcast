{
  "schemaVersion": 2,
  "timing": {
    "lrclibId": 485047,
    "durationMs": 234000
  },
  "segments": [
    {
      "startMs": 22380,
      "endMs": 31450,
      "translation": "깨진 위스키 잔으로 코데인을 마셨지"
    },
    {
      "startMs": 31450,
      "endMs": 40820,
      "translation": "알약도 털어 넣고 대마도 실컷 피웠어"
    },
    {
      "startMs": 40820,
      "endMs": 50210,
      "translation": "윗사람 밑에서 노예처럼 일하다 허리가 빌어먹게 부러졌지"
    },
    {
      "startMs": 50210,
      "endMs": 60120,
      "translation": "그러니 네 9시 출근 6시 퇴근 같은 건 처박아 둬"
    },
    {
      "startMs": 60120,
      "endMs": 69690,
      "translation": "그리고 난 지옥으로 가는 고속도로처럼 계속 달리진 않을 거야"
    },
    {
      "startMs": 69690,
      "endMs": 79270,
      "translation": "너무 빨리 달리다 내 샤넬에 술을 쏟았어"
    },
    {
      "startMs": 79270,
      "endMs": 88850,
      "translation": "일어나 보니 내 방은 호텔처럼 빌어먹게 엉망이었지"
    },
    {
      "startMs": 88850,
      "endMs": 98140,
      "translation": "이제 어디로 갈지는 시간만이 알겠지"
    },
    {
      "startMs": 98140,
      "endMs": 118010,
      "translation": "(워-오, 워-오)"
    },
    {
      "startMs": 118010,
      "endMs": 127250,
      "translation": "날 신경도 안 쓰는 여자들을 쫓느라 시간을 좀 썼지"
    },
    {
      "startMs": 127250,
      "endMs": 136800,
      "translation": "교훈을 얻었고 절대 잊지 않을 거야"
    },
    {
      "startMs": 136800,
      "endMs": 142380,
      "translation": "이 판을 부르기 시작했고, 잘나가기 시작했고, 손목을 털기 시작했어"
    },
    {
      "startMs": 142380,
      "endMs": 146960,
      "translation": "그들은 절대 안 들었지, 이제 내가 히트곡을 만드니 네 여자도 내 차지야"
    },
    {
      "startMs": 146960,
      "endMs": 151580,
      "translation": "네가 있었다는 걸 잊는 건 내겐 아무 일도 아니야"
    },
    {
      "startMs": 151580,
      "endMs": 156450,
      "translation": "세상에 없는 차를 끌고 나타나면 내 이름 기억하겠지"
    },
    {
      "startMs": 156450,
      "endMs": 158780,
      "translation": "지난 토요일 슈프림 옷에 린을 쏟았어"
    },
    {
      "startMs": 158780,
      "endMs": 160930,
      "translation": "튀게 놔둬, 녀석들은 떠들어 대지"
    },
    {
      "startMs": 160930,
      "endMs": 163450,
      "translation": "약 좀 건네줘, 나도 좀 빛나 보자"
    },
    {
      "startMs": 163450,
      "endMs": 167260,
      "translation": "백악관에서 내 친구 조 바이든에게 전화하면 대마를 날라 주지"
    },
    {
      "startMs": 167260,
      "endMs": 170710,
      "translation": "내 약을 피우면서 그게 암호이길 빌어"
    },
    {
      "startMs": 170710,
      "endMs": 173450,
      "translation": "이봐, 바보같이 굴지 마, 네가 걸친 건 한물갔어"
    },
    {
      "startMs": 173450,
      "endMs": 175650,
      "translation": "가게에 가 본 지 몇 년은 된 것처럼"
    },
    {
      "startMs": 175650,
      "endMs": 177730,
      "translation": "믹 밀 같은 기분이지만 난 필라델피아 출신이 아니야"
    },
    {
      "startMs": 177730,
      "endMs": 180180,
      "translation": "앞바퀴 들고 달리고, 금니를 자랑해"
    },
    {
      "startMs": 180180,
      "endMs": 182540,
      "translation": "이건 진짜로, 우리 가족을 위해 하는 거야"
    },
    {
      "startMs": 182540,
      "endMs": 185190,
      "translation": "밤마다 그늘 속에서, 이봐, 다 가족 같은 거야"
    },
    {
      "startMs": 185190,
      "endMs": 186820,
      "translation": "여자들은 날 미치게 해"
    },
    {
      "startMs": 186820,
      "endMs": 188140,
      "translation": "너 장난하는 거지?"
    },
    {
      "startMs": 188140,
      "endMs": 189980,
      "translation": "잘나가는 건 제이슨 키드처럼, 농담이지"
    },
    {
      "startMs": 189980,
      "endMs": 191650,
      "translation": "넌 날 떨쳐 낼 수 없어"
    },
    {
      "startMs": 191650,
      "endMs": 194930,
      "translation": "이제 내 목걸이랑 청바지를 원하지만, 넌 우리 사이의 화학엔 젬병이야"
    },
    {
      "startMs": 194930,
      "endMs": 234000,
      "translation": "(워-오, 워-오)"
    }
  ]
}
