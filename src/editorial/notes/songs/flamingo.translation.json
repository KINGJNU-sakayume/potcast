  "segments": [
    {
      "startMs": 8500,
      "endMs": 12830,
      "translation": "땅거미 속에 손끝으로 퉁기는 현"
    },
    {
      "startMs": 12830,
      "endMs": 17350,
      "translation": "슬픔 속에 비를 맞고, 꽃 필 무렵 흐린 하늘"
    },
    {
      "startMs": 17350,
      "endMs": 21300,
      "translation": "메마른 거리, 쌀쌀맞기만 해"
    },
    {
      "startMs": 21300,
      "endMs": 26020,
      "translation": "처량하게 콧물 흘리며 헤실헤실"
    },
    {
      "startMs": 26020,
      "endMs": 29420,
      "translation": "웃기지도 않는 이 시시한 진흙탕 싸움"
    },
    {
      "startMs": 29420,
      "endMs": 34550,
      "translation": "짙붉은 머리 장식, 사나운 연적"
    },
    {
      "startMs": 34550,
      "endMs": 37920,
      "translation": "만지고 싶은 벨벳 같은 눈꼬리에"
    },
    {
      "startMs": 37920,
      "endMs": 41760,
      "translation": "으스스한 미소에"
    },
    {
      "startMs": 41760,
      "endMs": 45300,
      "translation": "너는 (비틀비틀) 플라밍고"
    },
    {
      "startMs": 45300,
      "endMs": 49890,
      "translation": "선명한 (비틀비틀) 플라밍고"
    },
    {
      "startMs": 49890,
      "endMs": 50750,
      "translation": "춤추는 채로"
    },
    {
      "startMs": 50750,
      "endMs": 54580,
      "translation": "비틀비틀 웃으며 이제 돌아오지 않아"
    },
    {
      "startMs": 54580,
      "endMs": 58890,
      "translation": "쓸쓸함과 질투만 잔뜩 남기고"
    },
    {
      "startMs": 58890,
      "endMs": 71850,
      "translation": "늘 고마워, 다음엔 좀 더 소중히 대해 줘"
    },
    {
      "startMs": 71850,
      "endMs": 75840,
      "translation": "뵙게 해 주시니 황송하옵니다"
    },
    {
      "startMs": 75840,
      "endMs": 80240,
      "translation": "무작정 들떠 날아올라 겉돌기만 해"
    },
    {
      "startMs": 80240,
      "endMs": 84240,
      "translation": "허세를 부리며 흥얼흥얼"
    },
    {
      "startMs": 84240,
      "endMs": 89140,
      "translation": "허둥지둥 경솔하게 바보짓만 드러내"
    },
    {
      "startMs": 89140,
      "endMs": 92680,
      "translation": "사랑스러운 그 목소리만 듣고 싶어"
    },
    {
      "startMs": 92680,
      "endMs": 97440,
      "translation": "어설프게 번 공돈에 들러붙는 대낮의 좀도둑"
    },
    {
      "startMs": 97440,
      "endMs": 101110,
      "translation": "시시한 이 무대에서 빛나는 건"
    },
    {
      "startMs": 101110,
      "endMs": 104770,
      "translation": "너 하나뿐이어도 좋아"
    },
    {
      "startMs": 104770,
      "endMs": 108420,
      "translation": "그건 (비틀비틀) 플라밍고"
    },
    {
      "startMs": 108420,
      "endMs": 112520,
      "translation": "무섭기도 하지 (비틀비틀) 플라밍고"
    },
    {
      "startMs": 112520,
      "endMs": 113840,
      "translation": "수줍게 웃었어"
    },
    {
      "startMs": 113840,
      "endMs": 117660,
      "translation": "둥실둥실 떠올라 이젠 안녕"
    },
    {
      "startMs": 117660,
      "endMs": 119570,
      "translation": "그건 아니지"
    },
    {
      "startMs": 119570,
      "endMs": 121890,
      "translation": "좀 더 제대로 얘기하자고"
    },
    {
      "startMs": 121890,
      "endMs": 127080,
      "translation": "젠장, 뱉은 말은 거둬들이지도 않고"
    },
    {
      "startMs": 127080,
      "endMs": 130930,
      "translation": "차가운 비를 맞으며 콧물 흘리고"
    },
    {
      "startMs": 130930,
      "endMs": 135420,
      "translation": "나는 오른손에 강아지풀"
    },
    {
      "startMs": 135420,
      "endMs": 139380,
      "translation": "요즘 세상에 이 정도론 못 속여"
    },
    {
      "startMs": 139380,
      "endMs": 143580,
      "translation": "그 틈새를 영원히 헤매며"
    },
    {
      "startMs": 143580,
      "endMs": 147700,
      "translation": "지옥의 염라대왕께 청을 넣어"
    },
    {
      "startMs": 147700,
      "endMs": 152110,
      "translation": "그 아이를 몸값 치러 빼내 주시와요"
    },
    {
      "startMs": 152110,
      "endMs": 156260,
      "translation": "술에 취한 종이 인형의 이야기"
    },
    {
      "startMs": 156260,
      "endMs": 164030,
      "translation": "해 보자고, 죽을 때까지 어설픈 연극"
    },
    {
      "startMs": 164030,
      "endMs": 167560,
      "translation": "너는 (비틀비틀) 플라밍고"
    },
    {
      "startMs": 167560,
      "endMs": 171720,
      "translation": "선명한 (비틀비틀) 플라밍고"
    },
