  "segments": [
    {
      "startMs": 3880,
      "endMs": 17110,
      "translation": "우-우-우-우"
    },
    {
      "startMs": 17110,
      "endMs": 19760,
      "translation": "한밤중에 차를 몰고 나섰을 때"
    },
    {
      "startMs": 19760,
      "endMs": 23650,
      "translation": "다 괜찮다고 나 자신에게 말했어"
    },
    {
      "startMs": 23650,
      "endMs": 26560,
      "translation": "네가 어떻게 날 내려다보고 서 있는지 이해해 보려 해"
    },
    {
      "startMs": 26560,
      "endMs": 29220,
      "translation": "그게 날 미치게 해"
    },
    {
      "startMs": 29220,
      "endMs": 32550,
      "translation": "그래, 한밤중은 지독하게 얼어붙을 듯 추워"
    },
    {
      "startMs": 32550,
      "endMs": 36530,
      "translation": "온기라곤 재떨이에서 나오는 것뿐"
    },
    {
      "startMs": 36530,
      "endMs": 39720,
      "translation": "차라리 잔뜩 취해서 계속 그런 척할래"
    },
    {
      "startMs": 39720,
      "endMs": 42240,
      "translation": "아무것도 날 흔들지 못하는 척"
    },
    {
      "startMs": 42240,
      "endMs": 46300,
      "translation": "그래, 날 꼭대기까지 데려가 줘, 자기야"
    },
    {
      "startMs": 46300,
      "endMs": 49700,
      "translation": "내가 멈추라고 해도 멈추지 마, 자기야"
    },
    {
      "startMs": 49700,
      "endMs": 54510,
      "translation": "날 하늘 끝까지 데려가 줘, 자기야, 자기야"
    },
    {
      "startMs": 54510,
      "endMs": 57720,
      "translation": "난 저 위로 가고 싶어"
    },
    {
      "startMs": 57720,
      "endMs": 61330,
      "translation": "그리고 절대 내려오고 싶지 않아"
    },
    {
      "startMs": 61330,
      "endMs": 64290,
      "translation": "저 위에 뭐가 있는지 보고 싶어"
    },
    {
      "startMs": 64290,
      "endMs": 67880,
      "translation": "다 알아낸 척하면서"
    },
    {
      "startMs": 67880,
      "endMs": 71170,
      "translation": "난 저 위로 가고 싶어"
    },
    {
      "startMs": 71170,
      "endMs": 74550,
      "translation": "그리고 절대 내려오고 싶지 않아"
    },
    {
      "startMs": 74550,
      "endMs": 77500,
      "translation": "저 위에 뭐가 있는지 보고 싶어"
    },
    {
      "startMs": 77500,
      "endMs": 82230,
      "translation": "땅 위의 이 지옥보다는 나을 거야"
    },
    {
      "startMs": 82230,
      "endMs": 95500,
      "translation": "우-우-우-우"
