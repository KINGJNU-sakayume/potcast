    },
    {
      "startMs": 98490,
      "endMs": 102260,
      "translation": "탈모약도 없이 지붕을 열어젖힐 거야 (부릉, 부릉, 부릉)"
    },
    {
      "startMs": 102260,
      "endMs": 105840,
      "translation": "지금 상관없는 소리 같겠지만, 난 돈을 쌓아 두는 게 좋아"
    },
    {
      "startMs": 105840,
      "endMs": 109390,
      "translation": "모든 게 무너질 때는 (시가 말아)"
    },
    {
      "startMs": 109390,
      "endMs": 112190,
      "translation": "난 신앙 같은 건 없지만 하늘을 올려다보며"
    },
    {
      "startMs": 112190,
      "endMs": 116130,
      "translation": "거룩한 누구에게든 기도해"
    },
