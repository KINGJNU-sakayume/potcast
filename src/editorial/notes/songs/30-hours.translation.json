{
  "schemaVersion": 2,
  "timing": {
    "lrclibId": 563482,
    "durationMs": 323000
  },
  "segments": [
    {
      "startMs": 0,
      "endMs": 4400,
      "translation": "어린 사자가 간다"
    },
    {
      "startMs": 4400,
      "endMs": 10260,
      "translation": "섬들이 가는 곳으로"
    },
    {
      "startMs": 10260,
      "endMs": 12890,
      "translation": "넌 이런 일이 올 줄 몰랐다고 해, 너만 그런 게 아니야"
    },
    {
      "startMs": 12890,
      "endMs": 15320,
      "translation": "행복한 집에 백만 달러짜리 수리를 해"
    },
    {
      "startMs": 15320,
      "endMs": 17900,
      "translation": "전 여자친구는 인생에서 가장 좋았던 시절을 내게 줬대"
    },
    {
      "startMs": 17900,
      "endMs": 20430,
      "translation": "최근 사진을 보니 그 말이 맞는 것 같아"
    },
    {
      "startMs": 20430,
      "endMs": 23820,
      "translation": "눈뜨면 피해부터 살펴봐"
    },
    {
      "startMs": 23820,
      "endMs": 25870,
      "translation": "미디어테이크아웃을 확인해"
    },
    {
      "startMs": 25870,
      "endMs": 28140,
      "translation": "술 취해서 여자랑 걸어 나오는 내 사진"
    },
    {
      "startMs": 28140,
      "endMs": 30480,
      "translation": "하지만 모른 척 빠져나갈 만큼은 흐릿해"
    },
    {
      "startMs": 30480,
      "endMs": 33000,
      "translation": "눈뜨면 채소만, 달걀은 없어"
    },
    {
      "startMs": 33000,
      "endMs": 35700,
      "translation": "헬스장에 가면 가슴만, 다리는 안 해"
    },
    {
      "startMs": 35700,
      "endMs": 38200,
      "translation": "그래, 그다음엔 스무디를 만들었어"
    },
    {
      "startMs": 38200,
      "endMs": 40470,
      "translation": "그래, 그다음엔 아내랑 영상을 찍어"
    },
    {
      "startMs": 40470,
      "endMs": 43270,
      "translation": "시카고, 세인트루이스, 세인트루이스에서 시카고"
    },
    {
      "startMs": 43270,
      "endMs": 45590,
      "translation": "어서, 어서, E.I., E.I., 어, 오"
    },
    {
      "startMs": 45590,
      "endMs": 48170,
      "translation": "너 때문에 시간대가 바뀔 만큼 멀리 운전했어"
    },
    {
      "startMs": 48170,
      "endMs": 50800,
      "translation": "그래도 그때만큼은 네가 누구보다 최고였어"
    },
    {
      "startMs": 50800,
      "endMs": 54010,
      "translation": "그래, 내 여자는 아니었지만"
    },
    {
      "startMs": 54010,
      "endMs": 60620,
      "translation": "그래도 서른 시간을 운전했어"
    },
    {
      "startMs": 60620,
      "endMs": 64170,
      "translation": "에에허, 어"
    },
    {
      "startMs": 64170,
      "endMs": 71230,
      "translation": "그래도 네게 가려고 서른 시간을 운전했어, 그래"
    },
    {
      "startMs": 71230,
      "endMs": 73670,
      "translation": "제이랑 캠 앞에서 랩하던 게 기억나"
    },
    {
      "startMs": 73670,
      "endMs": 76120,
      "translation": "그냥 자기 플로를 들려주려던 어린 프로듀서"
    },
    {
      "startMs": 76120,
      "endMs": 78610,
      "translation": "빅토리아 시크릿 무대 때문에 긴장했던 게 기억나"
    },
    {
      "startMs": 78610,
      "endMs": 81180,
      "translation": "모두 옷을 벗고 있다고 상상하기 전까진"
    },
    {
      "startMs": 81180,
      "endMs": 83550,
      "translation": "익스페디션은 에디 바우어 에디션이었어"
    },
    {
      "startMs": 83550,
      "endMs": 85800,
      "translation": "십이월에 겨울용 타이어도 없이 운전해"
    },
    {
      "startMs": 85800,
      "endMs": 88760,
      "translation": "스커트, 스커트, 스커트, 여자 사립학교처럼"
    },
    {
      "startMs": 88760,
      "endMs": 91720,
      "translation": "그런데 도착하니 파파이스는 전부 먹고 없네, 너"
    },
    {
      "startMs": 91720,
      "endMs": 93680,
      "translation": "넌 날 사랑하지 않아, 그냥 척하는 거야"
    },
    {
      "startMs": 93680,
      "endMs": 96070,
      "translation": "행복한 시작과 중간과 끝이 필요해"
    },
    {
      "startMs": 96070,
      "endMs": 99030,
      "translation": "시카고, 세인트루이스, 세인트루이스에서 시카고"
    },
    {
      "startMs": 99030,
      "endMs": 101380,
      "translation": "여긴 뜨거워지고 있어, 내가 아는 건 그뿐이야"
    },
    {
      "startMs": 101380,
      "endMs": 103780,
      "translation": "네게 별 세 개짜리 호텔 방을 잡았어"
    },
    {
      "startMs": 103780,
      "endMs": 106190,
      "translation": "넌 아래로 전화해 오믈렛을 시켜, 너, 새벽 다섯 시야"
    },
    {
      "startMs": 106190,
      "endMs": 108680,
      "translation": "여긴 아리아가 아니라 더블트리인 걸 알잖아"
    },
    {
      "startMs": 108680,
      "endMs": 111350,
      "translation": "문 연 건 와플하우스뿐이야, 너, 나랑 시비 걸지 마"
    },
    {
      "startMs": 111350,
      "endMs": 113910,
      "translation": "네게 웨스턴유니언으로 송금했어, 아무 문제도 없다는 듯"
    },
    {
      "startMs": 113910,
      "endMs": 116410,
      "translation": "넌 대학에 다니며 일자리가 없다고 투덜댔으니까"
    },
    {
      "startMs": 116410,
      "endMs": 119060,
      "translation": "하지만 내내 다른 놈의 좆을 빨고 있었네"
    },
    {
      "startMs": 119060,
      "endMs": 124730,
      "translation": "그래, 일이 없는 것보단 입으로 하는 일이 낫겠지, 어"
    },
    {
      "startMs": 124730,
      "endMs": 131360,
      "translation": "그러곤 다시 서른 시간을 운전해 돌아왔어, 어"
    },
    {
      "startMs": 131360,
      "endMs": 134610,
      "translation": "주줄이 돛에 연결되는 곳"
    },
    {
      "startMs": 134610,
      "endMs": 136490,
      "translation": "눈에 들어올 때 더 나아"
    },
    {
      "startMs": 136490,
      "endMs": 143600,
      "translation": "선미를 향해, 오"
    },
    {
      "startMs": 143600,
      "endMs": 145820,
      "translation": "쓰리 스택스, 좀 도와줄래?"
    },
    {
      "startMs": 145820,
      "endMs": 147500,
      "translation": "서른 시간"
    }
  ]
}
