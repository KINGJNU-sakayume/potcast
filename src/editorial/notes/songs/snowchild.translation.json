  "segments": [
    {
      "startMs": 20300,
      "endMs": 22650,
      "translation": "열여섯 살 땐 기도했다"
    },
    {
      "startMs": 22650,
      "endMs": 26050,
      "translation": "성공하지 못하면 아마 손목을 그어 피를 냈을 거라고"
    },
    {
      "startMs": 26050,
      "endMs": 29250,
      "translation": "오해는 말길, 난 악몽을 큰 꿈으로 바꿨다"
    },
    {
      "startMs": 29250,
      "endMs": 32450,
      "translation": "고작 여섯 명이어도 패거리 전부가 몰려다녔다"
    },
    {
      "startMs": 32450,
      "endMs": 35790,
      "translation": "친구들이 6킬로를 굴릴 때 난 음표를 불렀다"
    },
    {
      "startMs": 35790,
      "endMs": 38920,
      "translation": "손목에 얼음을 두르기 전부터 눈 속을 걸었다"
    },
    {
      "startMs": 38920,
      "endMs": 42020,
      "translation": "연기를 내뿜다 길레스피처럼 어지러웠다"
    },
    {
      "startMs": 42020,
      "endMs": 46430,
      "translation": "친구들은 집이 없었다, 우린 죽은 거리에서 살았다"
    },
    {
      "startMs": 46430,
      "endMs": 48580,
      "translation": "호파처럼 날 찾을 수 없었다"
    },
    {
      "startMs": 48580,
      "endMs": 51830,
      "translation": "표지 모델들이 팝업북처럼 페이지에서 튀어나온다"
    },
    {
      "startMs": 51830,
      "endMs": 55100,
      "translation": "내가 키운 녀석들에게 돈을 다 쓴다"
    },
    {
      "startMs": 55100,
      "endMs": 59220,
      "translation": "형제들이 갇혀 있을 때 그 가족들을 돌본다"
    },
    {
      "startMs": 59220,
      "endMs": 61530,
      "translation": "그리고 난 믿을 게 아무것도 없었다"
    },
    {
      "startMs": 61530,
      "endMs": 63080,
      "translation": "더블 컵을 기울이며"
    },
    {
      "startMs": 63080,
      "endMs": 65970,
      "translation": "숨조차 쉴 수 없었다, 그리고"
    },
    {
      "startMs": 65970,
      "endMs": 68050,
      "translation": "그 돈에 난 굶주려 있었다"
    },
    {
      "startMs": 68050,
      "endMs": 74190,
      "translation": "캘리포니아가 목표였지만 이제 나는 떠난다"
    },
    {
      "startMs": 74190,
      "endMs": 83330,
      "translation": "떠난다, 밤 속으로 떠난다"
    },
    {
      "startMs": 83330,
      "endMs": 86870,
      "translation": "이제 나는 떠난다"
    },
    {
      "startMs": 86870,
      "endMs": 96660,
      "translation": "떠난다, 밤 속으로 떠난다"
    },
    {
      "startMs": 96660,
      "endMs": 100450,
      "translation": "그녀는 새 우주선에서 내 미래적인 소리를 좋아한다"
    },
    {
      "startMs": 100450,
      "endMs": 103430,
      "translation": "미래적인 섹스, 그녀에게 필립 K. 딕을 건넨다"
    },
    {
      "startMs": 103430,
      "endMs": 106750,
      "translation": "그녀는 남자가 필요 없다, 남자에게 필요한 게 그녀다"
    },
    {
      "startMs": 106750,
      "endMs": 112540,
      "translation": "그래서 난 매일 그녀에게 빠져든다"
    },
    {
      "startMs": 112540,
      "endMs": 115600,
      "translation": "코첼라에서 미친 듯이 놀았다"
    },
    {
      "startMs": 115600,
      "endMs": 119060,
      "translation": "셰이디처럼 몇백만 달러를 쌓았다"
    },
    {
      "startMs": 119060,
      "endMs": 122470,
      "translation": "이제 난 제이지처럼 트라이베카에 있다"
    },
    {
      "startMs": 122470,
      "endMs": 125510,
      "translation": "돈이라도 받은 듯 소라야마를 걸친다"
    },
    {
      "startMs": 125510,
      "endMs": 128680,
      "translation": "메르세데스와 새 계약을 막 맺었다"
    },
    {
      "startMs": 128680,
      "endMs": 132050,
      "translation": "스웨이지처럼 아찔하게 몸을 흔든다"
    },
    {
      "startMs": 132050,
      "endMs": 135210,
      "translation": "내 다이아몬드는 스웨이지처럼 춤춘다"
    },
    {
      "startMs": 135210,
      "endMs": 138640,
      "translation": "내 다이아몬드는 스웨 리처럼 꽂힌다"
    },
    {
      "startMs": 138640,
      "endMs": 141510,
      "translation": "전용기는 너무 커서 비즈니스석과 이코노미석이 따로 있다"
    },
    {
      "startMs": 141510,
      "endMs": 143070,
      "translation": "늘 길 위에서 산다"
    },
    {
      "startMs": 143070,
      "endMs": 146190,
      "translation": "루이 비통을 아 라 모드로 걸친다"
    },
    {
      "startMs": 146190,
