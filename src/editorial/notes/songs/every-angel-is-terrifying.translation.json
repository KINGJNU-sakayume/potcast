  "segments": [
    {
      "startMs": 43880,
      "endMs": 51150,
      "translation": "내가 소리쳐 부른들, 천사의 서열 가운데 누가 내 말을 들어 줄까?"
    },
    {
      "startMs": 51150,
      "endMs": 58510,
      "translation": "그들이 나를 가슴에 끌어안는다 해도, 나는 사라지고 말리라"
    },
    {
      "startMs": 58510,
      "endMs": 75040,
      "translation": "아름다움은 우리가 견디는 공포이니, 우리가 서서 경탄하는 사이 우리는 소멸한다"
    },
    {
      "startMs": 75040,
      "endMs": 87610,
      "translation": "모든 천사는 무섭다"
    },
    {
      "startMs": 87610,
      "endMs": 96870,
      "translation": "강렬하고, 노골적이고, 섹시하고, 황홀하고, 도발적이고, 아슬아슬하고, 생각할 거리를 주는"
    },
    {
      "startMs": 96870,
      "endMs": 99290,
      "translation": "기술적으로도 시각적으로도 압도적인"
    },
    {
      "startMs": 99290,
      "endMs": 102090,
      "translation": "설득력 있는 SF 작품"
    },
    {
      "startMs": 102090,
      "endMs": 105090,
      "translation": "긴장감 넘치는 폭로"
    },
    {
      "startMs": 105090,
      "endMs": 107620,
      "translation": "한 번도 본 적 없는 영화"
    },
    {
      "startMs": 107620,
      "endMs": 112530,
      "translation": "「애프터 라이프」의 이국적이고 기묘하고 아름다운 세계"
    },
    {
      "startMs": 112530,
      "endMs": 114980,
      "translation": "그리고 이건 여러분을 그 세계로 초대하는 초대장이에요"
    },
    {
      "startMs": 114980,
      "endMs": 119550,
      "translation": "평론가들은 「애프터 라이프」가 지금의 삶을 완전히 지루한 혼수상태처럼 보이게 만든다고 해요"
    },
    {
      "startMs": 119550,
      "endMs": 122440,
      "translation": "액션이 가득하고, 모두의 운명이 걸린 미래예요"
    },
    {
      "startMs": 122440,
      "endMs": 125200,
      "translation": "나이절과 프랭크는 이걸 끝내주는 고전이라고 불러요"
    },
    {
      "startMs": 125200,
      "endMs": 128190,
      "translation": "아서 플레밍어는 \"화면에서 눈을 뗄 수가 없다\"고 하죠"
    },
    {
      "startMs": 128190,
      "endMs": 130720,
      "translation": "구독하시면 「애프터 라이프」가 단돈 4.95달러예요"
    },
    {
      "startMs": 130720,
      "endMs": 133080,
      "translation": "「지금 삶의 베스트」 컬렉션 시리즈를 주문하실 때요"
    },
    {
      "startMs": 133080,
      "endMs": 136050,
      "translation": "상상 너머의 세계로 들어가실 거예요"
    },
    {
      "startMs": 136050,
      "endMs": 137820,
      "translation": "통제를 벗어난 미래로"
    },
    {
      "startMs": 137820,
      "endMs": 140120,
      "translation": "그리고 절대 잊지 못할 경험으로"
    },
    {
      "startMs": 140120,
      "endMs": 142020,
      "translation": "(경고하지 않았다고 하지 마세요)"
    },
    {
      "startMs": 142020,
      "endMs": 143790,
      "translation": "기다림은 끝났어요"
    },
    {
      "startMs": 143790,
      "endMs": 146980,
      "translation": "1-800-414-4444로 전화하세요"
    },
    {
      "startMs": 146980,
      "endMs": 151850,
      "translation": "1-800-444-4444, 지금 바로 「애프터 라이프」를 주문하세요"
    },
    {
      "startMs": 151850,
      "endMs": 154950,
      "translation": "4.95달러에 (지금)"
    },
    {
      "startMs": 154950,
      "endMs": 158610,
      "translation": "주문하세요 (「애프터 라이프」) 배송비 3.79달러 별도"
    },
    {
      "startMs": 158610,
      "endMs": 167000,
      "translation": "지금"
    }
  ]
}
