    },
    {
      "startMs": 50700,
      "endMs": 52340,
      "translation": "핸드백 하나에 5천 달러를 냈어"
    },
    {
      "startMs": 52340,
      "endMs": 54320,
      "translation": "그건 생로랑이야 (생로랑이야, 자기야)"
    },
    {
      "startMs": 54320,
      "endMs": 57080,
      "translation": "젠장, 넌 돈을 정말 좋아해, 자기야 (오 오 오)"
    },
    {
      "startMs": 57080,
      "endMs": 60270,
      "translation": "10만 달러 더하기 10만 달러, 내 차 (내 차, 내 차)"
    },
    {
      "startMs": 60270,
      "endMs": 63870,
      "translation": "3만 달러 더하기 3만 달러, 내 손목 (내 손목, 내 손목)"
    },
    {
      "startMs": 63870,
      "endMs": 67410,
      "translation": "술에 끝내주는 여자들까지, 불타오르지 (불타오르지, 불타오르지)"
    },
    {
      "startMs": 67410,
      "endMs": 70960,
      "translation": "맹세해, 자기야, 우린 키스만 했어, 그게 다야 (그게 다야, 그게 다야)"
    },
    {
      "startMs": 70960,
      "endMs": 75000,
      "translation": "네가 날 위해 해 준 걸 내가 어떻게 잊겠어? (날 위해)"
    },
    {
      "startMs": 75000,
      "endMs": 78470,
      "translation": "내 여자는 날 위해 죄를 뒤집어쓰고 대신 무너져 줄 거야 (날 위해)"
    },
    {
      "startMs": 78470,
      "endMs": 81860,
      "translation": "쇼핑 데려가고 싶지만, 자기야, 난 투어 중일 거야"
