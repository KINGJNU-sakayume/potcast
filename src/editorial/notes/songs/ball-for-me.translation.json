    },
    {
      "startMs": 28260,
      "endMs": 32280,
      "translation": "오 오 오 오 오 우, 날 위해 돈을 써 줘"
    },
    {
      "startMs": 32280,
      "endMs": 35530,
      "translation": "오 오 오 오 오 우, 날 위해 써 줘, 그래"
    },
    {
      "startMs": 35530,
