    },
    {
      "startMs": 78120,
      "endMs": 81530,
      "translation": "비틀거리며 복도를 걷다가 열린 문을 발견했어"
    },
    {
      "startMs": 81530,
      "endMs": 84730,
      "translation": "토하는 건 쉬워, 그런데 누가 코모도어스를 틀었지?"
    },
    {
      "startMs": 84730,
      "endMs": 87980,
      "translation": "타일 바닥이 멋지네, 너를 더 알았으면 좋았을 텐데"
    },
    {
      "startMs": 87980,
      "endMs": 91250,
      "translation": "나 누구랑 말하는 거지? 아무도 없어"
    },
    {
      "startMs": 91250,
      "endMs": 94090,
      "translation": "밖으로 데려가 줘, 좀 너무 취했어"
    },
    {
      "startMs": 94090,
      "endMs": 97340,
      "translation": "인생 최고의 시간에 돈을 좀 너무 많이 썼어"
    },
    {
      "startMs": 97340,
      "endMs": 100890,
      "translation": "돈이 문제가 아닐 때면 다들 슬쩍 다가와"
    },
    {
      "startMs": 100890,
      "endMs": 104170,
      "translation": "나 스스로에게 말할 때조차, 난"
