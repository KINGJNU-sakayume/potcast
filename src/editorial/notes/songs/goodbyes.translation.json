  "segments": [
    {
      "startMs": 15220,
      "endMs": 18330,
      "translation": "나랑 커트는 같은 기분이야, 쾌락이 너무 크면 고통이 돼"
    },
    {
      "startMs": 18330,
      "endMs": 21760,
      "translation": "내 여자는 괜히 날 원망하고, 난 불평만 해"
    },
    {
      "startMs": 21760,
      "endMs": 26160,
      "translation": "그 여자는 뭔가 바뀌어야 해, 날 선 마음을 좀 누그러뜨려야 해"
    },
    {
      "startMs": 26160,
      "endMs": 28450,
      "translation": "그러니 오늘 밤은 다 집어치워"
    },
    {
      "startMs": 28450,
      "endMs": 32310,
      "translation": "닥치라고 하지 마"
    },
    {
      "startMs": 32310,
      "endMs": 35370,
      "translation": "너야말로 말이 너무 많은 거 알면서"
    },
    {
      "startMs": 35370,
      "endMs": 39010,
      "translation": "할 말은 하나도 없잖아 (말)"
    },
    {
      "startMs": 39010,
      "endMs": 41900,
      "translation": "너를 내 머릿속에서 지우고 싶어"
    },
    {
      "startMs": 41900,
      "endMs": 45760,
      "translation": "오늘 밤 너를 내 침실에서 내보내고 싶어 (침실)"
    },
    {
      "startMs": 45760,
      "endMs": 48580,
      "translation": "내가 널 구할 방법은 없어 (구할)"
    },
    {
      "startMs": 48580,
      "endMs": 51870,
      "translation": "나도 구원받아야 하니까"
    },
    {
      "startMs": 51870,
      "endMs": 53620,
      "translation": "난 작별 인사에 서툴러"
    },
    {
      "startMs": 53620,
      "endMs": 56620,
      "translation": "우린 둘 다 미친 듯이 굴지만 고집이 세서 변하지 않아"
    },
    {
      "startMs": 56620,
      "endMs": 60070,
      "translation": "이제 난 또 술을 마셔, 혈관엔 40도짜리 술"
    },
    {
      "startMs": 60070,
      "endMs": 64170,
      "translation": "손끝은 얼룩지고, 벼랑 끝을 내려다봐"
    },
    {
      "startMs": 64170,
      "endMs": 66240,
      "translation": "오늘 밤은 건드리지 마"
    },
    {
      "startMs": 66240,
      "endMs": 69770,
      "translation": "이 마음이 필요하다더니 넌 그걸 가졌지 (가졌지)"
    },
    {
      "startMs": 69770,
      "endMs": 73010,
      "translation": "알고 보니 네가 원하던 게 아니었어 (원하던)"
    },
    {
      "startMs": 73010,
      "endMs": 75770,
      "translation": "우린 놓지 않으려다 결국 잃어버렸어"
    },
    {
      "startMs": 75770,
      "endMs": 77580,
      "translation": "이제 난 끝장났어"
    },
    {
      "startMs": 77580,
      "endMs": 80760,
      "translation": "너를 내 머릿속에서 지우고 싶어"
    },
    {
      "startMs": 80760,
      "endMs": 83860,
      "translation": "오늘 밤 너를 내 침실에서 내보내고 싶어"
    },
    {
      "startMs": 83860,
      "endMs": 86730,
      "translation": "내가 널 구할 방법은 없어"
    },
    {
      "startMs": 86730,
