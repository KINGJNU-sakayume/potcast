    {
      "startMs": 26170,
      "endMs": 28110,
      "translation": "내 주제가를 위해 (블랙)"
    },
    {
      "startMs": 28110,
      "endMs": 29860,
      "translation": "검은 가죽 청바지를 입고 (블랙)"
    },
    {
      "startMs": 29860,
      "endMs": 31380,
      "translation": "'어떤 수단을 써서라도'를 걸치고"
    },
    {
      "startMs": 31380,
      "endMs": 33490,
      "translation": "실례, 이제 비명 좀 질러야겠어 (블랙)"
    },
    {
      "startMs": 33490,
      "endMs": 35470,
      "translation": "왕국으로 들어와 (블랙)"
    },
    {
      "startMs": 35470,
      "endMs": 36700,
      "translation": "하지만 누굴 집에 데려가는지 조심해"
    },
    {
      "startMs": 36700,
      "endMs": 38430,
      "translation": "백인 여자와 함께 있는 흑인 남자를 보면"
    },
    {
      "startMs": 38430,
      "endMs": 40510,
      "translation": "사람들은 꼭대기 층까지 킹콩을 죽이러 올 거야"
    },
    {
      "startMs": 40510,
      "endMs": 42310,
      "translation": "미국의 한복판이 빽빽이 들어찼어 (블랙)"
    },
    {
      "startMs": 42310,
      "endMs": 44380,
      "translation": "검은 피부의 날 보러 왔지 (블랙)"
    },
    {
      "startMs": 44380,
      "endMs": 46000,
      "translation": "그들이 제일 먼저 묻는 질문"
    },
    {
      "startMs": 46000,
      "endMs": 47950,
      "translation": "너희 질문 따윈 다 엿이나 먹어 (블랙)"
    },
    {
      "startMs": 47950,
      "endMs": 49650,
      "translation": "가톨릭 신자들에게 쫓겨나지 않으면 (블랙)"
    },
    {
      "startMs": 49650,
      "endMs": 51450,
      "translation": "이번엔 보수적인 침례교도들이 몰려와"
    },
    {
      "startMs": 51450,
      "endMs": 53250,
      "translation": "내가 과민 반응한다고 하지"
    },
    {
      "startMs": 53250,
      "endMs": 55380,
      "translation": "시카고 '시라크'의 흑인 아이들처럼 말이야"
    },
    {
      "startMs": 55380,
      "endMs": 57120,
      "translation": "새벽 네 시, 난 멍하니 빠져들어"
    },
    {
      "startMs": 57120,
      "endMs": 58920,
      "translation": "다들 내가 홀렸대, 불길한 징조래"
    },
    {
      "startMs": 58920,
      "endMs": 60830,
      "translation": "난 늘 300퍼센트 진짜야, 로마인들처럼"
    },
    {
      "startMs": 60830,
      "endMs": 62680,
      "translation": "여자는 삼백 명, 트로전은 어디 있지?"
    },
    {
      "startMs": 62680,
      "endMs": 64540,
      "translation": "자기, 우린 이 순간을 살고 있어"
    },
    {
      "startMs": 64540,
      "endMs": 66310,
      "translation": "난 아주 오랫동안 골칫거리였지"
    },
    {
      "startMs": 66310,
      "endMs": 68320,
      "translation": "하지만 아직 안 끝났어, 난 다 바쳤거든"
    },
    {
      "startMs": 68320,
      "endMs": 71630,
      "translation": "너도 알잖아, 너도 알잖아"
    },
    {
      "startMs": 71630,
      "endMs": 75080,
      "translation": "그러니 날 따라와, 이제 곧 일이 터질 거야"
    },
    {
      "startMs": 75080,
      "endMs": 78170,
      "translation": "시속 500으로 달려, 통제 불능이야 (이제)"
    },
    {
      "startMs": 78170,
      "endMs": 79750,
      "translation": "그런데 갈 곳이 없어 (이제)"
    },
    {
      "startMs": 79750,
      "endMs": 81490,
      "translation": "속도를 늦출 방법도 없어"
    },
    {
      "startMs": 81490,
      "endMs": 83130,
      "translation": "그때 알던 걸 진작 알았더라면"
    },
    {
      "startMs": 83130,
      "endMs": 92370,
      "translation": "넌 진작 이성을 잃은 나를 봤을 거야"
    },
    {
      "startMs": 92370,
      "endMs": 94060,
      "translation": "새벽 네 시, 난 멍하니 빠져들어"
