    },
    {
      "startMs": 20920,
      "endMs": 24470,
      "translation": "맹세하는데, 그녀는 남의 눈을 너무 의식해"
    },
    {
      "startMs": 24470,
      "endMs": 26810,
      "translation": "대학에서 뭘 하고 있는지도 몰라"
    },
    {
      "startMs": 26810,
      "endMs": 29230,
      "translation": "고른 전공은 돈도 안 되는데"
    },
    {
      "startMs": 29230,
      "endMs": 31820,
      "translation": "자퇴는 못 해, 부모님이 이상한 눈으로 볼 테니까"
    },
    {
      "startMs": 31820,
      "endMs": 34730,
      "translation": "자, 이게 불안한 게 아니라고 말해 봐"
    },
    {
      "startMs": 34730,
      "endMs": 37210,
      "translation": "학교라는 게 참 안전해 보이잖아"
    },
    {
      "startMs": 37210,
      "endMs": 39840,
      "translation": "3년째 2학년인데 아직 진로도 못 정했어"
    },
    {
      "startMs": 39840,
      "endMs": 42480,
      "translation": "그녀는 \"몰라, 그냥 여기서 머리나 하지 뭐\" 하지"
    },
    {
      "startMs": 42480,
      "endMs": 45400,
      "translation": "그 정도면 새 에어 조던 몇 켤레는 살 수 있으니까"
    },
    {
      "startMs": 45400,
      "endMs": 47780,
      "translation": "애 아빠는 별로 신경도 안 쓰니까"
    },
    {
      "startMs": 47780,
      "endMs": 50480,
      "translation": "또래들 눈치엔 그렇게 예민해"
    },
    {
      "startMs": 50480,
      "endMs": 52650,
      "translation": "차를 살 형편이 안 되니 딸 이름을 알렉서스라고 지었지"
    },
    {
      "startMs": 52650,
      "endMs": 55440,
      "translation": "머리가 얼마나 길었는지 붙임머리 같았는데"
    },
    {
      "startMs": 55440,
      "endMs": 58290,
      "translation": "다 잘라 버리고 나니 이브처럼 보여"
    },
    {
      "startMs": 58290,
      "endMs": 60840,
      "translation": "그녀가 안고 사는 문제들은 믿기도 힘들 거야"
    },
    {
      "startMs": 60840,
      "endMs": 63610,
      "translation": "쇼핑에 중독된 흑인 싱글 여성, 그리고"
    },
    {
      "startMs": 63610,
      "endMs": 65490,
      "translation": "오, 모든 게 (어)"
    },
    {
      "startMs": 65490,
      "endMs": 68560,
      "translation": "모든 게 무너질 때 (그리고 무너지면, 이제 누굴 부를 건데?)"
    },
    {
      "startMs": 68560,
      "endMs": 70920,
      "translation": "정말이야 (어서, 어서)"
    },
    {
      "startMs": 70920,
      "endMs": 73120,
      "translation": "모든 게 무너져 (그리고 모든 게 무너질 때)"
    },
    {
      "startMs": 73120,
      "endMs": 73950,
      "translation": "오, 모든 게"
    },
    {
      "startMs": 73950,
      "endMs": 77280,
      "translation": "맹세하는데, 나도 남의 눈을 너무 의식해"
    },
    {
      "startMs": 77280,
      "endMs": 79350,
      "translation": "그래서 내가 늘 시계를 적어도 하나는 차고 다니는 거야"
    },
    {
      "startMs": 79350,
      "endMs": 82180,
      "translation": "롤렉스랑 파샤가 날 미치게 했지"
    },
    {
      "startMs": 82180,
      "endMs": 85240,
      "translation": "이름도 제대로 못 읽어, 그 베르-세이-시 좀 건네 봐"
    },
    {
      "startMs": 85240,
      "endMs": 87040,
      "translation": "그러고는 이거 하나에 400달러를 썼어"
    },
    {
      "startMs": 87040,
      "endMs": 89690,
      "translation": "\"넌 이런 거 모르지\" 하고 말하려고"
    },
    {
      "startMs": 89690,
      "endMs": 92490,
      "translation": "마트 하나 가는 것도"
    },
    {
      "startMs": 92490,
      "endMs": 95350,
      "translation": "빳빳한 지폐랑 팀 로고 박힌 셔츠 없이는 못 가"
    },
    {
      "startMs": 95350,
      "endMs": 98040,
      "translation": "우린 아메리칸드림을 사는 것 같지만"
    },
    {
      "startMs": 98040,
      "endMs": 100410,
      "translation": "제일 높은 데 있는 사람들이 자존감은 제일 낮아"
    },
    {
      "startMs": 100410,
      "endMs": 103330,
      "translation": "제일 예쁜 사람들이 제일 추한 짓을 하지"
    },
    {
      "startMs": 103330,
      "endMs": 105960,
      "translation": "부자가 되는 길과 다이아몬드 반지를 위해서"
    },
    {
      "startMs": 105960,
      "endMs": 108550,
      "translation": "저들이 우릴 미워하니까 빛나고, 깎아내리니까 뽐내"
    },
    {
      "startMs": 108550,
      "endMs": 111050,
      "translation": "우린 우리의 40에이커를 되사려는 거야"
    },
    {
      "startMs": 111050,
      "endMs": 113600,
      "translation": "그 돈 때문에 우리가 얼마나 낮게 굽히는지 봐"
    },
    {
      "startMs": 113600,
      "endMs": 115960,
      "translation": "벤츠를 타도 쿠페 안의 흑인일 뿐이야"
    },
    {
      "startMs": 115960,
      "endMs": 118300,
      "translation": "오, 모든 게"
    },
    {
      "startMs": 118300,
      "endMs": 121590,
      "translation": "모든 게 무너질 때 (그리고 무너지면, 이제 누굴 부를 건데?)"
    },
    {
      "startMs": 121590,
      "endMs": 123360,
      "translation": "정말이야 (어서, 어서)"
    },
    {
      "startMs": 123360,
