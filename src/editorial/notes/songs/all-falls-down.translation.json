    },
    {
      "startMs": 126480,
      "endMs": 126970,
      "translation": "오, 모든 게"
    },
    {
      "startMs": 126970,
      "endMs": 129320,
      "translation": "경찰 따위 엿이나 먹으라지, 난 그렇게 대해"
    },
    {
      "startMs": 129320,
      "endMs": 132130,
      "translation": "돈으로 감옥에선 빠져나와도 자유는 못 사"
    },
    {
      "startMs": 132130,
      "endMs": 134770,
      "translation": "필요도 없는 옷을 잔뜩 사지"
    },
    {
      "startMs": 134770,
      "endMs": 137160,
      "translation": "속에 있는 걸 가리려고 사는 것들이야"
    },
    {
      "startMs": 137160,
      "endMs": 139840,
      "translation": "저들이 우리 자신은 미워하고 자기들 부는 사랑하게 만들었거든"
    },
    {
      "startMs": 139840,
      "endMs": 142660,
      "translation": "그래서 여자애들이 \"돈 많은 남자 어디 있어?\" 하고 외치는 거야"
    },
    {
      "startMs": 142660,
      "endMs": 145010,
      "translation": "마약상은 조던을 사고, 중독자는 크랙을 사"
    },
    {
      "startMs": 145010,
      "endMs": 147560,
      "translation": "그리고 그 모든 걸로 돈을 버는 건 백인이지"
    },
    {
      "startMs": 147560,
      "endMs": 150380,
      "translation": "그렇다고 나도 성자인 척하진 않을게"
    },
    {
      "startMs": 150380,
      "endMs": 153160,
      "translation": "젠장, 2만 5천 달러를 들고 제이콥에 갔으니까"
    },
    {
      "startMs": 153160,
      "endMs": 155450,
      "translation": "집도 사기 전이었는데, 그래도 또 그럴 거야"
    },
    {
      "startMs": 155450,
      "endMs": 158340,
      "translation": "'106 & Park'에 나가서 벤츠를 몰고 싶으니까"
    },
    {
      "startMs": 158340,
      "endMs": 160740,
      "translation": "모든 게 끝내주는 것처럼 부자 행세를 하고 싶어"
    },
    {
      "startMs": 160740,
      "endMs": 163500,
      "translation": "밀린 청구서가 몇 장 있는데, 자세히는 말 안 할게"
    },
    {
      "startMs": 163500,
      "endMs": 166180,
      "translation": "돈이 들어오기도 전에 써 버리는 게 문제야"
    },
    {
      "startMs": 166180,
      "endMs": 168840,
      "translation": "우린 다 남의 눈을 의식해, 난 그걸 처음 인정했을 뿐이야"
