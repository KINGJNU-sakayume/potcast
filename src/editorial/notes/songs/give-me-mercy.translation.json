    {
      "startMs": 28270,
      "endMs": 31330,
      "translation": "하늘과 나누는 대화"
    },
    {
      "startMs": 31330,
      "endMs": 37780,
      "translation": "내 영혼에 자비를, 진작 알았어야 했던 것들"
    },
    {
      "startMs": 37780,
      "endMs": 40910,
      "translation": "기만의 거짓말에 능한 자가"
    },
    {
      "startMs": 40910,
      "endMs": 45140,
      "translation": "날 연약하게 만들고, 혼자 남겨 두었죠"
    },
    {
      "startMs": 45140,
      "endMs": 49820,
      "translation": "길을 잃을 때마다 당신을 향한 믿음을 잃었어요"
    },
    {
      "startMs": 49820,
      "endMs": 54510,
      "translation": "유혹과 싸우느라 내 몸을 학대했어요"
    },
