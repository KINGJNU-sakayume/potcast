{
  "schemaVersion": 2,
  "timing": {
    "lrclibId": 582826,
    "durationMs": 213000
  },
  "segments": [
    {
      "startMs": 1510,
      "endMs": 6140,
      "translation": "(널 영광으로 데려가 줄게, 오, 난 전쟁을 배울 수 없어)"
    },
    {
      "startMs": 6140,
      "endMs": 21750,
      "translation": "사우스사이드는 어디 있어, 웨스트사이드는 어디 있어"
    },
    {
      "startMs": 21750,
      "endMs": 27060,
      "translation": "또 잘난 척 좀 해도 될까?"
    },
    {
      "startMs": 27060,
      "endMs": 29050,
      "translation": "다시는 히트를 못 친다 해도?"
    },
    {
      "startMs": 29050,
      "endMs": 31110,
      "translation": "친구, 지금 농담해?"
    },
    {
      "startMs": 31110,
      "endMs": 32820,
      "translation": "내 모자, 내 신발, 내 코트"
    },
    {
      "startMs": 32820,
      "endMs": 35100,
      "translation": "루이 비통 바느질, 도나텔라 베르사체까지"
    },
    {
      "startMs": 35100,
      "endMs": 36650,
      "translation": "난 루이 비통의 노예야"
    },
    {
      "startMs": 36650,
      "endMs": 39010,
      "translation": "헤네시를 생각하고, 마시고, 취했어"
    },
    {
      "startMs": 39010,
      "endMs": 41950,
      "translation": "바카디 리몬에 코로나까지, 정신이 없어"
    },
    {
      "startMs": 41950,
      "endMs": 44530,
      "translation": "다시 수업이 시작돼서 한 학년 올라갔지"
    },
    {
      "startMs": 44530,
      "endMs": 47610,
      "translation": "2년 만에 드웨인 웨인이 드웨인 웨이드가 됐어"
    },
    {
      "startMs": 47610,
      "endMs": 49580,
      "translation": "그리고, 제발 날 건드리지 마"
    },
    {
      "startMs": 49580,
      "endMs": 52250,
      "translation": "난 날스 바클리와 찰스 바클리의 만남이야"
    },
    {
      "startMs": 52250,
      "endMs": 54990,
      "translation": "바커스 가족처럼 팝이고, 파커스 가족처럼 동네 감성이야"
    },
    {
      "startMs": 54990,
      "endMs": 57740,
      "translation": "너희가 갈피를 못 잡는 동안 난 기준을 높였지"
    },
    {
      "startMs": 57740,
      "endMs": 59100,
      "translation": "모든 걸 건드렸어"
    },
    {
      "startMs": 59100,
      "endMs": 62230,
      "translation": "이 판과 결혼했어, 결혼반지 대신 로커펠라 체인을 끼고"
    },
    {
      "startMs": 62230,
      "endMs": 63920,
      "translation": "너희 들러리들은 가터나 받아"
    },
    {
      "startMs": 63920,
      "endMs": 65770,
      "translation": "예가 연애하는 밤이면"
    },
    {
      "startMs": 65770,
      "endMs": 67270,
      "translation": "카메라 플래시가 하도 터져서"
    },
    {
      "startMs": 67270,
      "endMs": 69230,
      "translation": "요요 댄스라도 춰야 해"
    },
    {
      "startMs": 69230,
      "endMs": 72090,
      "translation": "내 친구 커먼이랑 월드 투어 중이야"
    },
    {
      "startMs": 72090,
      "endMs": 75420,
      "translation": "공연이 끝날 때마다 밴에 여자들이 타, 쉽지"
    },
    {
      "startMs": 75420,
      "endMs": 78260,
      "translation": "동네는 지지랑 위지 노래를 좋아해"
    },
    {
      "startMs": 78260,
      "endMs": 79810,
      "translation": "그리고, 아 맞다, 이지도"
    },
    {
      "startMs": 79810,
      "endMs": 90030,
      "translation": "난 영광을 위해 해냈어"
    },
    {
      "startMs": 90030,
      "endMs": 100000,
      "translation": "사우스사이드는 어디 있어, 웨스트사이드는 어디 있어"
    },
    {
      "startMs": 100000,
      "endMs": 104190,
      "translation": "이제 난 뭘 해야 하지?"
    },
    {
      "startMs": 104190,
      "endMs": 105160,
      "translation": "이봐, 판이 완전히 엉망이야"
    },
    {
      "startMs": 105160,
      "endMs": 107600,
      "translation": "다들 차려입는데 내가 어떻게 튀어야 해?"
    },
    {
      "startMs": 107600,
      "endMs": 110400,
      "translation": "그래, 그래서 그래미에서 완전히 트래볼타처럼 입었지"
    },
    {
      "startMs": 110400,
      "endMs": 113250,
      "translation": "그래, 그 턱시도는 좀 촌스러웠을지도"
    },
    {
      "startMs": 113250,
      "endMs": 114710,
      "translation": "하지만 내 자존심이면"
    },
    {
      "startMs": 114710,
      "endMs": 116370,
      "translation": "수영복만 입고 서 있어도"
    },
    {
      "startMs": 116370,
      "endMs": 118610,
      "translation": "영웅처럼 보일 거야"
    },
    {
      "startMs": 118610,
      "endMs": 121910,
      "translation": "영광, 이야기, 체인, 폴로, 밤"
    },
    {
      "startMs": 121910,
      "endMs": 124190,
      "translation": "노력, 텅 빈 각성제 병들"
    },
    {
      "startMs": 124190,
      "endMs": 126870,
      "translation": "기름은 바닥인데 엄마의 볼보를 몰고"
    },
    {
      "startMs": 126870,
      "endMs": 129640,
      "translation": "그 기름값을 로고 박힌 옷에 써 버렸지"
    },
    {
      "startMs": 129640,
      "endMs": 132010,
      "translation": "모피는 에르메스, 너희는 못 뽐낼 물건"
    },
    {
      "startMs": 132010,
      "endMs": 134750,
      "translation": "고야드 가방은 너무 세서, 난 휴고 보스의 보스야"
    },
    {
      "startMs": 134750,
      "endMs": 137460,
      "translation": "그 투 도어 차가 얼마인지 왜 물어봐야 해"
    },
    {
      "startMs": 137460,
      "endMs": 138740,
      "translation": "언덕 위의 집"
    },
    {
      "startMs": 138740,
      "endMs": 140430,
      "translation": "트레이시 로스네 두 집 건너"
    },
    {
      "startMs": 140430,
      "endMs": 142090,
      "translation": "그리고 난 그녀의 친구들에 대해 물어"
    },
    {
      "startMs": 142090,
      "endMs": 143360,
      "translation": "그래, 피부 어둡고 마른 애들"
    },
    {
      "startMs": 143360,
      "endMs": 146410,
      "translation": "그녀는 스피드보트에 대해 묻지, 그래, 빌린 거라고 인정할게"
    },
    {
      "startMs": 146410,
      "endMs": 148590,
      "translation": "날 직접 만나면 어떤 기분이 들어?"
    },
    {
      "startMs": 148590,
      "endMs": 151610,
      "translation": "알아, 알아, 실물이 더 낫지"
    },
    {
      "startMs": 151610,
      "endMs": 153850,
      "translation": "사람들이 자기를 빅이랑 비교하는 걸 많이 들어"
    },
    {
      "startMs": 153850,
      "endMs": 156630,
      "translation": "비기와 투팍 말이야, 뜨겁게 달아오르려고"
    },
    {
      "startMs": 156630,
      "endMs": 159310,
      "translation": "난 죽은 뒤에 빅이랑 비교되고 싶어"
    },
    {
      "startMs": 159310,
      "endMs": 162450,
      "translation": "누구든, 빅 펀이든, 빅 엘이든, 노토리어스든"
    },
    {
      "startMs": 162450,
      "endMs": 165050,
      "translation": "돈 벌고, 뽐내고, 영광스럽게 살아"
    },
    {
      "startMs": 165050,
      "endMs": 169530,
      "translation": "그리고 후렴이 나오면 이 녀석들 죽이는 건 멈출게"
    },
    {
      "startMs": 169530,
      "endMs": 170730,
      "translation": "사우스사이드는 어디 있어, 웨스트사이드는 어디 있어"
    },
    {
      "startMs": 170730,
      "endMs": 173620,
      "translation": "그래, 후렴이 나오면 이 녀석들 죽이는 건 멈출게"
    },
    {
      "startMs": 173620,
      "endMs": 213000,
      "translation": "미워하는 놈들은 영광을 차지하려다 제풀에 죽어 나가지"
    }
  ]
}
