    {
      "startMs": 520,
      "endMs": 3370,
      "translation": "예전엔 친구가 있었는데 이젠 적이 생겼어 (우)"
    },
    {
      "startMs": 3370,
      "endMs": 6780,
      "translation": "예전엔 가까이 뒀는데 이젠 내겐 죽은 사람들이야 (젠장)"
    },
    {
      "startMs": 6780,
      "endMs": 9840,
      "translation": "예전엔 친구가 있었는데 이젠 적이 생겼어 (우)"
    },
    {
      "startMs": 9840,
      "endMs": 13030,
      "translation": "적들, 그래, 정말 슬픈 일이야"
    },
    {
      "startMs": 13030,
      "endMs": 16250,
      "translation": "내가 절대 여기까지 못 올 거라 했지, 아, 아"
    },
    {
      "startMs": 16250,
      "endMs": 19240,
      "translation": "우리가 네 정체를 모를 거라 생각해?"
    },
    {
      "startMs": 19240,
      "endMs": 22460,
      "translation": "하하하 웃으며 은행에 가"
    },
    {
      "startMs": 22460,
      "endMs": 25870,
      "translation": "내가 너무 떠드나 봐, 어쩌고저쩌고 (닥쳐)"
    },
    {
      "startMs": 25870,
      "endMs": 28150,
      "translation": "그래서, 너희 다 어디 갔었어?"
    },
    {
      "startMs": 28150,
      "endMs": 31300,
      "translation": "내가 쫄딱 망해서 담배 한 갑도 못 살 때"
    },
    {
      "startMs": 31300,
      "endMs": 34510,
      "translation": "이젠 너희 엄마가 내 경기장 공연 표를 구해 달래 (경기장 공연)"
    },
    {
      "startMs": 34510,
      "endMs": 38550,
      "translation": "라디오에서 내 노래가 나오면 엄청 좋아하신대, 오"
    },
    {
      "startMs": 38550,
      "endMs": 41310,
      "translation": "알아, 힘들겠지"
    },
    {
      "startMs": 41310,
      "endMs": 44530,
      "translation": "자존심을 굽히는 게"
    },
    {
      "startMs": 44530,
      "endMs": 47350,
      "translation": "날 못 잊어서 안됐다"
    },
    {
      "startMs": 47350,
      "endMs": 51620,
      "translation": "이제 네가 내 인생에서 사라져서 정말 후련해, 난"
    },
    {
      "startMs": 51620,
      "endMs": 54440,
      "translation": "예전엔 친구가 있었는데 이젠 적이 생겼어"
    },
    {
      "startMs": 54440,
      "endMs": 57610,
      "translation": "예전엔 가까이 뒀는데 이젠 내겐 죽은 사람들이야"
    },
    {
      "startMs": 57610,
      "endMs": 60870,
      "translation": "돈은 사람들의 본색을 다 드러내"
    },
    {
      "startMs": 60870,
      "endMs": 64070,
      "translation": "적들, 그래, 정말 슬픈 일이야"
    },
    {
      "startMs": 64070,
      "endMs": 66830,
      "translation": "가끔은, 매번, 그들은 날 실망시켜"
    },
    {
      "startMs": 66830,
      "endMs": 70080,
      "translation": "가끔은, 매번, 그들은 날 실망시켜"
    },
    {
      "startMs": 70080,
      "endMs": 73650,
      "translation": "예전엔 친구가 있었는데 이젠 적이 생겼어"
    },
    {
      "startMs": 73650,
      "endMs": 76600,
      "translation": "적들, 그래, 정말 슬픈 일이야"
    },
    {
      "startMs": 76600,
      "endMs": 78350,
      "translation": "내 적들 곁에 (가자)"
    },
    {
      "startMs": 78350,
      "endMs": 79300,
      "translation": "더 좋은 기운이 필요해 (응?)"
    },
    {
      "startMs": 79300,
      "endMs": 81420,
      "translation": "내가 꺼지라고 했을 때 장난인 줄 알았지? (그래, 그래)"
    },
    {
      "startMs": 81420,
      "endMs": 82370,
      "translation": "근데 난 진짜 말 그대로였어"
    },
    {
      "startMs": 82370,
      "endMs": 84190,
      "translation": "그 여자는 분위기 좀 타자고 했지만 난 됐다고 했어 (아니)"
    },
    {
      "startMs": 84190,
      "endMs": 85370,
      "translation": "그 여자는 놀란 눈으로 날 봐"
    },
    {
      "startMs": 85370,
      "endMs": 86870,
      "translation": "물건은 우편으로 오고 난 집에 혼자 있어"
    },
    {
      "startMs": 86870,
      "endMs": 88470,
      "translation": "상자가 문 앞에 닿으면 하나에 35에 팔려"
    },
    {
      "startMs": 88470,
      "endMs": 89620,
      "translation": "난 동료들을 위해 앞장서려 했는데"
    },
    {
      "startMs": 89620,
      "endMs": 91520,
      "translation": "내 눈앞에서 다들 적으로 변해"
    },
    {
      "startMs": 91520,
      "endMs": 93080,
      "translation": "악수하려고 손을 내밀면 난 주먹을 내밀 거야"
    },
    {
      "startMs": 93080,
      "endMs": 95090,
      "translation": "감자튀김 빼고 쿼터파운더 한 방 먹여 주지"
    },
    {
      "startMs": 95090,
      "endMs": 96490,
      "translation": "피처링 하나 없이 더블 플래티넘을 찍었어"
    },
    {
      "startMs": 96490,
      "endMs": 97970,
      "translation": "그놈 따위 필요 없다는 걸 보여 주려고"
    },
    {
      "startMs": 97970,
      "endMs": 99680,
      "translation": "접시를 건네면 그걸로 뭐라도 해 낼 수 있겠지만"
    },
    {
      "startMs": 99680,
      "endMs": 101670,
      "translation": "그놈은 분명 꺾이고 먹여 준 손을 물 거야"
    },
    {
      "startMs": 101670,
      "endMs": 103100,
      "translation": "내가 못 본 줄 알지"
    },
    {
      "startMs": 103100,
      "endMs": 104260,
      "translation": "네 여자한테 차가 없는 것도 알아"
    },
    {
      "startMs": 104260,
      "endMs": 106040,
      "translation": "내가 네 여자한테 작은 프리우스라도 사 주게 만들지 마"
    },
    {
      "startMs": 106040,
      "endMs": 107560,
      "translation": "카메라 앞에서 놀아 주면 그걸로 퉁 치자"
    },
    {
      "startMs": 107560,
      "endMs": 109310,
      "translation": "친구들은 가을 같아, 해마다 떠나가지"
    },
    {
      "startMs": 109310,
      "endMs": 111300,
      "translation": "갈퀴로 한데 모아 자루에 쓸어 담고"
    },
    {
      "startMs": 111300,
      "endMs": 112820,
      "translation": "꽁꽁 묶어서 두고 가"
    },
    {
      "startMs": 112820,
      "endMs": 114380,
      "translation": "이놈들은 대부분 속이니까"
    },
    {
      "startMs": 114380,
      "endMs": 115350,
      "translation": "그리고 난"
    },
    {
      "startMs": 115350,
      "endMs": 118450,
      "translation": "예전엔 친구가 있었는데 이젠 적이 생겼어"
    },
    {
      "startMs": 118450,
      "endMs": 121580,
