{
  "name": "arc-music-v7",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src scripts --ext .ts,.tsx --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "lyrics:lines": "NODE_USE_ENV_PROXY=1 vite-node scripts/lyrics-lines.ts --",
    "notes:audit": "vite-node scripts/notes-audit.ts --",
    "notes:art": "NODE_USE_ENV_PROXY=1 vite-node scripts/notes-art.ts --",
    "notes:migrate": "NODE_USE_ENV_PROXY=1 vite-node scripts/notes-migrate.ts --",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
